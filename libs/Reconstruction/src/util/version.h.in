#ifndef COLMAP_SRC_UTIL_VERSION_H_
#define COLMAP_SRC_UTIL_VERSION_H_

#include "misc.h"

namespace colmap {

// The upstream COLMAP release this fork is aligned with.
const static std::string COLMAP_VERSION = "${COLMAP_VERSION}";
const static std::string COLMAP_COMMIT_ID = "${GIT_COMMIT_ID}";
const static std::string COLMAP_COMMIT_DATE = "${GIT_COMMIT_DATE}";

constexpr int COLMAP_VERSION_MAJOR = ${COLMAP_VERSION_MAJOR};
constexpr int COLMAP_VERSION_MINOR = ${COLMAP_VERSION_MINOR};
constexpr int COLMAP_VERSION_PATCH = ${COLMAP_VERSION_PATCH};
constexpr int COLMAP_VERSION_NUMBER = COLMAP_VERSION_MAJOR * 1000000 +
                                      COLMAP_VERSION_MINOR * 10000 +
                                      COLMAP_VERSION_PATCH * 100;
// Bumped when the database schema gains new versioned migrations (e.g. the
// pose_priors table landing with pose-prior alignment).
constexpr int COLMAP_DATABASE_SCHEMA_REVISION = 0;

// Legacy fork-private database numbering written before the upstream
// user_version migration machinery was adopted. Databases stamped with this
// value carry the fork's float_descriptors and rigs/frame tables and run the
// version-gated row migrations on open.
constexpr int kLegacyForkDatabaseVersionNumber = 395;

std::string GetVersionInfo();

std::string GetBuildInfo();

// Computes database version number from version components.
// Format: major * 1000000 + minor * 10000 + patch * 100 + revision
// This gives 100 migration slots between consecutive releases.
int MakeDatabaseVersionNumber(int major, int minor, int patch, int revision);

// Returns the database version number for the current COLMAP version.
int GetDatabaseVersionNumber();

}  // namespace colmap

#endif  // COLMAP_SRC_UTIL_VERSION_H_
