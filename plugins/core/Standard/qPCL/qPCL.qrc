        <file alias="pclProjectionFilter.svg">resources/icons/pclProjectionFilter.svg</file>
        <file alias="pclGreedyTriangulation.svg">resources/icons/pclGreedyTriangulation.svg</file>
        <file alias="pclMLSSmoothing.svg">resources/icons/pclMLSSmoothing.svg</file>
        <file alias="pclNormalCurvature.svg">resources/icons/pclNormalCurvature.svg</file>
        <file alias="pclPoissonReconstruction.svg">resources/icons/pclPoissonReconstruction.svg</file>
        <file alias="pclRegionGrowing.svg">resources/icons/pclRegionGrowing.svg</file>
        <file alias="pclSACSegmentation.svg">resources/icons/pclSACSegmentation.svg</file>
        <file alias="pclSIFT.svg">resources/icons/pclSIFT.svg</file>
        <file alias="pclStatisticalOutliers.svg">resources/icons/pclStatisticalOutliers.svg</file>
        <file alias="pclTemplateAlignment.svg">resources/icons/pclTemplateAlignment.svg</file>
        <file alias="pclMinimumCut.svg">resources/icons/pclMinimumCut.svg</file>
        <file alias="pclDifferenceOfNormals.svg">resources/icons/pclDifferenceOfNormals.svg</file>
        <file alias="pclGeneralFilter.svg">resources/icons/pclGeneralFilter.svg</file>
        <file alias="pclBSplineCurve.svg">resources/icons/pclBSplineCurve.svg</file>
        <file alias="pclBSplineSurface.svg">resources/icons/pclBSplineSurface.svg</file>
        <file alias="pclMarchingCubes.svg">resources/icons/pclMarchingCubes.svg</file>
        <file alias="pclFastGlobalRegistration.svg">resources/icons/pclFastGlobalRegistration.svg</file>
    </qresource>
</RCC>
