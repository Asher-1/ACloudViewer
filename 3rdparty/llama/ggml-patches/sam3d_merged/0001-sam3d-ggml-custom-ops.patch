diff --git a/src/ggml-vulkan/vulkan-shaders/copy_from_quant_qk.comp b/src/ggml-vulkan/vulkan-shaders/copy_from_quant_qk.comp
new file mode 100644
index 0000000..d1cd9e1
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/copy_from_quant_qk.comp
@@ -0,0 +1,26 @@
+#version 450
+
+#include "types.glsl"
+#include "generic_unary_head.glsl"
+#include "dequant_funcs.glsl"
+
+// Q4_K is decoded as pairs rather than through the dequantize4 helper used by
+// the generic quantized copy shader. One workgroup owns one 256-value block.
+layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint idx = gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x * QUANT_K;
+    if (idx >= p.ne) {
+        return;
+    }
+
+    const uint dst_idx = get_doffset() + dst_idx(idx);
+    const uint src_idx = src0_idx_quant(idx, QUANT_K);
+    const uint a_offset = 0;
+
+    [[unroll]] for (uint j = 0; j < QUANT_K; j += 2) {
+        const vec2 v = dequantize(src_idx, j, a_offset);
+        data_d[dst_idx + j] = v.x;
+        data_d[dst_idx + j + 1] = v.y;
+    }
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/sam3d_scatter_mean.comp b/src/ggml-vulkan/vulkan-shaders/sam3d_scatter_mean.comp
new file mode 100644
index 0000000..f72624c
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/sam3d_scatter_mean.comp
@@ -0,0 +1,54 @@
+#version 450
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+
+// SAM 3D sparse-scatter mean (SparseTensor downsample): fine rows accumulate
+// into their owning coarse row, then each coarse row is divided by its count.
+//
+// Semantics pinned by the CUDA kernel (sam3d-scatter.cu) and the CPU fallback
+// (ggml_compute_forward_sam3d_sparse_scatter_mean):
+//   * accumulation happens in F16: each scalar add computes the exact sum of
+//     two halves and rounds it back to half (RNE). Running the add in f16
+//     arithmetic is mathematically identical to the CPU's F32-opmath form,
+//     because both round the same exact sum.
+//   * rows with a negative or out-of-range destination are skipped,
+//   * the division runs in F32 opmath: half(sum) -> float -> / count -> half.
+//
+// Mapping: invocation x = channel, invocation y = coarse row. Each output
+// address has exactly one writer thread, so the chain needs no barrier and
+// stays in program order; the per-channel loop over ascending fine rows
+// reproduces the CPU fallback's accumulation order bit-exactly. The rows[]
+// load is uniform across the workgroup and served from cache.
+
+layout (push_constant) uniform parameter {
+    uint channels;     // features.ne[0] == dst.ne[0]
+    uint fine_rows;    // features.ne[1]
+    uint coarse_rows;  // dst.ne[1]
+    uint pad;
+} p;
+
+layout (binding = 0) readonly buffer FEATURES { float16_t data_features[]; };
+layout (binding = 1) readonly buffer ROWS { int data_rows[]; };
+layout (binding = 2) readonly buffer COUNTS { float data_counts[]; };
+layout (binding = 3) buffer DST { float16_t data_dst[]; };
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint channel = gl_GlobalInvocationID.x;
+    const uint coarse_row = gl_GlobalInvocationID.y;
+    if (channel >= p.channels || coarse_row >= p.coarse_rows) {
+        return;
+    }
+    const uint dst_index = coarse_row * p.channels + channel;
+    const int owner = int(coarse_row);
+
+    float16_t acc = float16_t(0.0);
+    for (uint f = 0u; f < p.fine_rows; ++f) {
+        if (data_rows[f] == owner) {
+            acc = acc + data_features[f * p.channels + channel];
+        }
+    }
+
+    data_dst[dst_index] = float16_t(float(acc) / data_counts[coarse_row]);
+}
