+// PyTorch's vectorized CUDA LayerNorm path uses an online Welford reduction
+// for contiguous rows whose width is divisible by four.  SAM 3D Objects uses
+// 768-wide F32 LayerNorm before every transformer projection, where the older
+// sum/sum-of-squares reduction below loses enough precision to compound over
+// the mesh decoder.  Keep this implementation local to ggml's NORM operator:
+// it has no PyTorch, cuDNN, or host-runtime dependency.
+struct sam3d_welford_data {
+    float mean;
+    float sigma2;
+    float count;
+};
+
+static __device__ sam3d_welford_data sam3d_welford_online(
+        const float value, const sam3d_welford_data current) {
+    const float delta = value - current.mean;
+    const float count = current.count + 1.0f;
+    const float mean = current.mean + delta * (1.0f / count);
+    return {mean, current.sigma2 + delta * (value - mean), count};
+}
+
+static __device__ sam3d_welford_data sam3d_welford_combine(
+        const sam3d_welford_data data_b, const sam3d_welford_data data_a) {
+    const float delta = data_b.mean - data_a.mean;
+    const float count = data_a.count + data_b.count;
+    if (count == 0.0f) {
+        return {0.0f, 0.0f, 0.0f};
+    }
+    const float inv_count = 1.0f / count;
+    const float a_fraction = data_a.count * inv_count;
+    const float b_fraction = data_b.count * inv_count;
+    return {a_fraction * data_a.mean + b_fraction * data_b.mean,
+            data_a.sigma2 + data_b.sigma2 + delta * delta * data_a.count * b_fraction,
+            count};
+}
