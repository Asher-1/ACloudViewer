+// ggml_sam3d_f16_masked_attn
+
+struct ggml_tensor * ggml_sam3d_f16_masked_attn(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k,
+        struct ggml_tensor  * v,
+        struct ggml_tensor  * sequence_lengths,
+        float                 scale) {
+    GGML_ASSERT(q->type == GGML_TYPE_F16);
+    GGML_ASSERT(k->type == GGML_TYPE_F16);
+    GGML_ASSERT(v->type == GGML_TYPE_F16);
+    GGML_ASSERT(sequence_lengths->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(q));
+    GGML_ASSERT(ggml_is_contiguous(k));
+    GGML_ASSERT(ggml_is_contiguous(v));
+    GGML_ASSERT(ggml_is_contiguous(sequence_lengths));
+    GGML_ASSERT(q->ne[0] == k->ne[0] && q->ne[0] == v->ne[0]);
+    GGML_ASSERT(q->ne[1] == k->ne[1] && q->ne[1] == v->ne[1]);
+    GGML_ASSERT(q->ne[2] == k->ne[2] && q->ne[2] == v->ne[2]);
+    GGML_ASSERT(q->ne[3] == k->ne[3] && q->ne[3] == v->ne[3]);
+
+    struct ggml_tensor * result = ggml_new_tensor_4d(
+        ctx, GGML_TYPE_F16, q->ne[0], q->ne[1], q->ne[2], q->ne[3]);
+    ggml_set_op_params_f32(result, 0, scale);
+    result->op = GGML_OP_SAM3D_F16_MASKED_ATTN;
+    result->src[0] = q;
+    result->src[1] = k;
+    result->src[2] = v;
+    result->src[3] = sequence_lengths;
+    return result;
+}
+
+// ggml_sam3d_sparse_scatter_mean
+
+struct ggml_tensor * ggml_sam3d_sparse_scatter_mean(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * features,
+        struct ggml_tensor  * row_indices,
+        struct ggml_tensor  * inverse_counts) {
+    GGML_ASSERT(features->type == GGML_TYPE_F16);
+    GGML_ASSERT(row_indices->type == GGML_TYPE_I32);
+    GGML_ASSERT(inverse_counts->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(features));
+    GGML_ASSERT(ggml_is_contiguous(row_indices));
+    GGML_ASSERT(ggml_is_contiguous(inverse_counts));
+    GGML_ASSERT(features->ne[1] == row_indices->ne[0]);
+    GGML_ASSERT(inverse_counts->ne[0] == 1);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(
+        ctx, GGML_TYPE_F16, features->ne[0], inverse_counts->ne[1]);
+    result->op = GGML_OP_SAM3D_SPARSE_SCATTER_MEAN;
+    result->src[0] = features;
+    result->src[1] = row_indices;
+    result->src[2] = inverse_counts;
+    return result;
+}
+
+// ggml_sam3d_sparse_conv_f16
+
+struct ggml_tensor * ggml_sam3d_sparse_conv_f16(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * input,
+        struct ggml_tensor  * weight,
+        struct ggml_tensor  * bias,
+        struct ggml_tensor  * indices,
+        struct ggml_tensor  * mask,
+        struct ggml_tensor  * mask_argsort) {
+    GGML_ASSERT(input->type == GGML_TYPE_F16);
+    GGML_ASSERT(weight->type == GGML_TYPE_F16);
+    GGML_ASSERT(bias->type == GGML_TYPE_F16);
+    GGML_ASSERT(indices->type == GGML_TYPE_I32);
+    GGML_ASSERT(mask->type == GGML_TYPE_I32);
+    GGML_ASSERT(mask_argsort->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(input));
+    GGML_ASSERT(ggml_is_contiguous(weight));
+    GGML_ASSERT(ggml_is_contiguous(bias));
+    GGML_ASSERT(ggml_is_contiguous(indices));
+    GGML_ASSERT(ggml_is_contiguous(mask));
+    GGML_ASSERT(ggml_is_contiguous(mask_argsort));
+    GGML_ASSERT(indices->ne[0] == 27);
+    GGML_ASSERT(indices->ne[1] == input->ne[1]);
+    GGML_ASSERT(mask->ne[0] == input->ne[1]);
+    GGML_ASSERT(mask_argsort->ne[0] == input->ne[1]);
+    GGML_ASSERT(weight->ne[0] == 27 * input->ne[0]);
+    GGML_ASSERT(weight->ne[1] == bias->ne[0]);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(
+        ctx, GGML_TYPE_F16, bias->ne[0], input->ne[1]);
+    result->op = GGML_OP_SAM3D_SPARSE_CONV_F16;
+    result->src[0] = input;
+    result->src[1] = weight;
+    result->src[2] = bias;
+    result->src[3] = indices;
+    result->src[4] = mask;
+    result->src[5] = mask_argsort;
+    return result;
+}
