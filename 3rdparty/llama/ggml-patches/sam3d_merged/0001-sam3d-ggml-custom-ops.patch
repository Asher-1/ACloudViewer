+
+static bool layout_supported(const ggml_tensor * dst) {
+    if (dst == nullptr || dst->op != GGML_OP_SAM3D_SPARSE_CONV_F16) return false;
+    const ggml_tensor * input = dst->src[0];
+    const ggml_tensor * weight = dst->src[1];
+    const ggml_tensor * bias = dst->src[2];
+    const ggml_tensor * indices = dst->src[3];
+    const ggml_tensor * mask = dst->src[4];
+    const ggml_tensor * argsort = dst->src[5];
+    return input != nullptr && weight != nullptr && bias != nullptr &&
+           indices != nullptr && mask != nullptr && argsort != nullptr &&
+           input->type == GGML_TYPE_F16 && weight->type == GGML_TYPE_F16 &&
+           bias->type == GGML_TYPE_F16 && indices->type == GGML_TYPE_I32 &&
+           mask->type == GGML_TYPE_I32 && argsort->type == GGML_TYPE_I32 &&
+           dst->type == GGML_TYPE_F16 && ggml_is_contiguous(input) &&
+           ggml_is_contiguous(weight) && ggml_is_contiguous(bias) &&
+           ggml_is_contiguous(indices) && ggml_is_contiguous(mask) &&
+           ggml_is_contiguous(argsort) && indices->ne[0] == 27 &&
+           indices->ne[1] == input->ne[1] && mask->ne[0] == input->ne[1] &&
+           argsort->ne[0] == input->ne[1] &&
+           weight->ne[0] == 27 * input->ne[0] &&
+           weight->ne[1] == bias->ne[0] && dst->ne[0] == bias->ne[0] &&
+           dst->ne[1] == input->ne[1];
+}
+
+}  // namespace
+
+bool ggml_cuda_sam3d_sparse_conv_f16_supported(int device, const ggml_tensor * dst) {
+    return ggml_cuda_info().devices[device].cc >= GGML_CUDA_CC_AMPERE &&
+           layout_supported(dst);
+}
+
+void ggml_cuda_sam3d_sparse_conv_f16(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(layout_supported(dst));
+    const ggml_tensor * input = dst->src[0];
+    const ggml_tensor * weight = dst->src[1];
+    const ggml_tensor * bias = dst->src[2];
+    const ggml_tensor * indices = dst->src[3];
+    const ggml_tensor * mask = dst->src[4];
+    const ggml_tensor * argsort = dst->src[5];
+    sam3d_spconv_f16_forward(
+        ctx.stream(), input->data, weight->data, bias->data, dst->data,
+        static_cast<const int32_t *>(indices->data),
+        reinterpret_cast<const uint32_t *>(mask->data),
+        static_cast<const int32_t *>(argsort->data), input->ne[1],
+        input->ne[0], dst->ne[0]);
+    CUDA_CHECK(cudaGetLastError());
+}
