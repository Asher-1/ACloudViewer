+void ggml_compute_forward_sam3d_sparse_scatter_mean(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * features = dst->src[0];
+    const ggml_tensor * row_indices = dst->src[1];
+    const ggml_tensor * counts = dst->src[2];
+
+    // Threaded over coarse rows: each thread owns a disjoint coarse-row range,
+    // scans all fine rows but only accumulates into its own range. Within one
+    // coarse row the fine-row accumulation order is identical to the
+    // single-thread path, so results are bit-equal regardless of nth.
+    GGML_ASSERT(features != nullptr && row_indices != nullptr && counts != nullptr);
+    GGML_ASSERT(features->type == GGML_TYPE_F16);
+    GGML_ASSERT(row_indices->type == GGML_TYPE_I32);
+    GGML_ASSERT(counts->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F16);
+    GGML_ASSERT(ggml_is_contiguous(features));
+    GGML_ASSERT(ggml_is_contiguous(row_indices));
+    GGML_ASSERT(ggml_is_contiguous(counts));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+
+    const int64_t channels = features->ne[0];
+    const int64_t fine_rows = features->ne[1];
+    const int64_t coarse_rows = dst->ne[1];
+    GGML_ASSERT(row_indices->ne[0] == fine_rows);
+    GGML_ASSERT(counts->ne[0] == 1);
+    GGML_ASSERT(counts->ne[1] == coarse_rows);
+    GGML_ASSERT(dst->ne[0] == channels);
+
+    const auto * source = static_cast<const ggml_fp16_t *>(features->data);
+    const auto * rows = static_cast<const int32_t *>(row_indices->data);
+    const auto * counts_f = static_cast<const float *>(counts->data);
+    auto * result = static_cast<ggml_fp16_t *>(dst->data);
+
+    const int nth = params->nth > 0 ? params->nth : 1;
+    const int ith = params->ith;
+    const int64_t rows_per = (coarse_rows + nth - 1) / nth;
+    const int64_t cr_begin = std::min(coarse_rows, (int64_t)ith * rows_per);
+    const int64_t cr_end = std::min(coarse_rows, cr_begin + rows_per);
+    for (int64_t coarse_row = cr_begin; coarse_row < cr_end; ++coarse_row) {
+        std::memset(result + coarse_row * channels, 0, channels * sizeof(ggml_fp16_t));
+    }
+
+    // Keep every partial sum in F16 so the fallback follows the CUDA atomic path.
+    for (int64_t fine_row = 0; fine_row < fine_rows; ++fine_row) {
+        const int32_t coarse_row = rows[fine_row];
+        if (coarse_row < cr_begin || coarse_row >= cr_end) {
+            continue;
+        }
+        for (int64_t channel = 0; channel < channels; ++channel) {
+            const int64_t source_index = fine_row * channels + channel;
+            const int64_t result_index = static_cast<int64_t>(coarse_row) * channels + channel;
+            result[result_index] = ggml_fp32_to_fp16(
+                ggml_fp16_to_fp32(result[result_index]) + ggml_fp16_to_fp32(source[source_index]));
+        }
+    }
+
+    for (int64_t coarse_row = cr_begin; coarse_row < cr_end; ++coarse_row) {
+        for (int64_t channel = 0; channel < channels; ++channel) {
+            const int64_t result_index = coarse_row * channels + channel;
+            result[result_index] = ggml_fp32_to_fp16(
+                ggml_fp16_to_fp32(result[result_index]) / counts_f[coarse_row]);
+        }
+    }
+}
+
+void ggml_compute_forward_sam3d_sparse_conv_f16(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * input = dst->src[0];
+    const ggml_tensor * weight = dst->src[1];
+    const ggml_tensor * bias = dst->src[2];
+    const ggml_tensor * indices = dst->src[3];
+    GGML_ASSERT(input->type == GGML_TYPE_F16 && weight->type == GGML_TYPE_F16);
+    GGML_ASSERT(bias->type == GGML_TYPE_F16 && indices->type == GGML_TYPE_I32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F16);
+    GGML_ASSERT(ggml_is_contiguous(input) && ggml_is_contiguous(weight));
+    GGML_ASSERT(ggml_is_contiguous(bias) && ggml_is_contiguous(indices));
+
+    const int64_t channels = input->ne[0];
+    const int64_t tokens = input->ne[1];
+    const int64_t output_channels = dst->ne[0];
+    const auto * x = static_cast<const ggml_fp16_t *>(input->data);
+    const auto * w = static_cast<const ggml_fp16_t *>(weight->data);
+    const auto * b = static_cast<const ggml_fp16_t *>(bias->data);
+    const auto * pair = static_cast<const int32_t *>(indices->data);
+    auto * y = static_cast<ggml_fp16_t *>(dst->data);
+
+    // Portable fallback. The official spconv implicit GEMM accumulates in
+    // F32; matching that (instead of an F16 accumulator) is required for the
+    // out-stage modulated convolutions, whose inputs reach the F16 overflow
+    // boundary - an F16 accumulator would saturate to -inf and poison the
+    // rest of the graph. Missing neighbours are encoded as -1. Each output
+    // token is independent, so the token loop partitions over threads.
+    const int nth = params->nth > 0 ? params->nth : 1;
+    const int ith = params->ith;
+    const int64_t tokens_per = (tokens + nth - 1) / nth;
+    const int64_t tok_begin = std::min(tokens, (int64_t)ith * tokens_per);
+    const int64_t tok_end = std::min(tokens, tok_begin + tokens_per);
+    for (int64_t token = tok_begin; token < tok_end; ++token) {
+        for (int64_t out = 0; out < output_channels; ++out) {
+            float acc = ggml_fp16_to_fp32(b[out]);
+            for (int64_t offset = 0; offset < 27; ++offset) {
+                const int32_t source_token = pair[offset * tokens + token];
+                if (source_token < 0 || source_token >= tokens) continue;
+                for (int64_t channel = 0; channel < channels; ++channel) {
+                    const int64_t wi = (out * 27 + offset) * channels + channel;
+                    const int64_t xi = source_token * channels + channel;
+                    acc += ggml_fp16_to_fp32(w[wi]) * ggml_fp16_to_fp32(x[xi]);
+                }
+            }
+            y[token * output_channels + out] = ggml_fp32_to_fp16(acc);
+        }
+    }
+}
