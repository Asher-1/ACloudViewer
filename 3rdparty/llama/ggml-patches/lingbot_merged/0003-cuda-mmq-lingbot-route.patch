# lingbot patch: name-routed GEMM parity for the lingbot graph
# (LingbotMap-only; every other AICore task keeps its dispatch).
#
# (1) CUDA: the upstream reference CLI (cpp_ggml build-cuda) sets
#     GGML_CUDA_FORCE_CUBLAS=ON, so its q8-weight matmuls run the cuBLAS
#     reduction tree instead of the MMQ int8 kernels, and the camera head's
#     iterative AdaLN refinement amplifies the resulting 1e-12 accumulation
#     order differences into visible depth/pose drift. A global FORCE_CUBLAS
#     would regress every other AICore task's quantized throughput, so the
#     MMQ branch is skipped ONLY for nodes named "lingbot_scalar_*".
#     F16/F32 matmuls are unaffected: F16 keeps the mmf kernel on both
#     engines and F32 with GGML_PREC_F32 already bypasses MMQ; MMVQ stays
#     enabled on both engines for small batches.
# Pairs with the lingbot_scalar_ exemption in cuda_strict_f32/0001 (cuBLAS
# math mode stays TF32 for these nodes, matching the reference build).
# Zero-dependency fixed-length prefix compares; the tensor name buffer is
# at least GGML_MAX_NAME bytes, so the loops cannot read out of bounds.
diff --git a/src/ggml-cuda/ggml-cuda.cu b/src/ggml-cuda/ggml-cuda.cu
--- a/src/ggml-cuda/ggml-cuda.cu
+++ b/src/ggml-cuda/ggml-cuda.cu
@@ -2086,8 +2086,24 @@
         return;
     }
+    // lingbot patch: skip the MMQ int8 kernels for nodes named
+    // "lingbot_scalar_*" so they run the cuBLAS reduction tree, matching
+    // the reference CLI's GGML_CUDA_FORCE_CUBLAS=ON build. Scoped by node
+    // name so no other task's quantized dispatch changes; the tensor name
+    // buffer is at least GGML_MAX_NAME bytes, so the fixed-length loop
+    // cannot read out of bounds.
+    bool lingbot_parity = false;
+    {
+        static const char lb[] = "lingbot_scalar_";
+        const char * dn = dst->name;
+        lingbot_parity = true;
+        for (int i = 0; i < 15; ++i) {
+            if (dn[i] != lb[i]) { lingbot_parity = false; break; }
+        }
+    }
-    if (ggml_cuda_should_use_mmq(src0->type, cc, ne11, /*n_experts =*/ 0)) {
+    if (ggml_cuda_should_use_mmq(src0->type, cc, ne11, /*n_experts =*/ 0) &&
+            !lingbot_parity) {
         ggml_cuda_mul_mat_q(ctx, src0, src1, nullptr, dst);
         return;
     }
     ggml_cuda_mul_mat_cublas(ctx, src0, src1, dst);
 }
