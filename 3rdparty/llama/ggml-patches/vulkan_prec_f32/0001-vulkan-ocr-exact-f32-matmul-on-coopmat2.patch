diff --git a/src/ggml-vulkan/ggml-vulkan.cpp b/src/ggml-vulkan/ggml-vulkan.cpp
--- a/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/src/ggml-vulkan/ggml-vulkan.cpp
@@ -9653,10 +9653,24 @@
         src1_uma = d_Qy != nullptr;
     }
 
+    // ocr patch: the OCR det/rec/layout graphs mark their F32xF32 GEMMs
+    // (dense conv, SVTR attention, matmul_v2) under GGML_PREC_F32
+    // "ocr_scalar_*" so f32 models match CPU/CUDA (rec 4.4e-4 -> 0).
+    // Cooperative-matrix-2 has no F32 shader and converts F32 operands to
+    // F16 below (OCR det map 0.0267 max|diff| vs the Paddle predictor);
+    // marked outputs keep the F32 pair and run the exact scalar pipeline.
+    // Every other graph keeps the coopmat2 route: applying this to every
+    // PREC_F32 matmul cost rmbg/lingbot/table f32 +17..34% for no gate change.
+    const bool precise_f32 = dst->op_params[0] == GGML_PREC_F32 &&
+                             src0->type == GGML_TYPE_F32 &&
+                             src1->type == GGML_TYPE_F32 &&
+                             ggml_vk_rmbg_tensor_name(dst).compare(0, 11, "ocr_scalar_") == 0;
     // Reformat and convert to fp16 if non-contiguous, or for coopmat2 for better perf
-    const bool x_non_contig = (ctx->device->coopmat2 && src0->type == GGML_TYPE_F32) ||
+    const bool x_non_contig = (!precise_f32 && ctx->device->coopmat2 &&
+                               src0->type == GGML_TYPE_F32) ||
                               !ggml_vk_dim01_contiguous(src0);
-    const bool y_non_contig = (ctx->device->coopmat2 && src1->type == GGML_TYPE_F32) ||
+    const bool y_non_contig = (!precise_f32 && ctx->device->coopmat2 &&
+                               src1->type == GGML_TYPE_F32) ||
                               (src0->type == GGML_TYPE_BF16 && src1->type != GGML_TYPE_BF16) ||
                               !ggml_vk_dim01_contiguous(src1);
 
@@ -9676,8 +9690,9 @@
         quantize_y = false;
     }
 
-    if (ctx->device->coopmat_support &&
-        ggml_vk_rmbg_force_scalar_matmul(ctx->device, src0, src1, dst)) {
+    if (precise_f32 ||
+        (ctx->device->coopmat_support &&
+         ggml_vk_rmbg_force_scalar_matmul(ctx->device, src0, src1, dst))) {
         const ggml_type scalar_src1_type = y_non_contig ? f16_type : src1->type;
         vk_matmul_pipeline scalar = ggml_vk_rmbg_scalar_matmul_pipeline(
             ctx->device, src0->type, scalar_src1_type);
