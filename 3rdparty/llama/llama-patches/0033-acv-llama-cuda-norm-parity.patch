+// Match pinned llama RMS-norm naming. llm_graph_context::build_norm names every
+// LLM RMS_NORM node "norm-<il>" ("norm" for the final il < 0 case); model-level
+// cb() renames only the trailing MUL/ADD, never the RMS_NORM node itself.
+// Owner-scoped: the task runtime tags its LLM norm nodes via cp.cb_eval with the
+// strict-f32 hint (ggml_rms_norm_set_hint); untagged llama tasks such as llm
+// (pristine-new upstream reference) keep the newer float4 vectorized path.
+static inline bool ggml_cuda_llama_norm_node(const ggml_tensor * t) {
+    const char * name = t->name;
+    const bool named = name && strncmp(name, "norm", 4) == 0 &&
+        (name[4] == '\0' || (name[4] == '-' && name[5] >= '0' && name[5] <= '9'));
+    return named && ggml_get_op_params_i32(t, 1) == GGML_HINT_STRICT_F32;
+}
