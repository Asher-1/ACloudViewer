diff --git a/tools/mtmd/mtmd.h b/tools/mtmd/mtmd.h
index bcd76a9d..2a9c71e4 100644
--- a/tools/mtmd/mtmd.h
+++ b/tools/mtmd/mtmd.h
@@ -331,6 +331,30 @@ MTMD_API int32_t mtmd_encode_chunk(mtmd_context * ctx,
 // llama_model_n_embd_inp(model) * mtmd_input_chunk_get_n_tokens(chunk) * sizeof(float)
 MTMD_API float * mtmd_get_output_embd(mtmd_context * ctx);
 
+// WeVisOne: per-block hidden-state taps for the vision encoder.
+//
+// Select the ViT blocks whose raw pre-merger outputs must be captured by
+// every vision encode (each tap is a ggml_cpy into a dedicated leaf inside
+// the vision graph, so the pooled scheduler memory cannot recycle it).
+// Only single-frame image encodes are supported; with an audio-only mmproj
+// configure returns 1.
+struct mtmd_vision_tap {
+    int32_t layer;        // 0-based ViT block index of this tap
+    int64_t n_embd;       // channels per token (ne[0])
+    int64_t n_tokens;     // pre-merger token count (ne[1])
+    const float * data;   // (n_embd, n_tokens) in the graph token order
+};
+
+// choose which ViT block outputs are captured; n_layers == 0 disables.
+// layers may be NULL when n_layers == 0. returns 0 on success.
+MTMD_API int32_t mtmd_vision_taps_configure(mtmd_context * ctx, const int32_t * layers, size_t n_layers);
+
+// copy the taps of the last vision encode into out_taps (up to max_taps
+// entries) and return the number written (0 when taps are disabled or the
+// last encode carried no tap nodes). the data pointers stay valid until the
+// next vision encode or re-configure.
+MTMD_API int32_t mtmd_vision_taps_get(const mtmd_context * ctx, struct mtmd_vision_tap * out_taps, int32_t max_taps);
+
 
 // batch encoding API
 // chunks are not owned by the batch, they will not be freed by mtmd_batch_free()
