+void ggml_compute_forward_sam3d_sparse_conv_f16(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * input = dst->src[0];
+    const ggml_tensor * weight = dst->src[1];
+    const ggml_tensor * bias = dst->src[2];
+    const ggml_tensor * indices = dst->src[3];
+    GGML_ASSERT(input->type == GGML_TYPE_F16 && weight->type == GGML_TYPE_F16);
+    GGML_ASSERT(bias->type == GGML_TYPE_F16 && indices->type == GGML_TYPE_I32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F16);
+    GGML_ASSERT(ggml_is_contiguous(input) && ggml_is_contiguous(weight));
+    GGML_ASSERT(ggml_is_contiguous(bias) && ggml_is_contiguous(indices));
