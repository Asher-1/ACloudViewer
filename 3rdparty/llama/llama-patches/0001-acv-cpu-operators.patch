+                                                      const ggml_tensor *nchw,
+                                                      ggml_tensor *whcn, int32_t c,
+                                                      int32_t h, int32_t w);
+
+// Copy WHCN tensor to dense WHCN (handles gallocr padded strides on src).
+GGML_BACKEND_API bool ggml_vulkan_aliked_dense_copy_whcn(ggml_backend_t backend,
+                                                         const ggml_tensor *src,
+                                                         ggml_tensor *dst, int32_t w,
