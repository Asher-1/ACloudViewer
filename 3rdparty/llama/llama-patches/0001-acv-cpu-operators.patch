+    params[1] = head_dim;
+    params[2] = GGML_ROPE_TYPE_CUSTOM_QKV;
+    params[3] = n_heads;
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_ROPE;
+    result->src[0] = qkv;
+    result->src[1] = freqs;
+
+    return result;
