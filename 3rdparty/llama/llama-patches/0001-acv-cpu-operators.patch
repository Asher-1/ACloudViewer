+
+// Returns true when ALIKED Vulkan compute pipelines are available on this backend.
+GGML_BACKEND_API bool ggml_vulkan_aliked_available(ggml_backend_t backend);
+
+// Drain VkAliked + ggml compute queues; reset open compute_ctx / descriptor idx.
+// Call at extract boundaries to avoid stale command buffers across custom ops.
+GGML_BACKEND_API bool ggml_vulkan_aliked_queue_idle(ggml_backend_t backend);
+
