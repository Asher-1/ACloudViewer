+// threadgroup and O(100M) threadgroups for a 1024x1024 feature map, so
+// threadgroup scheduling overhead (not memory bandwidth) dominates.  Here a
+// one-dimensional grid over the output elements writes 4 contiguous channels
+// per thread with a vectorized store, cutting the threadgroup count by ~4K.
+template <typename T>
+struct im2col_vec4 { typedef vec<T, 4> type; };
+
+template <typename T>
+kernel void kernel_im2col_fast(
+        constant ggml_metal_kargs_im2col & args,
+        device const float * x,
+        device        char * dst,
+        uint3 tgpig[[threadgroup_position_in_grid]],
+        uint3  tgpg[[threadgroups_per_grid]],
+        uint3 tpitg[[thread_position_in_threadgroup]],
+        uint3   ntg[[threads_per_threadgroup]]) {
+
+    const int64_t CHW = args.CHW;
+    const int64_t OHW = (int64_t) args.OH * args.OW;
+    const int64_t total = (int64_t) args.N * CHW * OHW;
+
+    const int64_t tid = (int64_t) tgpig.x * ntg.x + tpitg.x;
+
+    // fast path: 16 contiguous channels per thread (4 vectorized stores).
+    // Channel decomposition advances by incrementing hw with carry into ic,
+    // so only two divisions per element remain (ikh/ikw); CHW % 16 == 0 is
+    // enforced by the dispatcher, keeping every store aligned.
+    if ((CHW & 15) == 0) {
+        const int64_t total16 = total >> 4;
+        if (tid >= total16) {
+            return;
+        }
+        const int64_t di16 = tid << 4;
+        const int64_t n    = di16 / (CHW * OHW);
+        const int64_t rem  = di16 % (CHW * OHW);
+        const int64_t pos  = rem / CHW; // oh * OW + ow
+        const int64_t c    = rem % CHW;
+        const int64_t oh   = pos / args.OW;
+        const int64_t ow   = pos % args.OW;
+
+        int64_t ic  = c / args.KHW;
+        int64_t hw  = c % args.KHW;
+        int64_t ikh = hw / args.KW;
+        int64_t ikw = hw % args.KW;
+
+        typename im2col_vec4<T>::type v[4];
+        for (int j = 0; j < 16; ++j) {
+            const int64_t iih = oh * args.s1 + ikh * args.d1 - args.p1;
+            const int64_t iiw = ow * args.s0 + ikw * args.d0 - args.p0;
+            if (iih < 0 || iih >= args.IH || iiw < 0 || iiw >= args.IW) {
+                v[j >> 2][j & 3] = (T) 0.0f;
+            } else {
+                v[j >> 2][j & 3] =
+                        (T) x[n * args.ofs0 + ic * args.ofs1 + iih * args.IW + iiw];
+            }
+            // advance hw with carry into ikw/ikh/ic - no division inside
+            // the group
+            ++hw;
+            if (hw == args.KHW) {
+                hw = 0;
+                ikh = 0;
+                ikw = 0;
+                ++ic;
+            } else {
+                ++ikw;
+                if (ikw == args.KW) {
+                    ikw = 0;
+                    ++ikh;
+                }
+            }
+        }
+        device typename im2col_vec4<T>::type * pdst =
+                (device typename im2col_vec4<T>::type *) dst;
+        pdst[(di16 >> 2) + 0] = v[0];
+        pdst[(di16 >> 2) + 1] = v[1];
+        pdst[(di16 >> 2) + 2] = v[2];
+        pdst[(di16 >> 2) + 3] = v[3];
+        return;
+    }
+
+    // fast path: 4 contiguous channels per thread, vectorized store.  The
+    // destination layout is [CHW, OW, OH, N] with CHW % 4 == 0 enforced by
+    // the dispatcher, so the store stays 16/8-byte aligned.
+    if ((CHW & 3) == 0) {
+        const int64_t total4 = total >> 2;
+        if (tid >= total4) {
+            return;
+        }
+        const int64_t di4 = tid << 2;
+        const int64_t n   = di4 / (CHW * OHW);
+        const int64_t rem = di4 % (CHW * OHW);
+        const int64_t pos = rem / CHW; // oh * OW + ow
+        const int64_t c   = rem % CHW;
+        const int64_t oh  = pos / args.OW;
+        const int64_t ow  = pos % args.OW;
+
+        typename im2col_vec4<T>::type v;
+        for (int j = 0; j < 4; ++j) {
+            const int64_t cj  = c + j;
+            const int64_t ic  = cj / args.KHW;
+            const int64_t hw  = cj % args.KHW;
+            const int64_t ikh = hw / args.KW;
+            const int64_t ikw = hw % args.KW;
+            const int64_t iih = oh * args.s1 + ikh * args.d1 - args.p1;
+            const int64_t iiw = ow * args.s0 + ikw * args.d0 - args.p0;
+            if (iih < 0 || iih >= args.IH || iiw < 0 || iiw >= args.IW) {
+                v[j] = (T) 0.0f;
+            } else {
+                v[j] = (T) x[n * args.ofs0 + ic * args.ofs1 + iih * args.IW + iiw];
+            }
+        }
+        ((device typename im2col_vec4<T>::type *) dst)[di4 >> 2] = v;
+        return;
+    }
+
+    // scalar fallback (CHW not a multiple of 4)
+    if (tid >= total) {
+        return;
+    }
+    const int64_t n   = tid / (CHW * OHW);
+    const int64_t rem = tid % (CHW * OHW);
+    const int64_t pos = rem / CHW;
+    const int64_t c   = rem % CHW;
+    const int64_t oh  = pos / args.OW;
+    const int64_t ow  = pos % args.OW;
+    const int64_t ic  = c / args.KHW;
+    const int64_t hw  = c % args.KHW;
+    const int64_t ikh = hw / args.KW;
+    const int64_t ikw = hw % args.KW;
+    const int64_t iih = oh * args.s1 + ikh * args.d1 - args.p1;
+    const int64_t iiw = ow * args.s0 + ikw * args.d0 - args.p0;
+    float val = 0.0f;
+    if (iih >= 0 && iih < args.IH && iiw >= 0 && iiw < args.IW) {
+        val = x[n * args.ofs0 + ic * args.ofs1 + iih * args.IW + iiw];
+    }
+    ((device T *) dst)[tid] = (T) val;
+}
+
+template [[host_name("kernel_im2col_fast_f32")]] kernel im2col_t kernel_im2col_fast<float>;
+template [[host_name("kernel_im2col_fast_f16")]] kernel im2col_t kernel_im2col_fast<half>;
+
