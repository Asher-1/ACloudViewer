+// ACV: flat-grid get_rows for the F32 case.  The stock kernel launches one
+// threadgroup per gathered row, which for a [64, 3.2M] row index tensor is
+// 3.2M threadgroups of 64 threads - threadgroup scheduling bound.  Here a
+// one-dimensional grid covers every float4 of the output so all cores
+// participate; the src1 row index is decomposed once per thread.
+kernel void kernel_get_rows_flat_f32(
+        constant ggml_metal_kargs_get_rows & args,
+        device const void * src0,
+        device const void * src1,
+        device       void * dst,
+        uint3 tgpig[[threadgroup_position_in_grid]],
+        ushort tiitg[[thread_index_in_threadgroup]],
+        ushort3 ntg[[threads_per_threadgroup]]) {
+    const int32_t idx = tgpig.x * ntg.x + tiitg;
+    const int32_t total = args.ne00 * args.ne10 * args.ne11 * args.ne12;
+    const int32_t total4 = total >> 2; // ne00 % 4 == 0 enforced by dispatch
+    if (idx >= total4) {
+        return;
+    }
+    const int32_t di = idx << 2;
+    const int32_t i0 = di % args.ne00; // 4-aligned
+    const int32_t i1 = di / args.ne00;
+
+    const int32_t i10 = i1 % args.ne10;
+    const int32_t i11 = (i1 / args.ne10) % args.ne11;
+    const int32_t i12 = i1 / (args.ne10 * args.ne11);
+
+    const int32_t r = ((const device int32_t *) ((const device char *) src1 + i12*args.nb12 + i11*args.nb11 + i10*args.nb10))[0];
+
+    const int32_t i02 = i11;
+    const int32_t i03 = i12;
+
+    device const float4 * psrc = (device const float4 *) ((const device char *) src0 + i03*args.nb03 + i02*args.nb02 + (int64_t) r*args.nb01 + i0*4);
+    device       float4 * pdst = (device       float4 *) ((      device char *)  dst + i12*args.nb3  + i11*args.nb2  + i10*args.nb1  + i0*4);
+
+    *pdst = *psrc;
+}
