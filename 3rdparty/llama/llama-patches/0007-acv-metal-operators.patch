+// ACV RMBG fused QKV split + bias for the Swin attention layout:
+// qkv [3C, N, nW] (+ bias [3C]) -> dst [hd, N, heads, nW] contiguous
+// segment (kind 0/1/2 selects q/k/v).  Replaces the primitive
+// add + 3x(cont + permute) chain with one pass; the F32 flash-attn
+// path consumes this exact layout directly.
+kernel void kernel_rmbg_swin_qkv_layout_f32(
+        constant ggml_metal_kargs_rmbg_swin_qkv_layout & args,
+        device const  float * qkv,
+        device const  float * bias,
+        device       float * dst,
+        uint3 tgpig[[threadgroup_position_in_grid]],
+        uint3 tpitg[[thread_position_in_threadgroup]]) {
+    const int64_t index = (int64_t) tgpig.x * 256 + tpitg.x;
+    if (index >= args.total) {
+        return;
+    }
+    // ACV fast path: 4 channels per thread.  The channel decomposition is
+    // computed once and amortized over 4 elements; qkv and bias reads stay
+    // contiguous (vectorized float4), and the dst head/lane walk only needs
+    // one head boundary check per group since hd is a multiple of 4.
+    if ((args.C & 3) == 0 && ((args.C / args.heads) & 3) == 0) {
+        const int64_t total4 = args.total >> 2;
+        if (index >= total4) {
+            return;
+        }
+        const int64_t di = index << 2;
+        const int64_t c0    = di % args.C;
+        const int64_t token = (di / args.C) % args.N;
+        const int64_t win   = di / ((int64_t) args.C * args.N);
+        const int64_t hd    = args.C / args.heads;
+        const int64_t src_base = (int64_t) args.kind * args.C +
+                                 3 * args.C * (token + (int64_t) args.N * win);
+        const int64_t bias_base = (int64_t) args.kind * args.C;
+
+        device const float4 * qv =
+                (device const float4 *) (qkv + src_base + c0);
+        device const float4 * bs =
+                (device const float4 *) (bias + bias_base + c0);
+        const float4 v = *qv + *bs;
+
+        int64_t head = c0 / hd;
+        int64_t lane = c0 % hd;
+        int64_t dst_off =
+                hd * (token + (int64_t) args.N * (head + args.heads * win));
+        for (int j = 0; j < 4; ++j) {
+            dst[dst_off + lane] = v[j];
+            ++lane;
+            if (lane == hd) {
+                lane = 0;
+                dst_off += hd * args.N;
+            }
+        }
+        return;
+    }
+    const int channel = (int) (index % args.C);
+    const int token   = (int) ((index / args.C) % args.N);
+    const int win     = (int) (index / ((int64_t) args.C * args.N));
+    const int hd      = args.C / args.heads;
+    const int head    = channel / hd;
+    const int lane    = channel % hd;
+    const int64_t src = channel + (int64_t) args.kind * args.C +
+                        (int64_t) 3 * args.C * (token + (int64_t) args.N * win);
+    const int64_t dst_idx =
+            lane + (int64_t) hd * (token + (int64_t) args.N *
+                                              (head + args.heads * win));
+    dst[dst_idx] = qkv[src] + bias[channel + (int64_t) args.kind * args.C];
+}
