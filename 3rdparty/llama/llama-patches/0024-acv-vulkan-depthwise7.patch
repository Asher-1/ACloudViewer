+        [[unroll]] for (uint i = 0; i < DW7_TILE_X + 6; ++i) {
+            const uint src_x = dst_x + i - p.pad_x;
+            if (src_x >= p.src_w) continue;
+            const vec4 v = src_data4[row + src_x * channels4];
+            [[unroll]] for (uint j = 0; j < DW7_TILE_X; ++j) {
+                const int kx = int(i) - int(j);
+                if (kx >= 0 && kx < 7) acc[j] = fma(v, k[kx], acc[j]);
+            }
+        }
+    }
+    const uint bi = p.c_offset + c;
+    const vec4 b = p.has_bias != 0 ? vec4(bias_data[bi], bias_data[bi + 1], bias_data[bi + 2], bias_data[bi + 3]) : vec4(0);
+    const uint dst_i = p.d_offset / 4 + (n * p.dst_h + dst_y) * p.dst_w * channels4 + c4;
+    [[unroll]] for (uint j = 0; j < DW7_TILE_X; ++j) {
+        if (dst_x + j < p.dst_w) {
+            precise vec4 rounded = acc[j];
+            precise vec4 result = p.has_bias != 0 ? rounded + b : rounded;
+            dst_data4[dst_i + (dst_x + j) * channels4] = result;
+        }
