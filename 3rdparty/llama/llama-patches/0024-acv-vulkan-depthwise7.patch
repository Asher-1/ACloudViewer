+
+void conv_2d_dw7_cwhn(uint idx) {
+    const uint channels4 = p.channels / 4;
+    const uint tiles_x = (p.dst_w + DW7_TILE_X - 1) / DW7_TILE_X;
+    const uint c4 = idx % channels4;
+    uint rest = idx / channels4;
+    const uint tile = rest % tiles_x;
+    rest /= tiles_x;
+    const uint dst_y = rest % p.dst_h;
+    const uint n = rest / p.dst_h;
+    const uint dst_x = tile * DW7_TILE_X;
+    const uint c = c4 * 4;
+    vec4 acc[DW7_TILE_X];
+    [[unroll]] for (uint j = 0; j < DW7_TILE_X; ++j) acc[j] = vec4(0);
+    const uint src_i = n * p.src_h * p.src_w * channels4 + c4;
+    [[unroll]] for (uint ky = 0; ky < 7; ++ky) {
+        const uint src_y = dst_y + ky - p.pad_y;
+        if (src_y >= p.src_h) continue;
+        vec4 k[7];
+        [[unroll]] for (uint kx = 0; kx < 7; ++kx) {
+            const uint ki = p.a_offset + (ky * 7 + kx) * p.channels + c;
