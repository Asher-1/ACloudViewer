+// Low-channel image stems otherwise launch a mostly idle workgroup for
+// every spatial position. Gather consecutive output elements instead, retaining
+// the original input addressing, zero padding and destination conversion.
+void im2col_spatial() {
+    const uint count = p.CHW * p.OW * p.OH_batch;
+    const uint stride = gl_NumWorkGroups.x * 512;
+    for (uint base = gl_WorkGroupID.x * 512; base < count; base += stride) {
+        for (uint lane = gl_LocalInvocationID.x; lane < 512; lane += BLOCK_SIZE) {
+            const uint index = base + lane;
+            if (index >= count) {
+                break;
+            }
+            uint window = index % p.CHW;
+            uint spatial = index / p.CHW;
+            const uint ow = spatial % p.OW;
+            spatial /= p.OW;
+            const uint oh = spatial % p.OH;
+            const uint batch = spatial / p.OH;
+            const uint kx = window % p.KW;
+            window /= p.KW;
+            const uint ky = window % p.KH;
+            const uint channel = window / p.KH;
+            const int iw = int(ow * p.s0 + kx * p.d0) - p.p0;
+            const int ih = int(oh * p.s1 + ky * p.d1) - p.p1;
+            A_TYPE val = A_TYPE(0);
+            if (uint(iw) < p.IW && uint(ih) < p.IH) {
+                val = data_a[batch * p.batch_offset + channel * p.offset_delta +
+                             uint(ih) * p.IW + uint(iw)];
+            }
+#if BDA
+            D_ptr(p.dst_addr + D_SIZE * BDA_OFFSET_T(index)).d = D_TYPE(val);
+#else
+            data_d[index] = D_TYPE(val);
+#endif
+        }
+    }
+}
