+// ── Upstream OpenPCDet-GGML phase-decomposed path (byte-faithful port) ───────
+//
+// Ported from OpenPCDet-GGML cpp_ggml/ggml/src/ggml-cuda/conv2d-transpose.cu
+// (scatter_phase / gather_phase / gemm_path). A transposed conv with
+// kernel_w == kernel_h == stride s decomposes into s*s independent 1x1
+// (pointwise) convolutions, one per output phase (r, c); each phase is a
+// plain cuBLAS GEMM. Identical arithmetic, reduction order and memory
+// ordering as upstream; the handle's math mode decides TF32 usage exactly
+// like upstream (GGML_PREC is not consulted).
+
+// Scatter a phase GEMM result Cbuf[p][oc] (p = ix + in_w*iy) into the output
+// tensor at the interleaved positions for phase (r, c):
+//   out[x = c + s*ix, y = r + s*iy, oc, n] = Cbuf[p][oc]
+__global__ static void conv2d_transpose_scatter_phase(
+        const float * __restrict__ cbuf, float * __restrict__ output,
+        int in_w, int in_h, int out_w, int out_h,
+        int stride, int r, int c, int c_out, int n, int total_n) {
+    const int p = blockIdx.x * blockDim.x + threadIdx.x;   // 0 .. in_w*in_h-1
+    if (p >= in_w * in_h) return;
+    const int ix = p % in_w;
+    const int iy = p / in_w;
+    const int ox = c + stride * ix;
+    const int oy = r + stride * iy;
+    const int base = n * (out_w * out_h * c_out) + (oy * out_w + ox);
+    for (int oc = 0; oc < c_out; ++oc) {
+        output[base + (size_t) oc * (out_w * out_h)] = cbuf[(size_t) p * c_out + oc];
+    }
+}
+
+// Gather the strided weights of phase (kx=c, ky=r) into a contiguous [oc][ic]
+// buffer. The kernel is laid out spatial-fastest:
+//   W[ic][oc][ky][kx] at linear = (kx + s*ky) + s*s*oc + s*s*c_out*ic
+// so within a phase the (oc, ic) values are strided (oc step s*s, ic step s*s*c_out).
+// Write wbuf[oc + c_out*ic] = W[(kx + s*ky) + s*s*oc + s*s*c_out*ic], i.e. a
+// [c_out][c_in] column-major block (leading dim c_out) usable as a cuBLAS A operand.
+__global__ static void conv2d_transpose_gather_phase(
+        const float * __restrict__ W, float * __restrict__ wbuf,
+        int s, int kx, int ky, int c_out, int c_in) {
+    const int idx = blockIdx.x * blockDim.x + threadIdx.x;   // 0 .. c_out*c_in-1
+    const int total = c_out * c_in;
+    if (idx >= total) return;
+    const int oc = idx % c_out;
+    const int ic = idx / c_out;
+    wbuf[idx] = W[(size_t) (kx + s * ky) + (size_t) s * s * oc + (size_t) s * s * c_out * ic];
+}
+
+// Phase-decomposed transposed convolution for kernel_w == kernel_h == stride.
+// Only the F32-kernel path takes this route.
+static bool conv2d_transpose_gemm_path(ggml_backend_cuda_context & ctx,
+                                       ggml_tensor * dst) {
+    if (getenv("GGML_CUDA_DISABLE_DECONV_GEMM")) return false;  // DEBUG isolation
+    const ggml_tensor * kernel = dst->src[0];
+    const ggml_tensor * input  = dst->src[1];
+
+    if (kernel->type != GGML_TYPE_F32) return false;
+    if (input->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+
+    const int in_w  = (int) input->ne[0];
+    const int in_h  = (int) input->ne[1];
+    const int c_in  = (int) input->ne[2];
+    const int n     = (int) input->ne[3];
+    const int c_out = (int) kernel->ne[2];
+    const int k_w   = (int) kernel->ne[0];
+    const int k_h   = (int) kernel->ne[1];
+    const int stride = (int) dst->op_params[0];
+    if (k_w != stride || k_h != stride) return false;
+    if (c_in != (int) kernel->ne[3]) return false;
+    GGML_ASSERT(c_in > 0 && c_out > 0 && in_w > 0 && in_h > 0);
+
+    cudaStream_t   stream = ctx.stream();
+    cublasHandle_t handle = ctx.cublas_handle();
+    CUBLAS_CHECK(cublasSetStream(handle, stream));
+
+    const int out_w = stride * in_w;
+    const int out_h = stride * in_h;
+    const int64_t n_pix = (int64_t) in_w * in_h;
+
+    const float * W  = (const float *) kernel->data;
+    const float * X  = (const float *) input->data;
+    float       * Out = (float *) dst->data;
+
+    const float alpha = 1.0f;
+    const float beta  = 0.0f;
+
+    // Temporary GEMM output buffer [c_out][n_pix] (column-major, ldc=c_out).
+    ggml_cuda_pool_alloc<float> cbuf(ctx.pool(), n_pix * c_out);
+    // Contiguous per-phase weight buffer [c_out][c_in].
+    ggml_cuda_pool_alloc<float> wbuf(ctx.pool(), (size_t) c_out * c_in);
+
+    const int threads = 256;
+    const int blocks  = (int) ((n_pix + threads - 1) / threads);
+    const int wblocks = (int) ((c_out * c_in + threads - 1) / threads);
+
+    for (int bn = 0; bn < n; ++bn) {
+        const float * X_n = X + (size_t) bn * n_pix * c_in;
+        for (int r = 0; r < stride; ++r) {
+            for (int c = 0; c < stride; ++c) {
+                // Gather the strided weights of phase (kx=c, ky=r) into wbuf.
+                conv2d_transpose_gather_phase<<<wblocks, threads, 0, stream>>>(
+                        W, wbuf.get(), stride, c, r, c_out, c_in);
+                // A = wbuf [c_out][c_in] column-major (lda=c_out), opA=N.
+                // B = X_n [pix][ic] (pix fastest), opB=T with ldb=n_pix.
+                // C = cbuf [c_out][n_pix] column-major, ldc=c_out.
+                CUBLAS_CHECK(cublasSgemm(handle, CUBLAS_OP_N, CUBLAS_OP_T,
+                                         c_out, (int) n_pix, c_in,
+                                         &alpha,
+                                         wbuf.get(), c_out,
+                                         X_n,     (int) n_pix,
+                                         &beta,
+                                         cbuf.get(), c_out));
+                conv2d_transpose_scatter_phase<<<blocks, threads, 0, stream>>>(
+                        cbuf.get(), Out, in_w, in_h, out_w, out_h,
+                        stride, r, c, c_out, bn, n);
+            }
+        }
+    }
+    return true;
+}
