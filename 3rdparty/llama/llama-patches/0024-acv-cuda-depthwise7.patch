+static constexpr int DW7_TILE_X = 7;
+
+static __global__ void conv2d_dw_7x7_cwhn_kernel(
+        const float4 * __restrict__ input, const float4 * __restrict__ kernel,
+        float4 * __restrict__ output, const float * __restrict__ bias,
+        int in_w, int in_h, int out_w, int out_h,
+        int padding_x, int padding_y, int channels4, int tiles_x, int total) {
+    const int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= total) return;
+    const int c4 = idx % channels4;
+    int rest = idx / channels4;
+    const int tile = rest % tiles_x;
+    rest /= tiles_x;
+    const int out_y = rest % out_h;
+    const int n = rest / out_h;
+    const int out_x = tile * DW7_TILE_X;
+    float4 acc[DW7_TILE_X];
+#pragma unroll
+    for (int j = 0; j < DW7_TILE_X; ++j) acc[j] = make_float4(0, 0, 0, 0);
+    const float4 * image = input + (size_t) n * in_h * in_w * channels4 + c4;
+#pragma unroll
+    for (int ky = 0; ky < 7; ++ky) {
+        const int in_y = out_y + ky - padding_y;
+        if (in_y < 0 || in_y >= in_h) continue;
+        float4 w[7];
+#pragma unroll
+        for (int kx = 0; kx < 7; ++kx) w[kx] = kernel[(ky * 7 + kx) * channels4 + c4];
+        const float4 * row = image + (size_t) in_y * in_w * channels4;
+#pragma unroll
+        for (int i = 0; i < DW7_TILE_X + 6; ++i) {
+            const int in_x = out_x + i - padding_x;
+            if (in_x < 0 || in_x >= in_w) continue;
+            const float4 v = row[(size_t) in_x * channels4];
+#pragma unroll
+            for (int j = 0; j < DW7_TILE_X; ++j) {
+                const int kx = i - j;
+                if (kx >= 0 && kx < 7) {
+                    acc[j].x += v.x * w[kx].x;
+                    acc[j].y += v.y * w[kx].y;
+                    acc[j].z += v.z * w[kx].z;
+                    acc[j].w += v.w * w[kx].w;
+                }
+            }
+        }
+    }
+    const int c = c4 * 4;
+    const float4 b = bias ? make_float4(bias[c], bias[c + 1], bias[c + 2], bias[c + 3])
+                         : make_float4(0, 0, 0, 0);
+    float4 * dst = output + ((size_t) n * out_h + out_y) * out_w * channels4 + c4;
+#pragma unroll
+    for (int j = 0; j < DW7_TILE_X; ++j) {
+        if (out_x + j < out_w) {
+            if (bias) {
+                acc[j].x = __fadd_rn(acc[j].x, b.x);
+                acc[j].y = __fadd_rn(acc[j].y, b.y);
+                acc[j].z = __fadd_rn(acc[j].z, b.z);
+                acc[j].w = __fadd_rn(acc[j].w, b.w);
+            }
+            dst[(size_t) (out_x + j) * channels4] = acc[j];
+        }
+    }
+}
+
+static bool conv2d_dw_aligned16(const void * ptr) {
+    return (reinterpret_cast<uintptr_t>(ptr) & 15) == 0;
+}
+
+static void conv2d_dw_7x7_cwhn_launch(
+        const float * x, const float * w, float * y, const float * b,
+        int in_w, int in_h, int out_w, int out_h, int pad_x, int pad_y,
+        int channels, int batches, cudaStream_t stream) {
+    const int channels4 = channels / 4;
+    const int tiles_x = (out_w + DW7_TILE_X - 1) / DW7_TILE_X;
+    const int total = batches * out_h * tiles_x * channels4;
+    const int blocks = (total + CUDA_CONV2D_DW_BLOCK_SIZE - 1) / CUDA_CONV2D_DW_BLOCK_SIZE;
+    conv2d_dw_7x7_cwhn_kernel<<<blocks, CUDA_CONV2D_DW_BLOCK_SIZE, 0, stream>>>(
+        reinterpret_cast<const float4 *>(x), reinterpret_cast<const float4 *>(w),
+        reinterpret_cast<float4 *>(y), b, in_w, in_h, out_w, out_h,
+        pad_x, pad_y, channels4, tiles_x, total);
+}
