+// OpenPCDet-GGML AICore port: sparse convolution lowering primitives.
+
+void ggml_compute_forward_sparse_gather(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 || src0->type == GGML_TYPE_F16);
+    GGML_ASSERT(src1->type == GGML_TYPE_I32);
+    GGML_ASSERT(dst->type == src0->type);
+    GGML_ASSERT(ggml_is_contiguous(src0) && ggml_is_contiguous(src1) && ggml_is_contiguous(dst));
+
+    const int64_t n_channels = src0->ne[0];
+    const int64_t n_input    = src0->ne[1];
+    const int64_t n_kernel   = src1->ne[0];
+    const int64_t n_output   = src1->ne[1];
+    const size_t row_bytes   = (size_t) n_channels * ggml_type_size(src0->type);
+    const int64_t rows       = n_kernel * n_output;
+
+    const int64_t rows_per_thread = (rows + params->nth - 1) / params->nth;
+    const int64_t begin = rows_per_thread * params->ith;
+    const int64_t end   = MIN(begin + rows_per_thread, rows);
+
+    for (int64_t row = begin; row < end; ++row) {
+        const int32_t input_row = ((const int32_t *) src1->data)[row];
+        char * out = (char *) dst->data + (size_t) row * row_bytes;
+        if (input_row < 0) {
+            memset(out, 0, row_bytes);
+        } else {
+            GGML_ASSERT(input_row < n_input);
+            memcpy(out, (const char *) src0->data + (size_t) input_row * row_bytes, row_bytes);
+        }
+    }
+}
+
+void ggml_compute_forward_sparse_scatter_add(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    // Two execution forms share this op:
+    //  - 2-src (op_params[0] == 0): src0 is the pre-concatenated compact block
+    //    [n_channels, n_compact], src1 the row-major scatter table.
+    //  - n-src (op_params[0] == n_a): src[0..n_a-1] are per-kernel-group GEMM
+    //    outputs [n_channels, count_i], src[n_a] the scatter table, and
+    //    op_params[1..n_a] / [1+n_a..1+2n_a] the compact [base, end) range of
+    //    each block. Entries in [base, end) address the block at column
+    //    (entry - base), so no concat is needed and whole empty groups can be
+    //    skipped without breaking the range arithmetic.
+    const int n_a = dst->op_params[0];
+    const bool multi = n_a > 0;
+    const int n_src = multi ? n_a : 1;
+    const ggml_tensor * scatter = multi ? dst->src[n_a] : dst->src[1];
+    const ggml_tensor * bias = multi ? dst->src[n_a + 1] : nullptr;
+
+    GGML_ASSERT(scatter->type == GGML_TYPE_I32);
+    GGML_ASSERT(dst->type == dst->src[0]->type);
+    GGML_ASSERT(ggml_is_contiguous(scatter) && ggml_is_contiguous(dst));
+
+    const int64_t n_channels = dst->src[0]->ne[0];
+    const int64_t n_kernel   = scatter->ne[1];
+    const int64_t n_output   = scatter->ne[0];
+
+    const int64_t columns_per_thread = (n_output + params->nth - 1) / params->nth;
+    const int64_t col_begin = columns_per_thread * params->ith;
+    const int64_t col_end   = MIN(col_begin + columns_per_thread, n_output);
+
+    const int32_t * table = (const int32_t *) scatter->data;
+
+    if (dst->type == GGML_TYPE_F32) {
+        std::vector<const float *> blocks((size_t) n_src);
+        for (int s = 0; s < n_src; ++s) blocks[(size_t) s] = (const float *) dst->src[s]->data;
+        const float * bias_data = bias ? (const float *) bias->data : nullptr;
+        const int64_t count0 = dst->src[0]->ne[1];
+        for (int64_t j = col_begin; j < col_end; ++j) {
+            float * dst_col = (float *) dst->data + j * n_channels;
+            const int32_t * scatter_row = table + j * n_kernel;
+            for (int64_t c = 0; c < n_channels; ++c)
+                dst_col[c] = bias_data ? bias_data[c] : 0.0f;
+            for (int64_t k = 0; k < n_kernel; ++k) {
+                const int32_t entry = scatter_row[k];
+                if (entry < 0) continue;
+                if (!multi) {
+                    if (entry >= count0) continue;
+                    const float * src_col = blocks[0] + (size_t) entry * n_channels;
+                    for (int64_t c = 0; c < n_channels; ++c) dst_col[c] += src_col[c];
+                    continue;
+                }
+                int lo = 0, hi = n_src;
+                while (lo < hi) {
+                    const int mid = (lo + hi) / 2;
+                    if (entry < dst->op_params[1 + mid]) hi = mid;
+                    else if (entry >= dst->op_params[1 + n_src + mid]) lo = mid + 1;
+                    else { lo = mid; break; }
+                }
+                if (lo < n_src && entry >= dst->op_params[1 + lo] &&
+                    entry < dst->op_params[1 + n_src + lo]) {
+                    const float * src_col =
+                        blocks[(size_t) lo] + (size_t) (entry - dst->op_params[1 + lo]) * n_channels;
+                    for (int64_t c = 0; c < n_channels; ++c) dst_col[c] += src_col[c];
+                }
+            }
+        }
+    } else {
+        GGML_ASSERT(dst->type == GGML_TYPE_F16);
+        std::vector<const ggml_fp16_t *> blocks((size_t) n_src);
+        for (int s = 0; s < n_src; ++s) blocks[(size_t) s] = (const ggml_fp16_t *) dst->src[s]->data;
+        const ggml_fp16_t * bias_data = bias ? (const ggml_fp16_t *) bias->data : nullptr;
+        const int64_t count0 = dst->src[0]->ne[1];
+        for (int64_t j = col_begin; j < col_end; ++j) {
+            ggml_fp16_t * dst_col = (ggml_fp16_t *) dst->data + j * n_channels;
+            const int32_t * scatter_row = table + j * n_kernel;
+            for (int64_t c = 0; c < n_channels; ++c)
+                dst_col[c] = bias_data ? bias_data[c] : (ggml_fp16_t) 0;
+            for (int64_t k = 0; k < n_kernel; ++k) {
+                const int32_t entry = scatter_row[k];
+                if (entry < 0) continue;
+                if (!multi) {
+                    if (entry >= count0) continue;
+                    const ggml_fp16_t * src_col = blocks[0] + (size_t) entry * n_channels;
+                    for (int64_t c = 0; c < n_channels; ++c)
+                        dst_col[c] = GGML_FP16_TO_FP32(dst_col[c]) + GGML_FP16_TO_FP32(src_col[c]);
+                    continue;
+                }
+                int lo = 0, hi = n_src;
+                while (lo < hi) {
+                    const int mid = (lo + hi) / 2;
+                    if (entry < dst->op_params[1 + mid]) hi = mid;
+                    else if (entry >= dst->op_params[1 + n_src + mid]) lo = mid + 1;
+                    else { lo = mid; break; }
+                }
+                if (lo < n_src && entry >= dst->op_params[1 + lo] &&
+                    entry < dst->op_params[1 + n_src + lo]) {
+                    const ggml_fp16_t * src_col =
+                        blocks[(size_t) lo] + (size_t) (entry - dst->op_params[1 + lo]) * n_channels;
+                    for (int64_t c = 0; c < n_channels; ++c)
+                        dst_col[c] = GGML_FP16_TO_FP32(dst_col[c]) + GGML_FP16_TO_FP32(src_col[c]);
+                }
+            }
+        }
+    }
+}
