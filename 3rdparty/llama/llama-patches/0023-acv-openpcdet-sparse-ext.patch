+// ggml_sparse_gather (OpenPCDet-GGML AICore port)
+
+struct ggml_tensor * ggml_sparse_gather(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32 || a->type == GGML_TYPE_F16);
+    GGML_ASSERT(a->ne[2] == 1 && a->ne[3] == 1);
+    GGML_ASSERT(b->type == GGML_TYPE_I32);
+    GGML_ASSERT(b->ne[2] == 1 && b->ne[3] == 1);
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_is_contiguous(b));
+
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, a->type, a->ne[0], b->ne[0], b->ne[1]);
+    result->op     = GGML_OP_SPARSE_GATHER;
+    result->src[0] = a;
+    result->src[1] = b;
+    return result;
+}
+
+// ggml_sparse_scatter_add (OpenPCDet-GGML AICore port)
+
+struct ggml_tensor * ggml_sparse_scatter_add(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32 || a->type == GGML_TYPE_F16);
+    GGML_ASSERT(a->ne[2] == 1 && a->ne[3] == 1);
+    GGML_ASSERT(b->type == GGML_TYPE_I32);
+    GGML_ASSERT(b->ne[2] == 1 && b->ne[3] == 1);
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_is_contiguous(b));
+
+    // b is row-major [n_output, kernel_volume] (compact column per (j, k),
+    // -1 skips), so the result is [n_channels, n_output].
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, a->type, a->ne[0], b->ne[0]);
+    result->op     = GGML_OP_SPARSE_SCATTER_ADD;
+    result->src[0] = a;
+    result->src[1] = b;
+    return result;
+}
+
+// ggml_sparse_scatter_add_n (OpenPCDet-GGML AICore port)
+
+struct ggml_tensor * ggml_sparse_scatter_add_n(
+        struct ggml_context * ctx,
+        struct ggml_tensor * const * a,
+        int n_a,
+        struct ggml_tensor * b,
+        struct ggml_tensor * bias) {
+    GGML_ASSERT(n_a >= 1 && n_a + 2 <= GGML_MAX_SRC);
+    GGML_ASSERT(a[0]->type == GGML_TYPE_F32 || a[0]->type == GGML_TYPE_F16);
+    for (int i = 0; i < n_a; ++i) {
+        GGML_ASSERT(a[i]->type == a[0]->type);
+        GGML_ASSERT(a[i]->ne[0] == a[0]->ne[0]);
+        GGML_ASSERT(a[i]->ne[2] == 1 && a[i]->ne[3] == 1);
+        GGML_ASSERT(ggml_is_contiguous(a[i]));
+    }
+    GGML_ASSERT(b->type == GGML_TYPE_I32);
+    GGML_ASSERT(b->ne[2] == 1 && b->ne[3] == 1);
+    GGML_ASSERT(ggml_is_contiguous(b));
+    if (bias) {
+        GGML_ASSERT(bias->type == a[0]->type);
+        GGML_ASSERT(bias->ne[0] == a[0]->ne[0]);
+        GGML_ASSERT(ggml_nelements(bias) == a[0]->ne[0]);
+    }
+
+    // op_params[0] = n_a; op_params[1..n_a] = each block's compact-column
+    // base (start of the kernel group's columns). Block i therefore covers
+    // compact columns [bases[i], bases[i] + a[i]->ne[1]).
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, a[0]->type, a[0]->ne[0], b->ne[0]);
+    result->op     = GGML_OP_SPARSE_SCATTER_ADD;
+    for (int i = 0; i < n_a; ++i) result->src[i] = a[i];
+    result->src[n_a] = b;
+    if (bias) result->src[n_a + 1] = bias;
+    result->op_params[0] = n_a;
+    return result;
+}
