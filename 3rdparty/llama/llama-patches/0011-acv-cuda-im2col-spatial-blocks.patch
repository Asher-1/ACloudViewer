+
+// Dense image stems and pointwise convolutions with few input channels have
+// too little work per spatial block. Flatten the identical gather so adjacent
+// output elements share a block, without changing any floating-point math.
+// The existing channel-parallel kernel remains preferable for large channels.
+template <typename T>
+static __global__ void im2col_flat_kernel(
+        const float * x, T * dst, int size, int IW, int IH, int OW, int OH,
+        int KW, int KH, int channels, int64_t channel_stride, int64_t batch_stride,
+        int s0, int s1, int p0, int p1, int d0, int d1) {
+    const int channel_window = channels * KH * KW;
+    for (int64_t linear = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+         linear < size; linear += int64_t(gridDim.x) * blockDim.x) {
+        int rest = int(linear);
+        const int channel_kernel = rest % channel_window;
+        rest /= channel_window;
+        const int ow = rest % OW;
+        rest /= OW;
+        const int oh = rest % OH;
+        const int batch = rest / OH;
+        const int channel = channel_kernel / (KH * KW);
+        const int kh = (channel_kernel / KW) % KH;
+        const int kw = channel_kernel % KW;
+        const int64_t ih = int64_t(oh) * s1 + int64_t(kh) * d1 - p1;
+        const int64_t iw = int64_t(ow) * s0 + int64_t(kw) * d0 - p0;
+        dst[linear] = ih < 0 || ih >= IH || iw < 0 || iw >= IW
+                ? 0.0f
+                : x[channel * channel_stride + batch * batch_stride + int64_t(ih) * IW + iw];
+    }
+}
+
