+#include "bn-fold-relu.cuh"
+
+// ---------------------------------------------------------------------------
+// Fused BN-fold + ReLU: dst = relu(x * scale + bias).
+//
+// x is [W, H, C, N] (ggml f32); scale/bias are per-channel [1, 1, C, 1].
+// Replaces the mul + add + relu triple of elementwise kernels that OpenPCDet
+// runs after every conv (the bn_fold scale/bias tensors), collapsing three
+// passes over the activations into one. On nuScenes CenterPoint voxel these
+// triples measured ~13ms/frame (mostly tiny 90-thread blocks under-utilizing
+// the SMs); a single pass over the same data runs at memory bandwidth.
+//
+// The kernel uses a float4 vector path when the innermost dim is contiguous
+// and a multiple of 4 (all OpenPCDet conv outputs are [W,H,C,N] contiguous
+// with W % 4 == 0), otherwise a scalar fallback honoring arbitrary strides.
+// ---------------------------------------------------------------------------
+
+static __global__ void bn_fold_relu_f32_vec4(
+        const float4 * __restrict__ x,
+        const float * __restrict__ scale,
+        const float * __restrict__ bias,
+        float4 * __restrict__ dst,
+        int n_vec,          // ne00 / 4
+        int ne01,           // H
+        int64_t sx1, int64_t sx2, int64_t sx3,   // x strides in float4 units
+        int64_t sd1, int64_t sd2, int64_t sd3) { // dst strides in float4 units
+    // Grid: (ceil(n_vec*ne01 / block), ne02, ne03). Each thread handles one
+    // float4; only one 32-bit div/mod pair per thread (n_vec is a runtime
+    // value, so a 64-bit index chain would cost 5 slow software divisions).
+    const int i0i1 = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i0i1 >= n_vec * ne01) {
+        return;
+    }
+    const int i0 = i0i1 % n_vec;
+    const int i1 = i0i1 / n_vec;
+    const int i2 = blockIdx.y;
+    const int i3 = blockIdx.z;
+
+    const float s = scale[i2];
+    const float b = bias[i2];
+
+    const float4 v = x[i0 + i1 * sx1 + i2 * sx2 + i3 * sx3];
+    float4 r;
+    r.x = fmaxf(v.x * s + b, 0.0f);
+    r.y = fmaxf(v.y * s + b, 0.0f);
+    r.z = fmaxf(v.z * s + b, 0.0f);
+    r.w = fmaxf(v.w * s + b, 0.0f);
+    dst[i0 + i1 * sd1 + i2 * sd2 + i3 * sd3] = r;
+}
+
+static __global__ void bn_fold_relu_f32(
+        const float * __restrict__ x,
+        const float * __restrict__ scale,
+        const float * __restrict__ bias,
+        float * __restrict__ dst,
+        int ne00, int ne01,
+        int64_t sx0, int64_t sx1, int64_t sx2, int64_t sx3,
+        int64_t sd0, int64_t sd1, int64_t sd2, int64_t sd3) {
+    // Grid: (ceil(ne00*ne01 / block), ne02, ne03); one 32-bit div/mod pair per
+    // thread (same scheme as the vec4 path).
+    const int i0i1 = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i0i1 >= ne00 * ne01) {
+        return;
+    }
+    const int i0 = i0i1 % ne00;
+    const int i1 = i0i1 / ne00;
+    const int i2 = blockIdx.y;
+    const int i3 = blockIdx.z;
+
+    const float s = scale[i2];
+    const float b = bias[i2];
+
+    const float v = x[i0 * sx0 + i1 * sx1 + i2 * sx2 + i3 * sx3];
+    dst[i0 * sd0 + i1 * sd1 + i2 * sd2 + i3 * sd3] = fmaxf(v * s + b, 0.0f);
+}
+
+void ggml_cuda_op_bn_fold_relu(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x     = dst->src[0];
+    const ggml_tensor * scale = dst->src[1];
+    const ggml_tensor * bias  = dst->src[2];
+
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(scale->type == GGML_TYPE_F32);
+    GGML_ASSERT(bias->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+
+    GGML_TENSOR_LOCALS(size_t, nbx, x,     nb);
+    GGML_TENSOR_LOCALS(size_t, nbd, dst,   nb);
+
+    const int64_t ne00 = x->ne[0];
+    const int64_t ne01 = x->ne[1];
+    const int64_t ne02 = x->ne[2];
+    const int64_t ne03 = x->ne[3];
+
+    const int block_size = 256;
+    ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(
+            dim3(1, 1, 1), dim3(block_size, 1, 1), 0, ctx.stream());
+
+    const bool vec_ok = nbx0 == sizeof(float) && nbd0 == sizeof(float) &&
+                        nbx1 == nbx0 * ne00 && nbd1 == nbd0 * ne00 &&
+                        (ne00 % 4) == 0;
+    if (vec_ok) {
+        const int n_vec = (int) (ne00 / 4);
+        const int n01   = (int) ne01;
+        GGML_ASSERT((int64_t) n_vec * n01 < INT32_MAX / 4);
+        const dim3 grid_dims((n_vec * n01 + block_size - 1) / block_size,
+                             (unsigned) ne02, (unsigned) ne03);
+        launch_params.block_nums = grid_dims;
+        ggml_cuda_kernel_launch(bn_fold_relu_f32_vec4, launch_params,
+                (const float4 *) x->data, (const float *) scale->data,
+                (const float *) bias->data, (float4 *) dst->data,
+                n_vec, n01,
+                nbx1 / (sizeof(float) * 4), nbx2 / (sizeof(float) * 4),
+                nbx3 / (sizeof(float) * 4),
+                nbd1 / (sizeof(float) * 4), nbd2 / (sizeof(float) * 4),
+                nbd3 / (sizeof(float) * 4));
+        return;
+    }
+
+    const int n00 = (int) ne00;
+    const int n01 = (int) ne01;
+    GGML_ASSERT((int64_t) n00 * n01 < INT32_MAX / 4);
+    const dim3 grid_dims((n00 * n01 + block_size - 1) / block_size,
+                         (unsigned) ne02, (unsigned) ne03);
+    launch_params.block_nums = grid_dims;
+    ggml_cuda_kernel_launch(bn_fold_relu_f32, launch_params,
+            (const float *) x->data, (const float *) scale->data,
+            (const float *) bias->data, (float *) dst->data,
+            n00, n01,
+            nbx0 / sizeof(float), nbx1 / sizeof(float),
+            nbx2 / sizeof(float), nbx3 / sizeof(float),
+            nbd0 / sizeof(float), nbd1 / sizeof(float),
+            nbd2 / sizeof(float), nbd3 / sizeof(float));
+}
