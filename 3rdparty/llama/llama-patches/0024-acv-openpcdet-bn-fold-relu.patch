+// ggml_bn_fold_relu (OpenPCDet-GGML AICore port)
+
+struct ggml_tensor * ggml_bn_fold_relu(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * scale,
+        struct ggml_tensor  * bias) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(scale->type == GGML_TYPE_F32);
+    GGML_ASSERT(bias->type == GGML_TYPE_F32);
+
+    // scale/bias are [1, 1, C, 1] reshapes; match x's channel count.
+    GGML_ASSERT(scale->ne[0] == 1 && scale->ne[1] == 1 && scale->ne[2] == x->ne[2]);
+    GGML_ASSERT(bias->ne[0] == 1 && bias->ne[1] == 1 && bias->ne[2] == x->ne[2]);
+    GGML_ASSERT(x->ne[3] == scale->ne[3] && x->ne[3] == bias->ne[3]);
+
+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, GGML_TYPE_F32,
+            x->ne[0], x->ne[1], x->ne[2], x->ne[3]);
+    result->op     = GGML_OP_BN_FOLD_RELU;
+    result->src[0] = x;
+    result->src[1] = scale;
+    result->src[2] = bias;
+    return result;
+}
