     // Depthwise 2D convolution
     // may be faster than ggml_conv_2d_dw, but not available in all backends
     // a:   KW    KH    1    C    convolution kernel
diff --git a/src/ggml.c b/src/ggml.c
--- a/src/ggml.c
+++ b/src/ggml.c
@@ -5100,6 +5100,18 @@
     return result;
 }
 
+struct ggml_tensor * ggml_conv_2d_dw_direct_bias(
+        struct ggml_context * ctx,
+        struct ggml_tensor * a, struct ggml_tensor * b, struct ggml_tensor * bias,
+        int stride0, int stride1, int pad0, int pad1, int dilation0, int dilation1) {
+    GGML_ASSERT(bias && bias->type == GGML_TYPE_F32 && ggml_is_contiguous(bias));
+    GGML_ASSERT(bias->ne[0] == b->ne[2] && bias->ne[1] == 1 && bias->ne[2] == 1 && bias->ne[3] == 1);
+    struct ggml_tensor * result = ggml_conv_2d_dw_direct(
+        ctx, a, b, stride0, stride1, pad0, pad1, dilation0, dilation1);
+    result->src[2] = bias;
+    return result;
+}
+
 // ggml_conv_2d_direct
 
 struct ggml_tensor * ggml_conv_2d_direct(
