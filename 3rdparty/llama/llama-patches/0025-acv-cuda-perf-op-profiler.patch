--- a/src/ggml-cuda/ggml-cuda.cu
+++ b/src/ggml-cuda/ggml-cuda.cu
@@ -748,6 +748,13 @@ static std::mutex ggml_cuda_lock;
 static std::condition_variable ggml_cuda_lock_cv;
 static std::atomic<int> ggml_cuda_lock_counter;
 
+// Temporary per-op CUDA profiler (env GGML_CUDA_PERF_OP=1).
+static bool ggml_cuda_perf_ops_enabled = getenv("GGML_CUDA_PERF_OP") != nullptr;
+static cudaEvent_t ggml_cuda_perf_ev_start = nullptr;
+static cudaEvent_t ggml_cuda_perf_ev_end = nullptr;
+struct ggml_cuda_perf_acc { double ms = 0.0; int count = 0; };
+static std::map<enum ggml_op, ggml_cuda_perf_acc> ggml_cuda_perf_accum;
+
 ggml_backend_cuda_context::~ggml_backend_cuda_context() {
     std::unique_lock<std::mutex> lock(ggml_cuda_lock);
     ggml_cuda_lock_cv.wait(lock, []{ return ggml_cuda_lock_counter.load(std::memory_order_relaxed) == 0; });
@@ -5533,12 +5540,26 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
                 GGML_UNUSED(integrated);
 #endif  // NDEBUG
 
+                if (ggml_cuda_perf_ops_enabled) {
+                    cudaEventRecord(ggml_cuda_perf_ev_start, cuda_ctx->stream());
+                }
+
                 bool ok = ggml_cuda_compute_forward(*cuda_ctx, node);
                 if (!ok) {
                     GGML_LOG_ERROR("%s: op not supported %s (%s)\n", __func__, node->name, ggml_op_name(node->op));
                 }
                 GGML_ASSERT(ok);
 
+                if (ggml_cuda_perf_ops_enabled) {
+                    cudaEventRecord(ggml_cuda_perf_ev_end, cuda_ctx->stream());
+                    cudaEventSynchronize(ggml_cuda_perf_ev_end);
+                    float ms = 0.0f;
+                    cudaEventElapsedTime(&ms, ggml_cuda_perf_ev_start, ggml_cuda_perf_ev_end);
+                    auto & acc = ggml_cuda_perf_accum[node->op];
+                    acc.count++;
+                    acc.ms += ms;
+                }
+
                 if (!is_concurrent_event_active) {
                     try_launch_concurrent_event(node);
                }
@@ -5603,6 +5624,14 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
 
     ggml_cuda_set_device(cuda_ctx->device);
 
+    if (ggml_cuda_perf_ops_enabled && ggml_cuda_perf_ev_start == nullptr) {
+        cudaEventCreate(&ggml_cuda_perf_ev_start);
+        cudaEventCreate(&ggml_cuda_perf_ev_end);
+    }
+    if (ggml_cuda_perf_ops_enabled) {
+        cudaEventRecord(ggml_cuda_perf_ev_start, cuda_ctx->stream());
+    }
+
     bool use_cuda_graph             = false;
     bool cuda_graph_update_required = false;
     ggml_cuda_graph_key graph_key = {};
@@ -5657,6 +5686,16 @@ static enum ggml_status ggml_backend_cuda_graph_compute(ggml_backend_t backend,
 
     ggml_cuda_graph_evaluate_and_capture(cuda_ctx, cgraph, use_cuda_graph, cuda_graph_update_required, graph_key);
 
+    if (ggml_cuda_perf_ops_enabled) {
+        cudaEventRecord(ggml_cuda_perf_ev_start, cuda_ctx->stream());
+        cudaEventSynchronize(ggml_cuda_perf_ev_start);
+        for (auto & [op, acc] : ggml_cuda_perf_accum) {
+            fprintf(stderr, "[cuda-perf-op] %-20s count=%-5d total=%8.2f ms\n",
+                    ggml_op_name(op), acc.count, acc.ms);
+        }
+        ggml_cuda_perf_accum.clear();
+    }
+
     return GGML_STATUS_SUCCESS;
 }
 
