+        igemm_nhwc_to_nchw<float>(plan->nhwc_output, dst->data, B, K, P, Q, stream);
+    } else {
+        igemm_nhwc_to_nchw<half>(plan->nhwc_output, dst->data, B, K, P, Q, stream);
+    }
+    return cudaPeekAtLastError() == cudaSuccess;
