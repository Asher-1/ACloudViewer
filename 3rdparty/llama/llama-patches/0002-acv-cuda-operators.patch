+            const bool m_ok = m_abs < M;
+            const int p = m_abs / Q;
+            const int q = m_abs % Q;
+            if (C8) {
+                int64_t src = -1;
+                if (m_ok && k < K_gemm) {
+                    const int rs = k / C;
+                    const int ih = p * sh + (rs / S) * dh - ph;
+                    const int iw = q * sw + (rs % S) * dw - pw;
+                    if (ih >= 0 && ih < H && iw >= 0 && iw < W) {
+                        src = ((int64_t) b * H + ih) * W * C + (int64_t) iw * C + k % C;
+                    }
+                }
+                if (src >= 0) {
+                    * (uint4 *) dst = * (const uint4 *) (in + src);
+                } else {
+                    * (uint4 *) dst = make_uint4(0, 0, 0, 0);
+                }
+            } else {
