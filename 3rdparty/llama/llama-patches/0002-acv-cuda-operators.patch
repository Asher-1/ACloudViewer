+[[noreturn]] void ggml_cuda_op_rmbg_conv2d(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_UNUSED(ctx);
+    GGML_UNUSED(dst);
+    GGML_ABORT("RMBG conv2d must not be dispatched on CUDA; graph falls back to im2col");
+}
