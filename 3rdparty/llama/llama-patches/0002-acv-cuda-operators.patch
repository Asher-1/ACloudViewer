+static const void * ggml_cuda_f16_linear_weight_transpose(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * weights,
+        int64_t rows, int64_t cols) {
+    auto & cache = ctx.f16_transpose_cache[ctx.device];
+    const auto found = cache.find(weights);
+    if (found != cache.end()) {
+        if (found->second.rows != rows || found->second.cols != cols) {
+            return nullptr;
+        }
+        return found->second.data;
+    }
+
+    ggml_cuda_f16_transpose_cache_entry entry{};
+    entry.rows = rows;
+    entry.cols = cols;
+    const size_t bytes = static_cast<size_t>(rows) * static_cast<size_t>(cols) * sizeof(uint16_t);
+    CUDA_CHECK(cudaMalloc(&entry.data, bytes));
+    constexpr int threads = 256;
+    const int64_t count = rows * cols;
+    const int blocks = static_cast<int>((count + threads - 1) / threads);
+    ggml_cuda_transpose_f16_linear_weights<<<blocks, threads, 0, ctx.stream()>>>(
+        static_cast<const uint16_t *>(weights->data), static_cast<uint16_t *>(entry.data), rows, cols);
+    CUDA_CHECK(cudaGetLastError());
+    const auto [it, inserted] = cache.emplace(weights, entry);
+    GGML_ASSERT(inserted);
+    return it->second.data;
