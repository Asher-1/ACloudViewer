+                for (int i = 0; i < 8; ++i) {
+                    const int kk = k + i;
+                    half v = (half) 0;
+                    if (m_ok && kk < K_gemm) {
+                        const int rs = kk / C;
+                        const int ih = p * sh + (rs / S) * dh - ph;
+                        const int iw = q * sw + (rs % S) * dw - pw;
