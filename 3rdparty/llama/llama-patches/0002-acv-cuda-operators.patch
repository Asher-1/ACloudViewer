+// ------------------------- dense F16 attention -------------------------
+// The official PyTorch reference evaluates every dense attention with the
+// same vendored mem-efficient cutlass kernel (fmha_cutlassF_f16_aligned
+// _64x64_rf_sm80). The ggml flash kernels use a different tile/reduction
+// topology and measurably diverge from the reference beyond its repeat-run
+// noise, so dense SLat attention is routed to the identical kernel. The
+// ggml flash contract keeps Q and the output in F32; both casts are
+// lossless because the reference holds the same values in F16.
+
+namespace {
+
+__global__ void sam3d_cast_f32_to_f16(
+        const float* src, half* dst, int64_t count) {
+    const int64_t index = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index < count) {
+        dst[index] = __float2half(src[index]);
+    }
+}
+
+__global__ void sam3d_cast_f16_to_f32(
+        const half* src, float* dst, int64_t count) {
+    const int64_t index = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index < count) {
+        dst[index] = __half2float(src[index]);
+    }
+}
+
+static bool sam3d_dense_layout_supported(int device, const ggml_tensor* dst) {
+    const ggml_tensor* q = dst->src[0];
+    const ggml_tensor* k = dst->src[1];
+    const ggml_tensor* v = dst->src[2];
+    if (ggml_cuda_info().devices[device].cc < GGML_CUDA_CC_AMPERE ||
+        ggml_cuda_info().devices[device].cc >= 1000 || q == nullptr || k == nullptr ||
+        v == nullptr || dst->src[3] != nullptr || dst->src[4] != nullptr) {
+        return false;
+    }
+    if (q->type != GGML_TYPE_F32 || k->type != GGML_TYPE_F16 || v->type != GGML_TYPE_F16 ||
+        dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    // The stride arithmetic below only holds for an element-contiguous head
+    // dimension; cross attention passes permuted views, which is fine as long
+    // as cutlass's 8-element token-stride alignment holds.
+    if (q->nb[0] != ggml_element_size(q) || k->nb[0] != ggml_element_size(k) ||
+        v->nb[0] != ggml_element_size(v) || dst->nb[0] != ggml_element_size(dst)) {
+        return false;
+    }
+    // Token strides expressed in half elements must satisfy cutlass's
+    // 8-element alignment. Q/output are F32 ggml tensors whose element
+    // counts match the F16 scratch copies, so divide their byte strides by
+    // the F32 element size.
+    if ((q->nb[1] / sizeof(float)) % 8 != 0 || (k->nb[1] / sizeof(cutlass::half_t)) % 8 != 0 ||
+        (v->nb[1] / sizeof(cutlass::half_t)) % 8 != 0 ||
+        (dst->nb[2] / sizeof(float)) % 8 != 0) {
+        return false;
+    }
+    float max_bias = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&max_bias, (const float*) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float*) dst->op_params + 2, sizeof(float));
+    if (max_bias != 0.0f || logit_softcap != 0.0f) {
+        return false;
+    }
+    // The vendored instantiation covers 64-dimensional heads; GQA stride
+    // sharing is out of scope, so head counts must match. The equal-token
+    // count requirement keeps the routed shape in the verified regime: the
+    // SLat graph only issues symmetric attention, and the n_q != n_kv path
+    // still needs an independent oracle before it may opt in.
+    if (q->ne[0] != 64 || v->ne[0] != 64 || q->ne[2] != k->ne[2] ||
+        q->ne[2] != v->ne[2] || q->ne[3] != k->ne[3] || q->ne[3] != v->ne[3] ||
+        q->ne[3] != 1 || q->ne[1] < 1 || k->ne[1] < 1 || q->ne[2] < 1 ||
+        q->ne[1] != k->ne[1]) {
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+bool ggml_cuda_sam3d_f16_dense_attn_supported(int device, const ggml_tensor* dst) {
+    // Name-gated: the SAM 3D graph builder marks its dense flash-attention
+    // nodes with the "sam3d_" prefix so no other task's FLASH_ATTN_EXT
+    // dispatch is diverted to the vendored cutlass kernel.
+    return dst != nullptr && dst->op == GGML_OP_FLASH_ATTN_EXT &&
+           strncmp(dst->name, "sam3d_", 6) == 0 &&
+           sam3d_dense_layout_supported(device, dst);
+}
+
+size_t ggml_cuda_sam3d_f16_dense_attn_get_alloc_size(int device, const ggml_tensor* dst) {
+    GGML_ASSERT(ggml_cuda_sam3d_f16_dense_attn_supported(device, dst));
+    const ggml_tensor* q = dst->src[0];
+    const int64_t q_elements = ggml_nelements(q);
+    const int64_t out_elements = ggml_nelements(dst);
+    size_t size = sam3d_align_up(ggml_nbytes(dst));
+    size += sam3d_align_up(static_cast<size_t>(q_elements) * sizeof(cutlass::half_t));
+    size += sam3d_align_up(static_cast<size_t>(out_elements) * sizeof(cutlass::half_t));
+    return size;
+}
+
+void ggml_cuda_sam3d_f16_dense_attn(ggml_backend_cuda_context& ctx, ggml_tensor* dst) {
+    GGML_ASSERT(ggml_cuda_sam3d_f16_dense_attn_supported(ctx.device, dst));
+    const ggml_tensor* q = dst->src[0];
+    const ggml_tensor* k = dst->src[1];
+    const ggml_tensor* v = dst->src[2];
+    const int64_t q_elements = ggml_nelements(q);
+    const int64_t out_elements = ggml_nelements(dst);
+    cudaStream_t stream = ctx.stream();
+
+    char* scratch = static_cast<char*>(dst->data) + sam3d_align_up(ggml_nbytes(dst));
+    cutlass::half_t* q16 = reinterpret_cast<cutlass::half_t*>(scratch);
+    scratch += sam3d_align_up(static_cast<size_t>(q_elements) * sizeof(cutlass::half_t));
+    cutlass::half_t* o16 = reinterpret_cast<cutlass::half_t*>(scratch);
+
+    constexpr int kCastThreads = 256;
+    {
+        const int64_t blocks = (q_elements + kCastThreads - 1) / kCastThreads;
+        GGML_ASSERT(blocks <= INT32_MAX);
+        sam3d_cast_f32_to_f16<<<static_cast<unsigned int>(blocks), kCastThreads, 0, stream>>>(
+            static_cast<const float*>(q->data), reinterpret_cast<half*>(q16), q_elements);
+    }
+
+    // Q16 copy: (head_dim, queries, heads) contiguous. K/V keep their ggml
+    // (head_dim, keys, heads) layout. The flash output tensor is
+    // (head_dim, heads, queries), so its token stride is nb[2], not nb[1].
+    Sam3dAttentionKernel::Params params;
+    params.query_ptr = q16;
+    params.key_ptr = static_cast<const cutlass::half_t*>(k->data);
+    params.value_ptr = static_cast<const cutlass::half_t*>(v->data);
+    params.attn_bias_ptr = nullptr;
+    params.output_ptr = o16;
+    params.scale = ggml_get_op_params_f32(dst, 0);
+    params.head_dim = static_cast<int32_t>(q->ne[0]);
+    params.head_dim_value = static_cast<int32_t>(v->ne[0]);
+    params.num_queries = static_cast<int32_t>(q->ne[1]);
+    params.num_keys = static_cast<int32_t>(k->ne[1]);
+    params.num_heads = static_cast<int32_t>(q->ne[2]);
+    params.num_batches = static_cast<int32_t>(q->ne[3]);
+    // Q/output are F32 ggml tensors; their element counts equal the F16
+    // scratch copies, so divide byte strides by the F32 element size. K/V are
+    // F16 and divide by the F16 element size.
+    params.q_strideM = static_cast<int32_t>(q->ne[0]);
+    params.k_strideM = static_cast<int32_t>(k->nb[1] / sizeof(cutlass::half_t));
+    params.v_strideM = static_cast<int32_t>(v->nb[1] / sizeof(cutlass::half_t));
+    // The kernel's epilogue hard-codes the output layout (B, M, H, DV) with
+    // heads adjacent in memory; the flash output tensor (head_dim, heads,
+    // queries) matches exactly with o_strideM = nb[2].
+    params.o_strideM = static_cast<int32_t>(dst->nb[2] / sizeof(float));
+    params.q_strideH = static_cast<int32_t>(q->nb[2] / sizeof(float));
+    params.k_strideH = static_cast<int32_t>(k->nb[2] / sizeof(cutlass::half_t));
+    params.v_strideH = static_cast<int32_t>(v->nb[2] / sizeof(cutlass::half_t));
+    params.q_strideB = q->nb[3] / sizeof(float);
+    params.k_strideB = k->nb[3] / sizeof(cutlass::half_t);
+    params.v_strideB = v->nb[3] / sizeof(cutlass::half_t);
+    params.bias_strideM = 0;
+    params.bias_strideH = 0;
+    params.bias_strideB = 0;
+    GGML_ASSERT(Sam3dAttentionKernel::check_supported(params));
+
+    const size_t shared_bytes = sizeof(Sam3dAttentionKernel::SharedStorage);
+    const size_t maximum_shared_bytes = ggml_cuda_info().devices[ctx.device].smpbo;
+    GGML_ASSERT(shared_bytes <= maximum_shared_bytes);
+    if (shared_bytes > ggml_cuda_info().devices[ctx.device].smpb) {
+        CUDA_CHECK(cudaFuncSetAttribute(
+            sam3d_pytorch_fmha_cutlass_f16_aligned_64x64_rf_sm80,
+            cudaFuncAttributeMaxDynamicSharedMemorySize, static_cast<int>(shared_bytes)));
+    }
+    sam3d_pytorch_fmha_cutlass_f16_aligned_64x64_rf_sm80<<<
+        params.getBlocksGrid(), params.getThreadsGrid(), shared_bytes, ctx.stream()>>>(params);
+    CUDA_CHECK(cudaGetLastError());
+
+    {
+        const int64_t blocks = (out_elements + kCastThreads - 1) / kCastThreads;
+        GGML_ASSERT(blocks <= INT32_MAX);
+        sam3d_cast_f16_to_f32<<<static_cast<unsigned int>(blocks), kCastThreads, 0, stream>>>(
+            reinterpret_cast<const half*>(o16), static_cast<float*>(dst->data), out_elements);
+    }
+}
diff --git a/src/ggml-cuda/sam3d-scatter.cu b/src/ggml-cuda/sam3d-scatter.cu
new file mode 100644
--- /dev/null
+++ b/src/ggml-cuda/sam3d-scatter.cu
@@ -0,0 +1,137 @@
+#include "common.cuh"
+#include "sam3d-scatter.cuh"
+
+#include <cstdint>
+
+namespace {
+
+// Match the public PyTorch CUDA scatter-gather launch policy: four logical
+// elements per 128-thread block.  The work distribution is numerically
+// observable for an F16 atomic reduction, so a conventional 256x1 kernel is
+// not an equivalent replacement.
+constexpr int kScatterThreads = 128;
+constexpr int kScatterValuesPerThread = 4;
+
+__device__ __forceinline__ void sam3d_pytorch_atomic_add(
+        half * values, int64_t index, int64_t numel, half value) {
+    // Exact fastSpecializedAtomicAdd(at::Half) semantics from PyTorch 2.5.1's
+    // ATen/native/cuda/KernelUtils.cuh: every scalar half atomic is widened
+    // into a half2 atomic with a zero on the untouched side (or a scalar
+    // atomic at the odd-alignment/last-element edges). A 32-bit
+    // read-modify-write interleaves differently than a native 16-bit atomic,
+    // which changes the F16 accumulation history and is observable against
+    // the official reference. A packed pair of two real values is NOT an
+    // equivalent implementation and corrupted adjacent channels in earlier
+    // experiments.
+    __half * target = values + index;
+    const bool low_byte = (reinterpret_cast<std::uintptr_t>(target) %
+                           sizeof(__half2)) == 0;
+    if (low_byte && index < (numel - 1)) {
+        __half2 pair;
+        pair.x = value;
+        pair.y = __int2half_rz(0);
+        atomicAdd(reinterpret_cast<__half2 *>(target), pair);
+    } else if (!low_byte && index > 0) {
+        __half2 pair;
+        pair.x = __int2half_rz(0);
+        pair.y = value;
+        atomicAdd(reinterpret_cast<__half2 *>(target - 1), pair);
+    } else {
+        atomicAdd(target, value);
+    }
+}
+
+__global__ void sam3d_scatter_add_f16(
+        const half * features,
+        const int32_t * row_indices,
+        half * sums,
+        int64_t channels,
+        int64_t fine_rows,
+        int64_t coarse_rows) {
+    const int64_t elements = channels * fine_rows;
+    const int64_t destination_elements = channels * coarse_rows;
+    int64_t element = (static_cast<int64_t>(blockIdx.x) * kScatterValuesPerThread) *
+        blockDim.x + threadIdx.x;
+    #pragma unroll
+    for (int value_index = 0; value_index < kScatterValuesPerThread; ++value_index) {
+        if (element < elements) {
+            const int64_t fine_row = element / channels;
+            const int64_t channel = element - fine_row * channels;
+            const int32_t coarse_row = row_indices[fine_row];
+            if (coarse_row >= 0 && coarse_row < coarse_rows) {
+                sam3d_pytorch_atomic_add(
+                    sums, static_cast<int64_t>(coarse_row) * channels + channel,
+                    destination_elements, features[element]);
+            }
+        }
+        element += blockDim.x;
+    }
+}
+
+__global__ void sam3d_scatter_scale_f16(
+        half * sums,
+        const float * counts,
+        int64_t channels,
+        int64_t coarse_rows) {
+    const int64_t element = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const int64_t elements = channels * coarse_rows;
+    if (element >= elements) {
+        return;
+    }
+
+    // The reference divides in F32 opmath (self.div_(num) on half tensors
+    // upcasts to float), so carry the divisor itself instead of a rounded
+    // reciprocal that would add a second rounding step.
+    const int64_t coarse_row = element / channels;
+    sums[element] = __float2half_rn(__half2float(sums[element]) / counts[coarse_row]);
+}
+
+static bool sam3d_scatter_layout_supported(const ggml_tensor * dst) {
+    if (dst == nullptr || dst->op != GGML_OP_SAM3D_SPARSE_SCATTER_MEAN) {
+        return false;
+    }
+    const ggml_tensor * features = dst->src[0];
+    const ggml_tensor * row_indices = dst->src[1];
+    const ggml_tensor * counts = dst->src[2];
+    return features != nullptr && row_indices != nullptr && counts != nullptr &&
+           features->type == GGML_TYPE_F16 && row_indices->type == GGML_TYPE_I32 &&
+           counts->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F16 &&
+           ggml_is_contiguous(features) && ggml_is_contiguous(row_indices) &&
+           ggml_is_contiguous(counts) && ggml_is_contiguous(dst) &&
+           features->ne[1] == row_indices->ne[0] && counts->ne[0] == 1 &&
+           features->ne[0] == dst->ne[0] && counts->ne[1] == dst->ne[1];
+}
+
+} // namespace
+
+bool ggml_cuda_sam3d_sparse_scatter_mean_supported(int device, const ggml_tensor * dst) {
+    return ggml_cuda_info().devices[device].cc >= GGML_CUDA_CC_VOLTA &&
+           sam3d_scatter_layout_supported(dst);
+}
+
+void ggml_cuda_sam3d_sparse_scatter_mean(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(sam3d_scatter_layout_supported(dst));
+
+    const ggml_tensor * features = dst->src[0];
+    const ggml_tensor * row_indices = dst->src[1];
+    const ggml_tensor * counts = dst->src[2];
+    const int64_t channels = features->ne[0];
+    const int64_t fine_rows = features->ne[1];
+    const int64_t coarse_rows = dst->ne[1];
+    const int64_t source_elements = channels * fine_rows;
+    const int64_t destination_elements = channels * coarse_rows;
+    cudaStream_t stream = ctx.stream();
+
+    CUDA_CHECK(cudaMemsetAsync(dst->data, 0, ggml_nbytes(dst), stream));
+    sam3d_scatter_add_f16<<<(source_elements + kScatterThreads * kScatterValuesPerThread - 1) /
+                                 (kScatterThreads * kScatterValuesPerThread),
+                             kScatterThreads, 0, stream>>>(
+        reinterpret_cast<const half *>(features->data),
+        reinterpret_cast<const int32_t *>(row_indices->data),
+        reinterpret_cast<half *>(dst->data), channels, fine_rows, coarse_rows);
+    sam3d_scatter_scale_f16<<<(destination_elements + kScatterThreads - 1) / kScatterThreads,
+                               kScatterThreads, 0, stream>>>(
+        reinterpret_cast<half *>(dst->data),
+        reinterpret_cast<const float *>(counts->data), channels, coarse_rows);
+    CUDA_CHECK(cudaGetLastError());
+}
