diff --git a/src/ggml-cuda/strict-arithmetic.cu b/src/ggml-cuda/strict-arithmetic.cu
new file mode 100644
--- /dev/null
+++ b/src/ggml-cuda/strict-arithmetic.cu
@@ -0,0 +1,519 @@
+#include "strict-arithmetic.cuh"
+#include <climits>
+#include <cmath>
+
+// Match the F32 persistent-warp reduction in PyTorch 2.6 PersistentSoftmax.cuh:
+// sequential per-lane accumulation, then XOR offsets 16,8,4,2,1 and division.
+// This TU is compiled without fast-math: expf and division retain F32 semantics.
+// Four warps share a CTA instead of allocating 1024 threads for each 789-column
+// row. Values remain in registers between maximum, exponent and sum reductions.
+template<int log2_cols>
+static __global__ void strict_softmax_warp(const float * x, float * dst,
+                                         int ncols, int nrows, float scale) {
+    constexpr int padded = 1 << log2_cols;
+    constexpr int width = padded < 32 ? padded : 32;
+    constexpr int iterations = padded / width;
+    constexpr int batches = padded <= 128 ? 2 : 1;
+    const int first_row = (blockIdx.x * blockDim.y + threadIdx.y) * batches;
+    const int lane = threadIdx.x;
+    float values[batches][iterations];
+    float maxima[batches];
+    float sums[batches] = {};
+#pragma unroll
+    for (int b = 0; b < batches; ++b) {
+#pragma unroll
+        for (int i = 0; i < iterations; ++i) {
+            const int col = lane + i * width;
+            values[b][i] = first_row + b < nrows && col < ncols
+                ? x[int64_t(first_row + b) * ncols + col] * scale : -INFINITY;
+        }
+        maxima[b] = values[b][0];
+#pragma unroll
+        for (int i = 0; i < iterations; ++i) {
+            maxima[b] = maxima[b] > values[b][i] ? maxima[b] : values[b][i];
+        }
+    }
+#pragma unroll
+    for (int offset = width / 2; offset > 0; offset /= 2) {
+#pragma unroll
+        for (int b = 0; b < batches; ++b) {
+            float other = __shfl_xor_sync(0xffffffff, maxima[b], offset, width);
+            maxima[b] = maxima[b] < other ? other : maxima[b];
+        }
+    }
+#pragma unroll
+    for (int b = 0; b < batches; ++b) {
+#pragma unroll
+        for (int i = 0; i < iterations; ++i) {
+            values[b][i] = expf(values[b][i] - maxima[b]);
+            sums[b] += values[b][i];
+        }
+    }
+#pragma unroll
+    for (int offset = width / 2; offset > 0; offset /= 2) {
+#pragma unroll
+        for (int b = 0; b < batches; ++b) {
+            sums[b] += __shfl_xor_sync(0xffffffff, sums[b], offset, width);
+        }
+    }
+#pragma unroll
+    for (int b = 0; b < batches; ++b) {
+        if (first_row + b >= nrows) break;
+#pragma unroll
+        for (int i = 0; i < iterations; ++i) {
+            const int col = lane + i * width;
+            if (col < ncols) dst[int64_t(first_row + b) * ncols + col] = values[b][i] / sums[b];
+        }
+    }
+}
+
+template<int log2_cols>
+static void launch(const float * x, float * dst, int ncols, int nrows,
+                   float scale, cudaStream_t stream) {
+    constexpr int padded = 1 << log2_cols;
+    constexpr int width = padded < 32 ? padded : 32;
+    constexpr int batches = padded <= 128 ? 2 : 1;
+    constexpr int warps = 128 / width;
+    strict_softmax_warp<log2_cols><<<(nrows + warps*batches - 1)/(warps*batches),
+                                     dim3(width, warps), 0, stream>>>(x, dst, ncols, nrows, scale);
+}
+
+bool ggml_cuda_strict_softmax(const float * x, float * dst, int64_t ncols,
+                             int64_t nrows, float scale, cudaStream_t stream) {
+    if (ncols < 1 || ncols > 1024 || nrows < 1 || nrows > INT_MAX) return false;
+    int log2_cols = 0;
+    while ((1 << log2_cols) < ncols) ++log2_cols;
+#define LAUNCH_CASE(n) case n: launch<n>(x, dst, int(ncols), int(nrows), scale, stream); break
+    switch (log2_cols) {
+        LAUNCH_CASE(0); LAUNCH_CASE(1); LAUNCH_CASE(2); LAUNCH_CASE(3);
+        LAUNCH_CASE(4); LAUNCH_CASE(5); LAUNCH_CASE(6); LAUNCH_CASE(7);
+        LAUNCH_CASE(8); LAUNCH_CASE(9); LAUNCH_CASE(10);
+    }
+#undef LAUNCH_CASE
+    return true;
+}
+
+// Tiling changes memory traffic but preserves each output's increasing-K FMA
+// sequence. GGML matrices are [K,C], [K,N] and [C,N] in contiguous storage.
+static __global__ void serial_matmul(const float * w, const float * x, float * out,
+                                     int k, int channels, int columns) {
+    __shared__ float weights[16][33];
+    __shared__ float inputs[32][17];
+    const int tid = threadIdx.y*16 + threadIdx.x;
+    const int c = blockIdx.y*16 + threadIdx.y;
+    const int n = blockIdx.x*16 + threadIdx.x;
+    float sum = 0;
+    for (int base = 0; base < k; base += 32) {
+#pragma unroll
+        for (int i = tid; i < 16*32; i += 256) {
+            const int row = i/32, col = i%32;
+            const int channel = blockIdx.y*16+row, column = blockIdx.x*16+row;
+            weights[row][col] = channel < channels && base+col < k ? w[channel*k+base+col] : 0;
+            inputs[col][row] = column < columns && base+col < k ? x[column*k+base+col] : 0;
+        }
+        __syncthreads();
+#pragma unroll
+        for (int i = 0; i < 32; ++i) {
+            if (base+i < k) sum = __fmaf_rn(weights[threadIdx.y][i], inputs[i][threadIdx.x], sum);
+        }
+        __syncthreads();
+    }
+    if (c < channels && n < columns) out[n*channels+c] = sum;
+}
+
+void ggml_cuda_serial_matmul(const float * weight, const float * input, float * output,
+                            int k, int channels, int columns, cudaStream_t stream) {
+    serial_matmul<<<dim3((columns+15)/16, (channels+15)/16), dim3(16,16), 0, stream>>>
+        (weight, input, output, k, channels, columns);
+}
+
+// PyTorch 2.6 layer_norm_kernel.cu, vectorized_layer_norm_kernel: one CTA of
+// (32,4) threads per row, per-thread Welford over float4 loads, shfl_down tree
+// 16..1, shared-memory warp tree 2,1, rsqrtf, then the affine expression
+// gamma*(rstd*(x-mean))+beta. Expressions are kept verbatim so nvcc contracts
+// the same multiply-adds; the reduction tree fixes the summation order.
+struct strict_welford { float mean, sigma2, count; };
+
+static __device__ strict_welford strict_welford_online(const float val, const strict_welford & s) {
+    float delta = val - s.mean;
+    float new_count = s.count + 1.f;
+    float new_mean = s.mean + delta * (1.f/new_count);
+    return {new_mean, s.sigma2 + delta * (val - new_mean), new_count};
+}
+
+static __device__ strict_welford strict_welford_combine(const strict_welford b, const strict_welford a) {
+    float delta = b.mean - a.mean;
+    float count = a.count + b.count;
+    float mean, sigma2;
+    if (count > 0.f) {
+        auto coef = 1.f/count;
+        auto na = a.count * coef;
+        auto nb = b.count * coef;
+        mean = na*a.mean + nb*b.mean;
+        sigma2 = a.sigma2 + b.sigma2 + delta * delta * a.count * nb;
+    } else {
+        mean = 0.f;
+        sigma2 = 0.f;
+    }
+    return {mean, sigma2, count};
+}
+
+static __global__ void strict_layer_norm(const int n, const float eps, const float * __restrict__ x,
+                                         const float * gamma, const float * beta, float * y) {
+    __shared__ float buf[6]; // blockDim.y*3/2 floats, as in PyTorch's nshared
+    const auto row = blockIdx.x;
+    const float4 * x_vec = reinterpret_cast<const float4 *>(x + row * n);
+    const int numx = blockDim.x * blockDim.y;
+    const int thrx = threadIdx.x + threadIdx.y * blockDim.x;
+    const int n_vec = n/4;
+    strict_welford wd{0.f, 0.f, 0.f};
+    for (int i = thrx; i < n_vec; i += numx) {
+        const float4 v = x_vec[i];
+        wd = strict_welford_online(v.x, wd);
+        wd = strict_welford_online(v.y, wd);
+        wd = strict_welford_online(v.z, wd);
+        wd = strict_welford_online(v.w, wd);
+    }
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        strict_welford wdb{__shfl_down_sync(0xffffffff, wd.mean, offset),
+                           __shfl_down_sync(0xffffffff, wd.sigma2, offset),
+                           __shfl_down_sync(0xffffffff, wd.count, offset)};
+        wd = strict_welford_combine(wd, wdb);
+    }
+    float * meansigmabuf = buf;
+    float * countbuf = buf + blockDim.y;
+    for (int offset = blockDim.y/2; offset > 0; offset /= 2) {
+        if (threadIdx.x == 0 && threadIdx.y >= offset && threadIdx.y < 2*offset) {
+            const int wrt_y = threadIdx.y - offset;
+            meansigmabuf[2*wrt_y] = wd.mean;
+            meansigmabuf[2*wrt_y+1] = wd.sigma2;
+            countbuf[wrt_y] = wd.count;
+        }
+        __syncthreads();
+        if (threadIdx.x == 0 && threadIdx.y < offset) {
+            strict_welford wdb{meansigmabuf[2*threadIdx.y], meansigmabuf[2*threadIdx.y+1],
+                               countbuf[threadIdx.y]};
+            wd = strict_welford_combine(wd, wdb);
+        }
+        __syncthreads();
+    }
+    if (threadIdx.x == 0 && threadIdx.y == 0) {
+        meansigmabuf[0] = wd.mean;
+        meansigmabuf[1] = wd.sigma2/float(n);
+    }
+    __syncthreads();
+    const float mean = meansigmabuf[0];
+    const float rstd = rsqrtf(meansigmabuf[1] + eps);
+    const float4 * gamma_vec = reinterpret_cast<const float4 *>(gamma);
+    const float4 * beta_vec = reinterpret_cast<const float4 *>(beta);
+    float4 * y_vec = reinterpret_cast<float4 *>(y + row * n);
+    // Every read of this row precedes the barriers above, so y may alias x.
+    for (int i = thrx; i < n_vec; i += numx) {
+        const float4 v = x_vec[i];
+        const float in[4] = {v.x, v.y, v.z, v.w};
+        float out[4];
+        if (gamma_vec != nullptr && beta_vec != nullptr) {
+            const float4 g = gamma_vec[i], b = beta_vec[i];
+            const float gv[4] = {g.x, g.y, g.z, g.w}, bv[4] = {b.x, b.y, b.z, b.w};
+#pragma unroll
+            for (int j = 0; j < 4; ++j) out[j] = gv[j] * (rstd * (in[j] - mean)) + bv[j];
+        } else if (gamma_vec != nullptr) {
+            const float4 g = gamma_vec[i];
+            const float gv[4] = {g.x, g.y, g.z, g.w};
+#pragma unroll
+            for (int j = 0; j < 4; ++j) out[j] = gv[j] * (rstd * (in[j] - mean));
+        } else if (beta_vec != nullptr) {
+            const float4 b = beta_vec[i];
+            const float bv[4] = {b.x, b.y, b.z, b.w};
+#pragma unroll
+            for (int j = 0; j < 4; ++j) out[j] = (rstd * (in[j] - mean)) + bv[j];
+        } else {
+#pragma unroll
+            for (int j = 0; j < 4; ++j) out[j] = rstd * (in[j] - mean);
+        }
+        y_vec[i] = make_float4(out[0], out[1], out[2], out[3]);
+    }
+}
+
+bool ggml_cuda_strict_layer_norm(const float * x, const float * gamma, const float * beta,
+                                 float * y, int64_t ncols, int64_t nrows, float eps,
+                                 cudaStream_t stream) {
+    const auto aligned = [](const void * p) { return reinterpret_cast<uintptr_t>(p) % 16 == 0; };
+    if (ncols < 4 || ncols % 4 != 0 || ncols > (int64_t(1) << 24) || nrows < 1 || nrows > INT_MAX ||
+        !aligned(x) || !aligned(y) || (gamma && !aligned(gamma)) || (beta && !aligned(beta))) {
+        return false;
+    }
+    strict_layer_norm<<<unsigned(nrows), dim3(32, 4), 0, stream>>>(int(ncols), eps, x, gamma, beta, y);
+    return true;
+}
+
+// For 512 contiguous inputs PyTorch 2.6 Reduce.cuh vectorizes float4 loads,
+// launches (32,16), gives each warp one row, keeps four independent lane
+// accumulators, combines them in index order, then uses shfl_down offsets
+// 1,2,4,8,16. F.normalize subsequently divides by clamp_min(sqrt(sum), eps).
+static __global__ void strict_l2_norm_512(const float * x, float * y, int nrows, float eps) {
+    const int row = int(blockIdx.x) * int(blockDim.y) + int(threadIdx.y);
+    if (row >= nrows) return;
+    const float4 * xv = reinterpret_cast<const float4 *>(x + int64_t(row) * 512);
+    float sums[4] = {};
+#pragma unroll
+    for (int i = int(threadIdx.x); i < 128; i += 32) {
+        const float4 v = xv[i];
+        sums[0] = __fmaf_rn(v.x, v.x, sums[0]);
+        sums[1] = __fmaf_rn(v.y, v.y, sums[1]);
+        sums[2] = __fmaf_rn(v.z, v.z, sums[2]);
+        sums[3] = __fmaf_rn(v.w, v.w, sums[3]);
+    }
+    float sum = sums[0];
+#pragma unroll
+    for (int i = 1; i < 4; ++i) sum += sums[i];
+#pragma unroll
+    for (int offset = 1; offset < 32; offset <<= 1) {
+        sum += __shfl_down_sync(0xffffffff, sum, offset);
+    }
+    sum = __shfl_sync(0xffffffff, sum, 0);
+    const float denom = fmaxf(sqrtf(sum), eps);
+    for (int col = int(threadIdx.x); col < 512; col += 32) {
+        y[int64_t(row) * 512 + col] = x[int64_t(row) * 512 + col] / denom;
+    }
+}
+
+bool ggml_cuda_strict_l2_norm(const float * x, float * y, int64_t ncols,
+                              int64_t nrows, float eps, cudaStream_t stream) {
+    if (ncols != 512 || nrows < 1 || nrows > INT_MAX ||
+        reinterpret_cast<uintptr_t>(x) % 16 != 0 || reinterpret_cast<uintptr_t>(y) % 16 != 0) {
+        return false;
+    }
+    strict_l2_norm_512<<<unsigned((nrows + 15) / 16), dim3(32, 16), 0, stream>>>
+        (x, y, int(nrows), eps);
+    return true;
+}
+
+// PyTorch 2.6 Reduce.cuh vectorizes 256 contiguous F32 inputs as 64 float4s.
+// Its second block-dimension pass uses 64 lanes while nrows < 16 and 32 lanes
+// otherwise.  The 64-lane tree first combines lanes 0..31 with 32..63 in
+// shared memory; this is observably different from two float4s per lane.
+static __global__ void strict_sum_rows_256(const float * x, float * y, int nrows) {
+    const int row = int(blockIdx.x) * int(blockDim.y) + int(threadIdx.y);
+    const bool active = row < nrows;
+    const float4 * xv = active ?
+        reinterpret_cast<const float4 *>(x + int64_t(row) * 256) : nullptr;
+    float sums[4] = {};
+    if (active) {
+#pragma unroll
+        for (int i = int(threadIdx.x); i < 64; i += int(blockDim.x)) {
+            const float4 v = xv[i];
+            sums[0] += v.x;
+            sums[1] += v.y;
+            sums[2] += v.z;
+            sums[3] += v.w;
+        }
+    }
+    float sum = sums[0];
+#pragma unroll
+    for (int i = 1; i < 4; ++i) sum += sums[i];
+    __shared__ float partial[512];
+    if (blockDim.x == 64) {
+        const int offset = int(threadIdx.y) * 64 + int(threadIdx.x);
+        partial[offset] = sum;
+        __syncthreads();
+        if (threadIdx.x < 32) sum += partial[offset + 32];
+    }
+    if (threadIdx.x < 32) {
+#pragma unroll
+        for (int offset = 1; offset < 32; offset <<= 1) {
+            sum += __shfl_down_sync(0xffffffff, sum, offset);
+        }
+        if (threadIdx.x == 0 && active) y[row] = sum;
+    }
+}
+
+bool ggml_cuda_strict_sum_rows(const float * x, float * y, int64_t ncols,
+                               int64_t nrows, cudaStream_t stream) {
+    if (ncols != 256 || nrows < 1 || nrows > INT_MAX ||
+        reinterpret_cast<uintptr_t>(x) % 16 != 0) {
+        return false;
+    }
+    int block_width = 32;
+    int block_height = 16;
+    if (nrows < 16) {
+        block_width = 64;
+        block_height = 1;
+        while (block_height * 2 <= nrows && block_height < 8) block_height *= 2;
+    }
+    strict_sum_rows_256<<<unsigned((nrows + block_height - 1) / block_height),
+        dim3(block_width, block_height), 0, stream>>>(x, y, int(nrows));
+    return true;
+}
+
+// PyTorch's CUDA sin/cos call ::sinf/::cosf; without fast-math these are the
+// precise libdevice routines rather than __sinf/__cosf.
+// One libdevice call per element, as PyTorch 2.6's F32 kernels write them:
+// UnaryGeometric*/UnaryLog*/ActivationSilu: ::sin, ::cos, ::log, ::tanh and
+// x / (1 + ::exp(-x)) in F32 opmath.
+template <ggml_cuda_strict_fn fn>
+static __global__ void strict_unary(const float * x, float * y, int64_t n) {
+    const int64_t i = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const float v = x[i];
+    switch (fn) {
+        case GGML_CUDA_STRICT_SIN:  y[i] = sinf(v); break;
+        case GGML_CUDA_STRICT_COS:  y[i] = cosf(v); break;
+        case GGML_CUDA_STRICT_LOG:  y[i] = logf(v); break;
+        case GGML_CUDA_STRICT_EXP:  y[i] = expf(v); break;
+        case GGML_CUDA_STRICT_TANH: y[i] = tanhf(v); break;
+        case GGML_CUDA_STRICT_SILU: y[i] = v / (1.0f + expf(-v)); break;
+    }
+}
+
+void ggml_cuda_strict_unary(ggml_cuda_strict_fn fn, const float * x, float * y, int64_t n, cudaStream_t stream) {
+    if (n <= 0) return;
+    const unsigned blocks = unsigned((n + 255) / 256);
+    switch (fn) {
+        case GGML_CUDA_STRICT_SIN:  strict_unary<GGML_CUDA_STRICT_SIN> <<<blocks, 256, 0, stream>>>(x, y, n); break;
+        case GGML_CUDA_STRICT_COS:  strict_unary<GGML_CUDA_STRICT_COS> <<<blocks, 256, 0, stream>>>(x, y, n); break;
+        case GGML_CUDA_STRICT_LOG:  strict_unary<GGML_CUDA_STRICT_LOG> <<<blocks, 256, 0, stream>>>(x, y, n); break;
+        case GGML_CUDA_STRICT_EXP:  strict_unary<GGML_CUDA_STRICT_EXP> <<<blocks, 256, 0, stream>>>(x, y, n); break;
+        case GGML_CUDA_STRICT_TANH: strict_unary<GGML_CUDA_STRICT_TANH><<<blocks, 256, 0, stream>>>(x, y, n); break;
+        case GGML_CUDA_STRICT_SILU: strict_unary<GGML_CUDA_STRICT_SILU><<<blocks, 256, 0, stream>>>(x, y, n); break;
+    }
+}
+
+// PyTorch 2.6 PowKernel.cu: ::pow(base, exp) for F32 tensor-tensor and
+// scalar-base pow.
+// GridSampler.cu/.cuh expressions with opmath_t = float; index_t is widened
+// to int64_t, which changes addressing only (indices convert to float
+// exactly in both widths).
+static __device__ __forceinline__ float strict_grid_source(float coord, int64_t size) {
+    coord = ((coord + 1.f) * size - 1) / 2;
+    if (coord > INT_MAX - 1 || coord < INT_MIN || !::isfinite(static_cast<double>(coord))) {
+        return static_cast<float>(-100.0);
+    }
+    return coord;
+}
+
+static __global__ void __launch_bounds__(256) strict_grid_sample(const float * __restrict__ x,
+        const float * __restrict__ grid, float * __restrict__ y, int64_t nthreads, int64_t C,
+        int64_t inp_H, int64_t inp_W, int64_t out_H, int64_t out_W) {
+    const auto inside = [&](int64_t h, int64_t w) { return h >= 0 && h < inp_H && w >= 0 && w < inp_W; };
+    for (int64_t index = int64_t(blockIdx.x) * blockDim.x + threadIdx.x; index < nthreads;
+         index += int64_t(blockDim.x) * gridDim.x) {
+        const int64_t w = index % out_W;
+        const int64_t h = (index / out_W) % out_H;
+        const int64_t n = index / (out_H * out_W);
+        const float gx = grid[2 * index];
+        const float gy = grid[2 * index + 1];
+        const float ix = strict_grid_source(gx, inp_W);
+        const float iy = strict_grid_source(gy, inp_H);
+        const int64_t ix_nw = static_cast<int64_t>(::floor(ix));
+        const int64_t iy_nw = static_cast<int64_t>(::floor(iy));
+        const int64_t ix_ne = ix_nw + 1, iy_ne = iy_nw, ix_sw = ix_nw, iy_sw = iy_nw + 1;
+        const int64_t ix_se = ix_nw + 1, iy_se = iy_nw + 1;
+        const float nw = (ix_se - ix)    * (iy_se - iy);
+        const float ne = (ix    - ix_sw) * (iy_sw - iy);
+        const float sw = (ix_ne - ix)    * (iy    - iy_ne);
+        const float se = (ix    - ix_nw) * (iy    - iy_nw);
+        const float * inp = x + n * C * inp_H * inp_W;
+        float * out = y + n * C * out_H * out_W + h * out_W + w;
+        for (int64_t c = 0; c < C; ++c, inp += inp_H * inp_W, out += out_H * out_W) {
+            float out_acc = 0;
+            if (inside(iy_nw, ix_nw)) {
+                out_acc += inp[iy_nw * inp_W + ix_nw] * nw;
+            }
+            if (inside(iy_ne, ix_ne)) {
+                out_acc += inp[iy_ne * inp_W + ix_ne] * ne;
+            }
+            if (inside(iy_sw, ix_sw)) {
+                out_acc += inp[iy_sw * inp_W + ix_sw] * sw;
+            }
+            if (inside(iy_se, ix_se)) {
+                out_acc += inp[iy_se * inp_W + ix_se] * se;
+            }
+            *out = out_acc;
+        }
+    }
+}
+
+void ggml_cuda_strict_grid_sample(const float * x, const float * grid, float * y, int64_t n, int64_t c,
+                                  int64_t h, int64_t w, int64_t out_h, int64_t out_w, cudaStream_t stream) {
+    const int64_t count = n * out_h * out_w;
+    if (count > 0) {
+        strict_grid_sample<<<(count + 255) / 256, 256, 0, stream>>>(x, grid, y, count, c, h, w, out_h, out_w);
+    }
+}
+
+static __global__ void strict_pow(const float * a, const float * b, float * y, int64_t n) {
+    const int64_t i = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i < n) y[i] = powf(a[i], b[i]);
+}
+
+void ggml_cuda_strict_pow(const float * a, const float * b, float * y, int64_t n, cudaStream_t stream) {
+    if (n > 0) strict_pow<<<unsigned((n + 255) / 256), 256, 0, stream>>>(a, b, y, n);
+}
+
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+#include <cublasLt.h>
+
+// PyTorch 2.6 CUDABlas.cpp _getAlignment: largest power of two <= 256.
+static uint32_t strict_alignment(const void * p) {
+    uint32_t alignment = 256;
+    while (reinterpret_cast<uintptr_t>(p) % alignment) alignment /= 2;
+    return alignment;
+}
+
+// PyTorch 2.6 addmm -> at::cuda::blas::gemm_and_bias<float> with allow_tf32
+// disabled. The heuristic is a deterministic function of these descriptors and
+// preferences, so issuing the same call selects the same kernel and K order.
+// In cuBLAS column-major terms: m=out, n=rows, A=w (transposed), B=x.
+bool ggml_cuda_strict_linear_bias(void * handle, const float * w, const float * x,
+                                  const float * bias, float * y, int64_t k, int64_t out,
+                                  int64_t rows, int64_t ldw, int64_t ldx, int64_t ldy,
+                                  bool gelu, void * workspace, cudaStream_t stream) {
+    // addmm_out_cuda_impl useLtInterface for CUDA < 12.1.
+    constexpr int64_t limit = 65535 * 32;
+    if (k <= 1 || out <= 1 || rows < 1 || k >= limit || out >= limit || rows >= limit) return false;
+    cublasLtHandle_t lt = reinterpret_cast<cublasLtHandle_t>(handle);
+    cublasLtMatmulDesc_t desc = nullptr;
+    cublasLtMatrixLayout_t a = nullptr, b = nullptr, c = nullptr;
+    cublasLtMatmulPreference_t preference = nullptr;
+    bool ok = cublasLtMatmulDescCreate(&desc, CUBLAS_COMPUTE_32F, CUDA_R_32F) == CUBLAS_STATUS_SUCCESS;
+    const cublasOperation_t transa = CUBLAS_OP_T, transb = CUBLAS_OP_N;
+    const cublasLtEpilogue_t epilogue = gelu ? CUBLASLT_EPILOGUE_GELU_BIAS : CUBLASLT_EPILOGUE_BIAS;
+    ok = ok && cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_TRANSA, &transa, sizeof(transa)) == CUBLAS_STATUS_SUCCESS;
+    ok = ok && cublasLtMatmulDescSetAttribute(desc, CUBLASLT_MATMUL_DESC_TRANSB, &transb, sizeof(transb)) == CUBLAS_STATUS_SUCCESS;
