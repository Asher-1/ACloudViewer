diff --git a/src/ggml-cuda/relateanything-fattn.cu b/src/ggml-cuda/relateanything-fattn.cu
new file mode 100644
--- /dev/null
+++ b/src/ggml-cuda/relateanything-fattn.cu
@@ -0,0 +1,48 @@
+// The native RelateAnything CUDA build uses fast device arithmetic. Keep
+// its 64/96-dimensional attention kernels isolated from other graph owners.
+#include "common.cuh"
+#include "convert.cuh"
+#include "vecdotq.cuh"
+#include "mma.cuh"
+#include "fattn.cuh"
+
+namespace relateanything_cuda {
+#include "fattn-mma-f16.cuh"
+
+DECL_FATTN_MMA_F16_CASE(64, 64, 8, 1);
+DECL_FATTN_MMA_F16_CASE(64, 64, 16, 1);
+DECL_FATTN_MMA_F16_CASE(64, 64, 32, 1);
+DECL_FATTN_MMA_F16_CASE(64, 64, 64, 1);
+DECL_FATTN_MMA_F16_CASE(96, 96, 8, 1);
+DECL_FATTN_MMA_F16_CASE(96, 96, 16, 1);
+DECL_FATTN_MMA_F16_CASE(96, 96, 32, 1);
+DECL_FATTN_MMA_F16_CASE(96, 96, 64, 1);
+
+template<int D>
+static void attention(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    const int64_t columns = dst->src[0]->ne[1];
+    if (turing_mma_available(cc) && columns <= 8) {
+        ggml_cuda_flash_attn_ext_mma_f16_case<D, D, 8, 1>(ctx, dst);
+    } else if (columns <= 16) {
+        ggml_cuda_flash_attn_ext_mma_f16_case<D, D, 16, 1>(ctx, dst);
+    } else if (columns <= 32 ||
+               (GGML_CUDA_CC_IS_NVIDIA(cc) && ggml_cuda_highest_compiled_arch(cc) == GGML_CUDA_CC_TURING)) {
+        ggml_cuda_flash_attn_ext_mma_f16_case<D, D, 32, 1>(ctx, dst);
+    } else {
+        ggml_cuda_flash_attn_ext_mma_f16_case<D, D, 64, 1>(ctx, dst);
+    }
+}
+} // namespace relateanything_cuda
+
+bool ggml_cuda_flash_attn_ext_relateanything(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    if (strncmp(dst->name, "relateanything_", 15) != 0 ||
+        (dst->src[0]->ne[0] != 64 && dst->src[0]->ne[0] != 96) ||
+        dst->src[2]->ne[0] != dst->src[0]->ne[0] ||
+        dst->src[0]->ne[2] != dst->src[1]->ne[2]) {
+        return false;
+    }
+    if (dst->src[0]->ne[0] == 64) relateanything_cuda::attention<64>(ctx, dst);
+    else relateanything_cuda::attention<96>(ctx, dst);
+    return true;
+}
diff --git a/src/ggml-cuda/rmbg-deform-im2col.cu b/src/ggml-cuda/rmbg-deform-im2col.cu
new file mode 100644
--- /dev/null
+++ b/src/ggml-cuda/rmbg-deform-im2col.cu
@@ -0,0 +1,610 @@
+#include "rmbg-deform-im2col.cuh"
+
+#include <cstdio>
+#include <cstring>
+#include <cmath>
+#include <array>
+#include <memory>
+#include <unordered_map>
+
+
+namespace {
+
+constexpr const char * kOpName = "rmbg_deform_im2col";
+
+constexpr const char * kSwinAttentionName = "rmbg_swin_attn_";
+constexpr const char * kPatchMergeName = "rmbg_patch_merge_";
+constexpr const char * kImagePatchesName = "rmbg_image_patches_";
+constexpr const char * kLayerNormName = "rmbg_layer_norm";
+constexpr const char * kAffineReluName = "rmbg_affine_relu";
+constexpr const char * kAffineName = "rmbg_affine";
+
+__device__ __forceinline__ float sample_bilinear(
+        const float * input, int w, int h, int hw, int channel, float y, float x) {
+    const int y0 = (int) floorf(y);
+    const int x0 = (int) floorf(x);
+    const int y1 = y0 + 1;
+    const int x1 = x0 + 1;
+    const float dy = y - (float) y0;
+    const float dx = x - (float) x0;
+    const int base = channel * hw;
+    float value = 0.0f;
+    if ((unsigned) y0 < (unsigned) h && (unsigned) x0 < (unsigned) w) {
+        value += input[base + y0 * w + x0] * (1.0f - dy) * (1.0f - dx);
+    }
+    if ((unsigned) y0 < (unsigned) h && (unsigned) x1 < (unsigned) w) {
+        value += input[base + y0 * w + x1] * (1.0f - dy) * dx;
+    }
+    if ((unsigned) y1 < (unsigned) h && (unsigned) x0 < (unsigned) w) {
+        value += input[base + y1 * w + x0] * dy * (1.0f - dx);
+    }
+    if ((unsigned) y1 < (unsigned) h && (unsigned) x1 < (unsigned) w) {
+        value += input[base + y1 * w + x1] * dy * dx;
+    }
+    return value;
+}
+
+
+// For one output location and kernel tap, offsets and modulation are shared by
+// every input channel.  Keep the CK-major destination layout while computing
+// those values once per channel tile.
+__global__ void rmbg_deform_im2col_tiled_kernel(
+        const float * input, const float * offset, const float * modulator,
+        float * dst, int w, int h, int channels, int kw, int kh,
+        int channel_tiles) {
+    extern __shared__ float shared[];
+    float * ys = shared;
+    float * xs = ys + kw * kh;
+    float * masks = xs + kw * kh;
+
+    const int k_count = kw * kh;
+    const int channel_tile = blockDim.x / k_count;
+    const int block = (int) blockIdx.x;
+    const int p = block / channel_tiles;
+    const int c_base = (block - p * channel_tiles) * channel_tile;
+    const int tid = (int) threadIdx.x;
+    const int64_t hw = (int64_t) w * h;
+
+    for (int k = tid; k < k_count; k += blockDim.x) {
+        const int y_base = p / w;
+        const int x_base = p - y_base * w;
+        const int ky = k / kw;
+        const int kx = k - ky * kw;
+        ys[k] = (float) (y_base + ky - kh / 2) + offset[p + hw * (2 * k)];
+        xs[k] = (float) (x_base + kx - kw / 2) + offset[p + hw * (2 * k + 1)];
+        masks[k] = 2.0f / (1.0f + expf(-modulator[p + hw * k]));
+    }
+    __syncthreads();
+
+    const int c = c_base + tid / k_count;
+    const int k = tid - (tid / k_count) * k_count;
+    if (c < channels && k < k_count) {
+        dst[((int64_t) p * channels + c) * k_count + k] =
+            sample_bilinear(input, w, h, (int) hw, c, ys[k], xs[k]) * masks[k];
+    }
+}
+
+__device__ __forceinline__ int rmbg_swin_region(int x, int limit, int window, int shift) {
+    if (x < limit - window) {
+        return 0;
+    }
+    return x < limit - shift ? 1 : 2;
+}
+
+__global__ void rmbg_swin_qkv_split_kernel(
+        const float * qkv, const float * bias, float * q, float * k, float * v,
+        int C, int N, int heads, int nW) {
+    const int64_t total = (int64_t) C * N * nW;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        const int channel = (int) (index % C);
+        const int token = (int) ((index / C) % N);
+        const int win = (int) (index / ((int64_t) C * N));
+        const int head = channel / 32;
+        const int lane = channel % 32;
+        const int64_t dst_index = lane + 32ll * (token + N * (head + heads * win));
+        const int64_t src_index = channel + (int64_t) 3 * C * (token + N * win);
+        q[dst_index] = qkv[src_index] + bias[channel];
+        k[dst_index] = qkv[src_index + C] + bias[channel + C];
+        v[dst_index] = qkv[src_index + 2 * C] + bias[channel + 2 * C];
+    }
+}
+
+__global__ void rmbg_swin_merge_heads_kernel(
+        const float * head_output, float * attended, int C, int N, int heads, int nW) {
+    const int64_t total = (int64_t) C * N * nW;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        const int channel = (int) (index % C);
+        const int token = (int) ((index / C) % N);
+        const int win = (int) (index / ((int64_t) C * N));
+        const int head = channel / 32;
+        const int lane = channel % 32;
+        const int64_t src_index = lane + 32ll * (token + N * (head + heads * win));
+        attended[index] = head_output[src_index];
+    }
+}
+
+// QK and AV stay in cuBLAS; this kernel fuses relative-position bias,
+// shifted-window masking and softmax in one pass over the logits.
+// One warp per query row.  The rpb/mask-adjusted scores stay in registers
+// between the max reduction and the normalized store, so the logits array is
+// read once and written once instead of three round trips — the kernel is
+// pure memory bandwidth (2 GB of logits per forward pass) and this cuts its
+// traffic by ~3x while keeping the exact expf/max/inv_sum semantics.
+__global__ void rmbg_swin_masked_softmax_kernel(
+        float * logits, const float * rpb,
+        int N, int heads, int Hp, int Wp, int ws, int shift) {
+    constexpr int kMaxPerLane = 5;   // N <= 32 * 5 = 160 (ws = 12 -> N = 144)
+    const int query_index = (int) blockIdx.x;
+    const int batch = query_index / N;
+    const int q = query_index - batch * N;
+    const int head = batch % heads;
+    const int win = batch / heads;
+    const int lane = (int) threadIdx.x;
+    float * row = logits + (int64_t) N * N * batch + (int64_t) N * q;
+    const int windows_w = Wp / ws;
+    const int wh = (win / windows_w) * ws;
+    const int ww = (win % windows_w) * ws;
+    const int qregion = shift == 0 ? 0 :
+        rmbg_swin_region(wh + q / ws, Hp, ws, shift) * 3 +
+        rmbg_swin_region(ww + q % ws, Wp, ws, shift);
+
+    float vals[kMaxPerLane];
+    int count = 0;
+    float max_logit = -INFINITY;
+    for (int k = lane; k < N; k += 32) {
+        float value = row[k] + rpb[k + N * (q + N * head)];
+        if (shift != 0) {
+            const int kregion = rmbg_swin_region(wh + k / ws, Hp, ws, shift) * 3 +
+                rmbg_swin_region(ww + k % ws, Wp, ws, shift);
+            if (qregion != kregion) {
+                value -= 100.0f;
+            }
+        }
+        vals[count++] = value;
+        max_logit = fmaxf(max_logit, value);
+    }
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        max_logit = fmaxf(max_logit, __shfl_down_sync(0xffffffffu, max_logit, offset));
+    }
+    max_logit = __shfl_sync(0xffffffffu, max_logit, 0);
+    float sum = 0.0f;
+    for (int i = 0; i < count; ++i) {
+        vals[i] = expf(vals[i] - max_logit);
+        sum += vals[i];
+    }
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        sum += __shfl_down_sync(0xffffffffu, sum, offset);
+    }
+    sum = __shfl_sync(0xffffffffu, sum, 0);
+    const float inv_sum = 1.0f / sum;
+    int idx = 0;
+    for (int k = lane; k < N; k += 32) {
+        row[k] = vals[idx++] * inv_sum;
+    }
+}
+
+__global__ void rmbg_swin_pack_kernel(
+        const float * input, float * packed, int C, int H, int W,
+        int Hp, int Wp, int ws, int shift, int nW) {
+    const int64_t total = (int64_t) C * ws * ws * nW;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        const int c = (int) (index % C);
+        const int t = (int) ((index / C) % (ws * ws));
+        const int win = (int) (index / ((int64_t) C * ws * ws));
+        const int wh = (win / (Wp / ws)) * ws;
+        const int ww = (win % (Wp / ws)) * ws;
+        const int sh = (wh + t / ws + shift) % Hp;
+        const int sw = (ww + t % ws + shift) % Wp;
+        packed[index] = (sh < H && sw < W) ? input[c + (int64_t) C * (sh * W + sw)] : 0.0f;
+    }
+}
+
+__global__ void rmbg_swin_bias_kernel(float * data, const float * bias, int rows, int cols) {
+    const int64_t total = (int64_t) rows * cols;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        data[index] += bias[index % rows];
+    }
+}
+
+__global__ void rmbg_swin_unpack_kernel(
+        const float * packed, float * output, int C, int H, int W,
+        int Hp, int Wp, int ws, int shift) {
+    const int64_t total = (int64_t) C * H * W;
+    const int windows_w = Wp / ws;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        const int c = (int) (index % C);
+        const int pos = (int) (index / C);
+        const int h = pos / W;
+        const int w = pos - h * W;
+        const int rh = (h - shift + Hp) % Hp;
+        const int rw = (w - shift + Wp) % Wp;
+        const int win = (rh / ws) * windows_w + rw / ws;
+        const int t = (rh % ws) * ws + rw % ws;
+        output[index] = packed[c + (int64_t) C * (t + ws * ws * win)];
+    }
+}
+
+// The four source positions are fixed by Swin patch merge. This avoids loading a
+// dynamic index tensor while preserving the exact gathered values for GGML LayerNorm.
+__global__ void rmbg_patch_merge_gather_kernel(
+        const float * input, float * merged, int C, int H, int W) {
+    const int row = (int) blockIdx.x;
+    const int out_w = W / 2;
+    const int oh = row / out_w;
+    const int ow = row - oh * out_w;
+    const int positions[4] = {
+        (2 * oh) * W + 2 * ow,
+        (2 * oh + 1) * W + 2 * ow,
+        (2 * oh) * W + 2 * ow + 1,
+        (2 * oh + 1) * W + 2 * ow + 1,
+    };
+    for (int j = (int) threadIdx.x; j < 4 * C; j += (int) blockDim.x) {
+        const int group = j / C;
+        const int channel = j - group * C;
+        merged[j + (int64_t) 4 * C * row] = input[channel + (int64_t) C * positions[group]];
+    }
+}
+
+__global__ void rmbg_image_patches_kernel(
+        const float * image, float * gathered,
+        int image_w, int patch_h, int patch_w, int gh, int gw) {
+    const int G = gh * gw;
+    const int P = patch_h * patch_w;
+    const int64_t total = (int64_t) 3 * G * P;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        const int channel = (int) (index % 3);
+        const int grid_pos = (int) ((index / 3) % G);
+        const int patch_pos = (int) (index / ((int64_t) 3 * G));
+        const int hg = grid_pos / gw;
+        const int wg = grid_pos - hg * gw;
+        const int hi = patch_pos / patch_w;
+        const int wi = patch_pos - hi * patch_w;
+        const int source = (hg * patch_h + hi) * image_w + wg * patch_w + wi;
+        gathered[index] = image[source + (int64_t) image_w * patch_h * gh * channel];
+    }
+}
+
+// weight_nn selects between the two supported weight layouts: TN (model
+// default, [in, out] row-major -> OP_T) and the pre-transposed NN copy
+// ([out, in] row-major, "__nn" name suffix -> OP_N, wider Ampere tiles).
+static void rmbg_swin_gemm(ggml_backend_cuda_context & ctx,
+        const float * weight, const float * input, float * output,
+        int out_rows, int cols, int in_rows, bool weight_nn) {
+    const float alpha = 1.0f, beta = 0.0f;
+    CUBLAS_CHECK(cublasSetStream(ctx.cublas_handle(), ctx.stream()));
+    CUBLAS_CHECK(cublasSgemm(ctx.cublas_handle(),
+        weight_nn ? CUBLAS_OP_N : CUBLAS_OP_T, CUBLAS_OP_N,
+        out_rows, cols, in_rows, &alpha, weight, weight_nn ? out_rows : in_rows,
+        input, in_rows, &beta, output, out_rows));
+}
+
+static bool rmbg_is_nn_weight_impl(const ggml_tensor * weight) {
+    const char * name = ggml_get_name(weight);
+    return name && std::strstr(name, "__nn") != nullptr;
+}
+
+// Fused LayerNorm over token columns: dst = (x - mean) * rsqrt(var + eps) * gamma + beta.
+// Bit-faithful mirror of the ggml norm_f32 primitive's numerics so the
+// fused node cannot shift the parity envelope: same one-pass
+// var = E[x^2] - E[x]^2 form, same __shfl_xor warp tree, same 32-vs-1024
+// thread split by rows, and an epilogue pinned with __fmul_rn/__fadd_rn to
+// the rounding sequence of the norm -> mul -> add primitive chain.
+template <int TPB>
+__global__ void rmbg_layer_norm_kernel(const float * x, const float * gamma,
+        const float * beta, float * dst, int rows, float eps) {
+    __shared__ float2 warp_red[32];
+    const float * col = x + (int64_t) blockIdx.x * rows;
+    float * out = dst + (int64_t) blockIdx.x * rows;
+    float2 mv = make_float2(0.0f, 0.0f);
+    for (int r = threadIdx.x; r < rows; r += TPB) {
+        const float xi = col[r];
+        mv.x += xi;
+        mv.y += xi * xi;
+    }
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        mv.x += __shfl_xor_sync(0xffffffffu, mv.x, off);
+        mv.y += __shfl_xor_sync(0xffffffffu, mv.y, off);
+    }
+    if (TPB > 32) {
+        if ((threadIdx.x & 31) == 0) warp_red[threadIdx.x >> 5] = mv;
+        __syncthreads();
+        const int nw = TPB / 32;
+        mv = make_float2(0.0f, 0.0f);
+        if ((threadIdx.x & 31) < nw) mv = warp_red[threadIdx.x & 31];
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            mv.x += __shfl_xor_sync(0xffffffffu, mv.x, off);
+            mv.y += __shfl_xor_sync(0xffffffffu, mv.y, off);
+        }
+    }
+    const float mean = mv.x / rows;
+    const float var = mv.y / rows - mean * mean;
+    const float inv = rsqrtf(var + eps);
+    for (int r = threadIdx.x; r < rows; r += TPB) {
+        const float n = __fmul_rn(col[r] - mean, inv);
+        const float g = __fmul_rn(n, gamma[r]);
+        out[r] = __fadd_rn(g, beta[r]);
+    }
+}
+
+// Fused channel affine (post-BatchNorm scale/shift) over [W, H, C] feature
+// maps with an optional ReLU, replacing the mul -> add -> relu kernel chain.
+__global__ void rmbg_affine_kernel(const float * x, const float * scale,
+        const float * shift, float * dst, int64_t spatial, int relu) {
+    const int channel = blockIdx.y;
+    const float s = scale[channel];
+    const float t = shift[channel];
+    const int64_t begin = (int64_t) channel * spatial;
+    for (int64_t i = begin + (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         i < begin + spatial;
+         i += (int64_t) gridDim.x * blockDim.x) {
+        const float v = x[i] * s + t;
+        dst[i] = (relu && v < 0.0f) ? 0.0f : v;
+    }
+}
+
+} // namespace
+
+// True when the GraphBuilder pre-transposed this weight to the [out, in]
+// NN layout for OP_N sgemm (marked by the "__nn" name suffix).
+bool rmbg_is_nn_weight(const ggml_tensor * weight) {
+    return rmbg_is_nn_weight_impl(weight);
+}
+
+bool ggml_cuda_is_rmbg_deform_im2col(const ggml_tensor * dst) {
+    return dst && dst->op == GGML_OP_CUSTOM &&
+           std::strncmp(ggml_get_name(dst), kOpName, std::strlen(kOpName)) == 0;
+}
+
+void ggml_cuda_op_rmbg_deform_im2col(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * input = dst->src[0];
+    const ggml_tensor * offset = dst->src[1];
+    const ggml_tensor * modulator = dst->src[2];
+    GGML_ASSERT(input && offset && modulator);
+    GGML_ASSERT(input->type == GGML_TYPE_F32 && offset->type == GGML_TYPE_F32 &&
+                modulator->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(input) && ggml_is_contiguous(offset) &&
+                ggml_is_contiguous(modulator) && ggml_is_contiguous(dst));
+
+    const int w = (int) input->ne[0];
+    const int h = (int) input->ne[1];
+    const int channels = (int) input->ne[2];
+    const int k_count = (int) modulator->ne[2];
+    const int kw = (int) sqrtf((float) k_count);
+    const int kh = k_count / kw;
+    const int threads = 256;
+    const int channel_tile = threads / k_count;
+    GGML_ASSERT(channel_tile > 0);
+    const int channel_tiles = (channels + channel_tile - 1) / channel_tile;
+    const int64_t blocks = (int64_t) w * h * channel_tiles;
+    const size_t shared_bytes = 3ull * k_count * sizeof(float);
+    GGML_ASSERT(blocks <= INT_MAX);
+    rmbg_deform_im2col_tiled_kernel<<<(int) blocks, threads, shared_bytes, ctx.stream()>>>(
+        (const float *) input->data, (const float *) offset->data,
+        (const float *) modulator->data, (float *) dst->data,
+        w, h, channels, kw, kh, channel_tiles);
+}
+
+bool ggml_cuda_is_rmbg_conv2d(const ggml_tensor * dst) {
+    // cuDNN convolution path removed: RMBG conv2d is not dispatched on CUDA;
+    // the graph falls back to im2col + mul_mat (see rmbg_graph.cpp).
+    GGML_UNUSED(dst);
+    return false;
+}
