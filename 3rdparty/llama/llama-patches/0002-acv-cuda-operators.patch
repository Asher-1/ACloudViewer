+template <bool WITH_BIAS, bool WITH_SILU, bool C8>
+static __global__ __launch_bounds__(128) void igemm_conv_f32_kernel(
+        const float * __restrict__ in,   // [B, H, W, C] NHWC
+        const float * __restrict__ w,    // [K, R, S, C] KRSC
+        const float * __restrict__ bias, // [K] (nullable)
+        float * __restrict__ out,        // [B, P, Q, K] NHWC
+        const int H, const int W, const int C, const int P, const int Q, const int K,
