+static __global__ void ggml_cuda_transpose_f16_linear_weights(
+        const uint16_t * source, uint16_t * destination, int64_t rows, int64_t cols) {
+    const int64_t index = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const int64_t count = rows * cols;
+    if (index >= count) {
+        return;
