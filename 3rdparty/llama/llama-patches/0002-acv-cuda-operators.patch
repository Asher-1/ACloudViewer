+bool ggml_cuda_is_rmbg_affine_relu(const ggml_tensor * dst) {
+    return rmbg_is_affine_name(dst, kAffineReluName);
+}
+
+bool ggml_cuda_is_rmbg_affine(const ggml_tensor * dst) {
+    return rmbg_is_affine_name(dst, kAffineName);
+}
+
+// Fused channel affine over [W, H, C] maps; the ReLU variant is selected by
+// the node name.  Fills the CUDA side of the batch_norm custom op that the
+// Vulkan backend already dispatches.
+void ggml_cuda_op_rmbg_affine(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
+    const ggml_tensor * scale = dst->src[1];
+    const ggml_tensor * shift = dst->src[2];
+    GGML_ASSERT(x && scale && shift);
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && scale->type == GGML_TYPE_F32 &&
+                shift->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    const int64_t spatial = x->ne[0] * x->ne[1];
+    const int channels = (int) x->ne[2];
+    const bool relu = ggml_cuda_is_rmbg_affine_relu(dst);
+    constexpr int threads = 256;
+    const int64_t blocks_x = (spatial + threads - 1) / threads;
+    GGML_ASSERT(blocks_x <= 65535 && channels > 0);
+    dim3 grid((unsigned) blocks_x, (unsigned) channels);
+    rmbg_affine_kernel<<<grid, threads, 0, ctx.stream()>>>(
+        (const float *) x->data, (const float *) scale->data,
+        (const float *) shift->data, (float *) dst->data, spatial, relu ? 1 : 0);
+}
