+void ggml_cuda_op_rmbg_image_patches(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * image = dst->src[0];
+    GGML_ASSERT(image && image->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    int patch_h = 0, patch_w = 0;
+    GGML_ASSERT(std::sscanf(ggml_get_name(dst), "rmbg_image_patches_ph%d_pw%d",
+                            &patch_h, &patch_w) == 2);
+    const int image_w = (int) image->ne[0];
+    const int image_h = (int) image->ne[1];
+    const int gh = image_h / patch_h;
+    const int gw = image_w / patch_w;
+    const int G = gh * gw;
+    const int P = patch_h * patch_w;
+    GGML_ASSERT(image->ne[2] == 3 && image_h % patch_h == 0 && image_w % patch_w == 0 &&
+                dst->ne[0] == 3 && dst->ne[1] == (int64_t) G * P);
+    constexpr int threads = 256;
+    const int blocks = (int) std::min<int64_t>(((int64_t) 3 * G * P + threads - 1) / threads, 65535);
+    rmbg_image_patches_kernel<<<blocks, threads, 0, ctx.stream()>>>(
+        (const float *) image->data, (float *) dst->data,
+        image_w, patch_h, patch_w, gh, gw);
+}
+
+bool ggml_cuda_is_rmbg_layer_norm(const ggml_tensor * dst) {
+    return dst && dst->op == GGML_OP_CUSTOM && ggml_get_name(dst) &&
+           std::strncmp(ggml_get_name(dst), kLayerNormName,
+                        std::strlen(kLayerNormName)) == 0;
+}
+
+// Fused norm + scale + shift over token columns, replacing the
+// norm -> mul(gamma) -> add(beta) kernel chain.
+void ggml_cuda_op_rmbg_layer_norm(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
+    const ggml_tensor * gamma = dst->src[1];
+    const ggml_tensor * beta = dst->src[2];
+    GGML_ASSERT(x && gamma && beta);
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && gamma->type == GGML_TYPE_F32 &&
+                beta->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    const int rows = (int) x->ne[0];
+    const int64_t cols = x->ne[1] * x->ne[2] * x->ne[3];
+    GGML_ASSERT(cols > 0 && cols <= INT_MAX);
+    // Same 32-vs-1024 thread split as ggml_cuda_norm so the reduction tree
+    // (and therefore every low-order bit) matches the primitive path.
+    if (rows < 1024) {
+        rmbg_layer_norm_kernel<32><<<(int) cols, 32, 0, ctx.stream()>>>(
+            (const float *) x->data, (const float *) gamma->data,
+            (const float *) beta->data, (float *) dst->data, rows, 1e-5f);
+    } else {
+        rmbg_layer_norm_kernel<1024><<<(int) cols, 1024, 0, ctx.stream()>>>(
+            (const float *) x->data, (const float *) gamma->data,
+            (const float *) beta->data, (float *) dst->data, rows, 1e-5f);
+    }
+}
+
+static bool rmbg_is_affine_name(const ggml_tensor * dst, const char * name) {
+    return dst && dst->op == GGML_OP_CUSTOM && ggml_get_name(dst) &&
+           std::strcmp(ggml_get_name(dst), name) == 0;
+}
