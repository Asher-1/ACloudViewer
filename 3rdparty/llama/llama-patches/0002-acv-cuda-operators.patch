+template <int NT, bool C8>
+static void igemm_conv_dispatch(const dim3 & grid, bool with_bias, bool with_silu,
+                                const half * in_p, const half * w_p, const float * b_p, half * out_p,
+                                cudaStream_t stream,
+                                int H, int W, int C, int P, int Q, int K, int R, int S, const int32_t * p) {
+    constexpr size_t smem = (IGEMM_MT + NT) * IGEMM_KP * sizeof(half); // A + B staging
+    // NT=256 needs >48KB dynamic smem; opt in once per kernel variant.
+    static const bool smem_ok = [] {
+        if (smem <= 48 * 1024) return true;
+        return cudaSuccess == cudaFuncSetAttribute(igemm_conv_f16_kernel<NT, true, true, C8>,
+                                                   cudaFuncAttributeMaxDynamicSharedMemorySize, smem)
+            && cudaSuccess == cudaFuncSetAttribute(igemm_conv_f16_kernel<NT, true, false, C8>,
+                                                   cudaFuncAttributeMaxDynamicSharedMemorySize, smem)
+            && cudaSuccess == cudaFuncSetAttribute(igemm_conv_f16_kernel<NT, false, false, C8>,
+                                                   cudaFuncAttributeMaxDynamicSharedMemorySize, smem);
+    }();
+    if (!smem_ok) return;
+    if (with_silu) {
+        igemm_conv_f16_kernel<NT, true, true, C8><<<grid, 128, smem, stream>>>
+            (in_p, w_p, b_p, out_p, H, W, C, P, Q, K, R, S, p[1], p[0], p[3], p[2], p[5], p[4]);
+    } else if (with_bias) {
+        igemm_conv_f16_kernel<NT, true, false, C8><<<grid, 128, smem, stream>>>
+            (in_p, w_p, b_p, out_p, H, W, C, P, Q, K, R, S, p[1], p[0], p[3], p[2], p[5], p[4]);
+    } else {
+        igemm_conv_f16_kernel<NT, false, false, C8><<<grid, 128, smem, stream>>>
+            (in_p, w_p, b_p, out_p, H, W, C, P, Q, K, R, S, p[1], p[0], p[3], p[2], p[5], p[4]);
+    }
+}
+
+// NT launcher folding the C % 8 vectorization check into the template tree.
+template <int NT>
+static void igemm_conv_launch(const dim3 & grid, bool with_bias, bool with_silu, int C,
+                              const half * in_p, const half * w_p, const float * b_p, half * out_p,
+                              cudaStream_t stream,
+                              int H, int W, int P, int Q, int K, int R, int S, const int32_t * p) {
+    if (C % 8 == 0) {
+        igemm_conv_dispatch<NT, true>(grid, with_bias, with_silu, in_p, w_p, b_p, out_p, stream,
+                                      H, W, C, P, Q, K, R, S, p);
+    } else {
+        igemm_conv_dispatch<NT, false>(grid, with_bias, with_silu, in_p, w_p, b_p, out_p, stream,
+                                       H, W, C, P, Q, K, R, S, p);
+    }
+}
