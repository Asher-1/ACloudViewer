+                } else {
+                    * (uint4 *) dst = make_uint4(0, 0, 0, 0);
+                }
+            } else {
+                #pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    const int kk = k + i;
+                    half v = (half) 0;
+                    if (n_abs < K && kk < K_gemm) {
+                        const int rs = kk / C;
+                        v = w[(((int64_t) n_abs * R + rs / S) * S + rs % S) * C + kk % C];
+                    }
+                    dst[i] = v;
+                }
+            }
+        }
+    };
+
+    for (int kbase = 0; kbase < K_gemm; kbase += KT) {
+        load_tile(kbase);
+        __syncthreads();
+        #pragma unroll
+        for (int ks = 0; ks < KT / 16; ++ks) {
+            #pragma unroll
+            for (int i = 0; i < FM; ++i) {
+                wmma::load_matrix_sync(fa[i], sa + (warp_m + i * 16) * KP + ks * 16, KP);
+                #pragma unroll
+                for (int j = 0; j < FN; ++j) {
+                    if (i == 0) {
+                        wmma::load_matrix_sync(fb[j], sb + (warp_n + j * 16) * KP + ks * 16, KP);
+                    }
+                    wmma::mma_sync(fc[i][j], fa[i], fb[j], fc[i][j]);
+                }
+            }
+        }
+        __syncthreads(); // mma reads are complete before the next overwrite
+    }
+
+    // Epilogue: route f32 accumulators through shared memory EC columns at a
+    // time so bias and SiLU can be applied per output channel, then store 16B
+    // vectors. Fragment j of a warp covers columns warp_n + j*16 .. +16, and
+    // every supported (NT, warp_n) places each 16-column slice in exactly one
+    // chunk, so no fragment straddles a chunk boundary.
+    for (int chunk = 0; chunk < NT; chunk += EC) {
+        __syncthreads();
+        #pragma unroll
+        for (int i = 0; i < FM; ++i) {
+            #pragma unroll
+            for (int j = 0; j < FN; ++j) {
+                const int col = warp_n + j * 16;
+                if (col >= chunk && col < chunk + EC) {
+                    wmma::store_matrix_sync(sc + (warp_m + i * 16) * ECP + (col - chunk), fc[i][j], ECP, wmma::mem_row_major);
+                }
+            }
+        }
+        __syncthreads();
+
+        for (int idx = tid; idx < MT * (EC / 8); idx += 128) {
+            const int m  = idx / (EC / 8);
+            const int n8 = idx % (EC / 8);
+            const int m_abs = m0 + m;
+            const int n_abs = n0 + chunk + n8 * 8;
+            if (m_abs >= M || n_abs >= K) {
+                continue;
+            }
+            alignas(16) half vals[8];
+            #pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                float v = sc[m * ECP + n8 * 8 + i];
+                if (WITH_BIAS && n_abs + i < K) {
+                    v += bias[n_abs + i];
+                }
+                if (WITH_SILU) {
+                    v = v / (1.0f + expf(-v));
