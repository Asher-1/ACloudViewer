+        // plain half loaders below.
+        for (int idx = tid; idx < NT * (KT / 8); idx += 128) {
+            const int n  = idx / (KT / 8);
+            const int k8 = idx % (KT / 8);
+            const int k  = kbase + k8 * 8;
