diff --git a/src/ggml-cuda/norm.cu b/src/ggml-cuda/norm.cu
--- a/src/ggml-cuda/norm.cu
+++ b/src/ggml-cuda/norm.cu
@@ -1,5 +1,197 @@
 #include "norm.cuh"
 #include <cstdint>
+
+// PyTorch's vectorized CUDA LayerNorm path uses an online Welford reduction
+// for contiguous rows whose width is divisible by four.  SAM 3D Objects uses
+// 768-wide F32 LayerNorm before every transformer projection, where the older
+// sum/sum-of-squares reduction below loses enough precision to compound over
+// the mesh decoder.  Keep this implementation local to ggml's NORM operator:
+// it has no PyTorch, cuDNN, or host-runtime dependency.
+struct sam3d_welford_data {
+    float mean;
+    float sigma2;
+    float count;
+};
+
+static __device__ sam3d_welford_data sam3d_welford_online(
+        const float value, const sam3d_welford_data current) {
+    const float delta = value - current.mean;
+    const float count = current.count + 1.0f;
+    const float mean = current.mean + delta * (1.0f / count);
+    return {mean, current.sigma2 + delta * (value - mean), count};
+}
+
+static __device__ sam3d_welford_data sam3d_welford_combine(
+        const sam3d_welford_data data_b, const sam3d_welford_data data_a) {
+    const float delta = data_b.mean - data_a.mean;
+    const float count = data_a.count + data_b.count;
+    if (count == 0.0f) {
+        return {0.0f, 0.0f, 0.0f};
+    }
+    const float inv_count = 1.0f / count;
+    const float a_fraction = data_a.count * inv_count;
+    const float b_fraction = data_b.count * inv_count;
+    return {a_fraction * data_a.mean + b_fraction * data_b.mean,
+            data_a.sigma2 + data_b.sigma2 + delta * delta * data_a.count * b_fraction,
+            count};
+}
+
+static __global__ void norm_f32_pytorch_welford(
+        const float * x, float * dst, const int ncols, const int64_t stride_row,
+        const int64_t stride_channel, const int64_t stride_sample, const float eps) {
+    constexpr int kWarpSize = 32;
+    const int row = blockIdx.x;
+    const int channel = blockIdx.y;
+    const int sample = blockIdx.z;
+    const int tid = threadIdx.x + threadIdx.y * blockDim.x;
+    const int thread_count = blockDim.x * blockDim.y;
+
+    x += sample * stride_sample + channel * stride_channel + row * stride_row;
+    dst += ((sample * gridDim.y + channel) * gridDim.x + row) * ncols;
+
+    sam3d_welford_data stats{0.0f, 0.0f, 0.0f};
+    const int vector_count = ncols / 4;
+    for (int vector = tid; vector < vector_count; vector += thread_count) {
+        const int first = vector * 4;
+        stats = sam3d_welford_online(x[first + 0], stats);
+        stats = sam3d_welford_online(x[first + 1], stats);
+        stats = sam3d_welford_online(x[first + 2], stats);
+        stats = sam3d_welford_online(x[first + 3], stats);
+    }
+
+    // Match the 32x4 block and merge order used by PyTorch's vectorized
+    // LayerNorm kernel. The six shared floats cover two reduction rounds.
+    for (int offset = kWarpSize / 2; offset > 0; offset >>= 1) {
+        const sam3d_welford_data other{
+            __shfl_down_sync(0xffffffffu, stats.mean, offset),
+            __shfl_down_sync(0xffffffffu, stats.sigma2, offset),
+            __shfl_down_sync(0xffffffffu, stats.count, offset)};
+        stats = sam3d_welford_combine(stats, other);
+    }
+
+    extern __shared__ float shared[];
+    if (threadIdx.y >= 2 && threadIdx.x == 0) {
+        const int target = threadIdx.y - 2;
+        shared[2 * target + 0] = stats.mean;
+        shared[2 * target + 1] = stats.sigma2;
+        shared[4 + target] = stats.count;
+    }
+    __syncthreads();
+    if (threadIdx.y < 2 && threadIdx.x == 0) {
+        const sam3d_welford_data other{
+            shared[2 * threadIdx.y + 0], shared[2 * threadIdx.y + 1],
+            shared[4 + threadIdx.y]};
+        stats = sam3d_welford_combine(stats, other);
+    }
+    __syncthreads();
+    if (threadIdx.y == 1 && threadIdx.x == 0) {
+        shared[0] = stats.mean;
+        shared[1] = stats.sigma2;
+        shared[4] = stats.count;
+    }
+    __syncthreads();
+    if (threadIdx.y == 0 && threadIdx.x == 0) {
+        const sam3d_welford_data other{shared[0], shared[1], shared[4]};
+        stats = sam3d_welford_combine(stats, other);
+        shared[0] = stats.mean;
+        shared[1] = stats.sigma2 / static_cast<float>(ncols);
+    }
+    __syncthreads();
+
+    const float mean = shared[0];
+    const float rstd = rsqrtf(shared[1] + eps);
+    for (int vector = tid; vector < vector_count; vector += thread_count) {
+        const int first = vector * 4;
+        dst[first + 0] = rstd * (x[first + 0] - mean);
+        dst[first + 1] = rstd * (x[first + 1] - mean);
+        dst[first + 2] = rstd * (x[first + 2] - mean);
+        dst[first + 3] = rstd * (x[first + 3] - mean);
+    }
+}
+
+// PyTorch's vectorized LayerNorm computes the affine expression while its
+// Welford statistics remain in registers:
+//
+//   gamma * (rstd * (x - mean)) + beta
+//
+// Materializing NORM, MUL and ADD as separate ggml F32 kernels changes the
+// low-order rounding of this expression. The resulting F16 boundary differs
+// at a small number of values, which sparse convolutions can subsequently
+// amplify. This kernel is intentionally narrow and is reached only by the
+// graph fusion matcher below.
+static __global__ void norm_f32_affine_pytorch_welford(
+        const float * x, const float * gamma, const float * beta, float * dst,
+        const int ncols, const int64_t stride_row, const int64_t stride_channel,
+        const int64_t stride_sample, const float eps) {
+    constexpr int kWarpSize = 32;
+    const int row = blockIdx.x;
+    const int channel = blockIdx.y;
+    const int sample = blockIdx.z;
+    const int tid = threadIdx.x + threadIdx.y * blockDim.x;
+    const int thread_count = blockDim.x * blockDim.y;
+
+    x += sample * stride_sample + channel * stride_channel + row * stride_row;
+    dst += ((sample * gridDim.y + channel) * gridDim.x + row) * ncols;
+
+    sam3d_welford_data stats{0.0f, 0.0f, 0.0f};
+    const int vector_count = ncols / 4;
+    for (int vector = tid; vector < vector_count; vector += thread_count) {
+        const int first = vector * 4;
+        stats = sam3d_welford_online(x[first + 0], stats);
+        stats = sam3d_welford_online(x[first + 1], stats);
+        stats = sam3d_welford_online(x[first + 2], stats);
+        stats = sam3d_welford_online(x[first + 3], stats);
+    }
+
+    for (int offset = kWarpSize / 2; offset > 0; offset >>= 1) {
+        const sam3d_welford_data other{
+            __shfl_down_sync(0xffffffffu, stats.mean, offset),
+            __shfl_down_sync(0xffffffffu, stats.sigma2, offset),
+            __shfl_down_sync(0xffffffffu, stats.count, offset)};
+        stats = sam3d_welford_combine(stats, other);
+    }
+
+    extern __shared__ float shared[];
+    if (threadIdx.y >= 2 && threadIdx.x == 0) {
+        const int target = threadIdx.y - 2;
+        shared[2 * target + 0] = stats.mean;
+        shared[2 * target + 1] = stats.sigma2;
+        shared[4 + target] = stats.count;
+    }
+    __syncthreads();
+    if (threadIdx.y < 2 && threadIdx.x == 0) {
+        const sam3d_welford_data other{
+            shared[2 * threadIdx.y + 0], shared[2 * threadIdx.y + 1],
+            shared[4 + threadIdx.y]};
+        stats = sam3d_welford_combine(stats, other);
+    }
+    __syncthreads();
+    if (threadIdx.y == 1 && threadIdx.x == 0) {
+        shared[0] = stats.mean;
+        shared[1] = stats.sigma2;
+        shared[4] = stats.count;
+    }
+    __syncthreads();
+    if (threadIdx.y == 0 && threadIdx.x == 0) {
+        const sam3d_welford_data other{shared[0], shared[1], shared[4]};
+        stats = sam3d_welford_combine(stats, other);
+        shared[0] = stats.mean;
+        shared[1] = stats.sigma2 / static_cast<float>(ncols);
