+void ggml_elementwise_set_epilogue_hint(struct ggml_tensor * a, int32_t epilogue) {
+    GGML_ASSERT(a && a->op == GGML_OP_ADD);
+    GGML_ASSERT(epilogue == 0 || epilogue == GGML_EPILOGUE_GELU);
+    ggml_set_op_params_i32(a, 2, epilogue);
+}
