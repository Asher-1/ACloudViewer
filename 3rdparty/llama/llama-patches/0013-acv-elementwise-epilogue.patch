+        ggml_elementwise_get_epilogue_hint(add) != GGML_EPILOGUE_GELU ||
+        ggml_get_unary_op(gelu) != GGML_UNARY_OP_GELU_ERF || gelu->src[0] != add ||
+        add->type != GGML_TYPE_F32 || gelu->type != GGML_TYPE_F32 ||
+        add->src[0]->type != GGML_TYPE_F32 || add->src[1]->type != GGML_TYPE_F32 ||
+        !ggml_are_same_shape(add, gelu) || !ggml_are_same_stride(add, gelu)) {
+        return false;
+    }
+    return ggml_can_fuse(graph, i, {GGML_OP_ADD, GGML_OP_UNARY});
+}
