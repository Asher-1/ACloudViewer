+// 只有完整融合域才能跳过 ADD；OUTPUT、多消费者、非相邻路径均回退。
+static bool ggml_vk_can_fuse_add_gelu(const ggml_backend_vk_context * ctx,
+                                    const ggml_cgraph * graph, int i) {
+    if (ctx->device->disable_fusion || i + 1 >= graph->n_nodes) return false;
+    const ggml_tensor * add = graph->nodes[i];
+    const ggml_tensor * gelu = graph->nodes[i + 1];
