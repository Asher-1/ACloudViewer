+bool ggml_vulkan_aliked_run_dkd(ggml_backend_t backend, const ggml_tensor *score_map, int32_t h,
+                                int32_t w, int32_t radius, int32_t top_k, float scores_th,
+                                int32_t n_limit, ggml_tensor *keypoints_norm,
+                                ggml_tensor *scores, int32_t *out_count, ggml_tensor *nms,
+                                ggml_tensor *tmp_a, ggml_tensor *tmp_b, ggml_tensor *tmp_c,
+                                ggml_tensor *block_keys, ggml_tensor *block_indices,
+                                ggml_tensor *indices_dev) {
+    ggml_backend_vk_context *ctx = vk_aliked_ctx(backend);
+    if (ctx == nullptr || out_count == nullptr) {
+        return false;
+    }
+    const int32_t count = h * w;
+    ggml_backend_synchronize(backend);
+    ctx->descriptor_set_idx = 0;
+    vk_aliked_pipelines &pipes = vk_aliked_ensure(ctx);
+    ggml_vulkan_aliked_queue_idle(backend);
+
+    if (!vk_aliked_simple_nms(ctx, pipes, score_map, nms, tmp_a, tmp_b, tmp_c, h, w, radius)) {
+        return false;
+    }
+    ggml_backend_synchronize(backend);
+
+    if (!vk_aliked_dkd_elem(ctx, pipes, 5, nms, nms, nms, tmp_c, h, w, count, radius)) {
+        return false;
+    }
+    vk_aliked_finish(ctx);
+    ggml_backend_synchronize(backend);
+
+    std::vector<int32_t> indices;
+    if (top_k > 0) {
+        const int32_t keep = std::min(top_k, count);
+        if (vk_aliked_use_gpu_topk() && block_keys != nullptr && block_indices != nullptr &&
+            vk_aliked_topk_indices_gpu(backend, ctx, pipes, nms, block_keys, block_indices,
+                                       count, keep, &indices)) {
+            // GPU block_topk path (CUDA-equivalent, opt-in).
+        } else {
+            std::vector<float> nms_host(static_cast<size_t>(count));
+            ggml_backend_tensor_get(nms, nms_host.data(), 0, nms_host.size() * sizeof(float));
+            std::vector<std::pair<float, int32_t>> scored;
+            scored.reserve(static_cast<size_t>(count));
+            for (int32_t i = 0; i < count; ++i) {
+                scored.emplace_back(nms_host[static_cast<size_t>(i)], i);
+            }
+            std::partial_sort(scored.begin(), scored.begin() + keep, scored.end(),
+                              [](const auto &a, const auto &b) { return a.first > b.first; });
+            indices.reserve(static_cast<size_t>(keep));
+            for (int32_t i = 0; i < keep; ++i) {
+                indices.push_back(scored[static_cast<size_t>(i)].second);
+            }
+        }
+    } else {
+        std::vector<float> nms_host(static_cast<size_t>(count));
+        ggml_backend_tensor_get(nms, nms_host.data(), 0, nms_host.size() * sizeof(float));
+        float threshold = scores_th;
+        if (scores_th > 0.0f) {
+            bool any = false;
+            for (float value : nms_host) {
+                if (value > threshold) {
+                    any = true;
+                    break;
+                }
+            }
+            if (!any) {
+                threshold = 0.0f;
+                for (float value : nms_host) {
+                    threshold += value;
+                }
+                threshold /= static_cast<float>(count);
+            }
+        } else {
+            threshold = 0.0f;
+            for (float value : nms_host) {
+                threshold += value;
+            }
+            threshold /= static_cast<float>(count);
+        }
+        std::vector<float> score_host(static_cast<size_t>(count));
+        ggml_backend_tensor_get(score_map, score_host.data(), 0, score_host.size() * sizeof(float));
+        std::vector<std::pair<float, int32_t>> scored;
+        for (int32_t i = 0; i < count; ++i) {
+            if (nms_host[static_cast<size_t>(i)] > threshold) {
+                scored.emplace_back(score_host[static_cast<size_t>(i)], i);
+            }
+        }
+        std::sort(scored.begin(), scored.end(),
+                  [](const auto &a, const auto &b) { return a.first > b.first; });
+        if (static_cast<int32_t>(scored.size()) > n_limit) {
+            scored.resize(static_cast<size_t>(n_limit));
+        }
+        indices.reserve(scored.size());
+        for (const auto &entry : scored) {
+            indices.push_back(entry.second);
+        }
+    }
+
+    const int32_t kpt_count = static_cast<int32_t>(indices.size());
+    *out_count = kpt_count;
+    if (kpt_count == 0) {
+        return true;
+    }
+
+    std::vector<float> indices_f(static_cast<size_t>(indices.size()));
+    for (size_t i = 0; i < indices.size(); ++i) {
+        indices_f[i] = static_cast<float>(indices[static_cast<size_t>(i)]);
+    }
+    ggml_backend_tensor_set(indices_dev, indices_f.data(), 0, indices_f.size() * sizeof(float));
+    ggml_backend_synchronize(backend);
+
+    vk_aliked_push_dkd_refine rpc{
+        static_cast<uint32_t>(kpt_count), static_cast<uint32_t>(h),
+        static_cast<uint32_t>(w), static_cast<uint32_t>(radius),
+        vk_aliked_misalign_floats(ctx, score_map),
+        vk_aliked_misalign_floats(ctx, indices_dev),
+        vk_aliked_misalign_floats(ctx, keypoints_norm),
+        vk_aliked_misalign_floats(ctx, scores)};
+    vk_aliked_dispatch1(ctx, pipes.dkd_refine,
+                        {vk_aliked_subbuf(ctx, score_map), vk_aliked_subbuf(ctx, indices_dev),
+                         vk_aliked_subbuf(ctx, keypoints_norm), vk_aliked_subbuf(ctx, scores)},
+                        rpc, {static_cast<uint32_t>(kpt_count), 1, 1});
+    vk_aliked_finish(ctx);
+    ggml_backend_synchronize(backend);
+    return true;
+}
+
+bool ggml_vulkan_aliked_run_sddh(
+    ggml_backend_t backend, const ggml_tensor *feature_map, int32_t dim, int32_t h, int32_t w,
+    const ggml_tensor *keypoints_norm, int32_t count, int32_t kernel_size, int32_t n_pos,
+    const ggml_tensor *offset_0_w, const ggml_tensor *offset_0_b, const ggml_tensor *offset_2_w,
+    const ggml_tensor *offset_2_b, const ggml_tensor *sf_conv_w, const ggml_tensor *agg_weights,
+    ggml_tensor *workspace, ggml_tensor *descriptors) {
+    ggml_backend_vk_context *ctx = vk_aliked_ctx(backend);
+    if (ctx == nullptr || count <= 0) {
+        return false;
+    }
+    ggml_backend_synchronize(backend);
+    ctx->descriptor_set_idx = 0;
+    vk_aliked_pipelines &pipes = vk_aliked_ensure(ctx);
+    const uint32_t feature_off = vk_aliked_misalign_floats(ctx, feature_map);
+    const uint32_t kpt_off = vk_aliked_misalign_floats(ctx, keypoints_norm);
+    const uint32_t workspace_off = vk_aliked_misalign_floats(ctx, workspace);
+    const uint32_t desc_off = vk_aliked_misalign_floats(ctx, descriptors);
+    const uint32_t off0_w = vk_aliked_misalign_floats(ctx, offset_0_w);
+    const uint32_t off0_b = vk_aliked_misalign_floats(ctx, offset_0_b);
+    const uint32_t off2_w = vk_aliked_misalign_floats(ctx, offset_2_w);
+    const uint32_t off2_b = vk_aliked_misalign_floats(ctx, offset_2_b);
+    const uint32_t sf_w = vk_aliked_misalign_floats(ctx, sf_conv_w);
+    const uint32_t agg_w = vk_aliked_misalign_floats(ctx, agg_weights);
+
+    const int32_t batch_size = vk_aliked_sddh_batch_size();
+    const int32_t num_batches = (count + batch_size - 1) / batch_size;
+
+    auto dispatch_batch = [&](int32_t start, int32_t batch) {
+        vk_aliked_push_sddh pc{static_cast<uint32_t>(dim), static_cast<uint32_t>(h),
+                               static_cast<uint32_t>(w), static_cast<uint32_t>(count),
+                               static_cast<uint32_t>(kernel_size), static_cast<uint32_t>(n_pos),
+                               feature_off, kpt_off, workspace_off, desc_off,
+                               static_cast<uint32_t>(start), static_cast<uint32_t>(batch),
+                               static_cast<uint32_t>(feature_map->nb[0]),
+                               static_cast<uint32_t>(feature_map->nb[1]),
+                               static_cast<uint32_t>(feature_map->nb[2]),
+                               off0_w, off0_b, off2_w, off2_b, sf_w, agg_w};
+        vk_aliked_dispatch1(
+            ctx, pipes.sddh,
+            {vk_aliked_subbuf(ctx, feature_map), vk_aliked_subbuf(ctx, keypoints_norm),
+             vk_aliked_subbuf(ctx, offset_0_w), vk_aliked_subbuf(ctx, offset_0_b),
+             vk_aliked_subbuf(ctx, offset_2_w), vk_aliked_subbuf(ctx, offset_2_b),
+             vk_aliked_subbuf(ctx, sf_conv_w), vk_aliked_subbuf(ctx, agg_weights),
+             vk_aliked_subbuf(ctx, workspace), vk_aliked_subbuf(ctx, descriptors)},
+            pc, {static_cast<uint32_t>(batch), 1, 1}, false);
+    };
+
+    const bool single_dispatch = vk_aliked_sddh_single_submit() || num_batches <= 1;
+    if (single_dispatch) {
+        ggml_pipeline_request_descriptor_sets(ctx, pipes.sddh, 1);
+        dispatch_batch(0, count);
+        vk_aliked_finish(ctx);
+    } else {
+        const int32_t finish_chunk = vk_aliked_sddh_finish_chunk();
+        for (int32_t chunk = 0; chunk < num_batches; chunk += finish_chunk) {
+            const int32_t chunk_batches =
+                std::min(finish_chunk, num_batches - chunk);
+            ggml_pipeline_request_descriptor_sets(ctx, pipes.sddh,
+                                                  static_cast<uint32_t>(chunk_batches));
+            for (int32_t b = 0; b < chunk_batches; ++b) {
+                const int32_t batch_idx = chunk + b;
+                const int32_t start = batch_idx * batch_size;
+                const int32_t batch = std::min(batch_size, count - start);
+                if (b > 0) {
+                    vk_aliked_compute_barrier(ctx);
+                }
+                dispatch_batch(start, batch);
+            }
+            if (chunk + finish_chunk < num_batches) {
+                vk_aliked_compute_barrier(ctx);
+            }
+            vk_aliked_finish(ctx);
+        }
+    }
+    ggml_backend_synchronize(backend);
+    return true;
+}
