+        (uint32_t) (get_misalign_bytes(ctx, offset) / sizeof(float)),
+        (uint32_t) (get_misalign_bytes(ctx, modulator) / sizeof(float)),
+        (uint32_t) (get_misalign_bytes(ctx, regular) / sizeof(uint16_t)),
+        (uint32_t) (get_misalign_bytes(ctx, bias) / sizeof(float)),
+        (uint32_t) (get_misalign_bytes(ctx, dst) / sizeof(float)),
