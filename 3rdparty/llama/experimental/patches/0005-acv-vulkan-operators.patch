diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_deform_conv.comp b/src/ggml-vulkan/vulkan-shaders/aliked_deform_conv.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_deform_conv.comp
@@ -0,0 +1,123 @@
+#version 450
+
+layout(push_constant) uniform parameter {
+    uint ic;
+    uint ih;
+    uint iw;
+    uint oc;
+    uint kh;
+    uint kw;
+    uint pad;
+    uint has_bias;
+    uint mem_layout; // 0 = NCHW, 1 = WHCN
+    uint input_off;
+    uint offset_off;
+    uint weight_off;
+    uint bias_off;
+    uint output_off;
+} p;
+
+layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Input { float data_in[]; };
+layout(binding = 1) readonly buffer Offset { float data_off[]; };
+layout(binding = 2) readonly buffer Weight { float data_w[]; };
+layout(binding = 3) readonly buffer Bias { float data_bias[]; };
+layout(binding = 4) writeonly buffer Output { float data_out[]; };
+
+int index_whcn(int x, int y, int c) {
+    return x + y * int(p.iw) + c * int(p.ih * p.iw);
+}
+
+int index_nchw(int c, int y, int x) {
+    return c * int(p.ih * p.iw) + y * int(p.iw) + x;
+}
+
+float bilinear_sample_whcn(int c, float y, float x) {
+    if (y <= -1.0 || y >= float(p.ih) || x <= -1.0 || x >= float(p.iw)) {
+        return 0.0;
+    }
+    int y0 = int(floor(y));
+    int x0 = int(floor(x));
+    int y1 = y0 + 1;
+    int x1 = x0 + 1;
+    float ly = y - float(y0);
+    float lx = x - float(x0);
+    float hy = 1.0 - ly;
+    float hx = 1.0 - lx;
+
+    float v00 = (y0 >= 0 && y0 < int(p.ih) && x0 >= 0 && x0 < int(p.iw))
+        ? data_in[p.input_off + index_whcn(x0, y0, c)] : 0.0;
+    float v01 = (y0 >= 0 && y0 < int(p.ih) && x1 >= 0 && x1 < int(p.iw))
+        ? data_in[p.input_off + index_whcn(x1, y0, c)] : 0.0;
+    float v10 = (y1 >= 0 && y1 < int(p.ih) && x0 >= 0 && x0 < int(p.iw))
+        ? data_in[p.input_off + index_whcn(x0, y1, c)] : 0.0;
+    float v11 = (y1 >= 0 && y1 < int(p.ih) && x1 >= 0 && x1 < int(p.iw))
+        ? data_in[p.input_off + index_whcn(x1, y1, c)] : 0.0;
+
+    return hy * hx * v00 + hy * lx * v01 + ly * hx * v10 + ly * lx * v11;
+}
+
+float bilinear_sample_nchw(int c, float y, float x) {
+    if (y <= -1.0 || y >= float(p.ih) || x <= -1.0 || x >= float(p.iw)) {
+        return 0.0;
+    }
+    int y0 = int(floor(y));
+    int x0 = int(floor(x));
+    int y1 = y0 + 1;
+    int x1 = x0 + 1;
+    float ly = y - float(y0);
+    float lx = x - float(x0);
+    float hy = 1.0 - ly;
+    float hx = 1.0 - lx;
+
+    float v00 = (y0 >= 0 && y0 < int(p.ih) && x0 >= 0 && x0 < int(p.iw))
+        ? data_in[p.input_off + index_nchw(c, y0, x0)] : 0.0;
+    float v01 = (y0 >= 0 && y0 < int(p.ih) && x1 >= 0 && x1 < int(p.iw))
+        ? data_in[p.input_off + index_nchw(c, y0, x1)] : 0.0;
+    float v10 = (y1 >= 0 && y1 < int(p.ih) && x0 >= 0 && x0 < int(p.iw))
+        ? data_in[p.input_off + index_nchw(c, y1, x0)] : 0.0;
+    float v11 = (y1 >= 0 && y1 < int(p.ih) && x1 >= 0 && x1 < int(p.iw))
+        ? data_in[p.input_off + index_nchw(c, y1, x1)] : 0.0;
+
+    return hy * hx * v00 + hy * lx * v01 + ly * hx * v10 + ly * lx * v11;
+}
+
+float bilinear_sample(int c, float y, float x) {
+    if (p.mem_layout == 1u) {
+        return bilinear_sample_whcn(c, y, x);
+    }
+    return bilinear_sample_nchw(c, y, x);
+}
+
+void main() {
+    uint ox = gl_GlobalInvocationID.x;
+    uint oy = gl_GlobalInvocationID.y;
+    uint o = gl_GlobalInvocationID.z;
+    if (ox >= p.iw || oy >= p.ih || o >= p.oc) {
+        return;
+    }
+
+    float sum = (p.has_bias != 0u) ? data_bias[p.bias_off + o] : 0.0;
+    for (uint i = 0u; i < p.ic; ++i) {
+        for (uint ky = 0u; ky < p.kh; ++ky) {
+            for (uint kx = 0u; kx < p.kw; ++kx) {
+                uint k_idx = ky * p.kw + kx;
+                uint off_c_y = k_idx * 2u + 0u;
+                uint off_c_x = k_idx * 2u + 1u;
+                float sample_y = float(int(oy) - int(p.pad) + int(ky)) +
+                    data_off[p.offset_off + (p.mem_layout == 1u
+                        ? index_whcn(int(ox), int(oy), int(off_c_y))
+                        : index_nchw(int(off_c_y), int(oy), int(ox)))];
+                float sample_x = float(int(ox) - int(p.pad) + int(kx)) +
+                    data_off[p.offset_off + (p.mem_layout == 1u
+                        ? index_whcn(int(ox), int(oy), int(off_c_x))
+                        : index_nchw(int(off_c_x), int(oy), int(ox)))];
+                uint widx = o * p.ic * p.kh * p.kw + i * p.kh * p.kw + ky * p.kw + kx;
+                sum += bilinear_sample(int(i), sample_y, sample_x) * data_w[p.weight_off + widx];
+            }
+        }
+    }
+    data_out[p.output_off + (p.mem_layout == 1u ? index_whcn(int(ox), int(oy), int(o))
+                           : index_nchw(int(o), int(oy), int(ox)))] = sum;
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_dense_copy.comp b/src/ggml-vulkan/vulkan-shaders/aliked_dense_copy.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_dense_copy.comp
@@ -0,0 +1,32 @@
+#version 450
+
+layout(push_constant) uniform parameter {
+    uint w;
+    uint h;
+    uint c;
+    uint src_nb0;
+    uint src_nb1;
+    uint src_nb2;
+    uint src_off;
+} p;
+
+layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Src { float data_src[]; };
+layout(binding = 1) writeonly buffer Dst { float data_dst[]; };
+
+float read_src(uint x, uint y, uint ch) {
+    uint byte_off = x * p.src_nb0 + y * p.src_nb1 + ch * p.src_nb2;
+    return data_src[p.src_off + byte_off / 4u];
+}
+
+void main() {
+    uint x = gl_GlobalInvocationID.x;
+    uint y = gl_GlobalInvocationID.y;
+    uint ch = gl_GlobalInvocationID.z;
+    if (x >= p.w || y >= p.h || ch >= p.c) {
+        return;
+    }
+    uint dst_idx = x + y * p.w + ch * p.h * p.w;
+    data_dst[dst_idx] = read_src(x, y, ch);
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_dkd_elem.comp b/src/ggml-vulkan/vulkan-shaders/aliked_dkd_elem.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_dkd_elem.comp
@@ -0,0 +1,63 @@
+#version 450
+
+// op: 0 compare_equal_mask, 1 threshold_positive, 2 suppress_scores,
+//     3 update_max_mask, 4 apply_max_mask, 5 zero_border, 6 copy
+
+layout(push_constant) uniform parameter {
+    uint count;
+    uint h;
+    uint w;
+    uint radius;
+    uint op;
+    uint a_off;
+    uint b_off;
+    uint c_off;
+    uint d_off;
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer A { float data_a[]; };
+layout(binding = 1) readonly buffer B { float data_b[]; };
+layout(binding = 2) buffer C { float data_c[]; };
+layout(binding = 3) buffer D { float data_d[]; };
+
+void main() {
+    uint i = gl_GlobalInvocationID.x;
+    if (p.op == 5u) {
+        uint x = gl_GlobalInvocationID.x;
+        uint y = gl_GlobalInvocationID.y;
+        if (x >= p.w || y >= p.h) {
+            return;
+        }
+        uint idx = y * p.w + x;
+        if (y < p.radius || x < p.radius || y >= p.h - p.radius || x >= p.w - p.radius) {
+            data_c[p.c_off + idx] = 0.0;
+        }
+        return;
+    }
+
+    if (i >= p.count) {
+        return;
+    }
+
+    if (p.op == 0u) {
+        data_c[p.c_off + i] = abs(data_a[p.a_off + i] - data_b[p.b_off + i]) <= 1e-6 ? 1.0 : 0.0;
+    } else if (p.op == 1u) {
+        data_c[p.c_off + i] = data_a[p.a_off + i] > 0.0 ? 1.0 : 0.0;
+    } else if (p.op == 2u) {
+        if (data_a[p.a_off + i] > 0.0) {
+            data_c[p.c_off + i] = 0.0;
+        }
+    } else if (p.op == 3u) {
+        if (abs(data_c[p.c_off + i] - data_a[p.a_off + i]) <= 1e-6) {
+            data_d[p.d_off + i] = 1.0;
+        } else if (data_b[p.b_off + i] <= 0.0) {
+            data_d[p.d_off + i] = 0.0;
+        }
+    } else if (p.op == 4u) {
+        data_c[p.c_off + i] = data_b[p.b_off + i] > 0.0 ? data_a[p.a_off + i] : 0.0;
+    } else if (p.op == 6u) {
+        data_c[p.c_off + i] = data_a[p.a_off + i];
+    }
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_dkd_refine.comp b/src/ggml-vulkan/vulkan-shaders/aliked_dkd_refine.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_dkd_refine.comp
@@ -0,0 +1,122 @@
+#version 450
+
+const float kDkdTemperature = 0.1;
+
+layout(push_constant) uniform parameter {
+    uint count;
+    uint h;
+    uint w;
+    uint radius;
+    uint score_off;
+    uint indices_off;
+    uint keypoints_off;
+    uint scores_off;
+} p;
+
+layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer ScoreMap { float score_map[]; };
+layout(binding = 1) readonly buffer Indices { float indices[]; };
+layout(binding = 2) writeonly buffer KeypointsNorm { float keypoints_norm[]; };
+layout(binding = 3) writeonly buffer ScoresOut { float scores_out[]; };
+
+bool is_finite(float v) {
+    return (v == v) && abs(v) < 1e30;
+}
+
+bool is_valid_sample(float y, float x) {
+    return is_finite(y) && is_finite(x) && y > -1.0 && y < float(p.h) && x > -1.0 && x < float(p.w);
+}
+
+float bilinear_sample_score(float y, float x) {
+    if (!is_valid_sample(y, x)) {
+        return 0.0;
+    }
+    int y0 = int(floor(y));
+    int x0 = int(floor(x));
+    int y1 = min(y0 + 1, int(p.h) - 1);
+    int x1 = min(x0 + 1, int(p.w) - 1);
+    float ly = y - float(y0);
+    float lx = x - float(x0);
+    float hy = 1.0 - ly;
+    float hx = 1.0 - lx;
+
+    float v00 = score_map[p.score_off + uint(y0) * p.w + uint(x0)];
+    float v01 = score_map[p.score_off + uint(y0) * p.w + uint(x1)];
+    float v10 = score_map[p.score_off + uint(y1) * p.w + uint(x0)];
+    float v11 = score_map[p.score_off + uint(y1) * p.w + uint(x1)];
+    return hy * hx * v00 + hy * lx * v01 + ly * hx * v10 + ly * lx * v11;
+}
+
+void main() {
+    uint k = gl_WorkGroupID.x;
+    if (k >= p.count) {
+        return;
+    }
+
+    int index = int(indices[p.indices_off + k]);
+    int x_nms = index % int(p.w);
+    int y_nms = index / int(p.w);
+    int kernel = int(p.radius) * 2 + 1;
+    int kernel_area = kernel * kernel;
+
+    float patch_scores[25];
+    float hw_grid[50];
+    int idx = 0;
+    for (int ky = -int(p.radius); ky <= int(p.radius); ++ky) {
+        for (int kx = -int(p.radius); kx <= int(p.radius); ++kx) {
+            int py = clamp(y_nms + ky, 0, int(p.h) - 1);
+            int px = clamp(x_nms + kx, 0, int(p.w) - 1);
+            patch_scores[idx] = score_map[p.score_off + uint(py) * p.w + uint(px)];
+            hw_grid[idx * 2 + 0] = float(kx);
+            hw_grid[idx * 2 + 1] = float(ky);
+            ++idx;
+        }
+    }
+
+    float max_v = patch_scores[0];
+    for (int i = 1; i < kernel_area; ++i) {
+        max_v = max(max_v, patch_scores[i]);
+    }
+
+    float exp_sum = 0.0;
+    float x_exp[25];
+    for (int i = 0; i < kernel_area; ++i) {
+        x_exp[i] = exp((patch_scores[i] - max_v) / kDkdTemperature);
+        exp_sum += x_exp[i];
+    }
+    exp_sum = max(exp_sum, 1e-12);
+
+    float residual_x = 0.0;
+    float residual_y = 0.0;
+    for (int i = 0; i < kernel_area; ++i) {
+        float weight = x_exp[i] / exp_sum;
+        residual_x += weight * hw_grid[i * 2 + 0];
+        residual_y += weight * hw_grid[i * 2 + 1];
+    }
+
+    float wh_x = float(p.w - 1u);
+    float wh_y = float(p.h - 1u);
+    if (!is_finite(wh_x) || !is_finite(wh_y) || wh_x <= 0.0 || wh_y <= 0.0) {
+        keypoints_norm[p.keypoints_off + k * 2u + 0u] = 0.0;
+        keypoints_norm[p.keypoints_off + k * 2u + 1u] = 0.0;
+        scores_out[p.scores_off + k] = 0.0;
+        return;
+    }
+
+    float x = (float(x_nms) + residual_x) / wh_x * 2.0 - 1.0;
+    float y = (float(y_nms) + residual_y) / wh_y * 2.0 - 1.0;
+    if (!is_finite(x) || !is_finite(y)) {
+        keypoints_norm[p.keypoints_off + k * 2u + 0u] = 0.0;
+        keypoints_norm[p.keypoints_off + k * 2u + 1u] = 0.0;
+        scores_out[p.scores_off + k] = 0.0;
+        return;
+    }
+
+    keypoints_norm[p.keypoints_off + k * 2u + 0u] = x;
+    keypoints_norm[p.keypoints_off + k * 2u + 1u] = y;
+
+    float sample_x = (x + 1.0) * 0.5 * wh_x;
+    float sample_y = (y + 1.0) * 0.5 * wh_y;
+    scores_out[p.scores_off + k] = bilinear_sample_score(sample_y, sample_x);
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_l2norm.comp b/src/ggml-vulkan/vulkan-shaders/aliked_l2norm.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_l2norm.comp
@@ -0,0 +1,37 @@
+#version 450
+
+layout(push_constant) uniform parameter {
+    uint channels;
+    uint h;
+    uint w;
+    uint data_off;
+    uint nb0;
+    uint nb1;
+    uint nb2;
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) buffer Data { float data[]; };
+
+void main() {
+    uint spatial_idx = gl_GlobalInvocationID.x;
+    uint spatial = p.h * p.w;
+    if (spatial_idx >= spatial) {
+        return;
+    }
+
+    uint x = spatial_idx % p.w;
+    uint y = spatial_idx / p.w;
+    float norm2 = 0.0;
+    for (uint c = 0u; c < p.channels; ++c) {
+        uint byte_off = x * p.nb0 + y * p.nb1 + c * p.nb2;
+        float value = data[p.data_off + byte_off / 4u];
+        norm2 += value * value;
+    }
+    float norm = sqrt(max(norm2, 1e-12));
+    for (uint c = 0u; c < p.channels; ++c) {
+        uint byte_off = x * p.nb0 + y * p.nb1 + c * p.nb2;
+        data[p.data_off + byte_off / 4u] /= norm;
+    }
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_layout_convert.comp b/src/ggml-vulkan/vulkan-shaders/aliked_layout_convert.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_layout_convert.comp
@@ -0,0 +1,37 @@
+#version 450
+
+layout(push_constant) uniform parameter {
+    uint c;
+    uint h;
+    uint w;
+    uint mode; // 0: WHCN->NCHW, 1: NCHW->WHCN
+} p;
+
+layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Src { float data_src[]; };
+layout(binding = 1) writeonly buffer Dst { float data_dst[]; };
+
+int index_nchw(int ch, int y, int x) {
+    return ch * int(p.h * p.w) + y * int(p.w) + x;
+}
+
+int index_whcn(int x, int y, int ch) {
+    return x + y * int(p.w) + ch * int(p.h * p.w);
+}
+
+void main() {
+    uint x = gl_GlobalInvocationID.x;
+    uint y = gl_GlobalInvocationID.y;
+    uint ch = gl_GlobalInvocationID.z;
+    if (x >= p.w || y >= p.h || ch >= p.c) {
+        return;
+    }
+    if (p.mode == 0u) {
+        data_dst[index_nchw(int(ch), int(y), int(x))] =
+            data_src[index_whcn(int(x), int(y), int(ch))];
+    } else {
+        data_dst[index_whcn(int(x), int(y), int(ch))] =
+            data_src[index_nchw(int(ch), int(y), int(x))];
+    }
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_max_pool.comp b/src/ggml-vulkan/vulkan-shaders/aliked_max_pool.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_max_pool.comp
@@ -0,0 +1,34 @@
+#version 450
+
+layout(push_constant) uniform parameter {
+    uint h;
+    uint w;
+    int pad;
+    uint input_off;
+    uint output_off;
+} p;
+
+layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Input { float data_in[]; };
+layout(binding = 1) writeonly buffer Output { float data_out[]; };
+
+void main() {
+    uint x = gl_GlobalInvocationID.x;
+    uint y = gl_GlobalInvocationID.y;
+    if (x >= p.w || y >= p.h) {
+        return;
+    }
+
+    float best = -3.402823466e+38;
+    for (int ky = -p.pad; ky <= p.pad; ++ky) {
+        for (int kx = -p.pad; kx <= p.pad; ++kx) {
+            int iy = int(y) + ky;
+            int ix = int(x) + kx;
+            if (iy >= 0 && ix >= 0 && iy < int(p.h) && ix < int(p.w)) {
+                best = max(best, data_in[p.input_off + uint(iy) * p.w + uint(ix)]);
+            }
+        }
+    }
+    data_out[p.output_off + y * p.w + x] = best;
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_sddh.comp b/src/ggml-vulkan/vulkan-shaders/aliked_sddh.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_sddh.comp
@@ -0,0 +1,246 @@
+#version 450
+
+const float kSeluScale = 1.050700987;
+const float kSeluAlpha = 1.67326324;
+
+layout(push_constant) uniform parameter {
+    uint dim;
+    uint h;
+    uint w;
+    uint count;
+    uint kernel_size;
+    uint n_pos;
+    uint feature_off;
+    uint kpt_off;
+    uint workspace_off;
+    uint desc_off;
+    uint k_offset;
+    uint batch_count;
+    uint src_nb0;
+    uint src_nb1;
+    uint src_nb2;
+    uint off0_w;
+    uint off0_b;
+    uint off2_w;
+    uint off2_b;
+    uint sf_w;
+    uint agg_w;
+} p;
+
+layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer FeatureMap { float feature_map[]; };
+layout(binding = 1) readonly buffer KeypointsNorm { float keypoints_norm[]; };
+layout(binding = 2) readonly buffer Offset0W { float offset_0_w[]; };
+layout(binding = 3) readonly buffer Offset0B { float offset_0_b[]; };
+layout(binding = 4) readonly buffer Offset2W { float offset_2_w[]; };
+layout(binding = 5) readonly buffer Offset2B { float offset_2_b[]; };
+layout(binding = 6) readonly buffer SfConvW { float sf_conv_w[]; };
+layout(binding = 7) readonly buffer AggWeights { float agg_weights[]; };
+layout(binding = 8) buffer Workspace { float workspace[]; };
+layout(binding = 9) buffer Descriptors { float descriptors[]; };
+
+shared float norm_partial[128];
+
+float selu(float x) {
+    return x > 0.0 ? kSeluScale * x : kSeluScale * kSeluAlpha * (exp(x) - 1.0);
+}
+
+bool is_finite(float v) {
+    return (v == v) && abs(v) < 1e30;
+}
+
+bool is_valid_sample(float py, float px) {
+    return is_finite(py) && is_finite(px) && py > -1.0 && py < float(p.h) && px > -1.0 && px < float(p.w);
+}
+
+float read_feature(int c, int y, int x) {
+    if (c < 0 || uint(c) >= p.dim || y < 0 || uint(y) >= p.h || x < 0 ||
+        uint(x) >= p.w) {
+        return 0.0;
+    }
+    uint byte_off = uint(x) * p.src_nb0 + uint(y) * p.src_nb1 + uint(c) * p.src_nb2;
+    return feature_map[p.feature_off + byte_off / 4u];
+}
+
+float bilinear_sample_feature(int c, float py, float px) {
+    if (!is_finite(py) || !is_finite(px) || p.h <= 0u || p.w <= 0u) {
+        return 0.0;
+    }
+    float clamped_y = clamp(py, 0.0, float(p.h - 1u));
+    float clamped_x = clamp(px, 0.0, float(p.w - 1u));
+    int y0 = int(floor(clamped_y));
+    int x0 = int(floor(clamped_x));
+    int y1 = min(y0 + 1, int(p.h) - 1);
+    int x1 = min(x0 + 1, int(p.w) - 1);
+    float ly = clamped_y - float(y0);
+    float lx = clamped_x - float(x0);
+    float hy = 1.0 - ly;
+    float hx = 1.0 - lx;
+
+    float v00 = read_feature(c, y0, x0);
+    float v01 = read_feature(c, y0, x1);
+    float v10 = read_feature(c, y1, x0);
+    float v11 = read_feature(c, y1, x1);
+    return hy * hx * v00 + hy * lx * v01 + ly * hx * v10 + ly * lx * v11;
+}
+
+void main() {
+    uint local_k = gl_WorkGroupID.x;
+    if (local_k >= p.batch_count) {
+        return;
+    }
+    uint k = p.k_offset + local_k;
+    uint lane = gl_LocalInvocationID.x;
+    uint lanes = gl_WorkGroupSize.x;
+
+    float x_norm = keypoints_norm[p.kpt_off + k * 2u + 0u];
+    float y_norm = keypoints_norm[p.kpt_off + k * 2u + 1u];
+    if (!is_finite(x_norm) || !is_finite(y_norm)) {
+        for (uint c = lane; c < p.dim; c += lanes) {
+            descriptors[p.desc_off + k * p.dim + c] = 0.0;
+        }
+        return;
+    }
+
+    uint patch_size = p.dim * p.kernel_size * p.kernel_size;
+    uint stride = patch_size + 64u + p.dim * 3u;
+    uint base = p.workspace_off + k * stride;
+
+    float wh_x = max(float(p.w - 1u), 1.0);
+    float wh_y = max(float(p.h - 1u), 1.0);
+    float max_offset = float(max(p.h, p.w)) / 4.0;
+    int pad = int(p.kernel_size / 2u);
+
+    float x_wh = (x_norm / 2.0 + 0.5) * float(p.w - 1u);
+    float y_wh = (y_norm / 2.0 + 0.5) * float(p.h - 1u);
+
+    if (p.kernel_size > 1u) {
+        int x0 = clamp(int(round(x_wh)) - pad, 0, max(int(p.w) - int(p.kernel_size), 0));
+        int y0 = clamp(int(round(y_wh)) - pad, 0, max(int(p.h) - int(p.kernel_size), 0));
+        for (uint c = lane; c < p.dim; c += lanes) {
+            for (uint ky = 0u; ky < p.kernel_size; ++ky) {
+                for (uint kx = 0u; kx < p.kernel_size; ++kx) {
+                    workspace[base + c * p.kernel_size * p.kernel_size + ky * p.kernel_size + kx] =
+                        read_feature(int(c), y0 + int(ky), x0 + int(kx));
+                }
+            }
+        }
+    } else {
+        int xi = clamp(int(round(x_wh)), 0, int(p.w) - 1);
+        int yi = clamp(int(round(y_wh)), 0, int(p.h) - 1);
+        for (uint c = lane; c < p.dim; c += lanes) {
+            workspace[base + c] = read_feature(int(c), yi, xi);
+        }
+    }
+
+    memoryBarrierBuffer();
+    barrier();
+
+    uint off_raw_base = base + patch_size;
+    uint off_final_base = off_raw_base + 32u;
+    uint sampled_base = off_final_base + 32u;
+    uint transformed_base = sampled_base + p.dim;
+    uint desc_base = transformed_base + p.dim;
+
+    for (uint oc = lane; oc < 32u; oc += lanes) {
+        float sum = offset_0_b[p.off0_b + oc];
+        for (uint ic = 0u; ic < p.dim; ++ic) {
+            for (uint ky = 0u; ky < p.kernel_size; ++ky) {
+                for (uint kx = 0u; kx < p.kernel_size; ++kx) {
+                    uint widx = oc * p.dim * p.kernel_size * p.kernel_size +
+                        ic * p.kernel_size * p.kernel_size + ky * p.kernel_size + kx;
+                    sum += workspace[base + ic * p.kernel_size * p.kernel_size + ky * p.kernel_size + kx] *
+                        offset_0_w[p.off0_w + widx];
+                }
+            }
+        }
+        workspace[off_raw_base + oc] = selu(sum);
+    }
+
+    memoryBarrierBuffer();
+    barrier();
+
+    for (uint oc = lane; oc < 32u; oc += lanes) {
+        float sum = offset_2_b[p.off2_b + oc];
+        for (uint ic = 0u; ic < 32u; ++ic) {
+            sum += workspace[off_raw_base + ic] *
+                offset_2_w[p.off2_w + oc * 32u + ic];
+        }
+        workspace[off_final_base + oc] = sum;
+    }
+
+    memoryBarrierBuffer();
+    barrier();
+
+    for (uint c = lane; c < p.dim; c += lanes) {
+        workspace[desc_base + c] = 0.0;
+    }
+
+    memoryBarrierBuffer();
+    barrier();
+
+    for (uint pos = 0u; pos < p.n_pos; ++pos) {
+        float raw_off_x = workspace[off_final_base + pos];
+        float raw_off_y = workspace[off_final_base + p.n_pos + pos];
+        if (!is_finite(raw_off_x) || !is_finite(raw_off_y)) {
+            continue;
+        }
+        float off_x = clamp(raw_off_x, -max_offset, max_offset);
+        float off_y = clamp(raw_off_y, -max_offset, max_offset);
+        float sample_x = (x_wh + off_x) / wh_x * 2.0 - 1.0;
+        float sample_y = (y_wh + off_y) / wh_y * 2.0 - 1.0;
+        if (!is_finite(sample_x) || !is_finite(sample_y)) {
+            continue;
+        }
+        float px = (sample_x + 1.0) * 0.5 * wh_x;
+        float py = (sample_y + 1.0) * 0.5 * wh_y;
+
+        for (uint c = lane; c < p.dim; c += lanes) {
+            workspace[sampled_base + c] = bilinear_sample_feature(int(c), py, px);
+        }
+
+        memoryBarrierBuffer();
+        barrier();
+
+        for (uint c = lane; c < p.dim; c += lanes) {
+            float value = 0.0;
+            for (uint ic = 0u; ic < p.dim; ++ic) {
+                value += workspace[sampled_base + ic] *
+                    sf_conv_w[p.sf_w + c * p.dim + ic];
+            }
+            workspace[transformed_base + c] = selu(value);
+        }
+
+        memoryBarrierBuffer();
+        barrier();
+
+        for (uint c = lane; c < p.dim; c += lanes) {
+            for (uint ic = 0u; ic < p.dim; ++ic) {
+                workspace[desc_base + c] += workspace[transformed_base + ic] *
+                    agg_weights[p.agg_w + pos * p.dim * p.dim + ic * p.dim + c];
+            }
+        }
+
+        memoryBarrierBuffer();
+        barrier();
+    }
+
+    float lane_norm = 0.0;
+    for (uint c = lane; c < p.dim; c += lanes) {
+        float value = workspace[desc_base + c];
+        lane_norm += value * value;
+    }
+    norm_partial[lane] = lane_norm;
+    barrier();
+    for (uint stride = lanes / 2u; stride > 0u; stride /= 2u) {
+        if (lane < stride) {
+            norm_partial[lane] += norm_partial[lane + stride];
+        }
+        barrier();
+    }
+    float norm = sqrt(max(norm_partial[0], 1e-12));
+    for (uint c = lane; c < p.dim; c += lanes) {
+        descriptors[p.desc_off + k * p.dim + c] = workspace[desc_base + c] / norm;
+    }
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_upsample_bilinear.comp b/src/ggml-vulkan/vulkan-shaders/aliked_upsample_bilinear.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_upsample_bilinear.comp
@@ -0,0 +1,59 @@
+#version 450
+
+// WHCN bilinear upsample — matches ALIKED UpsampleBilinear / CUDA UpsampleBilinearKernel.
+layout(push_constant) uniform parameter {
+    uint ic;
+    uint ih;
+    uint iw;
+    uint out_h;
+    uint out_w;
+    uint src_off;
+    uint dst_off;
+} p;
+
+layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Src { float data_src[]; };
+layout(binding = 1) writeonly buffer Dst { float data_dst[]; };
+
+int whcn_index(int x, int y, int ch, int h, int w) {
+    return x + y * w + ch * h * w;
+}
+
+float sample_at(int x, int y, int ch) {
+    return data_src[p.src_off + uint(whcn_index(x, y, ch, int(p.ih), int(p.iw)))];
+}
+
+void main() {
+    uint ox = gl_GlobalInvocationID.x;
+    uint oy = gl_GlobalInvocationID.y;
+    uint ch = gl_GlobalInvocationID.z;
+    if (ox >= p.out_w || oy >= p.out_h || ch >= p.ic) {
+        return;
+    }
+
+    float scale_y = p.out_h > 1u ? float(p.ih - 1u) / float(p.out_h - 1u) : 0.0;
+    float scale_x = p.out_w > 1u ? float(p.iw - 1u) / float(p.out_w - 1u) : 0.0;
+    float in_y = float(oy) * scale_y;
+    float in_x = float(ox) * scale_x;
+    in_y = clamp(in_y, 0.0, float(p.ih - 1u));
+    in_x = clamp(in_x, 0.0, float(p.iw - 1u));
+
+    int y0 = int(floor(in_y));
+    int x0 = int(floor(in_x));
+    int y1 = min(y0 + 1, int(p.ih) - 1);
+    int x1 = min(x0 + 1, int(p.iw) - 1);
+    float ly = in_y - float(y0);
+    float lx = in_x - float(x0);
+    float hy = 1.0 - ly;
+    float hx = 1.0 - lx;
+
+    int c = int(ch);
+    float v00 = sample_at(x0, y0, c);
+    float v01 = sample_at(x1, y0, c);
+    float v10 = sample_at(x0, y1, c);
+    float v11 = sample_at(x1, y1, c);
+    float v = hy * hx * v00 + hy * lx * v01 + ly * hx * v10 + ly * lx * v11;
+
+    data_dst[p.dst_off + uint(whcn_index(int(ox), int(oy), c, int(p.out_h), int(p.out_w)))] = v;
+}
