diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_affine_relu.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_affine_relu.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_affine_relu.comp
@@ -0,0 +1,30 @@
+#version 450
+
+// Fused BatchNorm affine transform and ReLU for decoder feature maps.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint b_offset;
+    uint c_offset;
+    uint d_offset;
+    uint width;
+    uint height;
+    uint channels;
+    uint relu;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) readonly buffer B { float data_b[]; };
+layout (binding = 2) readonly buffer C { float data_c[]; };
+layout (binding = 3) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    const uint total = p.width * p.height * p.channels;
+    if (idx >= total) return;
+    const uint channel = idx / (p.width * p.height);
+    const float value = data_a[p.a_offset + idx] * data_b[p.b_offset + channel] +
+                        data_c[p.c_offset + channel];
+    data_d[p.d_offset + idx] = p.relu != 0 ? max(0.0, value) : value;
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_deform_im2col.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_deform_im2col.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_deform_im2col.comp
@@ -0,0 +1,59 @@
+#version 450
+
+// RMBG deformable sampling is indexed independently for every output element.
+// Materializing it with generic graph nodes creates a C*K by H*W tensor through
+// many layout and gather operations. This computes the identical bilinear sample
+// directly into that tensor, retaining F32 arithmetic for the parity path.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint b_offset;
+    uint c_offset;
+    uint d_offset;
+    uint width;
+    uint height;
+    uint channels;
+    uint kernel_w;
+    uint kernel_h;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) readonly buffer B { float data_b[]; };
+layout (binding = 2) readonly buffer C { float data_c[]; };
+layout (binding = 3) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+float sample_input(const int y, const int x, const uint channel) {
+    if (y < 0 || y >= int(p.height) || x < 0 || x >= int(p.width)) return 0.0;
+    const uint hw = p.height * p.width;
+    return data_a[p.a_offset + uint(x) + p.width * uint(y) + hw * channel];
+}
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    const uint hw = p.height * p.width;
+    const uint kernel = p.kernel_h * p.kernel_w;
+    const uint total = hw * p.channels * kernel;
+    if (idx >= total) return;
+
+    const uint kc = idx % (p.channels * kernel);
+    const uint pos = idx / (p.channels * kernel);
+    const uint k = kc % kernel;
+    const uint channel = kc / kernel;
+    const uint y_base = pos / p.width;
+    const uint x_base = pos - y_base * p.width;
+    const float y = float(y_base) + float(k / p.kernel_w) - float(p.kernel_h / 2u) +
+        data_b[p.b_offset + pos + hw * (2u * k)];
+    const float x = float(x_base) + float(k % p.kernel_w) - float(p.kernel_w / 2u) +
+        data_b[p.b_offset + pos + hw * (2u * k + 1u)];
+    const int y0 = int(floor(y));
+    const int x0 = int(floor(x));
+    const float dy = y - float(y0);
+    const float dx = x - float(x0);
+    float value = sample_input(y0, x0, channel) * (1.0 - dy) * (1.0 - dx);
+    value += sample_input(y0, x0 + 1, channel) * (1.0 - dy) * dx;
+    value += sample_input(y0 + 1, x0, channel) * dy * (1.0 - dx);
+    value += sample_input(y0 + 1, x0 + 1, channel) * dy * dx;
+    const float modulator = data_c[p.c_offset + pos + hw * k];
+    data_d[p.d_offset + idx] = value * (2.0 / (1.0 + exp(-modulator)));
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_deform_project.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_deform_project.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_deform_project.comp
@@ -0,0 +1,103 @@
+#version 450
+
+// One workgroup owns one spatial position. It creates only a small C-tile of
+// bilinear samples in shared memory, then projects it directly to output
+// channels. No C*K by H*W column matrix is materialized.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint b_offset;
+    uint c_offset;
+    uint r_offset;
+    uint bias_offset;
+    uint d_offset;
+    uint width;
+    uint height;
+    uint channels;
+    uint out_channels;
+    uint kernel_w;
+    uint kernel_h;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) readonly buffer B { float data_b[]; };
+layout (binding = 2) readonly buffer C { float data_c[]; };
+// F16 checkpoint weights stay compact. They are expanded only at the F32
+// multiply, so the sampler is bandwidth-limited by activations rather than
+// an unnecessary F32 weight copy.
+layout (binding = 3) readonly buffer R { uint data_r[]; };
+layout (binding = 4) readonly buffer Bias { float data_bias[]; };
+layout (binding = 5) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+const uint CHANNEL_TILE = 8u;
+const uint MAX_KERNEL = 9u;
+shared float sample_y[MAX_KERNEL];
+shared float sample_x[MAX_KERNEL];
+shared float sample_mask[MAX_KERNEL];
+shared float samples[CHANNEL_TILE * MAX_KERNEL];
+
+float load_input(int y, int x, uint channel) {
+    if (y < 0 || y >= int(p.height) || x < 0 || x >= int(p.width)) return 0.0;
+    return data_a[p.a_offset + uint(x) + p.width * uint(y) +
+                  p.width * p.height * channel];
+}
+
+float sample_bilinear(float y, float x, uint channel) {
+    const int y0 = int(floor(y));
+    const int x0 = int(floor(x));
+    const float dy = y - float(y0);
+    const float dx = x - float(x0);
+    float value = load_input(y0, x0, channel) * (1.0 - dy) * (1.0 - dx);
+    value += load_input(y0, x0 + 1, channel) * (1.0 - dy) * dx;
+    value += load_input(y0 + 1, x0, channel) * dy * (1.0 - dx);
+    value += load_input(y0 + 1, x0 + 1, channel) * dy * dx;
+    return value;
+}
+
+float load_weight(uint index) {
+    const uint packed = data_r[(p.r_offset + index) / 2u];
+    const vec2 values = unpackHalf2x16(packed);
+    return ((p.r_offset + index) & 1u) == 0u ? values.x : values.y;
+}
+
+void main() {
+    const uint position = gl_WorkGroupID.x;
+    const uint tid = gl_LocalInvocationID.x;
+    const uint hw = p.width * p.height;
+    const uint kernel = p.kernel_w * p.kernel_h;
+    if (position >= hw || kernel > MAX_KERNEL) return;
+
+    if (tid < kernel) {
+        const uint y_base = position / p.width;
+        const uint x_base = position - y_base * p.width;
+        sample_y[tid] = float(y_base) + float(tid / p.kernel_w) - float(p.kernel_h / 2u) +
+            data_b[p.b_offset + position + hw * (2u * tid)];
+        sample_x[tid] = float(x_base) + float(tid % p.kernel_w) - float(p.kernel_w / 2u) +
+            data_b[p.b_offset + position + hw * (2u * tid + 1u)];
+        sample_mask[tid] = 2.0 / (1.0 + exp(-data_c[p.c_offset + position + hw * tid]));
+    }
+    barrier();
+
+    for (uint out_channel = tid; out_channel < p.out_channels; out_channel += 64u) {
+        float sum = data_bias[p.bias_offset + out_channel];
+        for (uint channel_base = 0u; channel_base < p.channels; channel_base += CHANNEL_TILE) {
+            const uint tile_channels = min(CHANNEL_TILE, p.channels - channel_base);
+            for (uint i = tid; i < tile_channels * kernel; i += 64u) {
+                const uint channel = channel_base + i / kernel;
+                const uint tap = i % kernel;
+                samples[i] = sample_bilinear(sample_y[tap], sample_x[tap], channel) * sample_mask[tap];
+            }
+            barrier();
+            for (uint local_channel = 0u; local_channel < tile_channels; ++local_channel) {
+                const uint channel = channel_base + local_channel;
+                for (uint tap = 0u; tap < kernel; ++tap) {
+                    const uint weight_index = tap + kernel * (channel + p.channels * out_channel);
+                    sum += samples[local_channel * kernel + tap] * load_weight(weight_index);
+                }
+            }
+            barrier();
+        }
+        data_d[p.d_offset + position + hw * out_channel] = sum;
+    }
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_deform_project_cm1.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_deform_project_cm1.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_deform_project_cm1.comp
@@ -0,0 +1,125 @@
+#version 450
+
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+#extension GL_KHR_cooperative_matrix : require
+#extension GL_KHR_memory_scope_semantics : require
+#extension GL_KHR_shader_subgroup_basic : require
+
+// The input samples are produced directly into a 16x16 F16 shared tile.
+// F16 is only the tile transport type; cooperative multiply accumulates F32.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint b_offset;
+    uint c_offset;
+    uint r_offset;
+    uint bias_offset;
+    uint d_offset;
+    uint width;
+    uint height;
+    uint channels;
+    uint out_channels;
+    uint kernel_w;
+    uint kernel_h;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) readonly buffer B { float data_b[]; };
+layout (binding = 2) readonly buffer C { float data_c[]; };
+layout (binding = 3) readonly buffer R { float16_t data_r[]; };
+layout (binding = 4) readonly buffer Bias { float data_bias[]; };
+layout (binding = 5) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+const uint TILE = 16u;
+const uint OUTPUT_TILES = 8u;
+// Cooperative-matrix loads use the same vec4-packed F16 layout as ggml's
+// established CM1 convolution and Flash Attention kernels.
+shared f16vec4 samples[TILE * TILE / 4u]; // [K tile, spatial-position]
+shared f16vec4 weights[OUTPUT_TILES * TILE * TILE / 4u];
+shared float projection[OUTPUT_TILES * TILE * TILE];
+
+float load_input(int y, int x, uint channel) {
+    if (y < 0 || y >= int(p.height) || x < 0 || x >= int(p.width)) return 0.0;
+    const uint hw = p.width * p.height;
+    return data_a[p.a_offset + uint(x) + p.width * uint(y) + hw * channel];
+}
+
+float sample_bilinear(uint position, uint channel, uint tap) {
+    const uint hw = p.width * p.height;
+    const uint y_base = position / p.width;
+    const uint x_base = position - y_base * p.width;
+    const float y = float(y_base) + float(tap / 3u) - 1.0 +
+        data_b[p.b_offset + position + hw * (2u * tap)];
+    const float x = float(x_base) + float(tap % 3u) - 1.0 +
+        data_b[p.b_offset + position + hw * (2u * tap + 1u)];
+    const int y0 = int(floor(y));
+    const int x0 = int(floor(x));
+    const float dy = y - float(y0);
+    const float dx = x - float(x0);
+    float value = load_input(y0,     x0,     channel) * (1.0 - dy) * (1.0 - dx);
+    value +=      load_input(y0,     x0 + 1, channel) * (1.0 - dy) * dx;
+    value +=      load_input(y0 + 1, x0,     channel) * dy * (1.0 - dx);
+    value +=      load_input(y0 + 1, x0 + 1, channel) * dy * dx;
+    const float modulator = data_c[p.c_offset + position + hw * tap];
+    return value * (2.0 / (1.0 + exp(-modulator)));
+}
+
+void main() {
+    const uint tile_position = gl_WorkGroupID.x * TILE;
+    const uint subgroup = gl_SubgroupID;
+    const uint tile_output = (gl_WorkGroupID.y * OUTPUT_TILES + subgroup) * TILE;
+    const uint tid = gl_LocalInvocationID.x;
+    const uint subgroup_tid = gl_SubgroupInvocationID;
+    const uint hw = p.width * p.height;
+    const uint k_total = p.channels * 9u;
+
+    coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator> sum =
+        coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>(0.0);
+
+    // k_total is a multiple of 16 for the eligible RMBG 3x3 layers.
+    for (uint k_base = 0; k_base < k_total; k_base += TILE) {
+        // The first subgroup produces the shared sample tile once.  All eight
+        // projection subgroups consume it for disjoint output-channel tiles.
+        if (subgroup == 0u) {
+            for (uint i = subgroup_tid; i < TILE * TILE / 4u; i += 32u) {
+                const uint scalar = 4u * i;
+                const uint k = k_base + scalar / TILE;
+                const uint position = tile_position + scalar % TILE;
+                samples[i] = f16vec4(
+                    float16_t(sample_bilinear(position + 0u, k / 9u, k % 9u)),
+                    float16_t(sample_bilinear(position + 1u, k / 9u, k % 9u)),
+                    float16_t(sample_bilinear(position + 2u, k / 9u, k % 9u)),
+                    float16_t(sample_bilinear(position + 3u, k / 9u, k % 9u)));
+            }
+        }
+        for (uint i = subgroup_tid; i < TILE * TILE / 4u; i += 32u) {
+            const uint scalar = 4u * i;
+            const uint out_channel = tile_output + scalar / TILE;
+            const uint weight_base = p.r_offset + out_channel * k_total + k_base + scalar % TILE;
+            weights[subgroup * (TILE * TILE / 4u) + i] =
+                f16vec4(data_r[weight_base + 0u], data_r[weight_base + 1u],
+                        data_r[weight_base + 2u], data_r[weight_base + 3u]);
+        }
+        barrier();
+
+        coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA> weight;
+        coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB> sample_mat;
+        coopMatLoad(weight, weights, subgroup * (TILE * TILE / 4u), TILE / 4u,
+                    gl_CooperativeMatrixLayoutRowMajor);
+        coopMatLoad(sample_mat, samples, 0, TILE / 4u, gl_CooperativeMatrixLayoutRowMajor);
+        sum = coopMatMulAdd(weight, sample_mat, sum);
+        barrier();
+    }
+
+    coopMatStore(sum, projection, subgroup * TILE * TILE, TILE,
+                 gl_CooperativeMatrixLayoutRowMajor);
+    barrier();
+    for (uint i = subgroup_tid; i < TILE * TILE; i += 32u) {
+        const uint out_channel = tile_output + i / TILE;
+        const uint position = tile_position + i % TILE;
+        data_d[p.d_offset + position + hw * out_channel] =
+            projection[subgroup * TILE * TILE + i] + data_bias[p.bias_offset + out_channel];
+    }
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_gather.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_gather.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_gather.comp
@@ -0,0 +1,60 @@
+#version 450
+
+// Exact F32 gathers used by RMBG's patch embedding and Swin patch merge. The
+// indices are implicit in the tensor shape, so this avoids a device index
+// tensor and a generic GET_ROWS dispatch without changing any values.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint d_offset;
+    uint channels;
+    uint height;
+    uint width;
+    uint patch_h;
+    uint patch_w;
+    uint kind;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+
+    if (p.kind == 0u) {
+        const uint row_width = p.width / 2u;
+        const uint row = idx / (4u * p.channels);
+        const uint component = idx - row * 4u * p.channels;
+        const uint group = component / p.channels;
+        const uint channel = component - group * p.channels;
+        if (row >= (p.height / 2u) * row_width) return;
+
+        const uint oh = row / row_width;
+        const uint ow = row - oh * row_width;
+        const uint positions[4] = uint[4](
+            (2u * oh) * p.width + 2u * ow,
+            (2u * oh + 1u) * p.width + 2u * ow,
+            (2u * oh) * p.width + 2u * ow + 1u,
+            (2u * oh + 1u) * p.width + 2u * ow + 1u);
+        data_d[p.d_offset + idx] = data_a[p.a_offset + channel + p.channels * positions[group]];
+        return;
+    }
+
+    const uint grid_h = p.height / p.patch_h;
+    const uint grid_w = p.width / p.patch_w;
+    const uint grid_count = grid_h * grid_w;
+    const uint patch_count = p.patch_h * p.patch_w;
+    const uint total = p.channels * grid_count * patch_count;
+    if (idx >= total) return;
+
+    const uint channel = idx % p.channels;
+    const uint grid_pos = (idx / p.channels) % grid_count;
+    const uint patch_pos = idx / (p.channels * grid_count);
+    const uint gh = grid_pos / grid_w;
+    const uint gw = grid_pos - gh * grid_w;
+    const uint hi = patch_pos / p.patch_w;
+    const uint wi = patch_pos - hi * p.patch_w;
+    const uint source = (gh * p.patch_h + hi) * p.width + gw * p.patch_w + wi;
+    data_d[p.d_offset + idx] = data_a[p.a_offset + source + p.width * p.height * channel];
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_swin_qkv_layout.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_swin_qkv_layout.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_swin_qkv_layout.comp
@@ -0,0 +1,37 @@
+#version 450
+
+// QKV bias, split, and head-major layout in one strict-F32 pass. Destination
+// is [head_dim=32, token=144, head, window], matching ggml MUL_MAT inputs.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint b_offset;
+    uint d_offset;
+    uint tokens;
+    uint heads;
+    uint windows;
+    uint kind;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) readonly buffer B { float data_b[]; };
+layout (binding = 2) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+const uint HEAD_DIM = 32u;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    const uint total = HEAD_DIM * p.tokens * p.heads * p.windows;
+    if (idx >= total) return;
+
+    const uint lane = idx % HEAD_DIM;
+    const uint token = (idx / HEAD_DIM) % p.tokens;
+    const uint head = (idx / (HEAD_DIM * p.tokens)) % p.heads;
+    const uint window = idx / (HEAD_DIM * p.tokens * p.heads);
+    const uint channels = HEAD_DIM * p.heads;
+    const uint channel = lane + HEAD_DIM * head;
+    const uint qkv_channel = channel + p.kind * channels;
+    const uint source = qkv_channel + 3u * channels * (token + p.tokens * window);
+    data_d[p.d_offset + idx] = data_a[p.a_offset + source] + data_b[p.b_offset + qkv_channel];
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_swin_windows.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_swin_windows.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_swin_windows.comp
@@ -0,0 +1,57 @@
+#version 450
+
+// Exact Swin-L window transform. The destination layout is C x 144 x nWindows
+// for pack and C x (H*W) for unpack. Window coordinates and shifted padding are
+// implicit, so no index tensors or generic GET_ROWS dispatches are required.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint d_offset;
+    uint channels;
+    uint height;
+    uint width;
+    uint shift;
+    uint kind;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+const uint WINDOW = 12u;
+const uint TOKENS = WINDOW * WINDOW;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    const uint hp = ((p.height + WINDOW - 1u) / WINDOW) * WINDOW;
+    const uint wp = ((p.width + WINDOW - 1u) / WINDOW) * WINDOW;
+    const uint windows_w = wp / WINDOW;
+
+    if (p.kind == 0u) {
+        const uint windows = (hp / WINDOW) * windows_w;
+        const uint total = p.channels * TOKENS * windows;
+        if (idx >= total) return;
+        const uint channel = idx % p.channels;
+        const uint t = (idx / p.channels) % TOKENS;
+        const uint window = idx / (p.channels * TOKENS);
+        const uint rh = (window / windows_w) * WINDOW + t / WINDOW;
+        const uint rw = (window % windows_w) * WINDOW + t % WINDOW;
+        const uint sh = (rh + p.shift) % hp;
+        const uint sw = (rw + p.shift) % wp;
+        data_d[p.d_offset + idx] = (sh < p.height && sw < p.width)
+            ? data_a[p.a_offset + channel + p.channels * (sh * p.width + sw)] : 0.0;
+        return;
+    }
+
+    const uint total = p.channels * p.height * p.width;
+    if (idx >= total) return;
+    const uint channel = idx % p.channels;
+    const uint pos = idx / p.channels;
+    const uint h = pos / p.width;
+    const uint w = pos - h * p.width;
+    const uint rh = (h + hp - p.shift) % hp;
+    const uint rw = (w + wp - p.shift) % wp;
+    const uint window = (rh / WINDOW) * windows_w + rw / WINDOW;
+    const uint t = (rh % WINDOW) * WINDOW + rw % WINDOW;
+    data_d[p.d_offset + idx] = data_a[p.a_offset + channel + p.channels * (t + TOKENS * window)];
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/sam3d_scatter_mean.comp b/src/ggml-vulkan/vulkan-shaders/sam3d_scatter_mean.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/sam3d_scatter_mean.comp
@@ -0,0 +1,54 @@
+#version 450
+#extension GL_EXT_shader_16bit_storage : require
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+
+// SAM 3D sparse-scatter mean (SparseTensor downsample): fine rows accumulate
+// into their owning coarse row, then each coarse row is divided by its count.
+//
+// Semantics pinned by the CUDA kernel (sam3d-scatter.cu) and the CPU fallback
+// (ggml_compute_forward_sam3d_sparse_scatter_mean):
+//   * accumulation happens in F16: each scalar add computes the exact sum of
+//     two halves and rounds it back to half (RNE). Running the add in f16
+//     arithmetic is mathematically identical to the CPU's F32-opmath form,
+//     because both round the same exact sum.
+//   * rows with a negative or out-of-range destination are skipped,
+//   * the division runs in F32 opmath: half(sum) -> float -> / count -> half.
+//
+// Mapping: invocation x = channel, invocation y = coarse row. Each output
+// address has exactly one writer thread, so the chain needs no barrier and
+// stays in program order; the per-channel loop over ascending fine rows
+// reproduces the CPU fallback's accumulation order bit-exactly. The rows[]
+// load is uniform across the workgroup and served from cache.
+
+layout (push_constant) uniform parameter {
+    uint channels;     // features.ne[0] == dst.ne[0]
+    uint fine_rows;    // features.ne[1]
+    uint coarse_rows;  // dst.ne[1]
+    uint pad;
+} p;
+
+layout (binding = 0) readonly buffer FEATURES { float16_t data_features[]; };
+layout (binding = 1) readonly buffer ROWS { int data_rows[]; };
+layout (binding = 2) readonly buffer COUNTS { float data_counts[]; };
+layout (binding = 3) buffer DST { float16_t data_dst[]; };
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint channel = gl_GlobalInvocationID.x;
+    const uint coarse_row = gl_GlobalInvocationID.y;
+    if (channel >= p.channels || coarse_row >= p.coarse_rows) {
+        return;
+    }
+    const uint dst_index = coarse_row * p.channels + channel;
+    const int owner = int(coarse_row);
+
+    float16_t acc = float16_t(0.0);
+    for (uint f = 0u; f < p.fine_rows; ++f) {
+        if (data_rows[f] == owner) {
+            acc = acc + data_features[f * p.channels + channel];
+        }
+    }
+
+    data_dst[dst_index] = float16_t(float(acc) / data_counts[coarse_row]);
+}
