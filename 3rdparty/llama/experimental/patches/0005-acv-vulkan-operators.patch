+// MapAnything parity contract: the map-anything-ggml reference runs on
+// pristine ggml Vulkan dispatch. Three downstream overrides change the module
+// selected for its graph: the RMBG F32-K/V flash-attention scalar routing, the
+// SAM3 2x2/stride-2 conv_transpose fast path, and the lingbot scalar routing of
+// F32-weight conv_transpose_2d on cooperative-matrix devices. The MapAnything
+// graph builder names its flash-attention / conv_transpose outputs "mapany_*";
+// those nodes keep the pristine selection, every other task is unchanged.
+static bool ggml_vk_mapany_pristine_node(const ggml_tensor * t) {
+    return strncmp(t->name, "mapany_", 7) == 0;
+}
+
+// First non-empty name found along the tensor's view chain (the RMBG graph
+// builder marks its tensors at build time).
+static std::string ggml_vk_rmbg_tensor_name(const ggml_tensor * tensor) {
+    for (const ggml_tensor * current = tensor; current; current = current->view_src) {
+        const char * name = ggml_get_name(current);
+        if (name && name[0]) {
+            return name;
+        }
+    }
+    return {};
+}
+
+// Name-based replacement of the historical RMBG_VK_COOPMAT_MATMUL environment
+// whitelist: the RMBG graph builder bakes the per-matmul decision into the
+// graph at build time, so no process-global state is involved and unrelated
+// graphs are never affected.
+//   "rmbg_scalar_*" -> always run the exact scalar pipelines;
+//   "rmbg_tc_*"     -> CM1/plain devices keep the numerically-accurate
+//                      cooperative F32 path, while coopmat2 forces the scalar
+//                      pipelines too (coopmat2 converts F32 operands to F16,
+//                      which the RMBG numerical gate forbids).
+static bool ggml_vk_rmbg_force_scalar_matmul(const vk_device& device,
+                                               const ggml_tensor * src0,
+                                               const ggml_tensor * src1,
+                                               const ggml_tensor * dst) {
+    GGML_UNUSED(src0);
+    GGML_UNUSED(src1);
+    const std::string name = ggml_vk_rmbg_tensor_name(dst);
+    if (name.compare(0, 12, "rmbg_scalar_") == 0) {
+        return true;
+    }
+    // lingbot patch: the LingBot-Map streaming graph marks every matmul
+    // output "lingbot_scalar_*" (see core/AICore/src/tasks/lingbot) so its
+    // long-recurrence GEMMs run the exact scalar pipelines (and never the
+    // Q8_1 activation quantization or the coopmat2 F16-converting F32
+    // path) without any process-global state.
+    if (name.compare(0, 15, "lingbot_scalar_") == 0) {
+        return true;
+    }
+    if (name.compare(0, 8, "rmbg_tc_") == 0) {
+        return device->coopmat2;
+    }
+    return false;
+}
