diff --git a/src/ggml-vulkan/vulkan-shaders/conv_transpose_2d_interleave.comp b/src/ggml-vulkan/vulkan-shaders/conv_transpose_2d_interleave.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/conv_transpose_2d_interleave.comp
@@ -0,0 +1,43 @@
+#version 450
+
+#include "types.glsl"
+
+#extension GL_EXT_shader_16bit_storage : require
+
+// Fast path helper for CONV_TRANSPOSE_2D with a 2x2 kernel and stride 2
+// (SAM3-style upsampling). Takes the dense [W, H, 4*Cout] output of the
+// 1x1 conv GEMM (one channel block per phase) and writes it back into the
+// interleaved [2W, 2H, Cout] transposed-conv output:
+//
+//   dst[ox + oy*2W + co*4WH] = ph[(ox>>1) + W*(oy>>1) + WH*(phase*Cout + co)]
+//   phase = (oy&1)*2 + (ox&1)
+//
+// Both tensors use the ggml layout (x fastest).
+
+layout(push_constant) uniform parameter {
+    uint W;
+    uint H;
+    uint Cout;
+    uint total; // 2W * 2H * Cout
+} p;
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer X { float data_a[]; };
+layout(binding = 1) writeonly buffer D { float data_d[]; };
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    if (idx >= p.total) {
+        return;
+    }
+
+    const uint ox = idx % (2u * p.W);
+    const uint oy = (idx / (2u * p.W)) % (2u * p.H);
+    const uint co = idx / (4u * p.W * p.H);
+
+    const uint pix = (ox >> 1u) + p.W * (oy >> 1u);
+    const uint phase = (oy & 1u) * 2u + (ox & 1u);
+
+    data_d[idx] = data_a[pix + p.W * p.H * (phase * p.Cout + co)];
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/conv_transpose_2d_reorder.comp b/src/ggml-vulkan/vulkan-shaders/conv_transpose_2d_reorder.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/conv_transpose_2d_reorder.comp
@@ -0,0 +1,45 @@
+#version 450
+
+#include "types.glsl"
+
+#extension GL_EXT_shader_16bit_storage : require
+
+// Fast path helper for CONV_TRANSPOSE_2D with a 2x2 kernel and stride 2
+// (SAM3-style upsampling). The four output phases (dy,dx) are independent
+// 1x1 convolutions of the input, so the transposed conv reduces to one GEMM
+// with K = 4*Cout plus an interleave write-back. This shader reorders the
+// strided kernel [2,2,Cout,Cin] into the dense [Cin, 4*Cout] layout that the
+// 1x1 conv GEMM expects (phase block-major, channel-minor):
+//
+//   w_ph[ci + (ph*Cout + co)*Cin] = w[dx + 2*dy + 4*co + 4*Cout*ci]
+//   ph = dy*2 + dx
+//
+// A_TYPE matches the kernel element type (float16_t for F16 kernels), so
+// reordering is a pure index remap with no arithmetic.
+
+layout(push_constant) uniform parameter {
+    uint Cout;  // output channels of the original transposed conv
+    uint Cin;   // input channels
+    uint total; // 4 * Cout * Cin
+} p;
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer X { A_TYPE data_a[]; };
+layout(binding = 1) writeonly buffer D { A_TYPE data_d[]; };
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    if (idx >= p.total) {
+        return;
+    }
+
+    const uint ci = idx % p.Cin;
+    const uint co = (idx / p.Cin) % p.Cout;
+    const uint ph = idx / (p.Cin * p.Cout);
+    const uint dx = ph & 1u;
+    const uint dy = ph >> 1u;
+
+    const uint src = dx + 2u * dy + 4u * co + 4u * p.Cout * ci;
+    data_d[idx] = data_a[src];
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/copy_from_quant_qk.comp b/src/ggml-vulkan/vulkan-shaders/copy_from_quant_qk.comp
new file mode 100644
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/copy_from_quant_qk.comp
@@ -0,0 +1,26 @@
+#version 450
+
+#include "types.glsl"
+#include "generic_unary_head.glsl"
+#include "dequant_funcs.glsl"
+
+// Q4_K is decoded as pairs rather than through the dequantize4 helper used by
+// the generic quantized copy shader. One workgroup owns one 256-value block.
+layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint idx = gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x * QUANT_K;
+    if (idx >= p.ne) {
+        return;
+    }
+
+    const uint dst_idx = get_doffset() + dst_idx(idx);
+    const uint src_idx = src0_idx_quant(idx, QUANT_K);
+    const uint a_offset = 0;
+
+    [[unroll]] for (uint j = 0; j < QUANT_K; j += 2) {
+        const vec2 v = dequantize(src_idx, j, a_offset);
+        data_d[dst_idx + j] = v.x;
+        data_d[dst_idx + j + 1] = v.y;
+    }
+}
