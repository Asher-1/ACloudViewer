From: ACloudViewer downstream
Subject: [PATCH] Standardize the CUDA Q8_1 activation sum semantics (s = d * sum(qs[i]))

ggml-common.h defines block_q8_1.s as "d * sum(qs[i])" - the sum of the
DEQUANTIZED activations - and quantize_row_q8_1_ref (CPU) plus the CPU
vec_dot_q4_1_q8_1 / vec_dot_q5_1_q8_1 (m_x * s_y) and vec_dot_q4_0_q8_1
(-8 * s_y) correction consumers all follow that definition. The two CUDA
quantize kernels stored the RAW float activation sum instead, so every
Q4_0/Q4_1/Q5_0/Q5_1 mul_mat correction term diverged between CPU and CUDA:

  - MMVQ (quantize_q8_1): raw float sum.
  - MMQ  (quantize_mmq_q8_1, DS4 layout used by Q4_1/Q5_1): raw float sum.

Measured with identical weights/activations (K=1024, N=3072, M=257,
activation mean 1.0 so the m-term matters): CPU-vs-CUDA Q4_1 mul_mat
max_abs error drops from 0.658 to 0.044 and Q4_0 from 0.627 to 0.046 -
both now at the pure int32-accumulation rounding level. End-to-end on
sam3-visual-q4_1 (cand1.jpg, RTX 3060): q4_1-CUDA vs f16-CUDA mask IoU
improves 0.978 -> 0.994.

The D2S6 layout (k-quants) keeps the raw sum: the k-quant correction
consumers have their own semantics and are out of scope here.
---
diff --git a/src/ggml-cuda/quantize.cu b/src/ggml-cuda/quantize.cu
--- a/src/ggml-cuda/quantize.cu
+++ b/src/ggml-cuda/quantize.cu
@@ -83,21 +83,27 @@ static __global__ void quantize_q8_1(
     ggml_cuda_pdl_sync();
     const float xi = i0 < ne00 ? x[i03*s03 + i02*s02 + i01*s01 + i00] : 0.0f;
     float amax = fabsf(xi);
-    float sum = xi;
 
     amax = warp_reduce_max<QK8_1>(amax);
-    sum  = warp_reduce_sum<QK8_1>(sum);
 
     const float  d = amax / 127.0f;
     const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
 
     y[ib].qs[iqs] = q;
 
+    // Standard block_q8_1 semantics (ggml-common.h): s = d * sum(qs[i]) —
+    // the dequantized activation sum, matching quantize_row_q8_1_ref on the
+    // CPU and quantize_mmq_q8_1's DS4 layout. Storing the raw float sum here
+    // made the Q4_1/Q5_1 correction term m_x * s_y diverge between the CPU
+    // and CUDA (SAM3 backend-parity mask IoU 0.977 vs the 0.98 gate).
+    float sumq = (float) q;
+    sumq = warp_reduce_sum<QK8_1>(sumq);
+
     if (iqs > 0) {
         return;
     }
 
-    y[ib].ds = make_half2(d, sum);
+    y[ib].ds = make_half2(d, d * sumq);
 }
 
 __device__ __forceinline__ uint8_t compute_e8m0_scale(float amax) {
@@ -501,17 +507,6 @@ static __global__ void quantize_mmq_q8_1(
         amax = fmaxf(amax, __shfl_xor_sync(0xFFFFFFFF, amax, offset, WARP_SIZE));
     }
 
-    float sum;
-    if (ds_layout != MMQ_Q8_1_DS_LAYOUT_D4) {
-        sum = xi.x + xi.y + xi.z + xi.w;
-
-        // Calculate sums across vals_per_sum/4 threads.
-#pragma unroll
-        for (int offset = vals_per_sum/8; offset > 0; offset >>= 1) {
-            sum += __shfl_xor_sync(0xFFFFFFFF, sum, offset, WARP_SIZE);
-        }
-    }
-
     const float d_inv = 127.0f / amax;
     char4 q;
     q.x = roundf(xi.x*d_inv);
@@ -520,6 +515,27 @@ static __global__ void quantize_mmq_q8_1(
     q.w = roundf(xi.w*d_inv);
     const float d = 1.0f / d_inv;
 
+    float sum = 0.0f;
+    if (ds_layout == MMQ_Q8_1_DS_LAYOUT_DS4) {
+        // Standard block_q8_1 semantics for the Q4_1/Q5_1 correction term
+        // m_x * s_y: s = d * sum(qs[i]) (quantize_row_q8_1_ref / MMVQ
+        // quantize_q8_1), not the raw float sum, which made CPU-vs-CUDA
+        // Q4_1 mul_mat diverge by ~0.7% rel_l2 and failed the SAM3
+        // backend-parity mask IoU gate (0.977 vs 0.98).
+        sum = (float) q.x + (float) q.y + (float) q.z + (float) q.w;
+#pragma unroll
+        for (int offset = vals_per_sum/8; offset > 0; offset >>= 1) {
+            sum += __shfl_xor_sync(0xFFFFFFFF, sum, offset, WARP_SIZE);
+        }
+        sum *= d;
+    } else if (ds_layout == MMQ_Q8_1_DS_LAYOUT_D2S6) {
+        sum = xi.x + xi.y + xi.z + xi.w;
+#pragma unroll
+        for (int offset = vals_per_sum/8; offset > 0; offset >>= 1) {
+            sum += __shfl_xor_sync(0xFFFFFFFF, sum, offset, WARP_SIZE);
+        }
+    }
+
     // write the block once (normal) or to each of the token's compact rows (scatter)
     const int nwrite = scatter ? n_expert_used : 1;
 #pragma unroll
@@ -578,7 +594,6 @@ void quantize_mmq_q8_1_cuda(
         const int64_t ne0, const int64_t ne1, const int64_t ne2, const int64_t ne3, cudaStream_t stream) {
     GGML_ASSERT(ne00 % 4 == 0);
     GGML_ASSERT(ne0 % QK8_1_MMQ == 0);
-
     // ne1 tends to assume the highest values, therefore use it as the "x" dimension of the CUDA grid:
     const int64_t block_num_y = (ne0 + 4*CUDA_QUANTIZE_BLOCK_SIZE_MMQ - 1) / (4*CUDA_QUANTIZE_BLOCK_SIZE_MMQ);
     const dim3 num_blocks(ne1, block_num_y, ne2*ne3);
