diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_block_topk.comp b/src/ggml-vulkan/vulkan-shaders/aliked_block_topk.comp
new file mode 100644
index 0000000..8fe6f97
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_block_topk.comp
@@ -0,0 +1,57 @@
+#version 450
+
+layout(push_constant) uniform parameter {
+    uint count;
+    uint num_blocks;
+    uint k_local;
+} p;
+
+layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer Nms { float data_nms[]; };
+layout(binding = 1) writeonly buffer BlockKeys { float block_keys[]; };
+layout(binding = 2) writeonly buffer BlockIndices { float data_block_indices[]; };
+
+void insert_local_topk(float value, float index, inout float keys[32], inout float indices[32]) {
+    if (value <= keys[p.k_local - 1u]) {
+        return;
+    }
+    keys[p.k_local - 1u] = value;
+    indices[p.k_local - 1u] = index;
+    for (uint j = p.k_local - 1u; j > 0u; --j) {
+        if (keys[j] > keys[j - 1u]) {
+            float tk = keys[j - 1u];
+            keys[j - 1u] = keys[j];
+            keys[j] = tk;
+            float ti = indices[j - 1];
+            indices[j - 1] = indices[j];
+            indices[j] = ti;
+        } else {
+            break;
+        }
+    }
+}
+
+void main() {
+    uint block = gl_WorkGroupID.x;
+    if (block >= p.num_blocks) {
+        return;
+    }
+
+    float keys[32];
+    float indices[32];
+    for (uint i = 0u; i < p.k_local; ++i) {
+        keys[i] = -3.402823466e+38;
+        indices[i] = -1.0;
+    }
+
+    for (uint i = block; i < p.count; i += p.num_blocks) {
+        insert_local_topk(data_nms[i], float(i), keys, indices);
+    }
+
+    for (uint i = 0u; i < p.k_local; ++i) {
+        uint out_idx = block * p.k_local + i;
+        block_keys[out_idx] = keys[i];
+        data_block_indices[out_idx] = indices[i];
+    }
+}
