+    int32_t radius, int32_t top_k, float scores_th, int32_t n_limit,
+    ggml_tensor *keypoints_norm, ggml_tensor *scores, int32_t *out_count,
+    ggml_tensor *nms, ggml_tensor *tmp_a, ggml_tensor *tmp_b, ggml_tensor *tmp_c,
+    ggml_tensor *block_keys, ggml_tensor *block_indices, ggml_tensor *indices_dev);
+
