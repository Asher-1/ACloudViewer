diff --git a/src/ggml-vulkan/ggml-vulkan-aliked.inc.cpp b/src/ggml-vulkan/ggml-vulkan-aliked.inc.cpp
new file mode 100644
index 0000000..2c697a8
--- /dev/null
+++ b/src/ggml-vulkan/ggml-vulkan-aliked.inc.cpp
@@ -0,0 +1,596 @@
+// ALIKED custom Vulkan compute — included at end of ggml-vulkan.cpp for internal API access.
+
+#include "ggml-vulkan-aliked.h"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+
+constexpr int32_t kTopKBlockCount = 256;
+constexpr int32_t kTopKLocal = 32;
+constexpr int32_t kSddhBatchSize = 64;
+constexpr int32_t kSddhFinishChunk = 4; // batches per Vulkan submit (256 keypoints @1024)
+
+static int32_t vk_aliked_sddh_finish_chunk() {
+    const char *env = std::getenv("LIGHTGLUE_ALIKED_VULKAN_SDDH_CHUNK");
+    if (env != nullptr && env[0] != '\0') {
+        const int32_t value = std::max(1, std::atoi(env));
+        return value;
+    }
+    return kSddhFinishChunk;
+}
+
+static bool vk_aliked_sddh_single_submit() {
+    const char *env = std::getenv("LIGHTGLUE_ALIKED_VULKAN_SDDH_SINGLE");
+    return env != nullptr && env[0] != '0';
+}
+
+struct vk_aliked_push_deform {
+    uint32_t ic, ih, iw, oc, kh, kw, pad, has_bias;
+    uint32_t mem_layout;
+};
+
+struct vk_aliked_push_layout {
+    uint32_t c, h, w, mode;
+};
+
+struct vk_aliked_push_dense_copy {
+    uint32_t w, h, c;
+    uint32_t src_nb0, src_nb1, src_nb2;
+    uint32_t src_off;
+};
+
+struct vk_aliked_push_clamp {
+    uint32_t count;
+    float min_val;
+    float max_val;
+};
+
+struct vk_aliked_push_max_pool {
+    uint32_t h, w;
+    int32_t pad;
+};
+
+struct vk_aliked_push_dkd_elem {
+    uint32_t count, h, w, radius, op;
+};
+
+struct vk_aliked_push_block_topk {
+    uint32_t count, num_blocks, k_local;
+};
+
+struct vk_aliked_push_dkd_refine {
+    uint32_t count, h, w, radius;
+};
+
+struct vk_aliked_push_sddh {
+    uint32_t dim, h, w, count, kernel_size, n_pos;
+    uint32_t feature_off, kpt_off, workspace_off, desc_off;
+    uint32_t k_offset, batch_count;
+    uint32_t src_nb0, src_nb1, src_nb2;
+};
+
+struct vk_aliked_push_upsample {
+    uint32_t ic, ih, iw, out_h, out_w;
+};
+
+struct vk_aliked_pipelines {
+    vk_pipeline deform_conv;
+    vk_pipeline layout_convert;
+    vk_pipeline dense_copy;
+    vk_pipeline clamp;
+    vk_pipeline max_pool;
+    vk_pipeline dkd_elem;
+    vk_pipeline block_topk;
+    vk_pipeline dkd_refine;
+    vk_pipeline sddh;
+    vk_pipeline upsample_bilinear;
+    bool ready = false;
+};
+
+static std::mutex g_aliked_mtx;
+static std::unordered_map<vk_device, vk_aliked_pipelines> g_aliked;
+
+static vk_pipeline vk_aliked_make_pipeline(vk_device &device, const char *name,
+                                           size_t spv_len, const void *spv_data,
+                                           uint32_t param_count, uint32_t push_size,
+                                           std::array<uint32_t, 3> wg_denoms) {
+    vk_pipeline pipeline = std::make_shared<vk_pipeline_struct>();
+    pipeline->name = name;
+    pipeline->parameter_count = param_count;
+    pipeline->push_constant_size = push_size;
+    pipeline->wg_denoms = wg_denoms;
+    pipeline->initialized = true;
+    ggml_vk_create_pipeline_func(device, pipeline, spv_len, spv_data, "main", param_count,
+                                 wg_denoms, {}, false, false, 0);
+    return pipeline;
+}
+
+static vk_aliked_pipelines &vk_aliked_ensure(ggml_backend_vk_context *ctx) {
+    std::lock_guard<std::mutex> guard(g_aliked_mtx);
+    vk_aliked_pipelines &state = g_aliked[ctx->device];
+    if (state.ready) {
+        return state;
+    }
+    vk_device device = ctx->device;
+    state.deform_conv =
+        vk_aliked_make_pipeline(device, "aliked_deform_conv_f32", aliked_deform_conv_f32_len,
+                                aliked_deform_conv_f32_data, 5, sizeof(vk_aliked_push_deform),
+                                {16, 16, 1});
+    state.layout_convert = vk_aliked_make_pipeline(
+        device, "aliked_layout_convert_f32", aliked_layout_convert_f32_len,
+        aliked_layout_convert_f32_data, 2, sizeof(vk_aliked_push_layout), {16, 1, 1});
+    state.dense_copy = vk_aliked_make_pipeline(device, "aliked_dense_copy_f32",
+                                               aliked_dense_copy_f32_len,
+                                               aliked_dense_copy_f32_data, 2,
+                                               sizeof(vk_aliked_push_dense_copy),
+                                               {16, 8, 1});
+    state.clamp = vk_aliked_make_pipeline(device, "aliked_clamp_f32", aliked_clamp_f32_len,
+                                          aliked_clamp_f32_data, 1, sizeof(vk_aliked_push_clamp),
+                                          {256, 1, 1});
+    state.max_pool = vk_aliked_make_pipeline(device, "aliked_max_pool_f32", aliked_max_pool_f32_len,
+                                             aliked_max_pool_f32_data, 2,
+                                             sizeof(vk_aliked_push_max_pool), {16, 16, 1});
+    state.dkd_elem = vk_aliked_make_pipeline(device, "aliked_dkd_elem_f32", aliked_dkd_elem_f32_len,
+                                             aliked_dkd_elem_f32_data, 4,
+                                             sizeof(vk_aliked_push_dkd_elem), {256, 1, 1});
+    state.block_topk = vk_aliked_make_pipeline(
+        device, "aliked_block_topk_f32", aliked_block_topk_f32_len, aliked_block_topk_f32_data, 3,
+        sizeof(vk_aliked_push_block_topk), {1, 1, 1});
+    state.dkd_refine = vk_aliked_make_pipeline(
+        device, "aliked_dkd_refine_f32", aliked_dkd_refine_f32_len, aliked_dkd_refine_f32_data, 4,
+        sizeof(vk_aliked_push_dkd_refine), {1, 1, 1});
+    state.sddh = vk_aliked_make_pipeline(device, "aliked_sddh_f32", aliked_sddh_f32_len,
+                                         aliked_sddh_f32_data, 10, sizeof(vk_aliked_push_sddh),
+                                         {1, 1, 1});
+    state.upsample_bilinear = vk_aliked_make_pipeline(
+        device, "aliked_upsample_bilinear_f32", aliked_upsample_bilinear_f32_len,
+        aliked_upsample_bilinear_f32_data, 2, sizeof(vk_aliked_push_upsample), {16, 16, 1});
+    state.ready = true;
+    return state;
+}
+
+static ggml_backend_vk_context *vk_aliked_ctx(ggml_backend_t backend) {
+    if (backend == nullptr || !ggml_backend_is_vk(backend)) {
+        return nullptr;
+    }
+    return static_cast<ggml_backend_vk_context *>(backend->context);
+}
+
+static uint32_t vk_aliked_misalign_floats(ggml_backend_vk_context *ctx, const ggml_tensor *t) {
+    if (t == nullptr || t->buffer == nullptr) {
+        return 0;
+    }
+    const size_t align = ctx->device->properties.limits.minStorageBufferOffsetAlignment;
+    const size_t byte_off =
+        (reinterpret_cast<uintptr_t>(t->data) - static_cast<uintptr_t>(0x1000)) + t->view_offs;
+    return static_cast<uint32_t>((byte_off & (align - 1)) / sizeof(float));
+}
+
+static vk_subbuffer vk_aliked_subbuf(ggml_backend_vk_context *ctx, const ggml_tensor *t) {
+    return ggml_vk_tensor_subbuffer(ctx, t, true);
+}
+
+template <typename PushT>
+static void vk_aliked_dispatch1(ggml_backend_vk_context *ctx, vk_pipeline &pipe,
+                                  std::initializer_list<vk_subbuffer> bufs, const PushT &pc,
+                                  std::array<uint32_t, 3> elements, bool request_descriptor = true) {
+    if (request_descriptor) {
+        ggml_pipeline_request_descriptor_sets(ctx, pipe, 1);
+    }
+    vk_context subctx = ggml_vk_get_compute_ctx(ctx);
+    std::vector<vk::DescriptorBufferInfo> infos;
+    infos.reserve(bufs.size());
+    for (const auto &sb : bufs) {
+        infos.push_back({sb.buffer->buffer, sb.offset, sb.size});
+    }
+
+    const uint32_t wg0 = CEIL_DIV(elements[0], pipe->wg_denoms[0]);
+    const uint32_t wg1 = CEIL_DIV(elements[1], pipe->wg_denoms[1]);
+    const uint32_t wg2 = CEIL_DIV(elements[2], pipe->wg_denoms[2]);
+    GGML_ASSERT(infos.size() == pipe->parameter_count);
+    GGML_ASSERT(pipe->push_constant_size == push_constant_size(pc));
+
+    vk::DescriptorSet &descriptor_set = ctx->descriptor_sets[ctx->descriptor_set_idx++];
+    vk::WriteDescriptorSet write_descriptor_set{
+        descriptor_set, 0, 0, pipe->parameter_count, vk::DescriptorType::eStorageBuffer,
+        nullptr, infos.data()};
+    ctx->device->device.updateDescriptorSets({write_descriptor_set}, {});
+
+    subctx->s->buffer->buf.pushConstants(pipe->layout, vk::ShaderStageFlagBits::eCompute, 0,
+                                         push_constant_size(pc), push_constant_data(pc));
+    subctx->s->buffer->buf.bindPipeline(vk::PipelineBindPoint::eCompute, pipe->pipeline);
+    subctx->s->buffer->buf.bindDescriptorSets(vk::PipelineBindPoint::eCompute, pipe->layout, 0,
+                                              {descriptor_set}, {});
+    subctx->s->buffer->buf.dispatch(wg0, wg1, wg2);
+}
+
+static void vk_aliked_compute_barrier(ggml_backend_vk_context *ctx) {
+    if (ctx->compute_ctx.expired()) {
+        return;
+    }
+    vk_context subctx = ctx->compute_ctx.lock();
+    subctx->s->buffer->buf.pipelineBarrier(
+        subctx->p->q->stage_flags, subctx->p->q->stage_flags, {},
+        vk::MemoryBarrier(vk::AccessFlagBits::eShaderWrite,
+                          vk::AccessFlagBits::eShaderRead | vk::AccessFlagBits::eShaderWrite),
+        {}, {});
+}
+
+static void vk_aliked_finish(ggml_backend_vk_context *ctx) {
+    if (!ctx->compute_ctx.expired()) {
+        vk_context subctx = ctx->compute_ctx.lock();
+        ggml_vk_ctx_end(subctx);
+        ggml_vk_submit(subctx, ctx->fence);
+        ctx->submit_pending = true;
+        ctx->compute_ctx.reset();
+    }
+    ggml_vk_synchronize(ctx);
+    ctx->descriptor_set_idx = 0;
+}
+
+static bool vk_aliked_layout_convert(ggml_backend_t backend, const ggml_tensor *src,
+                                     ggml_tensor *dst, int32_t c, int32_t h, int32_t w,
+                                     uint32_t mode) {
+    ggml_backend_vk_context *ctx = vk_aliked_ctx(backend);
+    if (ctx == nullptr) {
+        return false;
+    }
+    ggml_backend_synchronize(backend);
+    vk_aliked_pipelines &pipes = vk_aliked_ensure(ctx);
+    vk_aliked_push_layout pc{static_cast<uint32_t>(c), static_cast<uint32_t>(h),
+                             static_cast<uint32_t>(w), mode};
+    vk_aliked_dispatch1(ctx, pipes.layout_convert,
+                        {vk_aliked_subbuf(ctx, src), vk_aliked_subbuf(ctx, dst)}, pc,
+                        {static_cast<uint32_t>(w), static_cast<uint32_t>(h),
+                         static_cast<uint32_t>(c)});
+    vk_aliked_finish(ctx);
+    return true;
+}
+
+static bool vk_aliked_max_pool(ggml_backend_vk_context *ctx, vk_aliked_pipelines &pipes,
+                               const ggml_tensor *input, ggml_tensor *output, int32_t h,
+                               int32_t w, int32_t pad) {
+    vk_aliked_push_max_pool pc{static_cast<uint32_t>(h), static_cast<uint32_t>(w), pad};
+    vk_aliked_dispatch1(ctx, pipes.max_pool,
+                        {vk_aliked_subbuf(ctx, input), vk_aliked_subbuf(ctx, output)}, pc,
+                        {static_cast<uint32_t>(w), static_cast<uint32_t>(h), 1});
+    return true;
+}
+
+static bool vk_aliked_dkd_elem(ggml_backend_vk_context *ctx, vk_aliked_pipelines &pipes,
+                               uint32_t op, const ggml_tensor *a, const ggml_tensor *b,
+                               ggml_tensor *c, ggml_tensor *d, int32_t h, int32_t w,
+                               int32_t count, int32_t radius) {
+    vk_aliked_push_dkd_elem pc{static_cast<uint32_t>(count), static_cast<uint32_t>(h),
+                               static_cast<uint32_t>(w), static_cast<uint32_t>(radius), op};
+    if (op == 5) {
+        vk_aliked_dispatch1(ctx, pipes.dkd_elem, {vk_aliked_subbuf(ctx, a), vk_aliked_subbuf(ctx, b),
+                                                  vk_aliked_subbuf(ctx, c), vk_aliked_subbuf(ctx, d)},
+                            pc, {static_cast<uint32_t>(w), static_cast<uint32_t>(h), 1});
+    } else {
+        vk_aliked_dispatch1(ctx, pipes.dkd_elem, {vk_aliked_subbuf(ctx, a), vk_aliked_subbuf(ctx, b),
+                                                  vk_aliked_subbuf(ctx, c), vk_aliked_subbuf(ctx, d)},
+                            pc, {static_cast<uint32_t>(count), 1, 1});
+    }
+    return true;
+}
+
+static bool vk_aliked_simple_nms(ggml_backend_vk_context *ctx, vk_aliked_pipelines &pipes,
+                                 const ggml_tensor *scores, ggml_tensor *nms,
+                                 ggml_tensor *tmp_a, ggml_tensor *tmp_b, ggml_tensor *tmp_c,
+                                 int32_t h, int32_t w, int32_t radius) {
+    const int32_t count = h * w;
+    if (!vk_aliked_max_pool(ctx, pipes, scores, tmp_a, h, w, radius)) {
+        return false;
+    }
+    if (!vk_aliked_dkd_elem(ctx, pipes, 0, scores, tmp_a, tmp_b, tmp_c, h, w, count, radius)) {
+        return false;
+    }
+    if (!vk_aliked_dkd_elem(ctx, pipes, 6, scores, scores, nms, tmp_c, h, w, count, radius)) {
+        return false;
+    }
+    for (int iter = 0; iter < 2; ++iter) {
+        if (!vk_aliked_max_pool(ctx, pipes, tmp_b, tmp_a, h, w, radius)) {
+            return false;
+        }
+        if (!vk_aliked_dkd_elem(ctx, pipes, 1, tmp_a, tmp_a, tmp_c, tmp_c, h, w, count, radius)) {
+            return false;
+        }
+        if (!vk_aliked_dkd_elem(ctx, pipes, 2, tmp_c, tmp_c, nms, nms, h, w, count, radius)) {
+            return false;
+        }
+        if (!vk_aliked_max_pool(ctx, pipes, nms, tmp_a, h, w, radius)) {
+            return false;
+        }
+        if (!vk_aliked_dkd_elem(ctx, pipes, 3, tmp_a, tmp_c, nms, tmp_b, h, w, count, radius)) {
+            return false;
+        }
+    }
+    if (!vk_aliked_dkd_elem(ctx, pipes, 4, scores, tmp_b, nms, tmp_c, h, w, count, radius)) {
+        return false;
+    }
+    return true;
+}
+
+} // namespace
+
+bool ggml_vulkan_aliked_available(ggml_backend_t backend) {
+    return vk_aliked_ctx(backend) != nullptr;
+}
+
+bool ggml_vulkan_aliked_whcn_to_nchw(ggml_backend_t backend, const ggml_tensor *whcn,
+                                     ggml_tensor *nchw, int32_t c, int32_t h, int32_t w) {
+    return vk_aliked_layout_convert(backend, whcn, nchw, c, h, w, 0);
+}
+
+bool ggml_vulkan_aliked_dense_copy_whcn(ggml_backend_t backend, const ggml_tensor *src,
+                                        ggml_tensor *dst, int32_t w, int32_t h, int32_t c) {
+    ggml_backend_vk_context *ctx = vk_aliked_ctx(backend);
+    if (ctx == nullptr || src == nullptr || dst == nullptr || w <= 0 || h <= 0 || c <= 0) {
+        return false;
+    }
+    if (src->ne[0] != w || src->ne[1] != h || src->ne[2] != c || dst->ne[0] != w ||
+        dst->ne[1] != h || dst->ne[2] != c) {
+        return false;
+    }
+    ggml_backend_synchronize(backend);
+    vk_aliked_pipelines &pipes = vk_aliked_ensure(ctx);
+    vk_aliked_push_dense_copy pc{
+        static_cast<uint32_t>(w), static_cast<uint32_t>(h), static_cast<uint32_t>(c),
+        static_cast<uint32_t>(src->nb[0]), static_cast<uint32_t>(src->nb[1]),
+        static_cast<uint32_t>(src->nb[2]), vk_aliked_misalign_floats(ctx, src)};
+    vk_aliked_dispatch1(ctx, pipes.dense_copy,
+                        {vk_aliked_subbuf(ctx, src), vk_aliked_subbuf(ctx, dst)}, pc,
+                        {static_cast<uint32_t>(w), static_cast<uint32_t>(h),
+                         static_cast<uint32_t>(c)});
+    vk_aliked_finish(ctx);
+    return true;
+}
+
+bool ggml_vulkan_aliked_nchw_to_whcn(ggml_backend_t backend, const ggml_tensor *nchw,
+                                     ggml_tensor *whcn, int32_t c, int32_t h, int32_t w) {
+    return vk_aliked_layout_convert(backend, nchw, whcn, c, h, w, 1);
+}
+
+bool ggml_vulkan_aliked_upsample_bilinear(ggml_backend_t backend, const ggml_tensor *input,
+                                          ggml_tensor *output, int32_t ic, int32_t ih,
+                                          int32_t iw, int32_t out_h, int32_t out_w) {
+    ggml_backend_vk_context *ctx = vk_aliked_ctx(backend);
+    if (ctx == nullptr || input == nullptr || output == nullptr) {
+        return false;
+    }
+    ggml_backend_synchronize(backend);
+    vk_aliked_pipelines &pipes = vk_aliked_ensure(ctx);
+    vk_aliked_push_upsample pc{static_cast<uint32_t>(ic), static_cast<uint32_t>(ih),
+                               static_cast<uint32_t>(iw), static_cast<uint32_t>(out_h),
+                               static_cast<uint32_t>(out_w)};
+    vk_aliked_dispatch1(ctx, pipes.upsample_bilinear,
+                        {vk_aliked_subbuf(ctx, input), vk_aliked_subbuf(ctx, output)}, pc,
+                        {static_cast<uint32_t>(out_w), static_cast<uint32_t>(out_h),
+                         static_cast<uint32_t>(ic)});
+    vk_aliked_finish(ctx);
+    return true;
+}
+
+bool ggml_vulkan_aliked_clamp_inplace(ggml_backend_t backend, ggml_tensor *data, size_t count,
+                                      float min_value, float max_value) {
+    ggml_backend_vk_context *ctx = vk_aliked_ctx(backend);
+    if (ctx == nullptr) {
+        return false;
+    }
+    ggml_backend_synchronize(backend);
+    vk_aliked_pipelines &pipes = vk_aliked_ensure(ctx);
+    vk_aliked_push_clamp pc{static_cast<uint32_t>(count), min_value, max_value};
+    vk_aliked_dispatch1(ctx, pipes.clamp, {vk_aliked_subbuf(ctx, data)}, pc,
+                        {static_cast<uint32_t>((count + 255) / 256), 1, 1});
+    vk_aliked_finish(ctx);
+    return true;
+}
+
+bool ggml_vulkan_aliked_deform_conv2d(ggml_backend_t backend, const ggml_tensor *input,
+                                      const ggml_tensor *offset, const ggml_tensor *weight,
+                                      const ggml_tensor *bias, ggml_tensor *output, int32_t ic,
+                                      int32_t ih, int32_t iw, int32_t oc, int32_t kh, int32_t kw,
+                                      int32_t pad, int32_t layout) {
+    ggml_backend_vk_context *ctx = vk_aliked_ctx(backend);
+    if (ctx == nullptr) {
+        return false;
+    }
+    ggml_backend_synchronize(backend);
+    vk_aliked_pipelines &pipes = vk_aliked_ensure(ctx);
+    vk_subbuffer sb_bias = bias ? vk_aliked_subbuf(ctx, bias) : vk_aliked_subbuf(ctx, weight);
+    vk_aliked_push_deform pc{static_cast<uint32_t>(ic), static_cast<uint32_t>(ih),
+                             static_cast<uint32_t>(iw), static_cast<uint32_t>(oc),
+                             static_cast<uint32_t>(kh), static_cast<uint32_t>(kw),
+                             static_cast<uint32_t>(pad), bias ? 1u : 0u,
+                             static_cast<uint32_t>(layout)};
+    vk_aliked_dispatch1(ctx, pipes.deform_conv,
+                        {vk_aliked_subbuf(ctx, input), vk_aliked_subbuf(ctx, offset),
+                         vk_aliked_subbuf(ctx, weight), sb_bias, vk_aliked_subbuf(ctx, output)},
+                        pc, {static_cast<uint32_t>(iw), static_cast<uint32_t>(ih),
+                             static_cast<uint32_t>(oc)});
+    vk_aliked_finish(ctx);
+    return true;
+}
+
+bool ggml_vulkan_aliked_run_dkd(ggml_backend_t backend, const ggml_tensor *score_map, int32_t h,
+                                int32_t w, int32_t radius, int32_t top_k, float scores_th,
+                                int32_t n_limit, ggml_tensor *keypoints_norm,
+                                ggml_tensor *scores, int32_t *out_count, ggml_tensor *nms,
+                                ggml_tensor *tmp_a, ggml_tensor *tmp_b, ggml_tensor *tmp_c,
+                                ggml_tensor *block_keys, ggml_tensor *block_indices,
+                                ggml_tensor *indices_dev) {
+    ggml_backend_vk_context *ctx = vk_aliked_ctx(backend);
+    if (ctx == nullptr || out_count == nullptr) {
+        return false;
+    }
+    const int32_t count = h * w;
+    ggml_backend_synchronize(backend);
+    vk_aliked_pipelines &pipes = vk_aliked_ensure(ctx);
+
+    if (!vk_aliked_simple_nms(ctx, pipes, score_map, nms, tmp_a, tmp_b, tmp_c, h, w, radius)) {
+        return false;
+    }
+    vk_aliked_dkd_elem(ctx, pipes, 5, nms, nms, nms, tmp_c, h, w, count, radius);
+
+    std::vector<int32_t> indices;
+    if (top_k > 0) {
+        vk_aliked_finish(ctx);
+        std::vector<float> nms_host(static_cast<size_t>(count));
+        ggml_backend_tensor_get(nms, nms_host.data(), 0, nms_host.size() * sizeof(float));
+        const int32_t keep = std::min(top_k, count);
+        std::vector<std::pair<float, int32_t>> scored;
+        scored.reserve(static_cast<size_t>(count));
+        for (int32_t i = 0; i < count; ++i) {
+            scored.emplace_back(nms_host[static_cast<size_t>(i)], i);
+        }
+        std::partial_sort(
+            scored.begin(), scored.begin() + keep, scored.end(),
+            [](const auto &a, const auto &b) { return a.first > b.first; });
+        indices.reserve(static_cast<size_t>(keep));
+        for (int32_t i = 0; i < keep; ++i) {
+            indices.push_back(scored[static_cast<size_t>(i)].second);
+        }
+    } else {
+        vk_aliked_finish(ctx);
+        std::vector<float> nms_host(static_cast<size_t>(count));
+        ggml_backend_tensor_get(nms, nms_host.data(), 0, nms_host.size() * sizeof(float));
+        float threshold = scores_th;
+        if (scores_th > 0.0f) {
+            bool any = false;
+            for (float value : nms_host) {
+                if (value > threshold) {
+                    any = true;
+                    break;
+                }
+            }
+            if (!any) {
+                threshold = 0.0f;
+                for (float value : nms_host) {
+                    threshold += value;
+                }
+                threshold /= static_cast<float>(count);
+            }
+        } else {
+            threshold = 0.0f;
+            for (float value : nms_host) {
+                threshold += value;
+            }
+            threshold /= static_cast<float>(count);
+        }
+        std::vector<float> score_host(static_cast<size_t>(count));
+        ggml_backend_tensor_get(score_map, score_host.data(), 0, score_host.size() * sizeof(float));
+        std::vector<std::pair<float, int32_t>> scored;
+        for (int32_t i = 0; i < count; ++i) {
+            if (nms_host[static_cast<size_t>(i)] > threshold) {
+                scored.emplace_back(score_host[static_cast<size_t>(i)], i);
+            }
+        }
+        std::sort(scored.begin(), scored.end(),
+                  [](const auto &a, const auto &b) { return a.first > b.first; });
+        if (static_cast<int32_t>(scored.size()) > n_limit) {
+            scored.resize(static_cast<size_t>(n_limit));
+        }
+        indices.reserve(scored.size());
+        for (const auto &entry : scored) {
+            indices.push_back(entry.second);
+        }
+    }
+
+    const int32_t kpt_count = static_cast<int32_t>(indices.size());
+    *out_count = kpt_count;
+    if (kpt_count == 0) {
+        return true;
+    }
+
+    std::vector<float> indices_f(static_cast<size_t>(indices.size()));
+    for (size_t i = 0; i < indices.size(); ++i) {
+        indices_f[i] = static_cast<float>(indices[static_cast<size_t>(i)]);
+    }
+    ggml_backend_tensor_set(indices_dev, indices_f.data(), 0, indices_f.size() * sizeof(float));
+    ggml_backend_synchronize(backend);
+
+    vk_aliked_push_dkd_refine rpc{static_cast<uint32_t>(kpt_count), static_cast<uint32_t>(h),
+                                  static_cast<uint32_t>(w), static_cast<uint32_t>(radius)};
+    vk_aliked_dispatch1(ctx, pipes.dkd_refine,
+                        {vk_aliked_subbuf(ctx, score_map), vk_aliked_subbuf(ctx, indices_dev),
+                         vk_aliked_subbuf(ctx, keypoints_norm), vk_aliked_subbuf(ctx, scores)},
+                        rpc, {static_cast<uint32_t>(kpt_count), 1, 1});
+    vk_aliked_finish(ctx);
+    return true;
+}
+
+bool ggml_vulkan_aliked_run_sddh(
+    ggml_backend_t backend, const ggml_tensor *feature_map, int32_t dim, int32_t h, int32_t w,
+    const ggml_tensor *keypoints_norm, int32_t count, int32_t kernel_size, int32_t n_pos,
+    const ggml_tensor *offset_0_w, const ggml_tensor *offset_0_b, const ggml_tensor *offset_2_w,
+    const ggml_tensor *offset_2_b, const ggml_tensor *sf_conv_w, const ggml_tensor *agg_weights,
+    ggml_tensor *workspace, ggml_tensor *descriptors) {
+    ggml_backend_vk_context *ctx = vk_aliked_ctx(backend);
+    if (ctx == nullptr || count <= 0) {
+        return false;
+    }
+    ggml_backend_synchronize(backend);
+    ctx->descriptor_set_idx = 0;
+    vk_aliked_pipelines &pipes = vk_aliked_ensure(ctx);
+    const uint32_t feature_off = vk_aliked_misalign_floats(ctx, feature_map);
+    const uint32_t kpt_off = vk_aliked_misalign_floats(ctx, keypoints_norm);
+    const uint32_t workspace_off = vk_aliked_misalign_floats(ctx, workspace);
+    const uint32_t desc_off = vk_aliked_misalign_floats(ctx, descriptors);
+
+    const int32_t num_batches = (count + kSddhBatchSize - 1) / kSddhBatchSize;
+
+    auto dispatch_batch = [&](int32_t start, int32_t batch) {
+        vk_aliked_push_sddh pc{static_cast<uint32_t>(dim), static_cast<uint32_t>(h),
+                               static_cast<uint32_t>(w), static_cast<uint32_t>(count),
+                               static_cast<uint32_t>(kernel_size), static_cast<uint32_t>(n_pos),
+                               feature_off, kpt_off, workspace_off, desc_off,
+                               static_cast<uint32_t>(start), static_cast<uint32_t>(batch),
+                               static_cast<uint32_t>(feature_map->nb[0]),
+                               static_cast<uint32_t>(feature_map->nb[1]),
+                               static_cast<uint32_t>(feature_map->nb[2])};
+        vk_aliked_dispatch1(
+            ctx, pipes.sddh,
+            {vk_aliked_subbuf(ctx, feature_map), vk_aliked_subbuf(ctx, keypoints_norm),
+             vk_aliked_subbuf(ctx, offset_0_w), vk_aliked_subbuf(ctx, offset_0_b),
+             vk_aliked_subbuf(ctx, offset_2_w), vk_aliked_subbuf(ctx, offset_2_b),
+             vk_aliked_subbuf(ctx, sf_conv_w), vk_aliked_subbuf(ctx, agg_weights),
+             vk_aliked_subbuf(ctx, workspace), vk_aliked_subbuf(ctx, descriptors)},
+            pc, {static_cast<uint32_t>(batch), 1, 1}, false);
+    };
+
+    if (vk_aliked_sddh_single_submit()) {
+        ggml_pipeline_request_descriptor_sets(ctx, pipes.sddh, static_cast<uint32_t>(num_batches));
+        for (int32_t start = 0; start < count; start += kSddhBatchSize) {
+            const int32_t batch = std::min(kSddhBatchSize, count - start);
+            dispatch_batch(start, batch);
+            if (start + batch < count) {
+                vk_aliked_compute_barrier(ctx);
+            }
+        }
+        vk_aliked_finish(ctx);
+        return true;
+    }
+
+    const int32_t finish_chunk = vk_aliked_sddh_finish_chunk();
+    for (int32_t chunk = 0; chunk < num_batches; chunk += finish_chunk) {
+        const int32_t chunk_batches =
+            std::min(finish_chunk, num_batches - chunk);
+        ggml_pipeline_request_descriptor_sets(ctx, pipes.sddh,
+                                              static_cast<uint32_t>(chunk_batches));
+        for (int32_t b = 0; b < chunk_batches; ++b) {
+            const int32_t batch_idx = chunk + b;
+            const int32_t start = batch_idx * kSddhBatchSize;
+            const int32_t batch = std::min(kSddhBatchSize, count - start);
+            dispatch_batch(start, batch);
+        }
+        vk_aliked_finish(ctx);
+    }
+    return true;
+}
