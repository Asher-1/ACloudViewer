+static __device__ void cpy_blck_q8_0_q8_0(const char * cxi, char * cdsti) {
+    // Raw byte copy of Q8_0 block (scale + quantized data)
+    const block_q8_0 * xi  = (const block_q8_0 *) cxi;
+    block_q8_0 *       dst = (block_q8_0 *) cdsti;
+    dst->d = xi->d;
+#pragma unroll
+    for (int j = 0; j < QK8_0; ++j) {
+        dst->qs[j] = xi->qs[j];
+    }
+}
