-#define GGML_METAL_MAX_COMMAND_BUFFERS 8
+#define GGML_METAL_MAX_COMMAND_BUFFERS 64
 
 struct ggml_metal_command_buffer {
     id<MTLCommandBuffer> obj;
@@ -189,6 +189,27 @@
 void ggml_metal_free(ggml_metal_t ctx) {
     GGML_LOG_INFO("%s: deallocating\n", __func__);
 
+    // ACV: wait for ALL command buffers to complete before releasing.
+    // ggml_metal_synchronize only waits for cmd_buf_last and checks
+    // status of the rest.  With dynamic n_cb (our Metal patch), the
+    // number of active command buffers can vary.  If synchronize hit
+    // an error and returned early, some buffers may still be in flight.
+    // waitUntilCompleted is safe even on completed or errored buffers.
+    if (ctx->cmd_buf_last) {
+        [ctx->cmd_buf_last waitUntilCompleted];
+        ctx->cmd_buf_last = nil;
+    }
+    for (int i = 0; i < GGML_METAL_MAX_COMMAND_BUFFERS + 1; ++i) {
+        if (ctx->cmd_bufs[i].obj) {
+            [ctx->cmd_bufs[i].obj waitUntilCompleted];
+        }
+    }
+    for (int i = 0; i < (int) ctx->cmd_bufs_ext.count; ++i) {
+        if (ctx->cmd_bufs_ext[i]) {
+            [ctx->cmd_bufs_ext[i] waitUntilCompleted];
+        }
+    }
+
     for (int i = 0; i < GGML_METAL_MAX_COMMAND_BUFFERS; ++i) {
         if (ctx->cmd_bufs[i].obj) {
             [ctx->cmd_bufs[i].obj release];
@@ -265,7 +286,11 @@
         }
     }
 
-    // release any completed extra command buffers
+    // ACV: check status of extra command buffers but do NOT release them.
+    // Ownership of cmd_bufs_ext belongs exclusively to ggml_metal_free.
+    // Releasing here would leave dangling pointers in the NSMutableArray,
+    // causing a use-after-free / double-release when ggml_metal_free runs
+    // after ggml_backend_metal_free calls us then ggml_metal_free.
     if (ctx->cmd_bufs_ext.count > 0) {
         for (size_t i = 0; i < ctx->cmd_bufs_ext.count; ++i) {
