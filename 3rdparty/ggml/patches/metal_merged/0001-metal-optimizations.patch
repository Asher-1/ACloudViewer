+        dst_ptr[i0] = (T) precise::tanh(x);
+    }
+    if (FC_OP == OP_UNARY_NUM_RELU) {
+        dst_ptr[i0] = (T) fmax(0, x);
+    }
+    if (FC_OP == OP_UNARY_NUM_SIGMOID) {
+        dst_ptr[i0] = (T) (1 / (1 + exp(-x)));
+    }
+    if (FC_OP == OP_UNARY_NUM_GELU) {
