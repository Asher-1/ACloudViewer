+// QK and AV stay in cuBLAS; this kernel fuses relative-position bias,
+// shifted-window masking and softmax in one pass over the logits.
+__global__ void rmbg_swin_masked_softmax_kernel(
+        float * logits, const float * rpb,
+        int N, int heads, int Hp, int Wp, int ws, int shift) {
+    const int query_index = (int) blockIdx.x;
+    const int batch = query_index / N;
+    const int q = query_index - batch * N;
+    const int head = batch % heads;
+    const int win = batch / heads;
+    const int lane = (int) threadIdx.x;
+    float * row = logits + (int64_t) N * N * batch + (int64_t) N * q;
+    const int windows_w = Wp / ws;
+    const int wh = (win / windows_w) * ws;
+    const int ww = (win % windows_w) * ws;
+    const int qregion = shift == 0 ? 0 :
+        rmbg_swin_region(wh + q / ws, Hp, ws, shift) * 3 +
+        rmbg_swin_region(ww + q % ws, Wp, ws, shift);
+
+    float max_logit = -INFINITY;
+    for (int k = lane; k < N; k += 32) {
+        float value = row[k] + rpb[k + N * (q + N * head)];
+        if (shift != 0) {
+            const int kregion = rmbg_swin_region(wh + k / ws, Hp, ws, shift) * 3 +
+                rmbg_swin_region(ww + k % ws, Wp, ws, shift);
+            if (qregion != kregion) {
+                value -= 100.0f;
+            }
+        }
+        row[k] = value;
+        max_logit = fmaxf(max_logit, value);
+    }
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        max_logit = fmaxf(max_logit, __shfl_down_sync(0xffffffffu, max_logit, offset));
+    }
+    max_logit = __shfl_sync(0xffffffffu, max_logit, 0);
+    float sum = 0.0f;
+    for (int k = lane; k < N; k += 32) {
+        const float e = expf(row[k] - max_logit);
+        row[k] = e;
+        sum += e;
+    }
+#pragma unroll
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        sum += __shfl_down_sync(0xffffffffu, sum, offset);
+    }
+    sum = __shfl_sync(0xffffffffu, sum, 0);
+    const float inv_sum = 1.0f / sum;
+    for (int k = lane; k < N; k += 32) {
+        row[k] *= inv_sum;
+    }
+}
+
+__global__ void rmbg_swin_pack_kernel(
+        const float * input, float * packed, int C, int H, int W,
+        int Hp, int Wp, int ws, int shift, int nW) {
+    const int64_t total = (int64_t) C * ws * ws * nW;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        const int c = (int) (index % C);
+        const int t = (int) ((index / C) % (ws * ws));
+        const int win = (int) (index / ((int64_t) C * ws * ws));
+        const int wh = (win / (Wp / ws)) * ws;
+        const int ww = (win % (Wp / ws)) * ws;
+        const int sh = (wh + t / ws + shift) % Hp;
+        const int sw = (ww + t % ws + shift) % Wp;
+        packed[index] = (sh < H && sw < W) ? input[c + (int64_t) C * (sh * W + sw)] : 0.0f;
+    }
+}
+
+__global__ void rmbg_swin_bias_kernel(float * data, const float * bias, int rows, int cols) {
+    const int64_t total = (int64_t) rows * cols;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        data[index] += bias[index % rows];
+    }
+}
+
+__global__ void rmbg_swin_unpack_kernel(
+        const float * packed, float * output, int C, int H, int W,
+        int Hp, int Wp, int ws, int shift) {
+    const int64_t total = (int64_t) C * H * W;
+    const int windows_w = Wp / ws;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        const int c = (int) (index % C);
+        const int pos = (int) (index / C);
+        const int h = pos / W;
+        const int w = pos - h * W;
+        const int rh = (h - shift + Hp) % Hp;
+        const int rw = (w - shift + Wp) % Wp;
+        const int win = (rh / ws) * windows_w + rw / ws;
+        const int t = (rh % ws) * ws + rw % ws;
+        output[index] = packed[c + (int64_t) C * (t + ws * ws * win)];
+    }
+}
