+static void ggml_vk_rmbg_deform_project(ggml_backend_vk_context * ctx, vk_context& subctx,
+                                          const ggml_tensor * input, const ggml_tensor * offset,
+                                          const ggml_tensor * modulator, const ggml_tensor * regular,
+                                          const ggml_tensor * bias, ggml_tensor * dst) {
+    GGML_ASSERT(input && offset && modulator && regular && bias &&
+                input->type == GGML_TYPE_F32 && offset->type == GGML_TYPE_F32 &&
+                modulator->type == GGML_TYPE_F32 && regular->type == GGML_TYPE_F16 &&
+                bias->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+                ggml_is_contiguous(input) && ggml_is_contiguous(offset) &&
+                ggml_is_contiguous(modulator) && ggml_is_contiguous(regular) &&
+                ggml_is_contiguous(bias) && ggml_is_contiguous(dst));
+    const uint32_t width = input->ne[0], height = input->ne[1], channels = input->ne[2];
+    const uint32_t kernel_w = regular->ne[0], kernel_h = regular->ne[1];
+    const uint32_t kernel = kernel_w * kernel_h, out_channels = regular->ne[3];
+    GGML_ASSERT(width && height && channels && kernel && kernel <= 9 &&
+                regular->ne[2] == channels && offset->ne[0] == width && offset->ne[1] == height &&
+                offset->ne[2] == 2 * kernel && modulator->ne[0] == width &&
+                modulator->ne[1] == height && modulator->ne[2] == kernel &&
+                dst->ne[0] == width && dst->ne[1] == height && dst->ne[2] == out_channels &&
+                bias->ne[0] == out_channels);
+
+    const bool coopmat = ggml_vk_is_rmbg_deform_project_cm1(dst);
+    vk_pipeline & pipeline = coopmat
+        ? ctx->device->pipeline_rmbg_deform_project_cm1
+        : ctx->device->pipeline_rmbg_deform_project_f32;
+    GGML_ASSERT(pipeline);
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+    const vk_op_rmbg_deform_project_push_constants pc {
+        (uint32_t) (get_misalign_bytes(ctx, input) / sizeof(float)),
+        (uint32_t) (get_misalign_bytes(ctx, offset) / sizeof(float)),
+        (uint32_t) (get_misalign_bytes(ctx, modulator) / sizeof(float)),
+        (uint32_t) (get_misalign_bytes(ctx, regular) / sizeof(uint16_t)),
+        (uint32_t) (get_misalign_bytes(ctx, bias) / sizeof(float)),
+        (uint32_t) (get_misalign_bytes(ctx, dst) / sizeof(float)),
+        width, height, channels, out_channels, kernel_w, kernel_h,
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline,
+                              {ggml_vk_tensor_subbuffer(ctx, input, true),
+                               ggml_vk_tensor_subbuffer(ctx, offset, true),
+                               ggml_vk_tensor_subbuffer(ctx, modulator, true),
+                               ggml_vk_tensor_subbuffer(ctx, regular, true),
+                               ggml_vk_tensor_subbuffer(ctx, bias, true),
+                               ggml_vk_tensor_subbuffer(ctx, dst, true)},
+                              // Each 256-thread CM1 workgroup produces a 16-position by
+                              // 128-channel tile (eight subgroups). dispatch_pipeline
+                              // converts elements to groups through wg_denoms.
+                              pc, coopmat ? std::array<uint32_t, 3>{width * height * 16u,
+                                      out_channels / 128u, 1u}
+                                  : std::array<uint32_t, 3>{width * height * 64u, 1u, 1u});
+}
