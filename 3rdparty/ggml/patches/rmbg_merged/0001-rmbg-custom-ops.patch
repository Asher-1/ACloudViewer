+// The four source positions are fixed by Swin patch merge. This avoids loading a
+// dynamic index tensor while preserving the exact gathered values for GGML LayerNorm.
+__global__ void rmbg_patch_merge_gather_kernel(
+        const float * input, float * merged, int C, int H, int W) {
+    const int row = (int) blockIdx.x;
+    const int out_w = W / 2;
+    const int oh = row / out_w;
+    const int ow = row - oh * out_w;
+    const int positions[4] = {
+        (2 * oh) * W + 2 * ow,
+        (2 * oh + 1) * W + 2 * ow,
+        (2 * oh) * W + 2 * ow + 1,
+        (2 * oh + 1) * W + 2 * ow + 1,
+    };
+    for (int j = (int) threadIdx.x; j < 4 * C; j += (int) blockDim.x) {
+        const int group = j / C;
+        const int channel = j - group * C;
+        merged[j + (int64_t) 4 * C * row] = input[channel + (int64_t) C * positions[group]];
+    }
+}
+
+__global__ void rmbg_image_patches_kernel(
+        const float * image, float * gathered,
+        int image_w, int patch_h, int patch_w, int gh, int gw) {
+    const int G = gh * gw;
+    const int P = patch_h * patch_w;
+    const int64_t total = (int64_t) 3 * G * P;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        const int channel = (int) (index % 3);
+        const int grid_pos = (int) ((index / 3) % G);
+        const int patch_pos = (int) (index / ((int64_t) 3 * G));
+        const int hg = grid_pos / gw;
+        const int wg = grid_pos - hg * gw;
+        const int hi = patch_pos / patch_w;
+        const int wi = patch_pos - hi * patch_w;
+        const int source = (hg * patch_h + hi) * image_w + wg * patch_w + wi;
+        gathered[index] = image[source + (int64_t) image_w * patch_h * gh * channel];
+    }
+}
