+    const float x = float(x_base) + float(tap % 3u) - 1.0 +
+        data_b[p.b_offset + position + hw * (2u * tap + 1u)];
+    const int y0 = int(floor(y));
+    const int x0 = int(floor(x));
+    const float dy = y - float(y0);
+    const float dx = x - float(x0);
+    float value = load_input(y0,     x0,     channel) * (1.0 - dy) * (1.0 - dx);
+    value +=      load_input(y0,     x0 + 1, channel) * (1.0 - dy) * dx;
+    value +=      load_input(y0 + 1, x0,     channel) * dy * (1.0 - dx);
+    value +=      load_input(y0 + 1, x0 + 1, channel) * dy * dx;
+    const float modulator = data_c[p.c_offset + position + hw * tap];
+    return value * (2.0 / (1.0 + exp(-modulator)));
+}
+
+void main() {
+    const uint tile_position = gl_WorkGroupID.x * TILE;
+    const uint subgroup = gl_SubgroupID;
+    const uint tile_output = (gl_WorkGroupID.y * OUTPUT_TILES + subgroup) * TILE;
+    const uint tid = gl_LocalInvocationID.x;
+    const uint subgroup_tid = gl_SubgroupInvocationID;
+    const uint hw = p.width * p.height;
+    const uint k_total = p.channels * 9u;
+
+    coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator> sum =
+        coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>(0.0);
+
+    // k_total is a multiple of 16 for the eligible RMBG 3x3 layers.
+    for (uint k_base = 0; k_base < k_total; k_base += TILE) {
+        // The first subgroup produces the shared sample tile once.  All eight
+        // projection subgroups consume it for disjoint output-channel tiles.
+        if (subgroup == 0u) {
+            for (uint i = subgroup_tid; i < TILE * TILE / 4u; i += 32u) {
+                const uint scalar = 4u * i;
+                const uint k = k_base + scalar / TILE;
+                const uint position = tile_position + scalar % TILE;
+                samples[i] = f16vec4(
+                    float16_t(sample_bilinear(position + 0u, k / 9u, k % 9u)),
+                    float16_t(sample_bilinear(position + 1u, k / 9u, k % 9u)),
+                    float16_t(sample_bilinear(position + 2u, k / 9u, k % 9u)),
+                    float16_t(sample_bilinear(position + 3u, k / 9u, k % 9u)));
+            }
+        }
+        for (uint i = subgroup_tid; i < TILE * TILE / 4u; i += 32u) {
+            const uint scalar = 4u * i;
+            const uint out_channel = tile_output + scalar / TILE;
+            const uint weight_base = p.r_offset + out_channel * k_total + k_base + scalar % TILE;
+            weights[subgroup * (TILE * TILE / 4u) + i] =
+                f16vec4(data_r[weight_base + 0u], data_r[weight_base + 1u],
+                        data_r[weight_base + 2u], data_r[weight_base + 3u]);
+        }
+        barrier();
+
+        coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA> weight;
+        coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB> sample_mat;
+        coopMatLoad(weight, weights, subgroup * (TILE * TILE / 4u), TILE / 4u,
+                    gl_CooperativeMatrixLayoutRowMajor);
+        coopMatLoad(sample_mat, samples, 0, TILE / 4u, gl_CooperativeMatrixLayoutRowMajor);
+        sum = coopMatMulAdd(weight, sample_mat, sum);
+        barrier();
+    }
+
+    coopMatStore(sum, projection, subgroup * TILE * TILE, TILE,
+                 gl_CooperativeMatrixLayoutRowMajor);
+    barrier();
+    for (uint i = subgroup_tid; i < TILE * TILE; i += 32u) {
+        const uint out_channel = tile_output + i / TILE;
+        const uint position = tile_position + i % TILE;
+        data_d[p.d_offset + position + hw * out_channel] =
+            projection[subgroup * TILE * TILE + i] + data_bias[p.bias_offset + out_channel];
+    }
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_gather.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_gather.comp
new file mode 100644
index 0000000..6cbfbca
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_gather.comp
@@ -0,0 +1,60 @@
+#version 450
+
+// Exact F32 gathers used by RMBG's patch embedding and Swin patch merge. The
+// indices are implicit in the tensor shape, so this avoids a device index
+// tensor and a generic GET_ROWS dispatch without changing any values.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint d_offset;
+    uint channels;
+    uint height;
+    uint width;
+    uint patch_h;
+    uint patch_w;
+    uint kind;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+
+    if (p.kind == 0u) {
+        const uint row_width = p.width / 2u;
+        const uint row = idx / (4u * p.channels);
+        const uint component = idx - row * 4u * p.channels;
+        const uint group = component / p.channels;
+        const uint channel = component - group * p.channels;
+        if (row >= (p.height / 2u) * row_width) return;
+
+        const uint oh = row / row_width;
+        const uint ow = row - oh * row_width;
+        const uint positions[4] = uint[4](
+            (2u * oh) * p.width + 2u * ow,
+            (2u * oh + 1u) * p.width + 2u * ow,
+            (2u * oh) * p.width + 2u * ow + 1u,
+            (2u * oh + 1u) * p.width + 2u * ow + 1u);
+        data_d[p.d_offset + idx] = data_a[p.a_offset + channel + p.channels * positions[group]];
+        return;
+    }
+
+    const uint grid_h = p.height / p.patch_h;
+    const uint grid_w = p.width / p.patch_w;
+    const uint grid_count = grid_h * grid_w;
+    const uint patch_count = p.patch_h * p.patch_w;
+    const uint total = p.channels * grid_count * patch_count;
+    if (idx >= total) return;
+
+    const uint channel = idx % p.channels;
+    const uint grid_pos = (idx / p.channels) % grid_count;
+    const uint patch_pos = idx / (p.channels * grid_count);
+    const uint gh = grid_pos / grid_w;
+    const uint gw = grid_pos - gh * grid_w;
+    const uint hi = patch_pos / p.patch_w;
+    const uint wi = patch_pos - hi * p.patch_w;
+    const uint source = (gh * p.patch_h + hi) * p.width + gw * p.patch_w + wi;
+    data_d[p.d_offset + idx] = data_a[p.a_offset + source + p.width * p.height * channel];
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_swin_qkv_layout.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_swin_qkv_layout.comp
new file mode 100644
index 0000000..f5fb888
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_swin_qkv_layout.comp
@@ -0,0 +1,37 @@
+#version 450
+
+// QKV bias, split, and head-major layout in one strict-F32 pass. Destination
+// is [head_dim=32, token=144, head, window], matching ggml MUL_MAT inputs.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint b_offset;
+    uint d_offset;
+    uint tokens;
+    uint heads;
+    uint windows;
+    uint kind;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) readonly buffer B { float data_b[]; };
+layout (binding = 2) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+const uint HEAD_DIM = 32u;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    const uint total = HEAD_DIM * p.tokens * p.heads * p.windows;
+    if (idx >= total) return;
+
+    const uint lane = idx % HEAD_DIM;
+    const uint token = (idx / HEAD_DIM) % p.tokens;
+    const uint head = (idx / (HEAD_DIM * p.tokens)) % p.heads;
+    const uint window = idx / (HEAD_DIM * p.tokens * p.heads);
+    const uint channels = HEAD_DIM * p.heads;
+    const uint channel = lane + HEAD_DIM * head;
+    const uint qkv_channel = channel + p.kind * channels;
+    const uint source = qkv_channel + 3u * channels * (token + p.tokens * window);
+    data_d[p.d_offset + idx] = data_a[p.a_offset + source] + data_b[p.b_offset + qkv_channel];
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_swin_windows.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_swin_windows.comp
new file mode 100644
index 0000000..9b21cd4
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_swin_windows.comp
@@ -0,0 +1,57 @@
+#version 450
+
+// Exact Swin-L window transform. The destination layout is C x 144 x nWindows
+// for pack and C x (H*W) for unpack. Window coordinates and shifted padding are
+// implicit, so no index tensors or generic GET_ROWS dispatches are required.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint d_offset;
+    uint channels;
+    uint height;
+    uint width;
+    uint shift;
+    uint kind;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+const uint WINDOW = 12u;
+const uint TOKENS = WINDOW * WINDOW;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    const uint hp = ((p.height + WINDOW - 1u) / WINDOW) * WINDOW;
+    const uint wp = ((p.width + WINDOW - 1u) / WINDOW) * WINDOW;
+    const uint windows_w = wp / WINDOW;
+
+    if (p.kind == 0u) {
+        const uint windows = (hp / WINDOW) * windows_w;
+        const uint total = p.channels * TOKENS * windows;
+        if (idx >= total) return;
+        const uint channel = idx % p.channels;
+        const uint t = (idx / p.channels) % TOKENS;
+        const uint window = idx / (p.channels * TOKENS);
+        const uint rh = (window / windows_w) * WINDOW + t / WINDOW;
+        const uint rw = (window % windows_w) * WINDOW + t % WINDOW;
+        const uint sh = (rh + p.shift) % hp;
+        const uint sw = (rw + p.shift) % wp;
+        data_d[p.d_offset + idx] = (sh < p.height && sw < p.width)
+            ? data_a[p.a_offset + channel + p.channels * (sh * p.width + sw)] : 0.0;
+        return;
+    }
+
+    const uint total = p.channels * p.height * p.width;
+    if (idx >= total) return;
+    const uint channel = idx % p.channels;
+    const uint pos = idx / p.channels;
+    const uint h = pos / p.width;
+    const uint w = pos - h * p.width;
+    const uint rh = (h + hp - p.shift) % hp;
+    const uint rw = (w + wp - p.shift) % wp;
+    const uint window = (rh / WINDOW) * windows_w + rw / WINDOW;
+    const uint t = (rh % WINDOW) * WINDOW + rw % WINDOW;
+    data_d[p.d_offset + idx] = data_a[p.a_offset + channel + p.channels * (t + TOKENS * window)];
+}
