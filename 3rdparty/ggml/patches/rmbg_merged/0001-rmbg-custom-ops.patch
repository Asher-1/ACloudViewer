new file mode 100644
index 0000000..6caac96
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_affine_relu.comp
@@ -0,0 +1,30 @@
+#version 450
+
+// Fused BatchNorm affine transform and ReLU for decoder feature maps.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint b_offset;
+    uint c_offset;
+    uint d_offset;
+    uint width;
+    uint height;
+    uint channels;
+    uint relu;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) readonly buffer B { float data_b[]; };
+layout (binding = 2) readonly buffer C { float data_c[]; };
+layout (binding = 3) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    const uint total = p.width * p.height * p.channels;
+    if (idx >= total) return;
+    const uint channel = idx / (p.width * p.height);
+    const float value = data_a[p.a_offset + idx] * data_b[p.b_offset + channel] +
+                        data_c[p.c_offset + channel];
+    data_d[p.d_offset + idx] = p.relu != 0 ? max(0.0, value) : value;
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_deform_im2col.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_deform_im2col.comp
new file mode 100644
index 0000000..7c44b06
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_deform_im2col.comp
@@ -0,0 +1,59 @@
+#version 450
+
+// RMBG deformable sampling is indexed independently for every output element.
+// Materializing it with generic graph nodes creates a C*K by H*W tensor through
+// many layout and gather operations. This computes the identical bilinear sample
+// directly into that tensor, retaining F32 arithmetic for the parity path.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint b_offset;
+    uint c_offset;
+    uint d_offset;
+    uint width;
+    uint height;
+    uint channels;
+    uint kernel_w;
+    uint kernel_h;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) readonly buffer B { float data_b[]; };
+layout (binding = 2) readonly buffer C { float data_c[]; };
+layout (binding = 3) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+float sample_input(const int y, const int x, const uint channel) {
+    if (y < 0 || y >= int(p.height) || x < 0 || x >= int(p.width)) return 0.0;
+    const uint hw = p.height * p.width;
+    return data_a[p.a_offset + uint(x) + p.width * uint(y) + hw * channel];
+}
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    const uint hw = p.height * p.width;
+    const uint kernel = p.kernel_h * p.kernel_w;
+    const uint total = hw * p.channels * kernel;
+    if (idx >= total) return;
+
+    const uint kc = idx % (p.channels * kernel);
+    const uint pos = idx / (p.channels * kernel);
+    const uint k = kc % kernel;
+    const uint channel = kc / kernel;
+    const uint y_base = pos / p.width;
+    const uint x_base = pos - y_base * p.width;
+    const float y = float(y_base) + float(k / p.kernel_w) - float(p.kernel_h / 2u) +
+        data_b[p.b_offset + pos + hw * (2u * k)];
+    const float x = float(x_base) + float(k % p.kernel_w) - float(p.kernel_w / 2u) +
+        data_b[p.b_offset + pos + hw * (2u * k + 1u)];
+    const int y0 = int(floor(y));
+    const int x0 = int(floor(x));
+    const float dy = y - float(y0);
+    const float dx = x - float(x0);
+    float value = sample_input(y0, x0, channel) * (1.0 - dy) * (1.0 - dx);
+    value += sample_input(y0, x0 + 1, channel) * (1.0 - dy) * dx;
+    value += sample_input(y0 + 1, x0, channel) * dy * (1.0 - dx);
+    value += sample_input(y0 + 1, x0 + 1, channel) * dy * dx;
+    const float modulator = data_c[p.c_offset + pos + hw * k];
+    data_d[p.d_offset + idx] = value * (2.0 / (1.0 + exp(-modulator)));
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/rmbg_deform_project.comp b/src/ggml-vulkan/vulkan-shaders/rmbg_deform_project.comp
new file mode 100644
index 0000000..0967554
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/rmbg_deform_project.comp
@@ -0,0 +1,103 @@
+#version 450
+
+// One workgroup owns one spatial position. It creates only a small C-tile of
+// bilinear samples in shared memory, then projects it directly to output
+// channels. No C*K by H*W column matrix is materialized.
+layout (push_constant) uniform parameter {
+    uint a_offset;
+    uint b_offset;
+    uint c_offset;
+    uint r_offset;
+    uint bias_offset;
+    uint d_offset;
+    uint width;
+    uint height;
+    uint channels;
+    uint out_channels;
+    uint kernel_w;
+    uint kernel_h;
+} p;
+
+layout (binding = 0) readonly buffer A { float data_a[]; };
+layout (binding = 1) readonly buffer B { float data_b[]; };
+layout (binding = 2) readonly buffer C { float data_c[]; };
+// F16 checkpoint weights stay compact. They are expanded only at the F32
+// multiply, so the sampler is bandwidth-limited by activations rather than
+// an unnecessary F32 weight copy.
+layout (binding = 3) readonly buffer R { uint data_r[]; };
+layout (binding = 4) readonly buffer Bias { float data_bias[]; };
+layout (binding = 5) writeonly buffer D { float data_d[]; };
+
+layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+const uint CHANNEL_TILE = 8u;
+const uint MAX_KERNEL = 9u;
+shared float sample_y[MAX_KERNEL];
+shared float sample_x[MAX_KERNEL];
+shared float sample_mask[MAX_KERNEL];
+shared float samples[CHANNEL_TILE * MAX_KERNEL];
+
+float load_input(int y, int x, uint channel) {
+    if (y < 0 || y >= int(p.height) || x < 0 || x >= int(p.width)) return 0.0;
+    return data_a[p.a_offset + uint(x) + p.width * uint(y) +
+                  p.width * p.height * channel];
+}
+
+float sample_bilinear(float y, float x, uint channel) {
+    const int y0 = int(floor(y));
+    const int x0 = int(floor(x));
+    const float dy = y - float(y0);
+    const float dx = x - float(x0);
+    float value = load_input(y0, x0, channel) * (1.0 - dy) * (1.0 - dx);
+    value += load_input(y0, x0 + 1, channel) * (1.0 - dy) * dx;
+    value += load_input(y0 + 1, x0, channel) * dy * (1.0 - dx);
+    value += load_input(y0 + 1, x0 + 1, channel) * dy * dx;
+    return value;
+}
+
+float load_weight(uint index) {
+    const uint packed = data_r[(p.r_offset + index) / 2u];
+    const vec2 values = unpackHalf2x16(packed);
+    return ((p.r_offset + index) & 1u) == 0u ? values.x : values.y;
+}
+
+void main() {
+    const uint position = gl_WorkGroupID.x;
+    const uint tid = gl_LocalInvocationID.x;
+    const uint hw = p.width * p.height;
+    const uint kernel = p.kernel_w * p.kernel_h;
+    if (position >= hw || kernel > MAX_KERNEL) return;
+
+    if (tid < kernel) {
+        const uint y_base = position / p.width;
+        const uint x_base = position - y_base * p.width;
+        sample_y[tid] = float(y_base) + float(tid / p.kernel_w) - float(p.kernel_h / 2u) +
+            data_b[p.b_offset + position + hw * (2u * tid)];
+        sample_x[tid] = float(x_base) + float(tid % p.kernel_w) - float(p.kernel_w / 2u) +
+            data_b[p.b_offset + position + hw * (2u * tid + 1u)];
+        sample_mask[tid] = 2.0 / (1.0 + exp(-data_c[p.c_offset + position + hw * tid]));
+    }
+    barrier();
+
+    for (uint out_channel = tid; out_channel < p.out_channels; out_channel += 64u) {
+        float sum = data_bias[p.bias_offset + out_channel];
+        for (uint channel_base = 0u; channel_base < p.channels; channel_base += CHANNEL_TILE) {
+            const uint tile_channels = min(CHANNEL_TILE, p.channels - channel_base);
+            for (uint i = tid; i < tile_channels * kernel; i += 64u) {
+                const uint channel = channel_base + i / kernel;
+                const uint tap = i % kernel;
+                samples[i] = sample_bilinear(sample_y[tap], sample_x[tap], channel) * sample_mask[tap];
+            }
+            barrier();
+            for (uint local_channel = 0u; local_channel < tile_channels; ++local_channel) {
+                const uint channel = channel_base + local_channel;
+                for (uint tap = 0u; tap < kernel; ++tap) {
+                    const uint weight_index = tap + kernel * (channel + p.channels * out_channel);
+                    sum += samples[local_channel * kernel + tap] * load_weight(weight_index);
+                }
+            }
+            barrier();
+        }
+        data_d[p.d_offset + position + hw * out_channel] = sum;
+    }
+}
