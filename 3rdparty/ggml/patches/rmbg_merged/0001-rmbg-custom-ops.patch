+bool ggml_cuda_is_rmbg_swin_attention(const ggml_tensor * dst) {
+    return dst && dst->op == GGML_OP_CUSTOM &&
+           std::strncmp(ggml_get_name(dst), kSwinAttentionName,
+                        std::strlen(kSwinAttentionName)) == 0;
+}
+
+void ggml_cuda_op_rmbg_swin_attention(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * input = dst->src[0];
+    const ggml_tensor * qkv_weight = dst->src[1];
+    const ggml_tensor * qkv_bias = dst->src[2];
+    const ggml_tensor * proj_weight = dst->src[3];
+    const ggml_tensor * proj_bias = dst->src[4];
+    const ggml_tensor * rpb = dst->src[5];
+    GGML_ASSERT(input && qkv_weight && qkv_bias && proj_weight && proj_bias && rpb);
+    GGML_ASSERT(input->type == GGML_TYPE_F32 && qkv_weight->type == GGML_TYPE_F32 &&
+                qkv_bias->type == GGML_TYPE_F32 && proj_weight->type == GGML_TYPE_F32 &&
+                proj_bias->type == GGML_TYPE_F32 && rpb->type == GGML_TYPE_F32 &&
+                dst->type == GGML_TYPE_F32);
+
+    int H = 0, W = 0, shift = 0;
+    GGML_ASSERT(std::sscanf(ggml_get_name(dst), "rmbg_swin_attn_h%d_w%d_sh%d",
+                            &H, &W, &shift) == 3);
+    constexpr int ws = 12;
+    constexpr int N = ws * ws;
+    const int C = (int) input->ne[0];
+    const int heads = C / 32;
+    const int Hp = H + (ws - H % ws) % ws;
+    const int Wp = W + (ws - W % ws) % ws;
+    const int nW = (Hp / ws) * (Wp / ws);
+    const int cols = N * nW;
+    GGML_ASSERT(C % 32 == 0 && input->ne[1] == (int64_t) H * W);
+    const bool qkv_nn = rmbg_is_nn_weight(qkv_weight);
+    const bool proj_nn = rmbg_is_nn_weight(proj_weight);
+    GGML_ASSERT((qkv_weight->ne[0] == C && qkv_weight->ne[1] == 3 * C) ||
+                (qkv_nn && qkv_weight->ne[0] == 3 * C && qkv_weight->ne[1] == C));
+    GGML_ASSERT(proj_weight->ne[0] == C && proj_weight->ne[1] == C);
+    GGML_ASSERT(rpb->ne[0] == N && rpb->ne[1] == N && rpb->ne[2] == heads);
+
+    ggml_cuda_pool_alloc<float> packed(ctx.pool(), (size_t) C * cols);
+    ggml_cuda_pool_alloc<float> qkv(ctx.pool(), (size_t) 3 * C * cols);
+    ggml_cuda_pool_alloc<float> q(ctx.pool(), (size_t) C * cols);
+    ggml_cuda_pool_alloc<float> k(ctx.pool(), (size_t) C * cols);
+    ggml_cuda_pool_alloc<float> v(ctx.pool(), (size_t) C * cols);
+    ggml_cuda_pool_alloc<float> logits(ctx.pool(), (size_t) N * N * heads * nW);
+    ggml_cuda_pool_alloc<float> head_output(ctx.pool(), (size_t) C * cols);
+    ggml_cuda_pool_alloc<float> attended(ctx.pool(), (size_t) C * cols);
+    ggml_cuda_pool_alloc<float> projected(ctx.pool(), (size_t) C * cols);
+    constexpr int threads = 256;
+    const int pack_blocks = (int) std::min<int64_t>(
+        ((int64_t) C * cols + threads - 1) / threads, 65535);
+    rmbg_swin_pack_kernel<<<pack_blocks, threads, 0, ctx.stream()>>>(
+        (const float *) input->data, packed.get(), C, H, W, Hp, Wp, ws, shift, nW);
+
+    rmbg_swin_gemm(ctx, (const float *) qkv_weight->data, packed.get(), qkv.get(),
+                   3 * C, cols, C, qkv_nn);
+    const int qkv_blocks = (int) std::min<int64_t>(
+        ((int64_t) C * cols + threads - 1) / threads, 65535);
+    rmbg_swin_qkv_split_kernel<<<qkv_blocks, threads, 0, ctx.stream()>>>(
+        qkv.get(), (const float *) qkv_bias->data, q.get(), k.get(), v.get(),
+        C, N, heads, nW);
+
+    const int batches = nW * heads;
+    const float scale = 1.0f / std::sqrt(32.0f);
+    const float one = 1.0f;
+    const float zero = 0.0f;
+    CUBLAS_CHECK(cublasSetStream(ctx.cublas_handle(), ctx.stream()));
+    CUBLAS_CHECK(cublasSgemmStridedBatched(ctx.cublas_handle(), CUBLAS_OP_T, CUBLAS_OP_N,
+        N, N, 32, &scale, k.get(), 32, (long long) 32 * N,
+        q.get(), 32, (long long) 32 * N, &zero, logits.get(), N,
+        (long long) N * N, batches));
+    rmbg_swin_masked_softmax_kernel<<<batches * N, 32, 0, ctx.stream()>>>(
+        logits.get(), (const float *) rpb->data, N, heads, Hp, Wp, ws, shift);
+    CUBLAS_CHECK(cublasSgemmStridedBatched(ctx.cublas_handle(), CUBLAS_OP_N, CUBLAS_OP_N,
+        32, N, N, &one, v.get(), 32, (long long) 32 * N,
+        logits.get(), N, (long long) N * N, &zero, head_output.get(), 32,
+        (long long) 32 * N, batches));
+    rmbg_swin_merge_heads_kernel<<<qkv_blocks, threads, 0, ctx.stream()>>>(
+        head_output.get(), attended.get(), C, N, heads, nW);
+
+    rmbg_swin_gemm(ctx, (const float *) proj_weight->data, attended.get(), projected.get(),
+                   C, cols, C, proj_nn);
+    const int proj_blocks = (int) std::min<int64_t>(
+        ((int64_t) C * cols + threads - 1) / threads, 65535);
+    rmbg_swin_bias_kernel<<<proj_blocks, threads, 0, ctx.stream()>>>(
+        projected.get(), (const float *) proj_bias->data, C, cols);
+    rmbg_swin_unpack_kernel<<<pack_blocks, threads, 0, ctx.stream()>>>(
+        projected.get(), (float *) dst->data, C, H, W, Hp, Wp, ws, shift);
+}
