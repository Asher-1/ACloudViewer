+bool ggml_cuda_is_rmbg_image_patches(const ggml_tensor * dst) {
+    return dst && dst->op == GGML_OP_CUSTOM &&
+           std::strncmp(ggml_get_name(dst), kImagePatchesName,
+                        std::strlen(kImagePatchesName)) == 0;
+}
+
+void ggml_cuda_op_rmbg_image_patches(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * image = dst->src[0];
+    GGML_ASSERT(image && image->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    int patch_h = 0, patch_w = 0;
+    GGML_ASSERT(std::sscanf(ggml_get_name(dst), "rmbg_image_patches_ph%d_pw%d",
+                            &patch_h, &patch_w) == 2);
+    const int image_w = (int) image->ne[0];
+    const int image_h = (int) image->ne[1];
+    const int gh = image_h / patch_h;
+    const int gw = image_w / patch_w;
+    const int G = gh * gw;
+    const int P = patch_h * patch_w;
+    GGML_ASSERT(image->ne[2] == 3 && image_h % patch_h == 0 && image_w % patch_w == 0 &&
+                dst->ne[0] == 3 && dst->ne[1] == (int64_t) G * P);
+    constexpr int threads = 256;
+    const int blocks = (int) std::min<int64_t>(((int64_t) 3 * G * P + threads - 1) / threads, 65535);
+    rmbg_image_patches_kernel<<<blocks, threads, 0, ctx.stream()>>>(
+        (const float *) image->data, (float *) dst->data,
+        image_w, patch_h, patch_w, gh, gw);
+}
