+__device__ __forceinline__ float sample_bilinear(
+        const float * input, int w, int h, int hw, int channel, float y, float x) {
+    const int y0 = (int) floorf(y);
+    const int x0 = (int) floorf(x);
+    const int y1 = y0 + 1;
+    const int x1 = x0 + 1;
+    const float dy = y - (float) y0;
+    const float dx = x - (float) x0;
+    const int base = channel * hw;
+    float value = 0.0f;
+    if ((unsigned) y0 < (unsigned) h && (unsigned) x0 < (unsigned) w) {
+        value += input[base + y0 * w + x0] * (1.0f - dy) * (1.0f - dx);
+    }
+    if ((unsigned) y0 < (unsigned) h && (unsigned) x1 < (unsigned) w) {
+        value += input[base + y0 * w + x1] * (1.0f - dy) * dx;
+    }
+    if ((unsigned) y1 < (unsigned) h && (unsigned) x0 < (unsigned) w) {
+        value += input[base + y1 * w + x0] * dy * (1.0f - dx);
+    }
+    if ((unsigned) y1 < (unsigned) h && (unsigned) x1 < (unsigned) w) {
+        value += input[base + y1 * w + x1] * dy * dx;
+    }
+    return value;
+}
+
+#ifdef GGML_CUDA_RMBG_CUDNN
+
+#define CUDNN_CHECK(expr) do { \
+    const cudnnStatus_t status_ = (expr); \
+    GGML_ASSERT(status_ == CUDNN_STATUS_SUCCESS); \
+} while (0)
+
+struct CudnnHandle {
+    cudnnHandle_t value = nullptr;
+    CudnnHandle() { CUDNN_CHECK(cudnnCreate(&value)); }
+    ~CudnnHandle() { if (value) cudnnDestroy(value); }
+};
+
+struct rmbg_cudnn_key {
+    std::array<int, 15> values;
+
+    bool operator==(const rmbg_cudnn_key & other) const {
+        return values == other.values;
+    }
+};
+
+struct rmbg_cudnn_key_hash {
+    size_t operator()(const rmbg_cudnn_key & key) const {
+        size_t hash = 0;
+        for (const int value : key.values) {
+            hash ^= (size_t) value + 0x9e3779b9u + (hash << 6) + (hash >> 2);
+        }
+        return hash;
+    }
+};
+
+struct rmbg_cudnn_plan {
+    cudnnTensorDescriptor_t x = nullptr;
+    cudnnTensorDescriptor_t y = nullptr;
+    cudnnFilterDescriptor_t w = nullptr;
+    cudnnConvolutionDescriptor_t conv = nullptr;
+    cudnnConvolutionFwdAlgo_t algorithm = CUDNN_CONVOLUTION_FWD_ALGO_IMPLICIT_GEMM;
+    size_t workspace_size = 0;
+
+    ~rmbg_cudnn_plan() {
+        if (conv) cudnnDestroyConvolutionDescriptor(conv);
+        if (w) cudnnDestroyFilterDescriptor(w);
+        if (y) cudnnDestroyTensorDescriptor(y);
+        if (x) cudnnDestroyTensorDescriptor(x);
+    }
+};
+
+struct rmbg_cudnn_device_cache {
+    CudnnHandle handle;
+    std::unordered_map<rmbg_cudnn_key, std::unique_ptr<rmbg_cudnn_plan>,
+                       rmbg_cudnn_key_hash> plans;
+};
+
+static rmbg_cudnn_device_cache & rmbg_cudnn_cache_for_device(int device) {
+    thread_local std::unordered_map<int, std::unique_ptr<rmbg_cudnn_device_cache>> caches;
+    auto & cache = caches[device];
+    if (!cache) cache.reset(new rmbg_cudnn_device_cache());
+    return *cache;
+}
+
+static rmbg_cudnn_plan & rmbg_cudnn_get_plan(
+        rmbg_cudnn_device_cache & cache, const rmbg_cudnn_key & key,
+        bool conv_tf32) {
+    auto found = cache.plans.find(key);
+    if (found != cache.plans.end()) return *found->second;
+
+    std::unique_ptr<rmbg_cudnn_plan> plan(new rmbg_cudnn_plan());
+    const auto & v = key.values;
+    CUDNN_CHECK(cudnnCreateTensorDescriptor(&plan->x));
+    CUDNN_CHECK(cudnnCreateTensorDescriptor(&plan->y));
+    CUDNN_CHECK(cudnnCreateFilterDescriptor(&plan->w));
+    CUDNN_CHECK(cudnnCreateConvolutionDescriptor(&plan->conv));
+    CUDNN_CHECK(cudnnSetTensor4dDescriptor(plan->x, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+        v[0], v[1], v[2], v[3]));
+    CUDNN_CHECK(cudnnSetTensor4dDescriptor(plan->y, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+        v[4], v[5], v[6], v[7]));
+    CUDNN_CHECK(cudnnSetFilter4dDescriptor(plan->w, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW,
+        v[8], v[9], v[10], v[11]));
+    CUDNN_CHECK(cudnnSetConvolution2dDescriptor(plan->conv, v[13], v[13], v[12], v[12],
+        1, 1, CUDNN_CROSS_CORRELATION, CUDNN_DATA_FLOAT));
+    CUDNN_CHECK(cudnnSetConvolutionMathType(plan->conv,
+        conv_tf32 ? CUDNN_TENSOR_OP_MATH : CUDNN_FMA_MATH));
+
+    constexpr size_t max_workspace = 512ull * 1024 * 1024;
+    cudnnConvolutionFwdAlgoPerf_t perf[8];
+    int returned = 0;
+    CUDNN_CHECK(cudnnGetConvolutionForwardAlgorithm_v7(cache.handle.value, plan->x, plan->w,
+        plan->conv, plan->y, 8, &returned, perf));
+    for (int i = 0; i < returned; ++i) {
+        if (perf[i].status == CUDNN_STATUS_SUCCESS && perf[i].memory <= max_workspace) {
+            plan->algorithm = perf[i].algo;
+            plan->workspace_size = perf[i].memory;
+            break;
+        }
+    }
+    auto inserted = cache.plans.emplace(key, std::move(plan));
+    return *inserted.first->second;
+}
+
+static void rmbg_cudnn_conv2d(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * kernel = dst->src[0];
+    const ggml_tensor * input = dst->src[1];
+    int stride = 0, pad = 0;
+    GGML_ASSERT(std::sscanf(ggml_get_name(dst), "rmbg_conv2d_s%d_p%d", &stride, &pad) == 2);
+    // cuDNN's TF32 convolution was measured at parity 1.92e-3 (vs 1.32e-3 for
+    // FP32 conv) with no latency gain on RTX 3060 — the heuristic picks the
+    // same implicit-GEMM algorithm either way.  Keep FP32 by default;
+    // RMBG_CUDA_CONV_TF32=1 re-enables tensor-core convolution.
+    static const bool conv_tf32 = [] {
+        const char * opt = std::getenv("RMBG_CUDA_CONV_TF32");
+        return opt && opt[0] && opt[0] != '0';
+    }();
+    rmbg_cudnn_device_cache & cache = rmbg_cudnn_cache_for_device(ctx.device);
+    CUDNN_CHECK(cudnnSetStream(cache.handle.value, ctx.stream()));
+    const rmbg_cudnn_key key {{
+        (int) input->ne[3], (int) input->ne[2], (int) input->ne[1], (int) input->ne[0],
+        (int) dst->ne[3], (int) dst->ne[2], (int) dst->ne[1], (int) dst->ne[0],
+        (int) kernel->ne[3], (int) kernel->ne[2], (int) kernel->ne[1], (int) kernel->ne[0],
+        stride, pad, conv_tf32 ? 1 : 0,
+    }};
+    rmbg_cudnn_plan & plan = rmbg_cudnn_get_plan(cache, key, conv_tf32);
+    ggml_cuda_pool_alloc<uint8_t> workspace(ctx.pool());
+    if (plan.workspace_size) workspace.alloc(plan.workspace_size);
+    const float alpha = 1.f, beta = 0.f;
+    CUDNN_CHECK(cudnnConvolutionForward(cache.handle.value, &alpha, plan.x, input->data,
+        plan.w, kernel->data, plan.conv, plan.algorithm, workspace.ptr, plan.workspace_size,
+        &beta, plan.y, dst->data));
+}
+
+#endif
