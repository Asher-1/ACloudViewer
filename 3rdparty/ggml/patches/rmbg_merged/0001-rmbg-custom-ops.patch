+    size_t start = 0;
+    while (start <= filters.size()) {
+        const size_t end = filters.find(',', start);
+        const size_t length = (end == std::string::npos ? filters.size() : end) - start;
+        const std::string token = filters.substr(start, length);
+        if (token == "*" || (!token.empty() &&
+            (ggml_vk_rmbg_tensor_matches(src0, token) ||
+             ggml_vk_rmbg_tensor_matches(src1, token) ||
+             ggml_vk_rmbg_tensor_matches(dst, token)))) {
+            return false;
+        }
+        if (end == std::string::npos) {
+            break;
+        }
