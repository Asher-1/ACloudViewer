+static void ggml_vk_rmbg_gather(ggml_backend_vk_context * ctx, vk_context& subctx,
+                                 const ggml_tensor * src0, ggml_tensor * dst) {
+    GGML_ASSERT(src0 && src0->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(src0) && ggml_is_contiguous(dst));
+
+    int height = 0;
+    int width = 0;
+    int patch_h = 0;
+    int patch_w = 0;
+    const bool patch_merge = ggml_vk_is_rmbg_patch_merge(dst);
+    const bool image_patches = ggml_vk_is_rmbg_image_patches(dst);
+    GGML_ASSERT(patch_merge || image_patches);
+    if (patch_merge) {
+        GGML_ASSERT(std::sscanf(ggml_get_name(dst), "rmbg_patch_merge_h%d_w%d", &height, &width) == 2);
+    } else {
+        GGML_ASSERT(std::sscanf(ggml_get_name(dst), "rmbg_image_patches_ph%d_pw%d", &patch_h, &patch_w) == 2);
+        height = (int) src0->ne[1];
+        width = (int) src0->ne[0];
+    }
+    GGML_ASSERT(height > 0 && width > 0 && (patch_merge || (patch_h > 0 && patch_w > 0)));
+
+    ggml_pipeline_request_descriptor_sets(ctx, ctx->device->pipeline_rmbg_gather_f32, 1);
+    const vk_subbuffer src0_buf = ggml_vk_tensor_subbuffer(ctx, src0, true);
+    const vk_subbuffer dst_buf = ggml_vk_tensor_subbuffer(ctx, dst, true);
+    const vk_op_rmbg_gather_push_constants pc {
+        (uint32_t) (get_misalign_bytes(ctx, src0) / sizeof(float)),
+        (uint32_t) (get_misalign_bytes(ctx, dst) / sizeof(float)),
+        (uint32_t) (patch_merge ? src0->ne[0] : src0->ne[2]),
+        (uint32_t) height, (uint32_t) width,
+        (uint32_t) patch_h, (uint32_t) patch_w, patch_merge ? 0u : 1u,
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, ctx->device->pipeline_rmbg_gather_f32,
+                              {src0_buf, dst_buf}, pc,
+                              {(uint32_t) ggml_nelements(dst), 1, 1});
+}
