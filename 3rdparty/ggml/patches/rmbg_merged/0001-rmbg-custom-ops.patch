+static void rmbg_cudnn_conv2d(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * kernel = dst->src[0];
+    const ggml_tensor * input = dst->src[1];
+    int stride = 0, pad = 0;
+    GGML_ASSERT(std::sscanf(ggml_get_name(dst), "rmbg_conv2d_s%d_p%d", &stride, &pad) == 2);
+    thread_local CudnnHandle handle;
+    CUDNN_CHECK(cudnnSetStream(handle.value, ctx.stream()));
+
+    cudnnTensorDescriptor_t x_desc = nullptr, y_desc = nullptr;
+    cudnnFilterDescriptor_t w_desc = nullptr;
+    cudnnConvolutionDescriptor_t conv_desc = nullptr;
+    CUDNN_CHECK(cudnnCreateTensorDescriptor(&x_desc));
+    CUDNN_CHECK(cudnnCreateTensorDescriptor(&y_desc));
+    CUDNN_CHECK(cudnnCreateFilterDescriptor(&w_desc));
+    CUDNN_CHECK(cudnnCreateConvolutionDescriptor(&conv_desc));
+    CUDNN_CHECK(cudnnSetTensor4dDescriptor(x_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+        (int) input->ne[3], (int) input->ne[2], (int) input->ne[1], (int) input->ne[0]));
+    CUDNN_CHECK(cudnnSetTensor4dDescriptor(y_desc, CUDNN_TENSOR_NCHW, CUDNN_DATA_FLOAT,
+        (int) dst->ne[3], (int) dst->ne[2], (int) dst->ne[1], (int) dst->ne[0]));
+    CUDNN_CHECK(cudnnSetFilter4dDescriptor(w_desc, CUDNN_DATA_FLOAT, CUDNN_TENSOR_NCHW,
+        (int) kernel->ne[3], (int) kernel->ne[2], (int) kernel->ne[1], (int) kernel->ne[0]));
+    CUDNN_CHECK(cudnnSetConvolution2dDescriptor(conv_desc, pad, pad, stride, stride, 1, 1,
+        CUDNN_CROSS_CORRELATION, CUDNN_DATA_FLOAT));
+    CUDNN_CHECK(cudnnSetConvolutionMathType(conv_desc, CUDNN_FMA_MATH));
+    constexpr size_t max_workspace = 512ull * 1024 * 1024;
+    cudnnConvolutionFwdAlgoPerf_t perf[8];
+    int returned = 0;
+    CUDNN_CHECK(cudnnGetConvolutionForwardAlgorithm_v7(handle.value, x_desc, w_desc,
+        conv_desc, y_desc, 8, &returned, perf));
+    cudnnConvolutionFwdAlgo_t algorithm = CUDNN_CONVOLUTION_FWD_ALGO_IMPLICIT_GEMM;
+    size_t workspace_size = 0;
+    for (int i = 0; i < returned; ++i) {
+        if (perf[i].status == CUDNN_STATUS_SUCCESS && perf[i].memory <= max_workspace) {
+            algorithm = perf[i].algo;
+            workspace_size = perf[i].memory;
+            break;
+        }
+    }
+    ggml_cuda_pool_alloc<uint8_t> workspace(ctx.pool());
+    if (workspace_size) workspace.alloc(workspace_size);
+    const float alpha = 1.f, beta = 0.f;
+    CUDNN_CHECK(cudnnConvolutionForward(handle.value, &alpha, x_desc, input->data,
+        w_desc, kernel->data, conv_desc, algorithm, workspace.ptr, workspace_size,
+        &beta, y_desc, dst->data));
+    CUDNN_CHECK(cudnnDestroyConvolutionDescriptor(conv_desc));
+    CUDNN_CHECK(cudnnDestroyFilterDescriptor(w_desc));
+    CUDNN_CHECK(cudnnDestroyTensorDescriptor(y_desc));
+    CUDNN_CHECK(cudnnDestroyTensorDescriptor(x_desc));
+}
