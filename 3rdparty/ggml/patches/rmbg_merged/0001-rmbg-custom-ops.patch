+static void ggml_vk_rmbg_deform_im2col(ggml_backend_vk_context * ctx, vk_context& subctx,
+                                         const ggml_tensor * input, const ggml_tensor * offset,
+                                         const ggml_tensor * modulator, ggml_tensor * dst) {
+    GGML_ASSERT(input && offset && modulator && input->type == GGML_TYPE_F32 &&
+                offset->type == GGML_TYPE_F32 && modulator->type == GGML_TYPE_F32 &&
+                dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(input) && ggml_is_contiguous(offset) &&
+                ggml_is_contiguous(modulator) && ggml_is_contiguous(dst));
+    const uint32_t width = input->ne[0];
+    const uint32_t height = input->ne[1];
+    const uint32_t channels = input->ne[2];
+    const uint32_t kernel = modulator->ne[2];
+    const uint32_t kernel_w = (uint32_t) std::sqrt((double) kernel);
+    GGML_ASSERT(width && height && channels && kernel_w && kernel % kernel_w == 0);
+    GGML_ASSERT(offset->ne[0] == input->ne[0] && offset->ne[1] == input->ne[1] &&
+                offset->ne[2] == 2 * kernel && modulator->ne[0] == input->ne[0] &&
+                modulator->ne[1] == input->ne[1] && dst->ne[0] == channels * kernel &&
+                dst->ne[1] == width * height);
+
+    ggml_pipeline_request_descriptor_sets(ctx, ctx->device->pipeline_rmbg_deform_im2col_f32, 1);
+    const vk_op_rmbg_deform_im2col_push_constants pc {
+        (uint32_t) (get_misalign_bytes(ctx, input) / sizeof(float)),
+        (uint32_t) (get_misalign_bytes(ctx, offset) / sizeof(float)),
+        (uint32_t) (get_misalign_bytes(ctx, modulator) / sizeof(float)),
+        (uint32_t) (get_misalign_bytes(ctx, dst) / sizeof(float)),
+        width, height, channels, kernel_w, kernel / kernel_w,
+    };
+    ggml_vk_dispatch_pipeline(ctx, subctx, ctx->device->pipeline_rmbg_deform_im2col_f32,
+                              {ggml_vk_tensor_subbuffer(ctx, input, true),
+                               ggml_vk_tensor_subbuffer(ctx, offset, true),
+                               ggml_vk_tensor_subbuffer(ctx, modulator, true),
+                               ggml_vk_tensor_subbuffer(ctx, dst, true)},
+                              pc, {(uint32_t) ggml_nelements(dst), 1, 1});
+}
