+// For one output location and kernel tap, offsets and modulation are shared by
+// every input channel.  Keep the CK-major destination layout while computing
+// those values once per channel tile.
+__global__ void rmbg_deform_im2col_tiled_kernel(
+        const float * input, const float * offset, const float * modulator,
+        float * dst, int w, int h, int channels, int kw, int kh,
+        int channel_tiles) {
+    extern __shared__ float shared[];
+    float * ys = shared;
+    float * xs = ys + kw * kh;
+    float * masks = xs + kw * kh;
+
+    const int k_count = kw * kh;
+    const int channel_tile = blockDim.x / k_count;
+    const int block = (int) blockIdx.x;
+    const int p = block / channel_tiles;
+    const int c_base = (block - p * channel_tiles) * channel_tile;
+    const int tid = (int) threadIdx.x;
+    const int64_t hw = (int64_t) w * h;
+
+    for (int k = tid; k < k_count; k += blockDim.x) {
+        const int y_base = p / w;
+        const int x_base = p - y_base * w;
+        const int ky = k / kw;
+        const int kx = k - ky * kw;
+        ys[k] = (float) (y_base + ky - kh / 2) + offset[p + hw * (2 * k)];
+        xs[k] = (float) (x_base + kx - kw / 2) + offset[p + hw * (2 * k + 1)];
+        masks[k] = 2.0f / (1.0f + expf(-modulator[p + hw * k]));
+    }
+    __syncthreads();
+
+    const int c = c_base + tid / k_count;
+    const int k = tid - (tid / k_count) * k_count;
+    if (c < channels && k < k_count) {
+        dst[((int64_t) p * channels + c) * k_count + k] =
+            sample_bilinear(input, w, h, (int) hw, c, ys[k], xs[k]) * masks[k];
+    }
+}
+
+__device__ __forceinline__ int rmbg_swin_region(int x, int limit, int window, int shift) {
+    if (x < limit - window) {
+        return 0;
+    }
+    return x < limit - shift ? 1 : 2;
+}
+
+__global__ void rmbg_swin_qkv_split_kernel(
+        const float * qkv, const float * bias, float * q, float * k, float * v,
+        int C, int N, int heads, int nW) {
+    const int64_t total = (int64_t) C * N * nW;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        const int channel = (int) (index % C);
+        const int token = (int) ((index / C) % N);
+        const int win = (int) (index / ((int64_t) C * N));
+        const int head = channel / 32;
+        const int lane = channel % 32;
+        const int64_t dst_index = lane + 32ll * (token + N * (head + heads * win));
+        const int64_t src_index = channel + (int64_t) 3 * C * (token + N * win);
+        q[dst_index] = qkv[src_index] + bias[channel];
+        k[dst_index] = qkv[src_index + C] + bias[channel + C];
+        v[dst_index] = qkv[src_index + 2 * C] + bias[channel + 2 * C];
+    }
+}
+
+__global__ void rmbg_swin_merge_heads_kernel(
+        const float * head_output, float * attended, int C, int N, int heads, int nW) {
+    const int64_t total = (int64_t) C * N * nW;
+    for (int64_t index = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+         index < total; index += (int64_t) blockDim.x * gridDim.x) {
+        const int channel = (int) (index % C);
+        const int token = (int) ((index / C) % N);
+        const int win = (int) (index / ((int64_t) C * N));
+        const int head = channel / 32;
+        const int lane = channel % 32;
+        const int64_t src_index = lane + 32ll * (token + N * (head + heads * win));
+        attended[index] = head_output[src_index];
+    }
+}
