+static void rmbg_swin_gemm(ggml_backend_cuda_context & ctx,
+        const float * weight, const float * input, float * output,
+        int out_rows, int cols, int in_rows) {
+    const float alpha = 1.0f, beta = 0.0f;
+    CUBLAS_CHECK(cublasSetStream(ctx.cublas_handle(), ctx.stream()));
+    CUBLAS_CHECK(cublasSgemm(ctx.cublas_handle(), CUBLAS_OP_T, CUBLAS_OP_N,
+        out_rows, cols, in_rows, &alpha, weight, in_rows, input, in_rows,
+        &beta, output, out_rows));
+}
