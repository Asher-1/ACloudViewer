From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ACloudViewer <dev@acloudviewer.org>
Date: Wed, 29 Jul 2026 15:55:00 +0800
Subject: [PATCH] vulkan aliked: SDDH bounds + upsample misalign offsets

Align Vulkan upsample with dense-copy misalign handling and guard SDDH
feature reads when coordinates are out of range (prevents device-lost on
padded WHCN tensors).

---
 src/ggml-vulkan/ggml-vulkan-aliked.inc.cpp              | 6 ++++--
 src/ggml-vulkan/vulkan-shaders/aliked_sddh.comp         | 4 ++++
 src/ggml-vulkan/vulkan-shaders/aliked_upsample_bilinear.comp | 8 ++++++--
 3 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/src/ggml-vulkan/ggml-vulkan-aliked.inc.cpp b/src/ggml-vulkan/ggml-vulkan-aliked.inc.cpp
index 1111111..2222222 100644
--- a/src/ggml-vulkan/ggml-vulkan-aliked.inc.cpp
+++ b/src/ggml-vulkan/ggml-vulkan-aliked.inc.cpp
@@ -79,7 +79,7 @@ struct vk_aliked_push_dense_copy {
 };
 
 struct vk_aliked_push_upsample {
-    uint32_t ic, ih, iw, out_h, out_w;
+    uint32_t ic, ih, iw, out_h, out_w, src_off, dst_off;
 };
 
 struct vk_aliked_pipelines {
@@ -371,7 +371,9 @@ bool ggml_vulkan_aliked_upsample_bilinear(ggml_backend_t backend, const ggml_t
     vk_aliked_pipelines &pipes = vk_aliked_ensure(ctx);
     vk_aliked_push_upsample pc{static_cast<uint32_t>(ic), static_cast<uint32_t>(ih),
                                static_cast<uint32_t>(iw), static_cast<uint32_t>(out_h),
-                               static_cast<uint32_t>(out_w)};
+                               static_cast<uint32_t>(out_w),
+                               vk_aliked_misalign_floats(ctx, input),
+                               vk_aliked_misalign_floats(ctx, output)};
     vk_aliked_dispatch1(ctx, pipes.upsample_bilinear,
                         {vk_aliked_subbuf(ctx, input), vk_aliked_subbuf(ctx, output)}, pc,
                         {static_cast<uint32_t>(out_w), static_cast<uint32_t>(out_h),
diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_sddh.comp b/src/ggml-vulkan/vulkan-shaders/aliked_sddh.comp
index 1111111..2222222 100644
--- a/src/ggml-vulkan/vulkan-shaders/aliked_sddh.comp
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_sddh.comp
@@ -47,6 +47,10 @@ bool is_valid_sample(float py, float px) {
 }
 
 float read_feature(int c, int y, int x) {
+    if (c < 0 || uint(c) >= p.dim || y < 0 || uint(y) >= p.h || x < 0 ||
+        uint(x) >= p.w) {
+        return 0.0;
+    }
     uint byte_off = uint(x) * p.src_nb0 + uint(y) * p.src_nb1 + uint(c) * p.src_nb2;
     return feature_map[p.feature_off + byte_off / 4u];
 }
diff --git a/src/ggml-vulkan/vulkan-shaders/aliked_upsample_bilinear.comp b/src/ggml-vulkan/vulkan-shaders/aliked_upsample_bilinear.comp
index 1111111..2222222 100644
--- a/src/ggml-vulkan/vulkan-shaders/aliked_upsample_bilinear.comp
+++ b/src/ggml-vulkan/vulkan-shaders/aliked_upsample_bilinear.comp
@@ -7,6 +7,8 @@ layout(push_constant) uniform parameter {
     uint iw;
     uint out_h;
     uint out_w;
+    uint src_off;
+    uint dst_off;
 } p;
 
 layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
@@ -19,7 +21,7 @@ int whcn_index(int x, int y, int ch, int h, int w) {
 }
 
 float sample_at(int x, int y, int ch) {
-    return data_src[whcn_index(x, y, ch, int(p.ih), int(p.iw))];
+    return data_src[p.src_off + uint(whcn_index(x, y, ch, int(p.ih), int(p.iw)))];
 }
 
 void main() {
@@ -53,5 +55,5 @@ void main() {
     float v11 = sample_at(x1, y1, c);
     float v = hy * hx * v00 + hy * lx * v01 + ly * hx * v10 + ly * lx * v11;
 
-    data_dst[whcn_index(int(ox), int(oy), c, int(p.out_h), int(p.out_w))] = v;
+    data_dst[p.dst_off + uint(whcn_index(int(ox), int(oy), c, int(p.out_h), int(p.out_w)))] = v;
 }
-- 
2.34.1
