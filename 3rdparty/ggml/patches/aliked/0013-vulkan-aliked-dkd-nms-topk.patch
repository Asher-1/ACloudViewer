+static bool vk_aliked_use_gpu_topk() {
+    const char *env = std::getenv("LIGHTGLUE_ALIKED_VULKAN_DKD_GPU_TOPK");
+    return env != nullptr && env[0] != '0';
+}
+
+static bool vk_aliked_topk_indices_gpu(ggml_backend_t backend, ggml_backend_vk_context *ctx,
+                                       vk_aliked_pipelines &pipes, const ggml_tensor *nms,
+                                       ggml_tensor *block_keys, ggml_tensor *block_indices,
+                                       int32_t count, int32_t keep,
+                                       std::vector<int32_t> *indices) {
+    if (indices == nullptr || block_keys == nullptr || block_indices == nullptr ||
+        keep <= 0) {
+        return false;
+    }
+    if (!vk_aliked_block_topk(ctx, pipes, nms, block_keys, block_indices, count)) {
+        return false;
+    }
+    vk_aliked_finish(ctx);
+    ggml_backend_synchronize(backend);
+
+    const int32_t candidates = kTopKBlockCount * kTopKLocal;
+    std::vector<float> keys_host(static_cast<size_t>(candidates));
+    std::vector<float> idx_host(static_cast<size_t>(candidates));
+    ggml_backend_tensor_get(block_keys, keys_host.data(), 0,
+                            keys_host.size() * sizeof(float));
+    ggml_backend_tensor_get(block_indices, idx_host.data(), 0,
+                            idx_host.size() * sizeof(float));
+
+    std::vector<std::pair<float, int32_t>> scored(static_cast<size_t>(candidates));
+    for (int32_t i = 0; i < candidates; ++i) {
+        const float idx_f = idx_host[static_cast<size_t>(i)];
+        scored[static_cast<size_t>(i)] = {keys_host[static_cast<size_t>(i)],
+                                          static_cast<int32_t>(idx_f)};
+    }
+    const int32_t n = std::min(keep, candidates);
+    std::partial_sort(scored.begin(), scored.begin() + n, scored.end(),
+                      [](const auto &a, const auto &b) { return a.first > b.first; });
+    indices->clear();
+    indices->reserve(static_cast<size_t>(n));
+    for (int32_t i = 0; i < n; ++i) {
+        indices->push_back(scored[static_cast<size_t>(i)].second);
+    }
+    return static_cast<int32_t>(indices->size()) > 0;
+}
