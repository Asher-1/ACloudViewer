+    // parameter_count in sync (upstream passes 3 for the vanilla 3-binding
+    // shader).
+    ggml_vk_dispatch_pipeline(ctx, subctx, conv_pipeline, { buf_k, buf_in, buf_ph, buf_k }, p, elements);
