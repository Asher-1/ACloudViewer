+
+    std::map<vk_conv2d_pipeline_state, vk_pipeline> *pipelines = nullptr;
+    if (kernel_f16) {
+        pipelines = &ctx->device->pipeline_conv2d_f16_f32[shape];
+    } else {
+        pipelines = &ctx->device->pipeline_conv2d_f32[shape];
+    }
+    vk_pipeline conv_pipeline = nullptr;
+    {
+        std::lock_guard<std::mutex> guard(ctx->device->compile_mutex);
+        auto it = pipelines->find(conv_state);
+        if (it != pipelines->end()) {
+            conv_pipeline = it->second;
+        } else {
+            (*pipelines)[conv_state] = conv_pipeline = std::make_shared<vk_pipeline_struct>();
+        }
+    }
+    ggml_pipeline_request_descriptor_sets(ctx, conv_pipeline, 1);
+
+    vk_op_conv2d_push_constants p{};
+    p.Cout = K;
+    p.Cin  = Cin;
+    p.N    = 1;
+    p.W  = W;
+    p.H  = H;
+    p.OW = W;
+    p.OH = H;
+    // Reordered kernel is a contiguous [Cin, K] matrix. The regular CONV_2D
+    // shader indexes it as kw + kh*nb01 + ci*nb02 + co*nb03; with 1x1
+    // geometry the only nonzero dimensions must therefore be ci and co.
+    p.nb01 = 1;
+    p.nb02 = 1;
+    p.nb03 = Cin;
+    // input [W,H,Cin]
+    p.nb11 = W;
+    p.nb12 = WH;
+    p.nb13 = WH * Cin;
+    // dst [W,H,K]
