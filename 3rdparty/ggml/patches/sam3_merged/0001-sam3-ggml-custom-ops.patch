+template <typename T, typename D>
+static __global__ void rope_custom_freqs(
+        const T * x, D * dst, const float * freqs,
+        int64_t ne00, int64_t ne01, int64_t ne02,
+        size_t s01, size_t s02, size_t s03,
+        size_t d01, size_t d02, size_t d03,
+        int64_t n_pairs) {
+    const int64_t pair = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (pair >= n_pairs) {
+        return;
+    }
+
+    const int64_t half = ne00 / 2;
+    const int64_t d = pair % half;
+    const int64_t row = pair / half;
+    const int64_t i1 = row % ne01;
+    const int64_t i2 = (row / ne01) % ne02;
+    const int64_t i3 = row / (ne01 * ne02);
+    const int64_t src = i1 * s01 + i2 * s02 + i3 * s03 + 2 * d;
+    const int64_t out = i1 * d01 + i2 * d02 + i3 * d03 + 2 * d;
+    const int64_t f = i1 * ne00 + 2 * d;
+
+    const float re = (float) x[src + 0];
+    const float im = (float) x[src + 1];
+    const float cs = freqs[f + 0];
+    const float sn = freqs[f + 1];
+    dst[out + 0] = (D) (re * cs - im * sn);
+    dst[out + 1] = (D) (re * sn + im * cs);
+}
+
+template <typename T, typename D>
+static void rope_custom_freqs_cuda(const T * x, D * dst, const float * freqs,
+                                   const ggml_tensor * src, const ggml_tensor * out,
+                                   cudaStream_t stream) {
+    const int64_t n_pairs = ggml_nelements(src) / 2;
+    const int blocks = (int) ((n_pairs + CUDA_ROPE_BLOCK_SIZE - 1) / CUDA_ROPE_BLOCK_SIZE);
+    rope_custom_freqs<T, D><<<blocks, CUDA_ROPE_BLOCK_SIZE, 0, stream>>>(
+        x, dst, freqs, src->ne[0], src->ne[1], src->ne[2],
+        src->nb[1] / sizeof(T), src->nb[2] / sizeof(T), src->nb[3] / sizeof(T),
+        out->nb[1] / sizeof(D), out->nb[2] / sizeof(D), out->nb[3] / sizeof(D), n_pairs);
+}
+
+static __global__ void rope_custom_qkv_f16(
+        const half * qkv, half * dst, const float * freqs,
+        int64_t head_dim, int64_t n_tokens, int64_t n_heads,
+        int64_t n_head_batches, int64_t n_pairs) {
+    const int64_t pair = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (pair >= n_pairs) {
+        return;
+    }
+
+    const int64_t half_dim = head_dim / 2;
+    const int64_t d        = pair % half_dim;
+    const int64_t row      = pair / half_dim;
+    const int64_t token    = row % n_tokens;
+    const int64_t hb       = (row / n_tokens) % n_head_batches;
+    const int64_t kind     = row / (n_tokens * n_head_batches);
+    const int64_t head     = hb % n_heads;
+    const int64_t batch    = hb / n_heads;
+    const int64_t embed    = head_dim * n_heads;
+    const int64_t src      = kind * embed + head * head_dim + 2 * d +
+                             3 * embed * (token + n_tokens * batch);
+
+    const float re = (float) qkv[src + 0];
+    const float im = (float) qkv[src + 1];
+    if (kind < 2) {
+        const int64_t f = token * head_dim + 2 * d;
+        const float cs = freqs[f + 0];
+        const float sn = freqs[f + 1];
+        dst[2 * pair + 0] = (half) (re * cs - im * sn);
+        dst[2 * pair + 1] = (half) (re * sn + im * cs);
+    } else {
+        dst[2 * pair + 0] = qkv[src + 0];
+        dst[2 * pair + 1] = qkv[src + 1];
+    }
+}
+
+static void rope_custom_qkv_cuda(const half * qkv, half * dst, const float * freqs,
+                                 const ggml_tensor * out, int64_t n_heads,
+                                 cudaStream_t stream) {
+    const int64_t n_pairs = ggml_nelements(out) / 2;
+    const int blocks = (int) ((n_pairs + CUDA_ROPE_BLOCK_SIZE - 1) / CUDA_ROPE_BLOCK_SIZE);
+    rope_custom_qkv_f16<<<blocks, CUDA_ROPE_BLOCK_SIZE, 0, stream>>>(
+        qkv, dst, freqs, out->ne[0], out->ne[1], n_heads, out->ne[2], n_pairs);
+}
