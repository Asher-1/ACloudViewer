+// out. Returns false outside the vectorized PyTorch domain.
+static bool ggml_cuda_strict_norm(ggml_backend_cuda_context & ctx, const ggml_tensor * norm,
+                                  const ggml_tensor * gamma, const ggml_tensor * beta, ggml_tensor * out) {
+    const ggml_tensor * src = norm->src[0];
+    if (src->type != GGML_TYPE_F32 || out->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(src) || !ggml_is_contiguous(out) || !ggml_are_same_shape(src, out)) {
+        return false;
+    }
+    float eps;
+    memcpy(&eps, norm->op_params, sizeof(float));
+    return ggml_cuda_strict_layer_norm((const float *) src->data,
+        gamma ? (const float *) gamma->data : nullptr, beta ? (const float *) beta->data : nullptr,
+        (float *) out->data, src->ne[0], ggml_nrows(src), eps, ctx.stream());
