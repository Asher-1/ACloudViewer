diff --git a/src/ggml-cuda/relateanything-arithmetic.cu b/src/ggml-cuda/relateanything-arithmetic.cu
new file mode 100644
index 0000000000000000000000000000000000000000..c250eaa4f8a6d7d7ce9be49c85c315e4f508cfb7
--- /dev/null
+++ b/src/ggml-cuda/relateanything-arithmetic.cu
@@ -0,0 +1,56 @@
+// Reuse the shared kernels with the native task's device compiler policy.
+// Namespace isolation keeps every other graph on its existing arithmetic.
+#include "common.cuh"
+#include "unary.cuh"
+#include "norm.cuh"
+#include "relateanything-arithmetic.cuh"
+
+namespace {
+namespace relateanything_arithmetic {
+__device__ __forceinline__ float ggml_cuda_op_silu_single(float x) {
+    return x / (1.0f + expf(-x));
+}
+#define GGML_RELATEANYTHING_ARITHMETIC
+#include "unary.cu"
+#include "norm.cu"
+#undef GGML_RELATEANYTHING_ARITHMETIC
+} // namespace relateanything_arithmetic
+} // namespace
+
+bool ggml_cuda_relateanything_arithmetic(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    if (strncmp(dst->name, "relateanything_", 15) != 0) return false;
+    namespace native = relateanything_arithmetic;
+    switch (dst->op) {
+        case GGML_OP_NORM:
+        case GGML_OP_L2_NORM:
+            if (ggml_get_op_params_i32(dst, 1) == GGML_HINT_STRICT_F32) return false;
+            if (dst->op == GGML_OP_NORM) native::ggml_cuda_op_norm(ctx, dst);
+            else native::ggml_cuda_op_l2_norm(ctx, dst);
+            return true;
+        case GGML_OP_UNARY:
+            if (ggml_get_op_params_i32(dst, 1) == GGML_HINT_STRICT_F32) return false;
+            switch (ggml_get_unary_op(dst)) {
+                case GGML_UNARY_OP_GELU: native::ggml_cuda_op_gelu(ctx, dst); break;
+                case GGML_UNARY_OP_GELU_ERF: native::ggml_cuda_op_gelu_erf(ctx, dst); break;
+                case GGML_UNARY_OP_SILU: native::ggml_cuda_op_silu(ctx, dst); break;
+                case GGML_UNARY_OP_TANH: native::ggml_cuda_op_tanh(ctx, dst); break;
+                case GGML_UNARY_OP_EXP: native::ggml_cuda_op_exp(ctx, dst); break;
+                case GGML_UNARY_OP_SIGMOID: native::ggml_cuda_op_sigmoid(ctx, dst); break;
+                default: return false;
+            }
+            return true;
+        case GGML_OP_SIN:
+        case GGML_OP_COS:
+        case GGML_OP_LOG:
+            if (ggml_get_op_params_i32(dst, 0) == GGML_HINT_STRICT_F32) return false;
+            if (dst->op == GGML_OP_SIN) native::ggml_cuda_op_sin(ctx, dst);
+            else if (dst->op == GGML_OP_COS) native::ggml_cuda_op_cos(ctx, dst);
+            else native::ggml_cuda_op_log(ctx, dst);
+            return true;
+        default: return false;
+    }
+}
+
+void ggml_cuda_relateanything_unary_mul(ggml_backend_cuda_context & ctx, ggml_tensor * unary, ggml_tensor * mul) {
+    relateanything_arithmetic::ggml_cuda_op_unary_mul(ctx, unary, mul);
+}
