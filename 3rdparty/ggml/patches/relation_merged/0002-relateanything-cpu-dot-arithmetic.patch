From: ACloudViewer contributors
Subject: [PATCH] ggml-cpu: preserve RelateAnything upstream dot arithmetic

RelateAnything-GGML builds with GGML_LLAMAFILE=OFF. The shared AICore
runtime enables llamafile for other tasks, changing F16/Q8 arithmetic
and slowing the relation graph. Keep conversion and the upstream dot
kernels for the owner-marked relation matmuls; leave other graphs on
the existing accelerated dispatch. No backend-global state is changed.

For portable GCC AVX2 variants, retain full-width unaligned vector loads
and stores. Generic GCC tuning otherwise splits each AVX load into two
128-bit loads plus an insert, adding substantial F32 dot-product overhead
relative to upstream's native build. These flags change memory instructions,
not the advertised ISA or floating-point operations.

diff --git a/src/ggml-cpu/CMakeLists.txt b/src/ggml-cpu/CMakeLists.txt
--- a/src/ggml-cpu/CMakeLists.txt
+++ b/src/ggml-cpu/CMakeLists.txt
@@ -328,6 +328,13 @@ function(ggml_add_cpu_backend_variant_impl tag_name)
                 if (GGML_AVX2)
                     list(APPEND ARCH_FLAGS -mavx2)
                     list(APPEND ARCH_DEFINITIONS GGML_AVX2)
+                    if (CMAKE_C_COMPILER_ID STREQUAL "GNU" AND
+                        CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
+                        # Keep native-width memory operations in portable AVX2
+                        # builds without changing ISA or floating-point math.
+                        list(APPEND ARCH_FLAGS -mno-avx256-split-unaligned-load
+                                               -mno-avx256-split-unaligned-store)
+                    endif()
                 endif()
                 if (GGML_AVX_VNNI)
                     list(APPEND ARCH_FLAGS -mavxvnni)

diff --git a/src/ggml-cpu/ggml-cpu.c b/src/ggml-cpu/ggml-cpu.c
--- a/src/ggml-cpu/ggml-cpu.c
+++ b/src/ggml-cpu/ggml-cpu.c
@@ -1309,7 +1309,7 @@
      * thread utilization on small N strictly dominate the actual FMA work.
      * Folding the 16 windows into a single N=1616 call gives 4-5x speedup on
      * those shapes (see git log for measurements). */
-    if (src1_cont) {
+    if (src1_cont && strcmp(dst->name, "relateanything_matmul") != 0) {
         const size_t ts_src0 = ggml_type_size(src0->type);
         const size_t ts_src1 = ggml_type_size(src1->type);
         const size_t ts_dst  = ggml_type_size(dst->type);
@@ -1434,7 +1434,7 @@
     ggml_barrier(params->threadpool);
 
 #if GGML_USE_LLAMAFILE
-    if (src1->type != vec_dot_type) {
+    if (src1->type != vec_dot_type && strcmp(dst->name, "relateanything_matmul") != 0) {
         const void* wdata = (src1->type == vec_dot_type) ? src1->data : params->wdata;
         const size_t row_size = ggml_row_size(vec_dot_type, ne10);
         const size_t ts_src0 = ggml_type_size(src0->type);
