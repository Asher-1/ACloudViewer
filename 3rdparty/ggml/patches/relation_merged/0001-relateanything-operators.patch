+#pragma once
+#include <cstdint>
+#include <cuda_runtime.h>
+
+// Unmasked contiguous F32 rows, no ALiBi or sinks. Returns false outside the
+// persistent-warp domain; the caller retains the general softmax fallback.
+bool ggml_cuda_strict_softmax(const float * x, float * dst, int64_t ncols,
+                             int64_t nrows, float scale, cudaStream_t stream);
+
+void ggml_cuda_serial_matmul(const float * weight, const float * input, float * output,
+                            int k, int channels, int columns, cudaStream_t stream);
+
+// Contiguous F32 rows; gamma/beta may be null. Returns false outside PyTorch's
+// vectorized domain (N % 4, 16-byte alignment, N <= 2^24).
+bool ggml_cuda_strict_layer_norm(const float * x, const float * gamma, const float * beta,
+                                 float * y, int64_t ncols, int64_t nrows, float eps,
+                                 cudaStream_t stream);
+
+// PyTorch 2.6 NormTwoOps for contiguous 512-element F32 rows, followed by the
+// clamp_min(eps) and div kernels used by F.normalize.
+bool ggml_cuda_strict_l2_norm(const float * x, float * y, int64_t ncols,
+                              int64_t nrows, float eps, cudaStream_t stream);
+
+// PyTorch 2.6 Reduce.cuh sum over contiguous 256-element F32 rows.
+bool ggml_cuda_strict_sum_rows(const float * x, float * y, int64_t ncols,
+                               int64_t nrows, cudaStream_t stream);
+
+// Bytes PyTorch 2.6 reserves for cublasLt (CUBLASLT_WORKSPACE_SIZE default).
+constexpr size_t GGML_CUDA_STRICT_LT_WORKSPACE = 1024 * 1024;
+
+// y[rows,out] = x[rows,k] * w[out,k]^T + bias[out] with the cublasLt bias
+// epilogue exactly as PyTorch addmm issues it; gelu selects GELU_BIAS, the
+// epilogue of _addmm_activation(use_gelu=True). handle is a cublasHandle_t,
+// which cuBLAS defines to be usable as a cublasLtHandle_t. Returns false if
+// the call falls outside PyTorch's Lt domain or cublasLt rejects it.
+bool ggml_cuda_strict_linear_bias(void * handle, const float * w, const float * x,
+                                  const float * bias, float * y, int64_t k, int64_t out,
+                                  int64_t rows, int64_t ldw, int64_t ldx, int64_t ldy,
+                                  bool gelu, void * workspace, cudaStream_t stream);
+
+// Precise libdevice elementwise functions over contiguous F32, as PyTorch's
+// sin/cos/log/tanh/silu kernels compute them.
+enum ggml_cuda_strict_fn {
+    GGML_CUDA_STRICT_SIN, GGML_CUDA_STRICT_COS, GGML_CUDA_STRICT_LOG,
+    GGML_CUDA_STRICT_EXP, GGML_CUDA_STRICT_TANH, GGML_CUDA_STRICT_SILU,
+};
+void ggml_cuda_strict_unary(ggml_cuda_strict_fn fn, const float * x, float * y, int64_t n, cudaStream_t stream);
+
+// PyTorch 2.6 grid_sampler_2d_kernel, bilinear, zeros padding,
+// align_corners=False, over contiguous x [N,C,H,W], grid [N,Ho,Wo,2] and
+// y [N,C,Ho,Wo].
+void ggml_cuda_strict_grid_sample(const float * x, const float * grid, float * y, int64_t n, int64_t c,
+                                  int64_t h, int64_t w, int64_t out_h, int64_t out_w, cudaStream_t stream);
