diff --git a/src/ggml-cuda/strict-arithmetic.cu b/src/ggml-cuda/strict-arithmetic.cu
new file mode 100644
index 00000000..b07268e5
--- /dev/null
+++ b/src/ggml-cuda/strict-arithmetic.cu
@@ -0,0 +1,519 @@
+#include "strict-arithmetic.cuh"
+#include <climits>
+#include <cmath>
+
+// Match the F32 persistent-warp reduction in PyTorch 2.6 PersistentSoftmax.cuh:
+// sequential per-lane accumulation, then XOR offsets 16,8,4,2,1 and division.
+// This TU is compiled without fast-math: expf and division retain F32 semantics.
+// Four warps share a CTA instead of allocating 1024 threads for each 789-column
+// row. Values remain in registers between maximum, exponent and sum reductions.
+template<int log2_cols>
+static __global__ void strict_softmax_warp(const float * x, float * dst,
+                                         int ncols, int nrows, float scale) {
+    constexpr int padded = 1 << log2_cols;
+    constexpr int width = padded < 32 ? padded : 32;
+    constexpr int iterations = padded / width;
+    constexpr int batches = padded <= 128 ? 2 : 1;
+    const int first_row = (blockIdx.x * blockDim.y + threadIdx.y) * batches;
+    const int lane = threadIdx.x;
+    float values[batches][iterations];
+    float maxima[batches];
+    float sums[batches] = {};
+#pragma unroll
+    for (int b = 0; b < batches; ++b) {
+#pragma unroll
+        for (int i = 0; i < iterations; ++i) {
+            const int col = lane + i * width;
+            values[b][i] = first_row + b < nrows && col < ncols
+                ? x[int64_t(first_row + b) * ncols + col] * scale : -INFINITY;
+        }
+        maxima[b] = values[b][0];
+#pragma unroll
+        for (int i = 0; i < iterations; ++i) {
+            maxima[b] = maxima[b] > values[b][i] ? maxima[b] : values[b][i];
+        }
+    }
+#pragma unroll
+    for (int offset = width / 2; offset > 0; offset /= 2) {
+#pragma unroll
+        for (int b = 0; b < batches; ++b) {
+            float other = __shfl_xor_sync(0xffffffff, maxima[b], offset, width);
+            maxima[b] = maxima[b] < other ? other : maxima[b];
+        }
+    }
+#pragma unroll
+    for (int b = 0; b < batches; ++b) {
+#pragma unroll
+        for (int i = 0; i < iterations; ++i) {
+            values[b][i] = expf(values[b][i] - maxima[b]);
+            sums[b] += values[b][i];
+        }
+    }
+#pragma unroll
+    for (int offset = width / 2; offset > 0; offset /= 2) {
+#pragma unroll
+        for (int b = 0; b < batches; ++b) {
+            sums[b] += __shfl_xor_sync(0xffffffff, sums[b], offset, width);
+        }
+    }
+#pragma unroll
+    for (int b = 0; b < batches; ++b) {
+        if (first_row + b >= nrows) break;
+#pragma unroll
+        for (int i = 0; i < iterations; ++i) {
+            const int col = lane + i * width;
+            if (col < ncols) dst[int64_t(first_row + b) * ncols + col] = values[b][i] / sums[b];
+        }
+    }
+}
+
+template<int log2_cols>
+static void launch(const float * x, float * dst, int ncols, int nrows,
+                   float scale, cudaStream_t stream) {
+    constexpr int padded = 1 << log2_cols;
+    constexpr int width = padded < 32 ? padded : 32;
+    constexpr int batches = padded <= 128 ? 2 : 1;
+    constexpr int warps = 128 / width;
+    strict_softmax_warp<log2_cols><<<(nrows + warps*batches - 1)/(warps*batches),
+                                     dim3(width, warps), 0, stream>>>(x, dst, ncols, nrows, scale);
+}
+
+bool ggml_cuda_strict_softmax(const float * x, float * dst, int64_t ncols,
+                             int64_t nrows, float scale, cudaStream_t stream) {
+    if (ncols < 1 || ncols > 1024 || nrows < 1 || nrows > INT_MAX) return false;
+    int log2_cols = 0;
+    while ((1 << log2_cols) < ncols) ++log2_cols;
+#define LAUNCH_CASE(n) case n: launch<n>(x, dst, int(ncols), int(nrows), scale, stream); break
+    switch (log2_cols) {
+        LAUNCH_CASE(0); LAUNCH_CASE(1); LAUNCH_CASE(2); LAUNCH_CASE(3);
+        LAUNCH_CASE(4); LAUNCH_CASE(5); LAUNCH_CASE(6); LAUNCH_CASE(7);
+        LAUNCH_CASE(8); LAUNCH_CASE(9); LAUNCH_CASE(10);
+    }
+#undef LAUNCH_CASE
+    return true;
+}
+
+// Tiling changes memory traffic but preserves each output's increasing-K FMA
+// sequence. GGML matrices are [K,C], [K,N] and [C,N] in contiguous storage.
+static __global__ void serial_matmul(const float * w, const float * x, float * out,
+                                     int k, int channels, int columns) {
+    __shared__ float weights[16][33];
+    __shared__ float inputs[32][17];
+    const int tid = threadIdx.y*16 + threadIdx.x;
+    const int c = blockIdx.y*16 + threadIdx.y;
+    const int n = blockIdx.x*16 + threadIdx.x;
+    float sum = 0;
+    for (int base = 0; base < k; base += 32) {
+#pragma unroll
+        for (int i = tid; i < 16*32; i += 256) {
+            const int row = i/32, col = i%32;
+            const int channel = blockIdx.y*16+row, column = blockIdx.x*16+row;
+            weights[row][col] = channel < channels && base+col < k ? w[channel*k+base+col] : 0;
+            inputs[col][row] = column < columns && base+col < k ? x[column*k+base+col] : 0;
+        }
+        __syncthreads();
+#pragma unroll
+        for (int i = 0; i < 32; ++i) {
+            if (base+i < k) sum = __fmaf_rn(weights[threadIdx.y][i], inputs[i][threadIdx.x], sum);
+        }
+        __syncthreads();
+    }
+    if (c < channels && n < columns) out[n*channels+c] = sum;
+}
+
+void ggml_cuda_serial_matmul(const float * weight, const float * input, float * output,
+                            int k, int channels, int columns, cudaStream_t stream) {
+    serial_matmul<<<dim3((columns+15)/16, (channels+15)/16), dim3(16,16), 0, stream>>>
+        (weight, input, output, k, channels, columns);
+}
+
+// PyTorch 2.6 layer_norm_kernel.cu, vectorized_layer_norm_kernel: one CTA of
+// (32,4) threads per row, per-thread Welford over float4 loads, shfl_down tree
+// 16..1, shared-memory warp tree 2,1, rsqrtf, then the affine expression
+// gamma*(rstd*(x-mean))+beta. Expressions are kept verbatim so nvcc contracts
+// the same multiply-adds; the reduction tree fixes the summation order.
+struct strict_welford { float mean, sigma2, count; };
+
+static __device__ strict_welford strict_welford_online(const float val, const strict_welford & s) {
+    float delta = val - s.mean;
+    float new_count = s.count + 1.f;
+    float new_mean = s.mean + delta * (1.f/new_count);
+    return {new_mean, s.sigma2 + delta * (val - new_mean), new_count};
+}
+
+static __device__ strict_welford strict_welford_combine(const strict_welford b, const strict_welford a) {
+    float delta = b.mean - a.mean;
+    float count = a.count + b.count;
+    float mean, sigma2;
+    if (count > 0.f) {
+        auto coef = 1.f/count;
+        auto na = a.count * coef;
+        auto nb = b.count * coef;
+        mean = na*a.mean + nb*b.mean;
+        sigma2 = a.sigma2 + b.sigma2 + delta * delta * a.count * nb;
+    } else {
+        mean = 0.f;
+        sigma2 = 0.f;
+    }
+    return {mean, sigma2, count};
+}
+
+static __global__ void strict_layer_norm(const int n, const float eps, const float * __restrict__ x,
+                                         const float * gamma, const float * beta, float * y) {
