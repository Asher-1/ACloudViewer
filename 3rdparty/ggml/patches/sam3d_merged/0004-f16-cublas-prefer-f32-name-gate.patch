diff --git a/src/ggml-cuda/ggml-cuda.cu b/src/ggml-cuda/ggml-cuda.cu
--- a/src/ggml-cuda/ggml-cuda.cu
+++ b/src/ggml-cuda/ggml-cuda.cu
@@ -1542,12 +1542,18 @@ static void ggml_cuda_mul_mat_cublas_impl(ggml_backend_cuda_context & ctx, const
     const int cc = ggml_cuda_info().devices[ctx.device].cc;
     bool prefer_f32_output = false;
     if (compute_type == GGML_TYPE_F16) {
         // RMBG: prefer F16 inputs with FP32 accumulation/output on Ampere+ so the
         // 10-bit FP16 mantissa matches TF32 precision while tensor cores run at
         // the full FP16 rate instead of the GeForce TF32 rate (equal to FP32 CUDA
         // cores). Parity against the FP32 reference stays within the 2e-3 gate.
-        prefer_f32_output = cc == GGML_CUDA_CC_VOLTA || cc >= GGML_CUDA_CC_AMPERE ||
-                            GGML_CUDA_CC_IS_RDNA4(cc) || GGML_CUDA_CC_IS_CDNA(cc);
+        // sam3d parity gate: the sam-3d-objects-ggml reference keeps the base
+        // F16-output path on Ampere, and its SS occupancy decoder flips 2 voxels
+        // on the F32-direct output (+32 gaussians). Nodes named sam3d_* keep
+        // the upstream numerics; every other task keeps the RMBG optimization.
+        prefer_f32_output = cc == GGML_CUDA_CC_VOLTA ||
+                            (cc >= GGML_CUDA_CC_AMPERE &&
+                             !(dst->name && strncmp(dst->name, "sam3d_", 6) == 0)) ||
+                            GGML_CUDA_CC_IS_RDNA4(cc) || GGML_CUDA_CC_IS_CDNA(cc);
     } else if (compute_type == GGML_TYPE_BF16) {
         prefer_f32_output = !GGML_CUDA_CC_IS_RDNA3(cc) && !GGML_CUDA_CC_IS_CDNA(cc);
     }
