diff --git a/src/ggml-cuda/precise/fattn-precise.cu b/src/ggml-cuda/precise/fattn-precise.cu
new file mode 100644
index 0000000..13e296c
--- /dev/null
+++ b/src/ggml-cuda/precise/fattn-precise.cu
@@ -0,0 +1,104 @@
+// Precise twin of the generic F16 MMA flash-attention dispatch (fattn.cu, see
+// sam3d-precise.cuh). The SAM 3D graphs reach the generic kernels for the
+// attention layouts that sam3d-fattn.cu does not cover (F32 K/V, mismatched
+// token counts, ...); they never use grouped-query attention, so only the
+// ncols2 == 1 instance family is twinned (fattn-mma-f16-instance-*-precise.cu).
+// Every other shape - masks with gqa_ratio > 1, the vec/tile kernels, MLA head
+// sizes - is reported unsupported and keeps the fast dispatcher.
+#include "../common.cuh"
+#include "../convert.cuh"
+#include "../vecdotq.cuh"
+#include "../mma.cuh"
+#include "../fattn.cuh"
+#include <cstdint>
+
+#include "sam3d-precise.cuh"
+
+namespace ggml_cuda_precise {
+
+#include "../fattn-common.cuh"
+#include "../fattn-mma-f16.cuh"
+
+// Mirrors ggml_cuda_flash_attn_ext_mma_f16_switch_ncols1<DKQ, DV, 1> in fattn.cu.
+template <int DKQ, int DV>
+static void flash_attn_ext_mma_f16_ncols2_1(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    const ggml_tensor * Q = dst->src[0];
+
+    if (turing_mma_available(cc) && Q->ne[1] <= 8) {
+        ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 8, 1>(ctx, dst);
+        return;
+    }
+
+    if (Q->ne[1] <= 16) {
+        ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 16, 1>(ctx, dst);
+        return;
+    }
+
+    if (Q->ne[1] <= 32 || (GGML_CUDA_CC_IS_NVIDIA(cc) && ggml_cuda_highest_compiled_arch(cc) == GGML_CUDA_CC_TURING) ||
+            (GGML_CUDA_CC_IS_AMD(cc) && DKQ > 256)) {
+        ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 32, 1>(ctx, dst);
+        return;
+    }
+
+    ggml_cuda_flash_attn_ext_mma_f16_case<DKQ, DV, 64, 1>(ctx, dst);
+}
+
+bool flash_attn_ext_supported(int device, const ggml_tensor * dst) {
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+
+    // Already precise: routed to the vendored cutlass kernel in sam3d-fattn.cu.
+    if (ggml_cuda_sam3d_f16_dense_attn_supported(device, dst)) {
+        return false;
+    }
+    if (!ggml_cuda_flash_attn_ext_selects_mma_f16(device, dst)) {
+        return false;
+    }
+    // gqa_ratio == 1 is what makes ggml_cuda_flash_attn_ext_mma_f16_switch_ncols2
+    // end in the ncols2 == 1 instances, with or without a mask.
+    if (Q->ne[2] != K->ne[2] || Q->ne[0] != V->ne[0]) {
+        return false;
+    }
+    switch (Q->ne[0]) {
+        case 64:
+        case 80:
+        case 96:
+        case 112:
+        case 128:
+        case 256:
+            return true;
+        default:
+            return false;
+    }
+}
+
+void flash_attn_ext(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    ggml_cuda_set_device(ctx.device);
+    const ggml_tensor * Q = dst->src[0];
+    switch (Q->ne[0]) {
+        case 64:
+            flash_attn_ext_mma_f16_ncols2_1< 64,  64>(ctx, dst);
+            break;
+        case 80:
+            flash_attn_ext_mma_f16_ncols2_1< 80,  80>(ctx, dst);
+            break;
+        case 96:
+            flash_attn_ext_mma_f16_ncols2_1< 96,  96>(ctx, dst);
+            break;
+        case 112:
+            flash_attn_ext_mma_f16_ncols2_1<112, 112>(ctx, dst);
+            break;
+        case 128:
+            flash_attn_ext_mma_f16_ncols2_1<128, 128>(ctx, dst);
+            break;
+        case 256:
+            flash_attn_ext_mma_f16_ncols2_1<256, 256>(ctx, dst);
+            break;
+        default:
+            GGML_ABORT("fatal error");
+    }
+}
+
+} // namespace ggml_cuda_precise
