diff --git a/src/ggml-cuda/precise/sam3d-precise-dispatch.cu b/src/ggml-cuda/precise/sam3d-precise-dispatch.cu
new file mode 100644
index 0000000..aaa6bd5
--- /dev/null
+++ b/src/ggml-cuda/precise/sam3d-precise-dispatch.cu
@@ -0,0 +1,208 @@
+// Node-level routing for the precise twins (see sam3d-precise.cuh). The op
+// headers are included inside the namespace so the declarations resolve to the
+// twin definitions in *-precise.cu; the switch mirrors ggml_cuda_compute_forward
+// for exactly the ops that have a twin.
+#include "../common.cuh"
+#include "../convert.cuh"
+
+#include "sam3d-precise.cuh"
+
+namespace ggml_cuda_precise {
+
+#include "../norm.cuh"
+#include "../softmax.cuh"
+#include "../unary.cuh"
+#include "../upscale.cuh"
+
+static bool compute_forward_unary(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    switch (ggml_get_unary_op(dst)) {
+        case GGML_UNARY_OP_ABS:
+            ggml_cuda_op_abs(ctx, dst);
+            break;
+        case GGML_UNARY_OP_SGN:
+            ggml_cuda_op_sgn(ctx, dst);
+            break;
+        case GGML_UNARY_OP_NEG:
+            ggml_cuda_op_neg(ctx, dst);
+            break;
+        case GGML_UNARY_OP_STEP:
+            ggml_cuda_op_step(ctx, dst);
+            break;
+        case GGML_UNARY_OP_GELU:
+            ggml_cuda_op_gelu(ctx, dst);
+            break;
+        case GGML_UNARY_OP_SILU:
+            ggml_cuda_op_silu(ctx, dst);
+            break;
+        case GGML_UNARY_OP_GELU_ERF:
+            ggml_cuda_op_gelu_erf(ctx, dst);
+            break;
+        case GGML_UNARY_OP_GELU_QUICK:
+            ggml_cuda_op_gelu_quick(ctx, dst);
+            break;
+        case GGML_UNARY_OP_TANH:
+            ggml_cuda_op_tanh(ctx, dst);
+            break;
+        case GGML_UNARY_OP_RELU:
+            ggml_cuda_op_relu(ctx, dst);
+            break;
+        case GGML_UNARY_OP_SIGMOID:
+            ggml_cuda_op_sigmoid(ctx, dst);
+            break;
+        case GGML_UNARY_OP_HARDSIGMOID:
+            ggml_cuda_op_hardsigmoid(ctx, dst);
+            break;
+        case GGML_UNARY_OP_HARDSWISH:
+            ggml_cuda_op_hardswish(ctx, dst);
+            break;
+        case GGML_UNARY_OP_EXP:
+            ggml_cuda_op_exp(ctx, dst);
+            break;
+        case GGML_UNARY_OP_ELU:
+            ggml_cuda_op_elu(ctx, dst);
+            break;
+        case GGML_UNARY_OP_XIELU:
+            ggml_cuda_op_xielu(ctx, dst);
+            break;
+        case GGML_UNARY_OP_FLOOR:
+            ggml_cuda_op_floor(ctx, dst);
+            break;
+        case GGML_UNARY_OP_CEIL:
+            ggml_cuda_op_ceil(ctx, dst);
+            break;
+        case GGML_UNARY_OP_ROUND:
+            ggml_cuda_op_round(ctx, dst);
+            break;
+        case GGML_UNARY_OP_TRUNC:
+            ggml_cuda_op_trunc(ctx, dst);
+            break;
+        case GGML_UNARY_OP_EXPM1:
+            ggml_cuda_op_expm1(ctx, dst);
+            break;
+        case GGML_UNARY_OP_SOFTPLUS:
+            ggml_cuda_op_softplus(ctx, dst);
+            break;
+        default:
+            return false;
+    }
+    return true;
+}
+
+static bool compute_forward_glu(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    switch (ggml_get_glu_op(dst)) {
+        case GGML_GLU_OP_REGLU:
+            ggml_cuda_op_reglu(ctx, dst);
+            break;
+        case GGML_GLU_OP_GEGLU:
+            ggml_cuda_op_geglu(ctx, dst);
+            break;
+        case GGML_GLU_OP_SWIGLU:
+            ggml_cuda_op_swiglu(ctx, dst);
+            break;
+        case GGML_GLU_OP_SWIGLU_OAI:
+            ggml_cuda_op_swiglu_oai(ctx, dst);
+            break;
+        case GGML_GLU_OP_GEGLU_ERF:
+            ggml_cuda_op_geglu_erf(ctx, dst);
+            break;
+        case GGML_GLU_OP_GEGLU_QUICK:
+            ggml_cuda_op_geglu_quick(ctx, dst);
+            break;
+        default:
+            return false;
+    }
+    return true;
+}
+
+bool compute_forward(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    if (!ggml_cuda_sam3d_precise_node(dst->name)) {
+        return false;
+    }
+    switch (dst->op) {
+        case GGML_OP_UNARY:
+            return compute_forward_unary(ctx, dst);
+        case GGML_OP_GLU:
+            return compute_forward_glu(ctx, dst);
+        // Top-level ops implemented in unary.cu (sin/cos feed the diffusion
+        // timestep embedding; fast-math __sinf/__cosf diverge at step 10).
+        case GGML_OP_SQR:
+            ggml_cuda_op_sqr(ctx, dst);
+            return true;
+        case GGML_OP_SQRT:
+            ggml_cuda_op_sqrt(ctx, dst);
+            return true;
+        case GGML_OP_SIN:
+            ggml_cuda_op_sin(ctx, dst);
+            return true;
+        case GGML_OP_COS:
+            ggml_cuda_op_cos(ctx, dst);
+            return true;
+        case GGML_OP_LOG:
+            ggml_cuda_op_log(ctx, dst);
+            return true;
+        case GGML_OP_LEAKY_RELU:
+            ggml_cuda_op_leaky_relu(ctx, dst);
+            return true;
+        case GGML_OP_SILU_BACK:
+            ggml_cuda_op_silu_back(ctx, dst);
+            return true;
+        case GGML_OP_NORM:
+            ggml_cuda_op_norm(ctx, dst);
+            return true;
+        case GGML_OP_GROUP_NORM:
+            ggml_cuda_op_group_norm(ctx, dst);
+            return true;
+        case GGML_OP_L2_NORM:
+            ggml_cuda_op_l2_norm(ctx, dst);
+            return true;
+        case GGML_OP_RMS_NORM:
+            ggml_cuda_op_rms_norm(ctx, dst);
+            return true;
+        case GGML_OP_RMS_NORM_BACK:
+            ggml_cuda_op_rms_norm_back(ctx, dst);
+            return true;
+        case GGML_OP_SOFT_MAX:
+            ggml_cuda_op_soft_max(ctx, dst);
+            return true;
+        case GGML_OP_SOFT_MAX_BACK:
+            ggml_cuda_op_soft_max_back(ctx, dst);
+            return true;
+        case GGML_OP_UPSCALE:
+            ggml_cuda_op_upscale(ctx, dst);
+            return true;
+        case GGML_OP_FLASH_ATTN_EXT:
+            if (!flash_attn_ext_supported(ctx.device, dst)) {
+                return false;
+            }
+            flash_attn_ext(ctx, dst);
+            return true;
+        default:
+            return false;
+    }
+}
+
+void rms_norm_fused(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * mul_tensor) {
+    ggml_cuda_op_rms_norm_fused(ctx, dst, mul_tensor);
+}
+
+void rms_norm_fused_add(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * mul_tensor, ggml_tensor * add_tensor) {
+    ggml_cuda_op_rms_norm_fused_add(ctx, dst, mul_tensor, add_tensor);
+}
+
+void unary_mul(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * mul_tensor) {
+    ggml_cuda_op_unary_mul(ctx, dst, mul_tensor);
+}
+
+void relu_sqr(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * sqr_tensor) {
+    ggml_cuda_op_relu_sqr(ctx, dst, sqr_tensor);
+}
+
+bool norm_f32_affine(ggml_backend_cuda_context & ctx,
+                     const ggml_tensor * norm,
+                     const ggml_tensor * gamma,
+                     const ggml_tensor * beta,
+                     ggml_tensor * dst) {
+    return ggml_cuda_op_norm_f32_affine(ctx, norm, gamma, beta, dst);
+}
+
+} // namespace ggml_cuda_precise
diff --git a/src/ggml-cuda/precise/sam3d-precise.cuh b/src/ggml-cuda/precise/sam3d-precise.cuh
new file mode 100644
index 0000000..8ad47e1
--- /dev/null
+++ b/src/ggml-cuda/precise/sam3d-precise.cuh
@@ -0,0 +1,61 @@
+#pragma once
+
+// Precise (no -use_fast_math) twins of the generic CUDA kernels that the SAM 3D
+// Objects graphs run through.
+//
+// nvcc's -use_fast_math is a per-translation-unit switch (--ftz=true,
+// --prec-div=false, --prec-sqrt=false and the __expf/__tanhf/__erff intrinsic
+// substitution behind __USE_FAST_MATH__). The sam-3d-objects-ggml production
+// build resolves it OFF while map-anything-ggml (pristine ggml) resolves it ON,
+// and both references are bit-parity contracts of this library. The two can
+// only coexist in one libggml-cuda.so if the kernels sam3d reaches are compiled
+// twice: the fast copies stay the default, and the files in this directory
+// re-include the pristine sources inside `namespace ggml_cuda_precise` so a
+// second, fully independent set of kernels (separate symbols, no COMDAT merge
+// of the header-only launch templates) is built without the flag. The graph
+// executor routes nodes named "sam3d_*" to the twins.
+//
+// Measured on the kidsroom f16 input (CUDA sm_89, seed 42, 25 steps): the
+// fast build produces 841760 gaussians, the fast-math OFF build 842560; with
+// {norm, unary, softmax, upscale, fattn mma, sam3d-*} compiled precise the
+// fast build reproduces all 352 deterministic stage tensors of the OFF build
+// bit-for-bit and the same 842560 count. The remaining kernel families
+// (binbcast, cpy, convert, cuBLAS/MMF GEMMs, conv2d, im2col, ...) were shown
+// not to contribute and keep the single fast copy.
+//
+// Compiled only when GGML_CUDA_SAM3D_PRECISE_TWINS is defined
+// (GGML_SAM3D_OPS=ON and GGML_CUDA_FAST_MATH=ON, see CMakeLists.txt).
+
+#include "../common.cuh"
+
+static inline bool ggml_cuda_sam3d_precise_node(const char * name) {
+    return name != nullptr && strncmp(name, "sam3d_", 6) == 0;
+}
+
+namespace ggml_cuda_precise {
+
+// Node-level entry: runs the precise twin for sam3d_* nodes whose op has one
+// (NORM, GROUP_NORM, RMS_NORM, L2_NORM, UNARY, GLU, SQR, SQRT, SIN, COS, LOG,
+// LEAKY_RELU, SOFT_MAX, UPSCALE and the generic F16 MMA flash-attention path). Returns false when the node must take
+// the regular dispatch; the caller still owns the trailing cudaGetLastError.
+bool compute_forward(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
+
+// Fused entry points reached from the graph fuser. The fuser keeps its own
+// shape/ownership checks and only swaps the kernel for sam3d_* nodes.
+void rms_norm_fused(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * mul_tensor);
+void rms_norm_fused_add(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * mul_tensor, ggml_tensor * add_tensor);
+void unary_mul(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * mul_tensor);
+void relu_sqr(ggml_backend_cuda_context & ctx, ggml_tensor * dst, ggml_tensor * sqr_tensor);
+bool norm_f32_affine(ggml_backend_cuda_context & ctx,
+                     const ggml_tensor * norm,
+                     const ggml_tensor * gamma,
+                     const ggml_tensor * beta,
+                     ggml_tensor * dst);
+
+// Generic F16 MMA flash attention (fattn-precise.cu). Only the gqa_ratio == 1
+// instances (ncols2 == 1) are twinned because the SAM 3D graphs never issue
+// grouped-query attention; every other shape keeps the fast dispatcher.
+bool flash_attn_ext_supported(int device, const ggml_tensor * dst);
+void flash_attn_ext(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
+
+} // namespace ggml_cuda_precise
