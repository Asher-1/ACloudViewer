# OCR ggml fixes: Vulkan IM2COL shape-source descriptor safety, plus TF32
# opt-in for the F32 igemm conv kernel, full-geometry plan validation, and the
# f32 grid fix, measured on the OCR stack (RTX 4090, driver 550).
# (1) The F32 igemm kernel computes with TF32 WMMA; TF32 is OPT-IN via
#     GGML_CUDA_IGEMM_F32_TF32=1 after the opt-out measurement below, and
#     the kernel writes every output channel: grid.y steps by the
#     compile-time NT=64 tile (the shared nt heuristic left n in
#     [64*grid.y, K) uncovered for K >= 120, which zero-boxed the OCR det
#     graph).
# (2) igemm_conv_plan is validated by the full (input, dst, kernel)
#     geometry + types instead of byte sizes: two different-shaped convs
#     can share byte counts at a recycled dst pointer, and the stale plan
#     then ran kernels with the wrong shape. The historical
#     op_params[8..9] owner_id read a constant 0 for constructors that
#     never write it (ggml_new_tensor zero-fills op_params) and carried no
#     information; it is dropped from the reuse and chained-NHWC checks.
# OCR A/B (medal_table, 98 boxes, idle GPU): det forward 60 -> 14.6 ms,
# rec 48-row chunk 68 -> ~15 ms; e2e 98.4-99.4 ms with AICORE_OCR_CONV_
# DIRECT=1 + GGML_CUDA_IGEMM_F32_TF32=1 at 98/98 valid decodes (text hash
# identical to the im2col baseline). End-to-end transcript parity of the
# TF32 route vs im2col+GEMM was verified by per-pixel det-map comparison
# (871,424 pixels, zero diff) plus the text-set hash.
diff --git a/src/ggml-vulkan/ggml-vulkan.cpp b/src/ggml-vulkan/ggml-vulkan.cpp
--- a/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/src/ggml-vulkan/ggml-vulkan.cpp
@@ -2459,7 +2459,10 @@
     GGML_UNUSED(src3);
     GGML_UNUSED(dst);
     static_assert(!std::is_const<T>::value, "unexpected type");
-    GGML_ASSERT(!src0 || get_misalign_bytes(ctx, src0) == 0);
+    constexpr bool unbound_im2col_shape_source =
+            std::is_same<T, vk_op_im2col_push_constants>::value ||
+            std::is_same<T, vk_op_im2col_3d_push_constants>::value;
+    GGML_ASSERT(unbound_im2col_shape_source || !src0 || get_misalign_bytes(ctx, src0) == 0);
     GGML_ASSERT(!src1 || get_misalign_bytes(ctx, src1) == 0);
     GGML_ASSERT(!src2 || get_misalign_bytes(ctx, src2) == 0);
     GGML_ASSERT(!src3 || get_misalign_bytes(ctx, src3) == 0);

