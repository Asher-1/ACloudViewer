+#pragma once
+
+// MapAnything flash-attention twin of the reference ggml (map-anything-ggml
+// cpp_ggml pins ggml v0.24.0).
+//
+// Why a twin: the F16 MMA kernel is launched stream-k with
+//     grid = min(max_active_blocks_per_sm * nsm, ntiles_KV * ntiles_dst)
+// and max_active_blocks_per_sm comes from cudaOccupancyMaxActiveBlocksPer-
+// Multiprocessor, i.e. from the register / shared-memory footprint of the
+// COMPILED kernel. The per-tile arithmetic of the v0.21.0 and v0.24.0 kernels
+// is the same, but v0.24.0 swizzles the K/V shared-memory tiles, which moves
+// that footprint (sm_89, fast math, <64,64,8,1>: 127 -> 130 registers,
+// 4 -> 3 blocks/SM). A different grid cuts the KV range at different points
+// and the stream-k fixup then sums the partial softmax results in a different
+// order: deterministic, but not bit-identical to the reference once the KV
+// range spans more than one wave (pi3x, >= 7 views).
+//
+// The only way to reproduce the reference partition on every GPU is to run
+// the reference kernel source: ggml-v0.24.0/ holds verbatim copies of the
+// v0.24.0 fattn-common.cuh / fattn-mma-f16.cuh / fattn-swizzle.cuh, compiled
+// inside namespace ggml_cuda_mapany (own symbols for launch_fattn and the
+// fixup/combine kernels; a weak COMDAT launch_fattn would otherwise merge with
+// the v0.21.0 instances) and reached only by mapany_* nodes.
+//
+// Version contract: MAPANY_FA_TWIN_GGML_VERSION is the ggml the reference
+// pins. A tree that IS that version must drop the twin (its own kernel already
+// is the reference), so CMakeLists.txt refuses to build it there.
+#define MAPANY_FA_TWIN_GGML_VERSION "0.24.0"
+
+#include "../common.cuh"
+
+namespace ggml_cuda_mapany {
+
+// For a node the dispatcher already sends to the F16 MMA kernels: true for
+// the shapes the twin mirrors, ncols2 == 1 (gqa_ratio == 1) at head size 64,
+// i.e. every flash-attention node the MapAnything graphs build.
+bool flash_attn_ext_supported(const ggml_tensor * dst);
+
+void flash_attn_ext(ggml_backend_cuda_context & ctx, ggml_tensor * dst);
+
+} // namespace ggml_cuda_mapany
