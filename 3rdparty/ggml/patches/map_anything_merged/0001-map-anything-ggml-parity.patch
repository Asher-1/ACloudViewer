diff --git a/src/ggml-cuda/mapany/fattn-mapany.cu b/src/ggml-cuda/mapany/fattn-mapany.cu
new file mode 100644
index 0000000000000000000000000000000000000000..ad7245997531345633a9a33b0ea0e31439b928ce
--- /dev/null
+++ b/src/ggml-cuda/mapany/fattn-mapany.cu
@@ -0,0 +1,73 @@
+// Dispatch of the MapAnything flash-attention twin (see mapany-fattn.cuh).
+#include "../common.cuh"
+#include "../convert.cuh"
+#include "../vecdotq.cuh"
+#include "../mma.cuh"
+#include <cstdint>
+
+#include "mapany-fattn.cuh"
+
+namespace ggml_cuda_mapany {
+
+#include "ggml-v0.24.0/fattn-mma-f16.cuh"
+
+// v0.24.0 defines these two in its fattn.cu. Sparse gather is selected only
+// for DKQ 512/576 (ggml_cuda_flash_attn_ext_mma_f16_may_use_sparse), never
+// for the head-64 instances below, so the reference never takes it on the
+// mirrored shapes either; reaching the gather here is a contract violation.
+// (The vendored declaration cannot gain [[noreturn]] without editing it.)
+#if defined(__GNUC__)
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wsuggest-attribute=noreturn"
+#endif
+void ggml_cuda_flash_attn_ext_compact_mask(
+        const ggml_tensor * mask, int32_t * indices, int32_t n_kv_max, cudaStream_t stream) {
+    GGML_UNUSED_VARS(mask, indices, n_kv_max, stream);
+    GGML_ABORT("mapany flash-attention twin: sparse gather is outside the mirrored head-64 contract");
+}
+#if defined(__GNUC__)
+#pragma GCC diagnostic pop
+#endif
+
+bool ggml_cuda_flash_attn_ext_mma_f16_shall_use_sparse(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_UNUSED_VARS(ctx, dst);
+    return false;
+}
+
+bool flash_attn_ext_supported(const ggml_tensor * dst) {
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+
+    // gqa_ratio == 1 is what makes ggml_cuda_flash_attn_ext_mma_f16_switch_ncols2
+    // end in the ncols2 == 1 instances (v0.21.0 and v0.24.0 alike).
+    return Q->ne[2] == K->ne[2] && Q->ne[0] == 64 && V->ne[0] == 64;
+}
+
+// Mirrors ggml_cuda_flash_attn_ext_mma_f16_switch_ncols1<64, 64, 1> of
+// v0.24.0 fattn.cu (identical to v0.21.0 apart from the sparse branch, which
+// may_use_sparse rules out at head size 64).
+void flash_attn_ext(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    ggml_cuda_set_device(ctx.device);
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    const ggml_tensor * Q = dst->src[0];
+
+    if (turing_mma_available(cc) && Q->ne[1] <= 8) {
+        ggml_cuda_flash_attn_ext_mma_f16_case<64, 64, 8, 1>(ctx, dst);
+        return;
+    }
+
+    if (Q->ne[1] <= 16) {
+        ggml_cuda_flash_attn_ext_mma_f16_case<64, 64, 16, 1>(ctx, dst);
+        return;
+    }
+
+    if (Q->ne[1] <= 32 || (GGML_CUDA_CC_IS_NVIDIA(cc) && ggml_cuda_highest_compiled_arch(cc) == GGML_CUDA_CC_TURING)) {
+        ggml_cuda_flash_attn_ext_mma_f16_case<64, 64, 32, 1>(ctx, dst);
+        return;
+    }
+
+    ggml_cuda_flash_attn_ext_mma_f16_case<64, 64, 64, 1>(ctx, dst);
+}
+
+} // namespace ggml_cuda_mapany
