+static void nchw_to_nhwc(const void * src, void * dst, cudnnDataType_t type,
+                         int64_t batches, int64_t channels, int64_t height, int64_t width, cudaStream_t stream) {
+    const int64_t total = batches * channels * height * width;
+    GGML_UNUSED(total);
+    const int64_t spatial = height * width;
+    const dim3 blocks((spatial + 31) / 32, (channels + 31) / 32, batches);
+    const dim3 threads(32, 8);
+    if (type == CUDNN_DATA_HALF) {
+        transpose_batched_kernel<<<blocks, threads, 0, stream>>>(
+            (const half *) src, (half *) dst, channels, spatial);
+    } else {
+        transpose_batched_kernel<<<blocks, threads, 0, stream>>>(
+            (const float *) src, (float *) dst, channels, spatial);
+    }
+}
