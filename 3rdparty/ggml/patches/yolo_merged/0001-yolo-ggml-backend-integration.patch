+static bool create_frontend_plan(cudnn_conv_context & cctx, const ggml_tensor * dst, cudnn_conv_plan & plan) {
+    const ggml_tensor * kernel = dst->src[0];
+    const ggml_tensor * input = dst->src[1];
+    const int32_t * p = (const int32_t *) dst->op_params;
+    const cudnnDataType_t data_type = input->type == GGML_TYPE_F16 ? CUDNN_DATA_HALF : CUDNN_DATA_FLOAT;
+
+    int64_t x_dim[] = {input->ne[3], input->ne[2], input->ne[1], input->ne[0]};
+    int64_t y_dim[] = {dst->ne[3], dst->ne[2], dst->ne[1], dst->ne[0]};
+    int64_t w_dim[] = {kernel->ne[3], kernel->ne[2], kernel->ne[1], kernel->ne[0]};
+    int64_t x_stride[] = {input->ne[1] * input->ne[0] * input->ne[2], 1, input->ne[0] * input->ne[2], input->ne[2]};
+    int64_t y_stride[] = {dst->ne[1] * dst->ne[0] * dst->ne[2], 1, dst->ne[0] * dst->ne[2], dst->ne[2]};
+    int64_t w_stride[] = {kernel->ne[1] * kernel->ne[0] * kernel->ne[2], 1,
+                          kernel->ne[0] * kernel->ne[2], kernel->ne[2]};
+    int64_t padding[] = {p[3], p[2]};
+    int64_t stride[] = {p[1], p[0]};
+    int64_t dilation[] = {p[5], p[4]};
+    const bool fuse_bias_silu = dst->src[2] && p[7] == 1;
+
+    if (!prepare_nhwc_buffers(cctx, dst, plan, fuse_bias_silu)) return false;
+    cudaStream_t frontend_stream = nullptr;
+    cudnnGetStream(cctx.handle, &frontend_stream);
+
+    auto select_plan = [&](const cudnn_backend_desc_ptr & graph, bool fused) {
+        std::vector<cudnn_backend_desc_ptr> configs;
+        cudnn_collect_engine_configs(graph, configs);
+
+        cudnn_backend_desc_ptr candidate;
+        for (const auto & config : configs) {
+            int64_t workspace_size = std::numeric_limits<int64_t>::max();
+            candidate = cudnn_make_execution_plan(cctx.handle, config, &workspace_size);
+            if (candidate && workspace_size <= (int64_t) cctx.workspace_bytes) break;
+            candidate.reset();
+        }
+        if (!candidate) return false;
+        plan.frontend_plan = candidate;
+
+        void * data_ptrs[] = {
+            plan.frontend_input, plan.frontend_output, plan.frontend_weight,
+            plan.frontend_bias ? plan.frontend_bias : (dst->src[2] ? dst->src[2]->data : nullptr)};
+        const int64_t uids[] = {'x', 'y', 'w', 'b'};
+        const int64_t pointer_count = fused ? 4 : 3;
+        auto variant = cudnn_make_variant_pack(cctx.workspace, data_ptrs, uids, pointer_count);
+        if (!variant) {
+            plan.frontend_plan.reset();
+            return false;
+        }
+
+        auto execute = [&]() {
+            nchw_to_nhwc(input->data, plan.frontend_input, data_type, input->ne[3], input->ne[2],
+                         input->ne[1], input->ne[0], frontend_stream);
+            const cudnnStatus_t status = cudnnBackendExecute(cctx.handle, plan.frontend_plan.get(), variant.get());
+            if (status == CUDNN_STATUS_SUCCESS) {
+                nhwc_to_nchw(plan.frontend_output, dst->data, data_type, dst->ne[3], dst->ne[2],
+                             dst->ne[1], dst->ne[0], frontend_stream);
+            }
+            return status;
+        };
+        if (execute() != CUDNN_STATUS_SUCCESS || cudaStreamSynchronize(frontend_stream) != cudaSuccess) {
+            cudaGetLastError();
+            plan.frontend_plan.reset();
+            return false;
+        }
+        cudaEvent_t start = nullptr;
+        cudaEvent_t stop = nullptr;
+        cudaEventCreate(&start);
+        cudaEventCreate(&stop);
+        std::array<float, 3> times{};
+        for (float & time : times) {
+            cudaEventRecord(start, frontend_stream);
+            if (execute() != CUDNN_STATUS_SUCCESS) {
+                plan.frontend_plan.reset();
+                break;
+            }
+            cudaEventRecord(stop, frontend_stream);
+            cudaEventSynchronize(stop);
+            cudaEventElapsedTime(&time, start, stop);
+        }
+        cudaEventDestroy(stop);
+        cudaEventDestroy(start);
+        if (!plan.frontend_plan) return false;
+        std::sort(times.begin(), times.end());
+        plan.frontend_time_ms = times[1];
+        return true;
+    };
+
+    auto x = cudnn_make_tensor_desc(x_dim, x_stride, 'x', data_type, false);
+    auto w = cudnn_make_tensor_desc(w_dim, w_stride, 'w', data_type, false);
+    auto y = cudnn_make_tensor_desc(y_dim, y_stride, 'y', data_type, false);
+    auto conv = cudnn_make_conv_desc(padding, stride, dilation);
+    if (!x || !w || !y || !conv) {
+        GGML_LOG_WARN("cuDNN backend plan failed: descriptor construction\n");
+        return false;
+    }
+    if (!fuse_bias_silu) {
+        auto operation = cudnn_make_conv_op(x.get(), y.get(), w.get(), conv.get());
+        if (!operation) {
+            GGML_LOG_WARN("cuDNN backend plan failed: convolution operation\n");
+            return false;
+        }
+        const cudnnBackendDescriptor_t ops[] = {operation.get()};
+        auto graph = cudnn_make_opgraph(cctx.handle, ops, 1);
+        if (!graph) {
+            GGML_LOG_WARN("cuDNN backend plan failed: operation graph\n");
+            return false;
+        }
+        return select_plan(graph, false);
+    }
+
+    int64_t b_dim[] = {1, dst->ne[2], 1, 1};
+    int64_t b_stride[] = {dst->ne[2], 1, dst->ne[2], dst->ne[2]};
+    auto b = cudnn_make_tensor_desc(b_dim, b_stride, 'b', data_type, false);
+    auto after_conv = cudnn_make_tensor_desc(y_dim, y_stride, 'c', data_type, true);
+    auto after_bias = cudnn_make_tensor_desc(y_dim, y_stride, 'z', data_type, true);
+    auto add = cudnn_make_pointwise_desc(CUDNN_POINTWISE_ADD);
+    auto silu = cudnn_make_pointwise_desc(CUDNN_POINTWISE_SWISH_FWD);
+    auto conv_op = cudnn_make_conv_op(x.get(), after_conv.get(), w.get(), conv.get());
+    auto bias_op = cudnn_make_pointwise_op(add.get(), after_conv.get(), after_bias.get(), b.get());
+    auto silu_op = cudnn_make_pointwise_op(silu.get(), after_bias.get(), y.get(), nullptr);
+    if (!b || !after_conv || !after_bias || !add || !silu || !conv_op || !bias_op || !silu_op) {
+        GGML_LOG_WARN("cuDNN backend plan failed: fused graph construction\n");
+        return false;
+    }
+    const cudnnBackendDescriptor_t ops[] = {conv_op.get(), bias_op.get(), silu_op.get()};
+    auto graph = cudnn_make_opgraph(cctx.handle, ops, 3);
+    if (!graph) {
+        GGML_LOG_WARN("cuDNN backend plan failed: operation graph\n");
+        return false;
+    }
+    plan.frontend_fused = select_plan(graph, true);
+    return plan.frontend_fused;
+}
