+static bool prepare_nhwc_buffers(cudnn_conv_context & cctx, const ggml_tensor * dst,
+                                 cudnn_conv_plan & plan, bool convert_bias) {
+    const ggml_tensor * kernel = dst->src[0];
+    const ggml_tensor * input = dst->src[1];
+    const cudnnDataType_t data_type = input->type == GGML_TYPE_F16 ? CUDNN_DATA_HALF : CUDNN_DATA_FLOAT;
+    if (!plan.frontend_input && cudaMalloc(&plan.frontend_input, ggml_nbytes(input)) != cudaSuccess) {
+        cudaGetLastError();
+        return false;
+    }
+    if (!plan.frontend_output && cudaMalloc(&plan.frontend_output, ggml_nbytes(dst)) != cudaSuccess) {
+        cudaGetLastError();
+        return false;
+    }
+    if (!plan.frontend_weight && cudaMalloc(&plan.frontend_weight, ggml_nbytes(kernel)) != cudaSuccess) {
+        cudaGetLastError();
+        return false;
+    }
+
+    cudaStream_t stream = nullptr;
+    cudnnGetStream(cctx.handle, &stream);
+    nchw_to_nhwc(kernel->data, plan.frontend_weight, data_type, kernel->ne[3], kernel->ne[2],
+                 kernel->ne[1], kernel->ne[0], stream);
+    nchw_to_nhwc(input->data, plan.frontend_input, data_type, input->ne[3], input->ne[2],
+                 input->ne[1], input->ne[0], stream);
+
+    if (convert_bias && data_type == CUDNN_DATA_HALF && !plan.frontend_bias) {
+        const size_t bias_bytes = dst->ne[2] * sizeof(half);
+        if (cudaMalloc(&plan.frontend_bias, bias_bytes) != cudaSuccess) {
+            cudaGetLastError();
+            return false;
+        }
+        const int blocks = (dst->ne[2] + CUDA_CONV2D_BLOCK_SIZE - 1) / CUDA_CONV2D_BLOCK_SIZE;
+        fp32_to_fp16_kernel<<<blocks, CUDA_CONV2D_BLOCK_SIZE, 0, stream>>>(
+            (const float *) dst->src[2]->data, (half *) plan.frontend_bias, dst->ne[2]);
+    }
+    return true;
+}
