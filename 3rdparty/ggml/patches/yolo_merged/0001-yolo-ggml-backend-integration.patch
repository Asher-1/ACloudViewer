+static cudnn_backend_desc_ptr cudnn_backend_create(cudnnBackendDescriptorType_t type) {
+    cudnnBackendDescriptor_t desc = nullptr;
+    if (cudnnBackendCreateDescriptor(type, &desc) != CUDNN_STATUS_SUCCESS) return nullptr;
+    return cudnn_backend_desc_ptr(desc, cudnn_backend_desc_deleter());
