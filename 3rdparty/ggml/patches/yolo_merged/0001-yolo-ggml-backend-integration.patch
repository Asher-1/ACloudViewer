+template <typename T>
+static __global__ void bias_silu_kernel(
+        T * output, const float * bias, int64_t spatial, int64_t channels, int64_t total) {
+    const int64_t index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index >= total) return;
+    const float value = ggml_cuda_cast<float>(output[index]) + bias[(index / spatial) % channels];
+    output[index] = ggml_cuda_cast<T>(value / (1.0f + expf(-value)));
+}
+
+static void bias_silu_cuda(ggml_tensor * dst, cudaStream_t stream) {
+    if (!dst->src[2] || ggml_get_op_params_i32(dst, 7) != 1) return;
+    const int64_t spatial = dst->ne[0] * dst->ne[1];
+    const int64_t total = ggml_nelements(dst);
+    const int blocks = (total + CUDA_CONV2D_BLOCK_SIZE - 1) / CUDA_CONV2D_BLOCK_SIZE;
+    if (dst->type == GGML_TYPE_F16) {
+        bias_silu_kernel<<<blocks, CUDA_CONV2D_BLOCK_SIZE, 0, stream>>>(
+            (half *) dst->data, (const float *) dst->src[2]->data, spatial, dst->ne[2], total);
+    } else {
+        bias_silu_kernel<<<blocks, CUDA_CONV2D_BLOCK_SIZE, 0, stream>>>(
+            (float *) dst->data, (const float *) dst->src[2]->data, spatial, dst->ne[2], total);
+    }
+}
