+static bool cudnn_ok(cudnnStatus_t status, const char * operation) {
+    if (status == CUDNN_STATUS_SUCCESS) return true;
+    GGML_LOG_WARN("cuDNN %s failed: %s\n", operation, cudnnGetErrorString(status));
+    return false;
+}
