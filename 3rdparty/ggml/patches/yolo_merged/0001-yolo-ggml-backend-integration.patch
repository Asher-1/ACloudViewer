+// Mirrors cudnn_frontend::get_heuristics_list({"heuristics_instant",
+// "heuristics_fallback"}, ..., /*evaluate_all=*/true): MODE_A first, then
+// MODE_FALLBACK, and a failing mode does not abort the collection.
+static void cudnn_collect_engine_configs(const cudnn_backend_desc_ptr & graph,
+                                         std::vector<cudnn_backend_desc_ptr> & configs) {
+    for (const cudnnBackendHeurMode_t mode : {CUDNN_HEUR_MODE_A, CUDNN_HEUR_MODE_FALLBACK}) {
+        const cudnnBackendDescriptor_t graph_desc = graph.get();
+        auto heur = cudnn_backend_create(CUDNN_BACKEND_ENGINEHEUR_DESCRIPTOR);
+        if (!heur ||
+            !cudnn_set_attr(heur.get(), CUDNN_ATTR_ENGINEHEUR_OPERATION_GRAPH,
+                            CUDNN_TYPE_BACKEND_DESCRIPTOR, 1, &graph_desc) ||
+            !cudnn_set_attr(heur.get(), CUDNN_ATTR_ENGINEHEUR_MODE, CUDNN_TYPE_HEUR_MODE, 1, &mode) ||
+            cudnnBackendFinalize(heur.get()) != CUDNN_STATUS_SUCCESS) {
+            continue;
+        }
+        int64_t count = 0;
+        if (cudnnBackendGetAttribute(heur.get(), CUDNN_ATTR_ENGINEHEUR_RESULTS, CUDNN_TYPE_BACKEND_DESCRIPTOR, 0,
+                                     &count, nullptr) != CUDNN_STATUS_SUCCESS || count <= 0) {
+            continue;
+        }
+        std::vector<cudnn_backend_desc_ptr> results;
+        std::vector<cudnnBackendDescriptor_t> raw;
+        results.reserve(count);
+        raw.reserve(count);
+        bool ready = true;
+        for (int64_t i = 0; i < count && ready; ++i) {
+            results.push_back(cudnn_backend_create(CUDNN_BACKEND_ENGINECFG_DESCRIPTOR));
+            ready = results.back() != nullptr;
+            if (ready) raw.push_back(results.back().get());
+        }
+        if (!ready) continue;
+        int64_t filled = 0;
+        if (cudnnBackendGetAttribute(heur.get(), CUDNN_ATTR_ENGINEHEUR_RESULTS, CUDNN_TYPE_BACKEND_DESCRIPTOR,
+                                     count, &filled, raw.data()) != CUDNN_STATUS_SUCCESS || filled <= 0) {
+            continue;
+        }
+        results.resize(filled);
+        configs.insert(configs.end(), std::make_move_iterator(results.begin()),
+                       std::make_move_iterator(results.end()));
+    }
+}
