+#ifdef GGML_CUDA_USE_CUDNN
+namespace {
+
+struct transpose_cudnn_plan {
+    cudnnHandle_t handle = nullptr;
+    cudnnTensorDescriptor_t dx_desc = nullptr;
+    cudnnTensorDescriptor_t dy_desc = nullptr;
+    cudnnFilterDescriptor_t w_desc = nullptr;
+    cudnnConvolutionDescriptor_t conv_desc = nullptr;
+    cudnnConvolutionBwdDataAlgo_t algo = CUDNN_CONVOLUTION_BWD_DATA_ALGO_0;
+    size_t workspace_bytes = 0;
+    void * workspace = nullptr;
+    std::string source_key;
+    bool disabled = false;
+    ~transpose_cudnn_plan() {
+        if (workspace) cudaFree(workspace);
+        if (conv_desc) cudnnDestroyConvolutionDescriptor(conv_desc);
+        if (w_desc) cudnnDestroyFilterDescriptor(w_desc);
+        if (dy_desc) cudnnDestroyTensorDescriptor(dy_desc);
+        if (dx_desc) cudnnDestroyTensorDescriptor(dx_desc);
+        if (handle) cudnnDestroy(handle);
+    }
+};
+
+static transpose_cudnn_plan & transpose_plan() {
+    // A plan owns a cuDNN handle and descriptors. Keep one cache per worker
+    // thread so independent sessions cannot race while rebuilding it.
+    thread_local transpose_cudnn_plan plan;
+    return plan;
+}
+
+static std::string transpose_plan_key(const ggml_tensor * kernel, const ggml_tensor * input,
+                                      const ggml_tensor * dst) {
+    const int32_t stride = dst->op_params[0];
+    return std::to_string(reinterpret_cast<uintptr_t>(kernel->data)) + ":" +
+           std::to_string(input->ne[0]) + ":" + std::to_string(input->ne[1]) + ":" +
+           std::to_string(input->ne[2]) + ":" + std::to_string(input->ne[3]) + ":" +
+           std::to_string(dst->ne[0]) + ":" + std::to_string(dst->ne[1]) + ":" +
+           std::to_string(dst->ne[2]) + ":" + std::to_string(dst->ne[3]) + ":" +
+           std::to_string(kernel->ne[0]) + ":" + std::to_string(kernel->ne[1]) + ":" +
+           std::to_string(kernel->ne[2]) + ":" + std::to_string(kernel->ne[3]) + ":" +
+           std::to_string((int) input->type) + ":" + std::to_string((int) kernel->type) + ":" +
+           std::to_string(stride);
+}
+
+static bool transpose_cudnn(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * kernel = dst->src[0];
+    const ggml_tensor * input = dst->src[1];
+    if (input->type != dst->type || kernel->type != input->type ||
+        (input->type != GGML_TYPE_F16 && input->type != GGML_TYPE_F32) || !ggml_is_contiguous(input) ||
+        !ggml_is_contiguous(kernel) || !ggml_is_contiguous(dst)) {
+        return false;
+    }
+
+    auto & plan = transpose_plan();
+    const std::string key = transpose_plan_key(kernel, input, dst);
+    if (plan.source_key != key || plan.handle == nullptr) {
+        if (plan.handle) {
+            plan.~transpose_cudnn_plan();
+            new (&plan) transpose_cudnn_plan();
+        }
+        if (cudnnCreate(&plan.handle) != CUDNN_STATUS_SUCCESS ||
+            cudnnCreateTensorDescriptor(&plan.dx_desc) != CUDNN_STATUS_SUCCESS ||
+            cudnnCreateTensorDescriptor(&plan.dy_desc) != CUDNN_STATUS_SUCCESS ||
+            cudnnCreateFilterDescriptor(&plan.w_desc) != CUDNN_STATUS_SUCCESS ||
+            cudnnCreateConvolutionDescriptor(&plan.conv_desc) != CUDNN_STATUS_SUCCESS) {
+            return false;
+        }
+
+        const int cin = input->ne[2], cout = dst->ne[2], kh = kernel->ne[1], kw = kernel->ne[0];
+        const cudnnDataType_t type = input->type == GGML_TYPE_F16 ? CUDNN_DATA_HALF : CUDNN_DATA_FLOAT;
+        if (cudnnSetTensor4dDescriptor(plan.dx_desc, CUDNN_TENSOR_NCHW, type,
+                                       dst->ne[3], dst->ne[2], dst->ne[1], dst->ne[0]) != CUDNN_STATUS_SUCCESS ||
+            cudnnSetTensor4dDescriptor(plan.dy_desc, CUDNN_TENSOR_NCHW, type,
+                                       input->ne[3], input->ne[2], input->ne[1], input->ne[0]) != CUDNN_STATUS_SUCCESS ||
+            // ConvTranspose weights are [Cin, Cout, Kh, Kw], exactly the filter
+            // layout expected by backward-data where dy has Cin channels.
+            cudnnSetFilter4dDescriptor(plan.w_desc, type, CUDNN_TENSOR_NCHW, cin, cout, kh, kw) != CUDNN_STATUS_SUCCESS ||
+            cudnnSetConvolution2dDescriptor(plan.conv_desc, 0, 0, dst->op_params[0], dst->op_params[0], 1, 1,
+                                            CUDNN_CROSS_CORRELATION, CUDNN_DATA_FLOAT) != CUDNN_STATUS_SUCCESS ||
+            cudnnSetConvolutionMathType(plan.conv_desc, CUDNN_TENSOR_OP_MATH_ALLOW_CONVERSION) != CUDNN_STATUS_SUCCESS) {
+            return false;
+        }
+        cudnnConvolutionBwdDataAlgoPerf_t perf[CUDNN_CONVOLUTION_BWD_DATA_ALGO_COUNT];
+        int count = 0;
+        if (cudaMalloc(&plan.workspace, 64ull << 20) != cudaSuccess ||
+            cudnnFindConvolutionBackwardDataAlgorithmEx(plan.handle, plan.w_desc, kernel->data, plan.dy_desc,
+                                                         input->data, plan.conv_desc, plan.dx_desc, dst->data,
+                                                         CUDNN_CONVOLUTION_BWD_DATA_ALGO_COUNT, &count, perf,
+                                                         plan.workspace, 64ull << 20) != CUDNN_STATUS_SUCCESS) {
+            return false;
+        }
+        bool found_algorithm = false;
+        for (int i = 0; i < count; ++i) {
+            if (perf[i].status == CUDNN_STATUS_SUCCESS && perf[i].memory <= (64ull << 20)) {
+                plan.algo = perf[i].algo;
+                plan.workspace_bytes = perf[i].memory;
+                found_algorithm = true;
+                break;
+            }
+        }
+        plan.source_key = key;
+        plan.disabled = !found_algorithm;
+    }
+    if (plan.disabled) return false;
+
+    if (cudnnSetStream(plan.handle, ctx.stream()) != CUDNN_STATUS_SUCCESS) return false;
+    const float alpha = 1.0f, beta = 0.0f;
+    const cudnnStatus_t status = cudnnConvolutionBackwardData(
+        plan.handle, &alpha, plan.w_desc, kernel->data, plan.dy_desc, input->data, plan.conv_desc, plan.algo,
+        plan.workspace, plan.workspace_bytes, &beta, plan.dx_desc, dst->data);
+    plan.disabled = status != CUDNN_STATUS_SUCCESS;
+    return !plan.disabled;
+}
+
+} // namespace
+#endif
