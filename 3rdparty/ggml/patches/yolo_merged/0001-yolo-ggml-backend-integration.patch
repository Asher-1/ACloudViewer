+template <typename T>
+static __global__ void transpose_batched_kernel(
+        const T * src, T * dst, int64_t rows, int64_t columns) {
+    __shared__ T tile[32][33];
+    const int64_t batch = blockIdx.z;
+    const int64_t src_x = blockIdx.x * 32 + threadIdx.x;
+    const int64_t src_y = blockIdx.y * 32 + threadIdx.y;
+    const T * src_batch = src + batch * rows * columns;
+    T * dst_batch = dst + batch * rows * columns;
+    for (int offset = 0; offset < 32; offset += 8) {
+        if (src_x < columns && src_y + offset < rows) {
+            tile[threadIdx.y + offset][threadIdx.x] = src_batch[(src_y + offset) * columns + src_x];
+        }
+    }
+    __syncthreads();
+    const int64_t dst_x = blockIdx.y * 32 + threadIdx.x;
+    const int64_t dst_y = blockIdx.x * 32 + threadIdx.y;
+    for (int offset = 0; offset < 32; offset += 8) {
+        if (dst_x < rows && dst_y + offset < columns) {
+            dst_batch[(dst_y + offset) * rows + dst_x] = tile[threadIdx.x][threadIdx.y + offset];
+        }
+    }
+}
