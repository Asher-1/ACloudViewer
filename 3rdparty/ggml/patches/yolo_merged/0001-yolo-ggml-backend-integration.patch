+                    const int rs = k / C;
+                    const int ih = p * sh + (rs / S) * dh - ph;
+                    const int iw = q * sw + (rs % S) * dw - pw;
+                    if (ih >= 0 && ih < H && iw >= 0 && iw < W) {
+                        src = ((int64_t) b * H + ih) * W * C + (int64_t) iw * C + k % C;
+                    }
+                }
+                if (src >= 0) {
+                    * (uint4 *) dst = * (const uint4 *) (in + src);
+                } else {
+                    * (uint4 *) dst = make_uint4(0, 0, 0, 0);
+                }
+            } else {
+                #pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    const int kk = k + i;
+                    float v = 0.0f;
+                    if (m_ok && kk < K_gemm) {
+                        const int rs = kk / C;
+                        const int ih = p * sh + (rs / S) * dh - ph;
+                        const int iw = q * sw + (rs % S) * dw - pw;
+                        if (ih >= 0 && ih < H && iw >= 0 && iw < W) {
+                            v = in[((int64_t) b * H + ih) * W * C + (int64_t) iw * C + kk % C];
+                        }
+                    }
+                    dst[i] = v;
+                }
+            }
+        }
+
+        // B tile: transposed view of the KRSC weight so k streams contiguously.
+        for (int idx = tid; idx < NT * (KT / 4); idx += 128) {
+            const int n  = idx / (KT / 4);
+            const int k4 = idx % (KT / 4);
+            const int k  = kbase + k4 * 4;
+            float * dst  = sb + n * KP + k4 * 4;
+            const int n_abs = n0 + n;
+            if (C8) {
+                if (n_abs < K && k < K_gemm) {
+                    const int rs = k / C;
+                    const int c0 = k % C;
+                    const float * src = w + (((int64_t) n_abs * R + rs / S) * S + rs % S) * C + c0;
+                    * (uint4 *) dst = * (const uint4 *) src;
+                } else {
+                    * (uint4 *) dst = make_uint4(0, 0, 0, 0);
+                }
+            } else {
+                #pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    const int kk = k + i;
+                    float v = 0.0f;
+                    if (n_abs < K && kk < K_gemm) {
+                        const int rs = kk / C;
+                        v = w[(((int64_t) n_abs * R + rs / S) * S + rs % S) * C + kk % C];
+                    }
+                    dst[i] = v;
+                }
+            }
+        }
+    };
+
+    for (int kbase = 0; kbase < K_gemm; kbase += KT) {
+        load_tile(kbase);
+        __syncthreads();
+        #pragma unroll
+        for (int ks = 0; ks < KT / 8; ++ks) {
+            #pragma unroll
+            for (int i = 0; i < 2; ++i) {
+                wmma::load_matrix_sync(fa[i], sa + (warp_m + i * 16) * KP + ks * 8, KP);
+                #pragma unroll
+                for (int j = 0; j < 2; ++j) {
+                    if (i == 0) {
+                        wmma::load_matrix_sync(fb[j], sb + (warp_n + j * 16) * KP + ks * 8, KP);
+                    }
+                    wmma::mma_sync(fc[i][j], fa[i], fb[j], fc[i][j]);
+                }
+            }
+        }
+        __syncthreads(); // mma reads are complete before the next overwrite
+    }
+
+    __syncthreads();
+    #pragma unroll
+    for (int i = 0; i < 2; ++i) {
+        #pragma unroll
+        for (int j = 0; j < 2; ++j) {
+            wmma::store_matrix_sync(sc + (warp_m + i * 16) * CP + warp_n + j * 16, fc[i][j], CP, wmma::mem_row_major);
+        }
+    }
+    __syncthreads();
+
+    for (int idx = tid; idx < MT * (NT / 4); idx += 128) {
+        const int m  = idx / (NT / 4);
+        const int n4 = idx % (NT / 4);
+        const int m_abs = m0 + m;
+        const int n_abs = n0 + n4 * 4;
+        if (m_abs >= M || n_abs >= K) {
+            continue;
+        }
+        alignas(16) float vals[4];
+        #pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            float v = sc[m * CP + n4 * 4 + i];
+            if (WITH_BIAS) {
+                v += bias[n_abs + i];
+            }
+            if (WITH_SILU) {
+                v = v / (1.0f + expf(-v));
+            }
+            vals[i] = v;
+        }
+        const int p = m_abs / Q;
+        const int q = m_abs % Q;
+        * (uint4 *) (out + (((int64_t) b * P + p) * Q + q) * K + n_abs) = * (uint4 *) vals;
+    }
+#else
+    // Placeholder body for pre-Ampere compilation passes; the host side never
+    // launches this kernel on devices below cc 8.0 (see conv2d_igemm).
+#endif
+}
+
+template <bool C8>
+static void igemm_conv_dispatch_f32(const dim3 & grid, bool with_bias, bool with_silu,
+                                    const float * in_p, const float * w_p, const float * b_p, float * out_p,
+                                    cudaStream_t stream,
+                                    int H, int W, int C, int P, int Q, int K, int R, int S, const int32_t * p) {
+    if (with_silu) {
+        igemm_conv_f32_kernel<true, true, C8><<<grid, 128, IGEMM_SMEM_F32, stream>>>
+            (in_p, w_p, b_p, out_p, H, W, C, P, Q, K, R, S, p[1], p[0], p[3], p[2], p[5], p[4]);
+    } else if (with_bias) {
+        igemm_conv_f32_kernel<true, false, C8><<<grid, 128, IGEMM_SMEM_F32, stream>>>
+            (in_p, w_p, b_p, out_p, H, W, C, P, Q, K, R, S, p[1], p[0], p[3], p[2], p[5], p[4]);
+    } else {
+        igemm_conv_f32_kernel<false, false, C8><<<grid, 128, IGEMM_SMEM_F32, stream>>>
+            (in_p, w_p, b_p, out_p, H, W, C, P, Q, K, R, S, p[1], p[0], p[3], p[2], p[5], p[4]);
+    }
+}
+
+struct igemm_conv_plan {
+    void * nhwc_input  = nullptr;
+    void * nhwc_output = nullptr;
+    void * nhwc_weight = nullptr;
+
+    ~igemm_conv_plan() {
+        if (nhwc_weight) cudaFree(nhwc_weight);
+        if (nhwc_output) cudaFree(nhwc_output);
+        if (nhwc_input)  cudaFree(nhwc_input);
+    }
+};
+
+static std::unordered_map<const ggml_tensor *, std::unique_ptr<igemm_conv_plan>> g_igemm_plans;
+
+// NHWC copies published by executed igemm convs. A downstream igemm conv whose
+// input matches one of these entries reads the staged layout directly and skips
+// the input transpose. The NCHW write-back always runs, so non-conv consumers
+// (dwconv, concat, add, detect heads) are unaffected.
+struct igemm_nhwc_copy {
+    const void * ptr;
+    ggml_type    type;
+    int64_t      ne[4];
+};
+static std::unordered_map<const ggml_tensor *, igemm_nhwc_copy> g_nhwc_copies;
+
+static bool igemm_env_enabled(const char * name) {
+    const char * value = getenv(name);
+    return value && value[0] != '\0' && strcmp(value, "0") != 0;
+}
+
+static igemm_conv_plan * igemm_create_plan(ggml_tensor * dst, cudaStream_t stream) {
+    const ggml_tensor * kernel = dst->src[0];
+    const ggml_tensor * input  = dst->src[1];
+    const bool q8_kernel = kernel->type == GGML_TYPE_Q8_0;
+    // KRSC staging holds one element per weight: halves for f16 (and the Q8_0
+    // expansion below), floats for f32. The 4D quantized view's ggml_nbytes
+    // is degenerate, so size it explicitly.
+    const int64_t K_gemm = kernel->ne[0] * kernel->ne[1] * kernel->ne[2];
+    const int64_t wbytes = kernel->ne[3] * K_gemm *
+                           (q8_kernel ? (int64_t) sizeof(half) : (int64_t) ggml_type_size(kernel->type));
+
+    auto plan = std::make_unique<igemm_conv_plan>();
+    if (cudaMalloc(&plan->nhwc_input, ggml_nbytes(input)) != cudaSuccess ||
+        cudaMalloc(&plan->nhwc_output, ggml_nbytes(dst)) != cudaSuccess ||
+        cudaMalloc(&plan->nhwc_weight, wbytes) != cudaSuccess) {
+        cudaGetLastError();
+        return nullptr;
+    }
+    // Weights are immutable for a live plan: stage them once in KRSC order so
+    // the conv kernel streams a plain half/float B tile (f16/f32: layout
+    // transpose; Q8_0: one-shot dequant expansion — gathering per element
+    // inside the hot conv kernel costs far more than the extra staging
+    // memory).
+    if (q8_kernel) {
+        const int C    = kernel->ne[2];
+        const int RS   = kernel->ne[0] * kernel->ne[1];
+        const int nblk = K_gemm / QK8_0; // blocks per output channel
+        const int OC   = kernel->ne[3];
+        const int64_t total = (int64_t) OC * nblk;
+        const dim3 blocks((total + 255) / 256);
+        igemm_q8_dequant_kernel<<<blocks, 256, 0, stream>>>(
+            (const block_q8_0 *) kernel->data, (half *) plan->nhwc_weight,
+            C, RS, nblk, (int) K_gemm, total);
+    } else if (kernel->type == GGML_TYPE_F32) {
+        igemm_nchw_to_nhwc<float>(kernel->data, plan->nhwc_weight, kernel->ne[3], kernel->ne[2],
+                                  kernel->ne[1], kernel->ne[0], stream);
+    } else {
+        igemm_nchw_to_nhwc<half>(kernel->data, plan->nhwc_weight, kernel->ne[3], kernel->ne[2],
+                                 kernel->ne[1], kernel->ne[0], stream);
+    }
+    if (igemm_env_enabled("GGML_CUDA_LOG_IGEMM")) {
+        GGML_LOG_INFO("CUDA IGEMM create %" PRId64 "x%" PRId64 "x%" PRId64
+                      " -> %" PRId64 "x%" PRId64 "x%" PRId64 " k=%" PRId64 "x%" PRId64 "\n",
+                      input->ne[0], input->ne[1], input->ne[2], dst->ne[0], dst->ne[1], dst->ne[2],
+                      kernel->ne[0], kernel->ne[1]);
+    }
+    igemm_conv_plan * result = plan.get();
+    g_igemm_plans.emplace(dst, std::move(plan));
+    return result;
+}
+
+static bool conv2d_igemm(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * kernel = dst->src[0];
+    const ggml_tensor * input  = dst->src[1];
+    const bool use_f16 = input->type == GGML_TYPE_F16 && kernel->type == GGML_TYPE_F16 &&
+                         dst->type == GGML_TYPE_F16;
+    const bool use_f32 = input->type == GGML_TYPE_F32 && kernel->type == GGML_TYPE_F32 &&
+                         dst->type == GGML_TYPE_F32;
+    // Quantized conv: f16 activations flow through the same WMMA kernel; the
+    // Q8_0 weight was expanded into KRSC halves once at plan creation (zero
+    // im2col, zero dynamic quantization, zero output transpose vs. the
+    // mul_mat path).
+    const bool use_q8 = input->type == GGML_TYPE_F16 && kernel->type == GGML_TYPE_Q8_0 &&
+                        dst->type == GGML_TYPE_F16;
+    if (!use_f16 && !use_f32 && !use_q8) {
+        return false;
+    }
+    // f16/f32 epilogues vectorize 8-wide and need OC % 8 == 0; the scalar
+    // tail path (below) writes the remainder, so quantized convs with any
+    // output-channel count (e.g. OC=4 end2end heads) are accepted.
+    if (!use_q8 && kernel->ne[3] % 8 != 0) return false;
+    if (use_q8 && (kernel->ne[0] * kernel->ne[1] * kernel->ne[2]) % QK8_0 != 0) return false;
+    if (igemm_env_enabled("GGML_CUDA_DISABLE_IGEMM")) return false;
+    // TF32 tensor-core mma exists on Ampere and newer; f16 WMMA on Volta+.
+    const int min_cc = use_f32 ? 800 : 700;
+    if (ggml_cuda_info().devices[ggml_cuda_get_device()].cc < min_cc) return false;
+
+    auto it = g_igemm_plans.find(dst);
+    igemm_conv_plan * plan = nullptr;
+    if (it == g_igemm_plans.end()) {
+        // igemm_create_plan emplaces successful plans itself; only record
+        // failures here so we do not retry (and re-leak) every invocation.
+        plan = igemm_create_plan(dst, ctx.stream());
+        if (!plan) g_igemm_plans.emplace(dst, std::unique_ptr<igemm_conv_plan>(nullptr));
+    } else {
+        plan = it->second.get();
+    }
+    if (!plan) return false;
+
+    const int32_t * p = (const int32_t *) dst->op_params;
+    const int B = input->ne[3];
+    const int H = input->ne[1];
+    const int W = input->ne[0];
+    const int C = input->ne[2];
+    const int P = dst->ne[1];
+    const int Q = dst->ne[0];
+    const int K = kernel->ne[3];
+    const int R = kernel->ne[1];
+    const int S = kernel->ne[0];
+    // Wide B tiles cut the DRAM re-read factor of the L2-resident-unfriendly
+    // activation operand (A traffic scales with K/NT); the fallback halves NT
+    // while the block count would starve the 28-SM device of parallelism.
+    // GGML_CUDA_IGEMM_NT overrides the heuristic for tuning.
+    int nt = 0;
+    if (const char * env = getenv("GGML_CUDA_IGEMM_NT")) nt = atoi(env);
+    if (nt != 16 && nt != 64 && nt != 128 && nt != 256) {
+        nt = K <= 16 ? 16 : K <= 96 ? 64 : K <= 192 ? 128 : 256;
+        const int64_t gm = (P * Q + 63) / 64;
+        while (nt > 64 && gm * ((K + nt - 1) / nt) < 56) nt /= 2;
+    }
+    const dim3 grid((P * Q + 63) / 64, (K + nt - 1) / nt, B);
+
+    cudaStream_t stream = ctx.stream();
+
+    // Chained input: the upstream igemm conv published its NHWC output; a
+    // pointer/type/shape match lets this conv consume it directly.
+    auto cit = g_nhwc_copies.find(input);
+    const bool chained = cit != g_nhwc_copies.end() &&
+                         cit->second.type == input->type &&
+                         cit->second.ne[0] == input->ne[0] &&
+                         cit->second.ne[1] == input->ne[1] &&
+                         cit->second.ne[2] == input->ne[2] &&
+                         cit->second.ne[3] == input->ne[3];
+
+    const bool with_bias = dst->src[2] != nullptr;
+    const bool with_silu = with_bias && ggml_get_op_params_i32(dst, 7) == 1;
+    const float * b_p = with_bias ? (const float *) dst->src[2]->data : nullptr;
+
+    // C % 8 == 0 keeps every staged 16B vector aligned; unaligned channel
+    // counts (e.g. the RGB first layer) fall back to scalar staging.
+    if (use_f32) {
+        if (!chained) {
+            igemm_nchw_to_nhwc<float>(input->data, plan->nhwc_input, B, C, H, W, stream);
+        }
+        const float * in_p = (const float *) (chained ? cit->second.ptr : plan->nhwc_input);
+        const float * w_p  = (const float *) plan->nhwc_weight;
+        float * out_p      = (float *) plan->nhwc_output;
+        if (C % 8 == 0) {
+            igemm_conv_dispatch_f32<true>(grid, with_bias, with_silu, in_p, w_p, b_p, out_p,
+                                          stream, H, W, C, P, Q, K, R, S, p);
+        } else {
+            igemm_conv_dispatch_f32<false>(grid, with_bias, with_silu, in_p, w_p, b_p, out_p,
+                                           stream, H, W, C, P, Q, K, R, S, p);
+        }
+    } else {
+        if (!chained) {
+            igemm_nchw_to_nhwc<half>(input->data, plan->nhwc_input, B, C, H, W, stream);
+        }
+        const half * in_p = (const half *) (chained ? cit->second.ptr : plan->nhwc_input);
+        const half * w_p  = (const half *) plan->nhwc_weight; // KRSC (Q8_0 pre-expanded)
+        half * out_p      = (half *) plan->nhwc_output;
+        if (nt == 16) {
+            igemm_conv_launch<16>(grid, with_bias, with_silu, C, in_p, w_p, b_p, out_p,
+                                  stream, H, W, P, Q, K, R, S, p);
+        } else if (nt == 128) {
+            igemm_conv_launch<128>(grid, with_bias, with_silu, C, in_p, w_p, b_p, out_p,
+                                   stream, H, W, P, Q, K, R, S, p);
+        } else if (nt == 256) {
+            igemm_conv_launch<256>(grid, with_bias, with_silu, C, in_p, w_p, b_p, out_p,
+                                   stream, H, W, P, Q, K, R, S, p);
+        } else {
+            igemm_conv_launch<64>(grid, with_bias, with_silu, C, in_p, w_p, b_p, out_p,
+                                  stream, H, W, P, Q, K, R, S, p);
+        }
+    }
+    // Publish the NHWC output for chained consumers; the NCHW write-back
+    // always runs so every other consumer keeps reading dst->data.
+    g_nhwc_copies[dst] = igemm_nhwc_copy{ plan->nhwc_output, dst->type,
+                                          { dst->ne[0], dst->ne[1], dst->ne[2], dst->ne[3] } };
+    if (use_f32) {
+        igemm_nhwc_to_nchw<float>(plan->nhwc_output, dst->data, B, K, P, Q, stream);
+    } else {
+        igemm_nhwc_to_nchw<half>(plan->nhwc_output, dst->data, B, K, P, Q, stream);
+    }
+    return cudaPeekAtLastError() == cudaSuccess;
+}
