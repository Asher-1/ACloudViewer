+        cudnnBackendFinalize(plan.get()) != CUDNN_STATUS_SUCCESS ||
+        cudnnBackendGetAttribute(plan.get(), CUDNN_ATTR_EXECUTION_PLAN_WORKSPACE_SIZE, CUDNN_TYPE_INT64, 1,
+                                 workspace_size, nullptr) != CUDNN_STATUS_SUCCESS) {
