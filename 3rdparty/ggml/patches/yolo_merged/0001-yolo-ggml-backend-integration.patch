+    choice.frontend_plan = plan->frontend_plan;
+    choice.frontend_fused = plan->frontend_fused;
+    choice.frontend_time_ms = plan->frontend_time_ms;
+    choice.legacy_time_ms = legacy_time;
+    choice.algorithms = plan->algorithms;
+    choice.algorithm_count = plan->algorithm_count;
+    choice.algorithm_index = plan->algorithm_index;
+    cctx.choices.emplace(shape, std::move(choice));
+
+    if (env_enabled("GGML_CUDA_LOG_CUDNN_PLANS")) {
