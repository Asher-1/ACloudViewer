+// 64xNT tile per 128-thread block; NT is the B-tile width (output channels)
+// chosen per layer so the A (activation) operand — which never fits in L2 on
+// the big layers — is re-read from DRAM as few times as possible: every block
+// row along N reloads the whole A tile, so A traffic scales with K/NT.
+// NT=64 keeps four warps in a 2x2 grid of 32x32 patches (2x2 WMMA 16x16x16
+// per warp per 16-wide k-step); NT=128 widens each warp to 32x64 (2x4
+// fragments, 2x2 warp grid); NT=256 runs a 1x4 warp grid of 64x64 patches
+// (4x4 fragments) so K=320..640 layers reload A only 2-3x instead of 5-10x.
+// NT=16 keeps the 4x1 grid of 16x16 patches for narrow-channel heads where a
+// wider tile would idle tensor cores. 64 k-elements are staged per iteration
+// to amortize the barriers. The +8 half row pitch of the A/B staging buffers
+// keeps ldmatrix loads bank-conflict free without swizzling.
+constexpr int IGEMM_MT      = 64;  // A tile rows (output positions)
+constexpr int IGEMM_KT      = 64;  // GEMM-K elements staged per iteration
+constexpr int IGEMM_KP      = IGEMM_KT + 8; // padded operand row pitch, in halves
+// NT (B tile rows = output channels) is a template parameter, selected per
+// layer from K and the resulting block count (see conv2d_igemm): wide tiles
+// cut DRAM A re-reads, narrow tiles keep the SMs busy when M or K is small.
+template <int NT, bool WITH_BIAS, bool WITH_SILU, bool C8>
+static __global__ __launch_bounds__(128) void igemm_conv_f16_kernel(
+        const half * __restrict__ in,     // [B, H, W, C] NHWC
+        const half * __restrict__ w,      // [K, R, S, C] KRSC (Q8_0 expanded once at plan creation)
+        const float * __restrict__ bias,  // [K] (nullable)
+        half * __restrict__ out,          // [B, P, Q, K] NHWC
+        const int H, const int W, const int C, const int P, const int Q, const int K,
+        const int R, const int S, const int sh, const int sw,
+        const int ph, const int pw, const int dh, const int dw) {
+#if !defined(__CUDA_ARCH__) || __CUDA_ARCH__ >= 700
+    using namespace nvcuda;
+
+    constexpr int MT = IGEMM_MT;
+    constexpr int KT = IGEMM_KT;
+    constexpr int KP = IGEMM_KP;
+    constexpr int EC  = NT < 64 ? NT : 64;  // epilogue chunk width (columns)
+    constexpr int ECP = EC + 8;             // padded epilogue row pitch
+    constexpr int FM = NT == 16 ? 1 : NT == 256 ? 4 : 2; // fragments per warp along m
+    constexpr int FN = NT == 16 ? 1 : NT == 64 ? 2 : 4;  // fragments per warp along n
+    static_assert(MT / (16 * FM) * (NT / (16 * FN)) == 4, "four warps must tile the output block");
+    // The f32 epilogue staging tile (MT*ECP*4B) overlays sa+sb ((MT+NT)*KP*2B)
+    // once the main loop is done; wide NT tiles write back EC columns at a
+    // time so the footprint stays small enough for multiple resident blocks.
+    static_assert(MT * ECP * 4 <= (MT + NT) * KP * 2, "f32 epilogue must overlay the operand staging buffers");
+
+    const int M      = P * Q;
+    const int K_gemm = R * S * C;
+    const int m0     = blockIdx.x * MT;
+    const int n0     = blockIdx.y * NT;
+    const int b      = blockIdx.z;
+    const int tid    = threadIdx.x;
+
+    extern __shared__ char smem_raw[];
+    half * sa = reinterpret_cast<half *>(smem_raw);   // A[MT][KP]
+    half * sb = sa + MT * KP;                         // B[NT][KP]
+    float * sc = reinterpret_cast<float *>(smem_raw); // overlays both buffers
+
+    constexpr int WARPS_N = NT / (16 * FN); // warp columns
+    constexpr int WARPS_M = 4 / WARPS_N;    // warp rows
+    const int warp_m = (tid / (32 * WARPS_N)) * 16 * FM;
+    const int warp_n = ((tid / 32) % WARPS_N) * 16 * FN;
+
+    wmma::fragment<wmma::matrix_a, 16, 16, 16, half, wmma::row_major> fa[FM];
+    wmma::fragment<wmma::matrix_b, 16, 16, 16, half, wmma::col_major> fb[FN];
+    wmma::fragment<wmma::accumulator, 16, 16, 16, float> fc[FM][FN];
+    #pragma unroll
+    for (int i = 0; i < FM; ++i) {
+        #pragma unroll
+        for (int j = 0; j < FN; ++j) {
+            wmma::fill_fragment(fc[i][j], 0.0f);
+        }
+    }
+
+    // Stage one k-tile at a time: load, sync, consume on the tensor cores,
+    // sync. At 64-deep stages and two resident blocks per SM the memory
+    // system stays ahead of the mma pipeline without software pipelining.
+    auto load_tile = [&](int kbase) {
+        // A tile: implicit im2col. k advances in steps of 8, so a staged
+        // vector maps to 8 consecutive channels of one input pixel whenever
+        // C % 8 == 0 — a single 16B load. Unaligned C splits such a vector
+        // across kernel taps, so every element is addressed on its own;
+        // out-of-image taps and padding become zeros.
+        for (int idx = tid; idx < MT * (KT / 8); idx += 128) {
+            const int m  = idx / (KT / 8);
+            const int k8 = idx % (KT / 8);
+            const int k  = kbase + k8 * 8;
+            half * dst   = sa + m * KP + k8 * 8;
+            const int m_abs = m0 + m;
+            const bool m_ok = m_abs < M;
+            const int p = m_abs / Q;
+            const int q = m_abs % Q;
+            if (C8) {
+                int64_t src = -1;
+                if (m_ok && k < K_gemm) {
+                    const int rs = k / C;
+                    const int ih = p * sh + (rs / S) * dh - ph;
+                    const int iw = q * sw + (rs % S) * dw - pw;
+                    if (ih >= 0 && ih < H && iw >= 0 && iw < W) {
+                        src = ((int64_t) b * H + ih) * W * C + (int64_t) iw * C + k % C;
+                    }
+                }
+                if (src >= 0) {
+                    * (uint4 *) dst = * (const uint4 *) (in + src);
+                } else {
+                    * (uint4 *) dst = make_uint4(0, 0, 0, 0);
+                }
+            } else {
+                #pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    const int kk = k + i;
+                    half v = (half) 0;
+                    if (m_ok && kk < K_gemm) {
+                        const int rs = kk / C;
+                        const int ih = p * sh + (rs / S) * dh - ph;
+                        const int iw = q * sw + (rs % S) * dw - pw;
+                        if (ih >= 0 && ih < H && iw >= 0 && iw < W) {
+                            v = in[((int64_t) b * H + ih) * W * C + (int64_t) iw * C + kk % C];
+                        }
+                    }
+                    dst[i] = v;
+                }
+            }
+        }
+
+        // B tile: transposed view of the KRSC weight so k streams contiguously.
+        // Q8_0 kernels arrive pre-dequantized into this same KRSC half layout
+        // (igemm_create_plan expands them once), so quantized convs share the
+        // plain half loaders below.
+        for (int idx = tid; idx < NT * (KT / 8); idx += 128) {
+            const int n  = idx / (KT / 8);
+            const int k8 = idx % (KT / 8);
+            const int k  = kbase + k8 * 8;
+            half * dst   = sb + n * KP + k8 * 8;
+            const int n_abs = n0 + n;
+            if (C8) {
+                if (n_abs < K && k < K_gemm) {
+                    const int rs = k / C;
+                    const int c0 = k % C;
+                    const half * src = w + (((int64_t) n_abs * R + rs / S) * S + rs % S) * C + c0;
+                    * (uint4 *) dst = * (const uint4 *) src;
+                } else {
+                    * (uint4 *) dst = make_uint4(0, 0, 0, 0);
+                }
+            } else {
+                #pragma unroll
+                for (int i = 0; i < 8; ++i) {
+                    const int kk = k + i;
+                    half v = (half) 0;
+                    if (n_abs < K && kk < K_gemm) {
+                        const int rs = kk / C;
+                        v = w[(((int64_t) n_abs * R + rs / S) * S + rs % S) * C + kk % C];
+                    }
+                    dst[i] = v;
+                }
+            }
+        }
+    };
+
+    for (int kbase = 0; kbase < K_gemm; kbase += KT) {
+        load_tile(kbase);
+        __syncthreads();
+        #pragma unroll
+        for (int ks = 0; ks < KT / 16; ++ks) {
+            #pragma unroll
+            for (int i = 0; i < FM; ++i) {
+                wmma::load_matrix_sync(fa[i], sa + (warp_m + i * 16) * KP + ks * 16, KP);
+                #pragma unroll
+                for (int j = 0; j < FN; ++j) {
+                    if (i == 0) {
+                        wmma::load_matrix_sync(fb[j], sb + (warp_n + j * 16) * KP + ks * 16, KP);
+                    }
+                    wmma::mma_sync(fc[i][j], fa[i], fb[j], fc[i][j]);
+                }
+            }
+        }
+        __syncthreads(); // mma reads are complete before the next overwrite
+    }
+
+    // Epilogue: route f32 accumulators through shared memory EC columns at a
+    // time so bias and SiLU can be applied per output channel, then store 16B
+    // vectors. Fragment j of a warp covers columns warp_n + j*16 .. +16, and
+    // every supported (NT, warp_n) places each 16-column slice in exactly one
+    // chunk, so no fragment straddles a chunk boundary.
+    for (int chunk = 0; chunk < NT; chunk += EC) {
+        __syncthreads();
+        #pragma unroll
+        for (int i = 0; i < FM; ++i) {
+            #pragma unroll
+            for (int j = 0; j < FN; ++j) {
+                const int col = warp_n + j * 16;
+                if (col >= chunk && col < chunk + EC) {
+                    wmma::store_matrix_sync(sc + (warp_m + i * 16) * ECP + (col - chunk), fc[i][j], ECP, wmma::mem_row_major);
+                }
+            }
+        }
+        __syncthreads();
+
+        for (int idx = tid; idx < MT * (EC / 8); idx += 128) {
+            const int m  = idx / (EC / 8);
+            const int n8 = idx % (EC / 8);
+            const int m_abs = m0 + m;
+            const int n_abs = n0 + chunk + n8 * 8;
+            if (m_abs >= M || n_abs >= K) {
+                continue;
+            }
+            alignas(16) half vals[8];
+            #pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                float v = sc[m * ECP + n8 * 8 + i];
+                if (WITH_BIAS && n_abs + i < K) {
+                    v += bias[n_abs + i];
+                }
+                if (WITH_SILU) {
+                    v = v / (1.0f + expf(-v));
+                }
+                vals[i] = __float2half(v);
+            }
+            const int p = m_abs / Q;
+            const int q = m_abs % Q;
+            if (n_abs + 8 <= K) {
+                * (uint4 *) (out + (((int64_t) b * P + p) * Q + q) * K + n_abs) = * (uint4 *) vals;
+            } else {
+                // tail: K not a multiple of 8 (e.g. the OC=4 end2end head convs)
+                for (int i = 0; i < K - n_abs; ++i) {
+                    out[(((int64_t) b * P + p) * Q + q) * K + n_abs + i] = vals[i];
+                }
+            }
+        }
+        __syncthreads();
+    }
+#else
+    // Placeholder body for pre-Volta compilation passes; the host side never
+    // launches this kernel on devices below cc 7.0 (see conv2d_igemm).
+#endif
+}
+
+template <int NT, bool C8>
+static void igemm_conv_dispatch(const dim3 & grid, bool with_bias, bool with_silu,
+                                const half * in_p, const half * w_p, const float * b_p, half * out_p,
+                                cudaStream_t stream,
+                                int H, int W, int C, int P, int Q, int K, int R, int S, const int32_t * p) {
+    constexpr size_t smem = (IGEMM_MT + NT) * IGEMM_KP * sizeof(half); // A + B staging
+    // NT=256 needs >48KB dynamic smem; opt in once per kernel variant.
+    static const bool smem_ok = [] {
+        if (smem <= 48 * 1024) return true;
+        return cudaSuccess == cudaFuncSetAttribute(igemm_conv_f16_kernel<NT, true, true, C8>,
+                                                   cudaFuncAttributeMaxDynamicSharedMemorySize, smem)
+            && cudaSuccess == cudaFuncSetAttribute(igemm_conv_f16_kernel<NT, true, false, C8>,
+                                                   cudaFuncAttributeMaxDynamicSharedMemorySize, smem)
+            && cudaSuccess == cudaFuncSetAttribute(igemm_conv_f16_kernel<NT, false, false, C8>,
+                                                   cudaFuncAttributeMaxDynamicSharedMemorySize, smem);
+    }();
+    if (!smem_ok) return;
+    if (with_silu) {
+        igemm_conv_f16_kernel<NT, true, true, C8><<<grid, 128, smem, stream>>>
+            (in_p, w_p, b_p, out_p, H, W, C, P, Q, K, R, S, p[1], p[0], p[3], p[2], p[5], p[4]);
+    } else if (with_bias) {
+        igemm_conv_f16_kernel<NT, true, false, C8><<<grid, 128, smem, stream>>>
+            (in_p, w_p, b_p, out_p, H, W, C, P, Q, K, R, S, p[1], p[0], p[3], p[2], p[5], p[4]);
+    } else {
+        igemm_conv_f16_kernel<NT, false, false, C8><<<grid, 128, smem, stream>>>
+            (in_p, w_p, b_p, out_p, H, W, C, P, Q, K, R, S, p[1], p[0], p[3], p[2], p[5], p[4]);
+    }
+}
+
+// NT launcher folding the C % 8 vectorization check into the template tree.
+template <int NT>
+static void igemm_conv_launch(const dim3 & grid, bool with_bias, bool with_silu, int C,
+                              const half * in_p, const half * w_p, const float * b_p, half * out_p,
+                              cudaStream_t stream,
+                              int H, int W, int P, int Q, int K, int R, int S, const int32_t * p) {
+    if (C % 8 == 0) {
+        igemm_conv_dispatch<NT, true>(grid, with_bias, with_silu, in_p, w_p, b_p, out_p, stream,
+                                      H, W, C, P, Q, K, R, S, p);
+    } else {
+        igemm_conv_dispatch<NT, false>(grid, with_bias, with_silu, in_p, w_p, b_p, out_p, stream,
+                                       H, W, C, P, Q, K, R, S, p);
+    }
