+static cudnn_backend_desc_ptr cudnn_make_tensor_desc(
+        const int64_t * dims, const int64_t * strides, int64_t id, cudnnDataType_t data_type, bool is_virtual) {
+    const int64_t alignment = 16;
+    auto tensor = cudnn_backend_create(CUDNN_BACKEND_TENSOR_DESCRIPTOR);
+    if (!tensor ||
+        !cudnn_set_attr(tensor.get(), CUDNN_ATTR_TENSOR_DATA_TYPE, CUDNN_TYPE_DATA_TYPE, 1, &data_type) ||
+        !cudnn_set_attr(tensor.get(), CUDNN_ATTR_TENSOR_DIMENSIONS, CUDNN_TYPE_INT64, 4, dims) ||
+        !cudnn_set_attr(tensor.get(), CUDNN_ATTR_TENSOR_STRIDES, CUDNN_TYPE_INT64, 4, strides) ||
+        !cudnn_set_attr(tensor.get(), CUDNN_ATTR_TENSOR_UNIQUE_ID, CUDNN_TYPE_INT64, 1, &id) ||
+        !cudnn_set_attr(tensor.get(), CUDNN_ATTR_TENSOR_BYTE_ALIGNMENT, CUDNN_TYPE_INT64, 1, &alignment)) {
+        return nullptr;
+    }
+    if (is_virtual) {
+        const bool virtual_flag = true;
+        if (!cudnn_set_attr(tensor.get(), CUDNN_ATTR_TENSOR_IS_VIRTUAL, CUDNN_TYPE_BOOLEAN, 1, &virtual_flag)) {
