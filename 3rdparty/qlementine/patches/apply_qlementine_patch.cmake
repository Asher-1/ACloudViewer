cmake_minimum_required(VERSION 3.24)
foreach(_required SOURCE_DIR PATCH_FILE MANIFEST_FILE GIT_EXECUTABLE QLEMENTINE_VERSION)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "Qlementine patch runner requires ${_required}")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${SOURCE_DIR}")
    message(FATAL_ERROR "Qlementine extracted source directory is absent: ${SOURCE_DIR}")
endif()
file(READ "${MANIFEST_FILE}" _manifest)
string(JSON _version GET "${_manifest}" upstream)
string(JSON _expected GET "${_manifest}" patch_sha256)
file(SHA256 "${PATCH_FILE}" _actual)
if(NOT _version STREQUAL QLEMENTINE_VERSION OR NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Qlementine version or patch hash differs from the manifest")
endif()
string(JSON _count LENGTH "${_manifest}" files)
if(_count LESS 1)
    message(FATAL_ERROR "Qlementine source manifest has no files")
endif()
math(EXPR _last "${_count} - 1")

function(qlementine_compare_files expected mismatches)
    set(_mismatches)
    foreach(_index RANGE ${_last})
        string(JSON _path GET "${_manifest}" files ${_index} path)
        string(JSON _hash GET "${_manifest}" files ${_index} ${expected})
        if(IS_ABSOLUTE "${_path}" OR _path MATCHES "(^|/)\\.\\.(/|$)" OR
           NOT _path MATCHES "^[A-Za-z0-9_./-]+$")
            message(FATAL_ERROR "Invalid Qlementine manifest path: ${_path}")
        endif()
        set(_actual "")
        if(EXISTS "${SOURCE_DIR}/${_path}")
            file(SHA256 "${SOURCE_DIR}/${_path}" _actual)
        endif()
        if(NOT _actual STREQUAL _hash)
            list(APPEND _mismatches "${_path}")
        endif()
    endforeach()
    set(${mismatches} "${_mismatches}" PARENT_SCOPE)
endfunction()

# Prevent Git from discovering a checkout enclosing the extracted source.
get_filename_component(_source_parent "${SOURCE_DIR}" DIRECTORY)
function(qlementine_git_apply)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
        "GIT_CEILING_DIRECTORIES=${_source_parent}"
        "${GIT_EXECUTABLE}" -c core.autocrlf=false -c apply.ignoreWhitespace=no
        apply --no-index --whitespace=nowarn ${ARGN} "${PATCH_FILE}"
        WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE _status ERROR_VARIABLE _error)
    if(NOT _status STREQUAL "0")
        message(FATAL_ERROR "Qlementine git apply ${ARGN} failed: ${_error}")
    endif()
endfunction()

qlementine_compare_files(after_sha256 _after_mismatches)
if(NOT _after_mismatches)
    qlementine_git_apply(--reverse --check)
    message(STATUS "Qlementine compatibility patch already applied and verified")
else()
    if(VERIFY_ONLY)
        message(FATAL_ERROR "Qlementine reused source is not the complete verified patched state: ${_after_mismatches}")
    endif()
    qlementine_compare_files(before_sha256 _before_mismatches)
    if(_before_mismatches)
        message(FATAL_ERROR "Qlementine source is partially patched or modified: ${_before_mismatches}")
    endif()
    qlementine_git_apply(--check)
    qlementine_git_apply()
    qlementine_compare_files(after_sha256 _after_mismatches)
    if(_after_mismatches)
        message(FATAL_ERROR "Qlementine patched file hashes mismatch: ${_after_mismatches}")
    endif()
    message(STATUS "Qlementine compatibility patch applied and verified (${_count} files)")
endif()
