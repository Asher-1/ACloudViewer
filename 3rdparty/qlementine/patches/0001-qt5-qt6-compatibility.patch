diff --git a/after/lib/include/oclero/qlementine/utils/QtCompat.hpp b/lib/include/oclero/qlementine/utils/QtCompat.hpp
new file mode 100644
index 0000000..9884004
--- /dev/null
+++ b/lib/include/oclero/qlementine/utils/QtCompat.hpp
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: MIT
+// ACloudViewer compatibility additions to pinned Qlementine v1.5.2.
+#pragma once
+
+#include <QtGlobal>
+#include <QEvent>
+#include <QPainter>
+#include <QMouseEvent>
+#include <QPixmap>
+#include <QWidget>
+#include <QWindow>
+#include <QScreen>
+#include <QGuiApplication>
+#include <type_traits>
+#if QT_VERSION >= QT_VERSION_CHECK(6, 9, 0)
+#include <QPainterStateGuard>
+#endif
+
+namespace oclero::qlementine::compat {
+template<class Enum>
+constexpr std::underlying_type_t<Enum> toUnderlying(Enum value) noexcept {
+  return static_cast<std::underlying_type_t<Enum>>(value);
+}
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+using EnterEvent = QEnterEvent;
+#else
+using EnterEvent = QEvent;
+#endif
+
+#if QT_VERSION >= QT_VERSION_CHECK(6, 9, 0)
+using PainterStateGuard = QPainterStateGuard;
+#else
+// The pinned upstream only uses the one-save RAII form; keep early-return and
+// nested-painter semantics identical instead of disabling any painting code.
+class PainterStateGuard {
+public:
+  explicit PainterStateGuard(QPainter* painter) : _painter(painter) {
+    Q_ASSERT(_painter);
+    _painter->save();
+  }
+  ~PainterStateGuard() { _painter->restore(); }
+  PainterStateGuard(const PainterStateGuard&) = delete;
+  PainterStateGuard& operator=(const PainterStateGuard&) = delete;
+private:
+  QPainter* _painter;
+};
+#endif
+
+inline QScreen* screenForWidget(const QWidget* widget) {
+#if QT_VERSION >= QT_VERSION_CHECK(5, 14, 0)
+  return widget ? widget->screen() : QGuiApplication::primaryScreen();
+#else
+  if (widget && widget->window() && widget->window()->windowHandle())
+    return widget->window()->windowHandle()->screen();
+  return QGuiApplication::primaryScreen();
+#endif
+}
+
+// Existing QWidget native visuals cannot acquire alpha by changing an
+// attribute after creation (notably Qt5 QMenu::popup). Query the actual surface.
+inline bool popupHasAlpha(const QWidget* widget) {
+  if (!widget) return true;
+  const auto* popup = widget->window();
+  const auto* handle = popup ? popup->windowHandle() : nullptr;
+  return !handle || handle->format().alphaBufferSize() > 0;
+}
+
+inline QSizeF pixmapLogicalSize(const QPixmap& pixmap) {
+  return QSizeF(pixmap.size()) / pixmap.devicePixelRatio();
+}
+inline QPointF mousePosition(const QMouseEvent* event) {
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+  return event->position();
+#else
+  return event->localPos();
+#endif
+}
+} // namespace oclero::qlementine::compat
