# ACloudViewer patch 0002 for OpenImageIO 3.1.17.0: enforce the pinned
# yaml-cpp 0.8.0 inside the OpenColorIO sub-build (windows wheel LNK2001).
#
# Follow-up to 0001's three-layer yaml-cpp defense (DIR/ROOT/INCLUDE_DIR/
# LIBRARY pins + CMAKE_PROJECT_INCLUDE repairs). The Sep-18 windows-wheel CI
# still produced the exact drift 0001 guards against:
#
#   oiio_static_closure.lib(OCIOYaml.obj) : error LNK2001:
#     YAML::FpToString(float, unsigned __int64)
#     YAML::FpToString(double, unsigned __int64)
#     YAML::Emitter::Write(char const*, unsigned __int64)
#   pybind.cp312-win_amd64.pyd : fatal error LNK1120: 3 unresolved externals
#
# i.e. OCIOYaml.cpp was compiled against yaml-cpp 0.9.x headers (the first
# release shipping Emitter::Write(const char*, size_t) and the public
# yaml-cpp/fptostring.h used by the inline WriteStreamable tail) while the
# closure merges the pinned 0.8.0 archive. This patch closes the class:
#
#   src/cmake/ocio_subbuild_project_include.cmake
#       repair 3 (OCIO_PINNED_YAML_CPP): append an enforcement tail to
#       Findyaml-cpp.cmake and prepend one to Installyaml-cpp.cmake. The
#       tail reads the OIIO pins back from the cache, forces them onto the
#       yaml-cpp::yaml-cpp target, and runs an emitter.h canary
#       ("fptostring" only exists in yaml-cpp 0.9.x+) that FATALs the OCIO
#       sub-configure on any residual drift - at configure time, hours
#       before the pybind link. Installyaml-cpp.cmake declares yaml-cpp
#       FOUND from the pins and returns before its ext clone, so the
#       empty-GIT_TAG default-branch clone 0001 guards can no longer even
#       start. Without pins (consumer scope) the guards stay silent, so
#       OCIO's installed config keeps working for plain consumers.
#
#   src/cmake/dependency_utils.cmake
#       default every local-dep sub-build to CMAKE_MESSAGE_LOG_LEVEL=STATUS
#       (was ERROR): the fixup confirmations and any FATAL call stack above
#       must be visible in CI logs; the windows-wheel failure was invisible
#       precisely because sub-build output was suppressed at ERROR level.
#
# Acceptance: the fixup is idempotent (marker-scoped), applies cleanly on a
# fresh tree after 0001, and a fake-tree dry run shows 0.8.0 headers pass
# while 0.9.x-style headers (fptostring.h canary) abort the configure.

diff --git a/src/cmake/ocio_subbuild_project_include.cmake b/src/cmake/ocio_subbuild_project_include.cmake
--- a/src/cmake/ocio_subbuild_project_include.cmake
+++ b/src/cmake/ocio_subbuild_project_include.cmake
@@ -94,3 +94,96 @@
         endif()
     endif()
 endif()
+
+set(_ocio_pin_install_block "")
+foreach(_ocio_pin_line IN ITEMS
+        "# --- OCIO_PINNED_YAML_CPP (ACloudViewer patch 0002) ---"
+        "get_property(_ocio_pin_include CACHE yaml-cpp_INCLUDE_DIR PROPERTY VALUE)"
+        "get_property(_ocio_pin_library CACHE yaml-cpp_LIBRARY PROPERTY VALUE)"
+        "if(_ocio_pin_include AND NOT _ocio_pin_include MATCHES \"NOTFOUND$\""
+        "        AND _ocio_pin_library AND NOT _ocio_pin_library MATCHES \"NOTFOUND$\""
+        "        AND EXISTS \"\${_ocio_pin_include}/yaml-cpp/yaml.h\""
+        "        AND EXISTS \"\${_ocio_pin_library}\")"
+        "    set(yaml-cpp_FOUND TRUE)"
+        "    set(yaml-cpp_INCLUDE_DIR \"\${_ocio_pin_include}\")"
+        "    set(yaml-cpp_LIBRARY \"\${_ocio_pin_library}\")"
+        "    if(NOT TARGET yaml-cpp::yaml-cpp)"
+        "        add_library(yaml-cpp::yaml-cpp UNKNOWN IMPORTED GLOBAL)"
+        "    endif()"
+        "    set_target_properties(yaml-cpp::yaml-cpp PROPERTIES"
+        "        IMPORTED_LOCATION \"\${_ocio_pin_library}\""
+        "        INTERFACE_INCLUDE_DIRECTORIES \"\${_ocio_pin_include}\")"
+        "    return()"
+        "endif()")
+    string(CONCAT _ocio_pin_install_block "${_ocio_pin_install_block}" "${_ocio_pin_line}" "\n")
+endforeach()
+
+# 3. OCIO_PINNED_YAML_CPP: whatever route the yaml-cpp resolution takes below
+#    (config find, module fallback, or the Installyaml-cpp ext build), the
+#    yaml-cpp::yaml-cpp target must end up on the OIIO-pinned 0.8.0 artifacts
+#    handed over as -D yaml-cpp_INCLUDE_DIR / yaml-cpp_LIBRARY cache entries.
+#    OCIOYaml.cpp compiled against a newer yaml-cpp (the 0.9.x emitter API:
+#    YAML::FpToString, Emitter::Write(const char*, size_t)) still links into
+#    OCIO's static archive and only explodes as LNK2001 x3 at the pybind
+#    link, hours after the drift. Append an enforcement tail to
+#    Findyaml-cpp.cmake and prepend one to Installyaml-cpp.cmake: the pins
+#    are forced onto the target, and an emitter.h canary (yaml-cpp 0.9.x+
+#    ships yaml-cpp/fptostring.h; 0.8.0 does not) fails the sub-configure
+#    loudly on any residual drift instead of silently resolving a host tree.
+set(_ocio_pin_find_block "")
+foreach(_ocio_pin_line IN ITEMS
+        "# --- OCIO_PINNED_YAML_CPP (ACloudViewer patch 0002) ---"
+        "get_property(_ocio_pin_include CACHE yaml-cpp_INCLUDE_DIR PROPERTY VALUE)"
+        "get_property(_ocio_pin_library CACHE yaml-cpp_LIBRARY PROPERTY VALUE)"
+        "if(_ocio_pin_include AND NOT _ocio_pin_include MATCHES \"NOTFOUND$\")"
+        "    set(yaml-cpp_INCLUDE_DIR \"\${_ocio_pin_include}\")"
+        "endif()"
+        "if(_ocio_pin_library AND NOT _ocio_pin_library MATCHES \"NOTFOUND$\")"
+        "    set(yaml-cpp_LIBRARY \"\${_ocio_pin_library}\")"
+        "endif()"
+        "if(TARGET yaml-cpp::yaml-cpp AND yaml-cpp_INCLUDE_DIR AND yaml-cpp_LIBRARY"
+        "        AND NOT yaml-cpp_INCLUDE_DIR MATCHES \"NOTFOUND$\""
+        "        AND NOT yaml-cpp_LIBRARY MATCHES \"NOTFOUND$\")"
+        "    set_target_properties(yaml-cpp::yaml-cpp PROPERTIES"
+        "        IMPORTED_LOCATION \"\${_ocio_pin_library}\""
+        "        INTERFACE_INCLUDE_DIRECTORIES \"\${_ocio_pin_include}\")"
+        "endif()"
+        "set(_ocio_canary_include \"\${yaml-cpp_INCLUDE_DIR}\")"
+        "if(NOT _ocio_canary_include OR _ocio_canary_include MATCHES \"NOTFOUND$\")"
+        "    get_target_property(_ocio_canary_include yaml-cpp::yaml-cpp INTERFACE_INCLUDE_DIRECTORIES)"
+        "endif()"
+        "set(_ocio_canary_hit \"\")"
+        "foreach(_ocio_inc IN LISTS _ocio_canary_include)"
+        "    if(NOT _ocio_canary_hit AND EXISTS \"\${_ocio_inc}/yaml-cpp/emitter.h\")"
+        "        file(READ \"\${_ocio_inc}/yaml-cpp/emitter.h\" _ocio_emitter_src)"
+        "        if(_ocio_emitter_src MATCHES \"fptostring\")"
+        "            set(_ocio_canary_hit \"\${_ocio_inc}\")"
+        "        endif()"
+        "    endif()"
+        "endforeach()"
+        "if(_ocio_canary_hit)"
+        "    message(FATAL_ERROR \"OCIO yaml-cpp: headers under \${_ocio_canary_hit} carry the 0.9.x emitter API (yaml-cpp/fptostring.h); compiling against them while OIIO links the pinned 0.8.0 static archive yields the windows-wheel YAML::FpToString / Emitter::Write(const char*, size_t) LNK2001 set at the pybind link\")"
+        "endif()")
+    string(CONCAT _ocio_pin_find_block "${_ocio_pin_find_block}" "${_ocio_pin_line}" "\n")
+endforeach()
+
+set(_ocio_find_mod "${_ocio_root}/share/cmake/modules/Findyaml-cpp.cmake")
+if(EXISTS "${_ocio_find_mod}")
+    file(READ "${_ocio_find_mod}" _ocio_yaml_src)
+    if(NOT _ocio_yaml_src MATCHES "OCIO_PINNED_YAML_CPP")
+        file(APPEND "${_ocio_find_mod}" "${_ocio_pin_find_block}")
+        message(STATUS
+            "OCIO sub-build fixup: Findyaml-cpp.cmake 0.9 emitter-API guard applied (OCIO_PINNED_YAML_CPP)")
+    endif()
+endif()
+
+set(_ocio_install_mod "${_ocio_root}/share/cmake/modules/install/Installyaml-cpp.cmake")
+if(EXISTS "${_ocio_install_mod}")
+    file(READ "${_ocio_install_mod}" _ocio_inst_src)
+    if(NOT _ocio_inst_src MATCHES "OCIO_PINNED_YAML_CPP")
+        file(WRITE "${_ocio_install_mod}"
+            "${_ocio_pin_install_block}${_ocio_inst_src}")
+        message(STATUS
+            "OCIO sub-build fixup: Installyaml-cpp.cmake pinned-target guard applied (OCIO_PINNED_YAML_CPP)")
+    endif()
+endif()
diff --git a/src/cmake/dependency_utils.cmake b/src/cmake/dependency_utils.cmake
--- a/src/cmake/dependency_utils.cmake
+++ b/src/cmake/dependency_utils.cmake
@@ -723,7 +723,7 @@ macro (build_dependency_with_cmake pkgname)
     else ()
         set (_pkg_cmake_verbose -DCMAKE_VERBOSE_MAKEFILE=OFF
-                                -DCMAKE_MESSAGE_LOG_LEVEL=ERROR
+                                -DCMAKE_MESSAGE_LOG_LEVEL=STATUS
                                 -DCMAKE_RULE_MESSAGES=OFF
                                 -Wno-dev
                                 )
     endif ()
