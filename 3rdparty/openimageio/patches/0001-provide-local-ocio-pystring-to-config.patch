diff --git a/src/cmake/build_OpenColorIO.cmake b/src/cmake/build_OpenColorIO.cmake
index 4f7a3170..a90e132f 100644
--- a/src/cmake/build_OpenColorIO.cmake
+++ b/src/cmake/build_OpenColorIO.cmake
@@ -59,6 +59,19 @@ build_dependency_with_cmake(OpenColorIO
 # Set some things up that we'll need for a subsequent find_package to work
 set (OpenColorIO_ROOT ${OpenColorIO_LOCAL_INSTALL_DIR})
 set (OpenColorIO_DIR ${OpenColorIO_LOCAL_INSTALL_DIR})
+
+# OCIO's installed config re-finds pystring, but when OCIO builds pystring as
+# an internal dependency it lives under its build tree rather than the OIIO
+# dependency prefix. Supply its platform-native static artifact explicitly so
+# the re-find is independent of host packages.
+set (_OpenColorIO_LOCAL_EXT_ROOT
+     "${CMAKE_BINARY_DIR}/deps/OpenColorIO-build/ext/dist")
+set (pystring_INCLUDE_DIR
+     "${_OpenColorIO_LOCAL_EXT_ROOT}/${CMAKE_INSTALL_INCLUDEDIR}/pystring"
+     CACHE PATH "Local OCIO pystring include directory" FORCE)
+set (pystring_LIBRARY
+     "${_OpenColorIO_LOCAL_EXT_ROOT}/${CMAKE_INSTALL_LIBDIR}/${CMAKE_STATIC_LIBRARY_PREFIX}pystring${CMAKE_STATIC_LIBRARY_SUFFIX}"
+     CACHE FILEPATH "Local OCIO pystring library" FORCE)
 
 # Signal to caller that we need to find again at the installed location
 # set (OpenColorIO_REFIND TRUE)
