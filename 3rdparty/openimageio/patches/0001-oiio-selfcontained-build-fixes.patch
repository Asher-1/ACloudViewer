+++ b/src/cmake/externalpackages.cmake
@@ -80,6 +80,14 @@ if (TARGET libjpeg-turbo::jpeg) # Try to find the non-turbo version
     # Doctor it so libjpeg-turbo is aliased as JPEG::JPEG
     alias_library_if_not_exists (JPEG::JPEG libjpeg-turbo::jpeg)
     set (JPEG_FOUND TRUE)
+elseif (TARGET libjpeg-turbo::jpeg-static)
+    # A static-only local build (ENABLE_SHARED=OFF, the default for local
+    # deps) exports `jpeg-static` but no plain `jpeg` target. Without this
+    # branch the fallback below scavenges a host JPEG (conda/Homebrew), so
+    # the libjpeg-turbo just built locally is never linked and the final
+    # dylib picks up a host library dependency.
+    alias_library_if_not_exists (JPEG::JPEG libjpeg-turbo::jpeg-static)
+    set (JPEG_FOUND TRUE)
 else ()
     # Try to find the non-turbo version
     checked_find_package (JPEG REQUIRED)
@@ -156,7 +164,12 @@ checked_find_package (OpenColorIO REQUIRED
                       VERSION_MAX 2.9
                      )
 if (NOT OPENCOLORIO_INCLUDES)
-    get_target_property(OPENCOLORIO_INCLUDES OpenColorIO::OpenColorIO INTERFACE_INCLUDE_DIRECTORIES)
+    # With USE_OPENCOLORIO=OFF the checked_find_package above is forced
+    # optional and no OpenColorIO::OpenColorIO target exists; probing it
+    # unconditionally is a fatal configure error. Guard the probe.
+    if (TARGET OpenColorIO::OpenColorIO)
+        get_target_property(OPENCOLORIO_INCLUDES OpenColorIO::OpenColorIO INTERFACE_INCLUDE_DIRECTORIES)
+    endif ()
 endif ()
 include_directories(BEFORE ${OPENCOLORIO_INCLUDES})
 
diff --git a/b/src/cmake/ocio_subbuild_project_include.cmake b/src/cmake/ocio_subbuild_project_include.cmake
new file mode 100644
index 0000000..b120869
--- /dev/null
+++ b/src/cmake/ocio_subbuild_project_include.cmake
@@ -0,0 +1,96 @@
+# Included right after project() inside the OpenColorIO sub-build via
+# -DCMAKE_PROJECT_INCLUDE (see build_OpenColorIO.cmake in the OIIO patch
+# set). Two in-place repairs, both idempotent, both limited to the cloned
+# OCIO sources inside the build tree:
+#
+# 1. OCIO's Findyaml-cpp.cmake reads the *generic* IMPORTED_LOCATION of
+#    yaml-cpp::yaml-cpp. MSVC multi-config generators only write
+#    IMPORTED_LOCATION_<CONFIG> into yaml-cpp-targets.cmake, so the read
+#    comes back *-NOTFOUND, find_package_handle_standard_args fails, and
+#    OCIO falls back to Installyaml-cpp. That ext fallback compiles
+#    OCIOYaml.cpp against whatever yaml-cpp headers the ext tree carries;
+#    when the version chain yields a newer tree than the pinned 0.8.0
+#    archive OIIO links, the final link fails with the windows-wheel
+#    YAML::FpToString / Emitter::Write(const char*, size_t) LNK2001 set.
+#    Recovering the per-config location makes the pinned config find
+#    succeed, so OCIO compiles against the same 0.8.0 headers it links.
+# 2. Guard Installyaml-cpp.cmake against an empty GIT_TAG: with no tag
+#    ExternalProject clones the default branch (a moving 0.9.x-dev tree),
+#    which is exactly the version drift above. Fail loudly instead.
+#
+# NOTE: the inserted fixup text is assembled with string(CONCAT) instead of
+# a foreach over a list - list elements would be split at every literal
+# semicolon inside the comment lines and garble the patched module.
+
+set(_ocio_root "${CMAKE_CURRENT_SOURCE_DIR}")
+
+set(_ocio_find_mod "${_ocio_root}/share/cmake/modules/Findyaml-cpp.cmake")
+if(EXISTS "${_ocio_find_mod}")
+    file(READ "${_ocio_find_mod}" _ocio_yaml_src)
+    if(NOT _ocio_yaml_src MATCHES "OCIO_MSVC_LOCATION_FIX")
+        set(_ocio_needle
+            "    get_target_property(yaml-cpp_LIBRARY yaml-cpp::yaml-cpp LOCATION)")
+        string(CONCAT _ocio_fix
+            "\n"
+            "    # OCIO_MSVC_LOCATION_FIX (ACloudViewer patch 0001): recover the\n"
+            "    # per-config import location on multi-config generators because\n"
+            "    # the generic LOCATION read above comes back NOTFOUND under\n"
+            "    # MSVC, FPHSA then fails and OCIO falls back to Installyaml-cpp\n"
+            "    # whose ext headers can drift from the pinned 0.8.0 archive\n"
+            "    # (windows wheel YAML::FpToString LNK2001).\n"
+            "    if(yaml-cpp_LIBRARY MATCHES \"NOTFOUND$\")\n"
+            "        get_target_property(yaml-cpp_LIBRARY yaml-cpp::yaml-cpp IMPORTED_LOCATION_RELEASE)\n"
+            "        if(NOT yaml-cpp_LIBRARY)\n"
+            "            get_target_property(yaml-cpp_LIBRARY yaml-cpp::yaml-cpp IMPORTED_LOCATION_DEBUG)\n"
+            "        endif()\n"
+            "    endif()\n")
+        if(_ocio_yaml_src MATCHES "yaml-cpp::yaml-cpp LOCATION")
+            string(REPLACE "${_ocio_needle}\n"
+                           "${_ocio_needle}\n${_ocio_fix}"
+                           _ocio_yaml_src "${_ocio_yaml_src}")
+            file(WRITE "${_ocio_find_mod}" "${_ocio_yaml_src}")
+            message(STATUS
+                "OCIO sub-build fixup: Findyaml-cpp.cmake LOCATION recovery applied (OCIO_MSVC_LOCATION_FIX)")
+        else()
+            # Upstream changed the module layout (OpenColorIO upgrade): the
+            # needle no longer matches. Loudly note that the MSVC recovery is
+            # NOT in effect instead of silently shipping a build that links
+            # against a yaml-cpp whose headers may drift from the pinned
+            # 0.8.0 archive.
+            message(WARNING
+                "OCIO sub-build fixup: Findyaml-cpp.cmake layout changed "
+                "(OpenColorIO upgrade?) - OCIO_MSVC_LOCATION_FIX NOT applied; "
+                "on MSVC a yaml-cpp version mismatch may resurface at link time")
+        endif()
+    endif()
+endif()
+
+set(_ocio_install_mod "${_ocio_root}/share/cmake/modules/install/Installyaml-cpp.cmake")
+if(EXISTS "${_ocio_install_mod}")
+    file(READ "${_ocio_install_mod}" _ocio_inst_src)
+    if(NOT _ocio_inst_src MATCHES "OCIO_EMPTY_TAG_GUARD")
+        set(_ocio_tag_needle
+            "        set(yaml-cpp_GIT_TAG \"\${yaml-cpp_VERSION}\")")
+        string(CONCAT _ocio_tag_fix
+            "\n"
+            "        # OCIO_EMPTY_TAG_GUARD (ACloudViewer patch 0001): an empty\n"
+            "        # tag makes ExternalProject clone the default branch - a\n"
+            "        # moving 0.9.x-dev tree whose headers mismatch the pinned\n"
+            "        # 0.8.0 closure archive. Fail loudly instead.\n"
+            "        if(NOT yaml-cpp_GIT_TAG)\n"
+            "            message(FATAL_ERROR \"OCIO ext yaml-cpp: empty install version; refusing to clone a moving branch\")\n"
+            "        endif()\n")
+        if(_ocio_inst_src MATCHES "set\\(yaml-cpp_GIT_TAG")
+            string(REPLACE "${_ocio_tag_needle}\n"
+                           "${_ocio_tag_needle}\n${_ocio_tag_fix}"
+                           _ocio_inst_src "${_ocio_inst_src}")
+            file(WRITE "${_ocio_install_mod}" "${_ocio_inst_src}")
+            message(STATUS
+                "OCIO sub-build fixup: Installyaml-cpp.cmake empty-GIT_TAG guard applied (OCIO_EMPTY_TAG_GUARD)")
+        else()
+            message(WARNING
+                "OCIO sub-build fixup: Installyaml-cpp.cmake layout changed "
+                "(OpenColorIO upgrade?) - OCIO_EMPTY_TAG_GUARD NOT applied")
+        endif()
+    endif()
+endif()
