# Build closures for compatibility selections. Their commands forward to the
# same Run.cmake policy as check-cpp; no execution policy lives in this module.
foreach(group aicore-fast aicore-contract aicore-model aicore-yolo-matrix)
    set(group_targets)
    set(group_tests)
    foreach(name IN LISTS registered_tests)
        string(SHA256 key "${name}")
        get_property(labels GLOBAL PROPERTY "CV_TEST_${key}_LABELS")
        if("${group}" IN_LIST labels)
            get_property(targets GLOBAL PROPERTY "CV_TEST_${key}_TARGETS")
            list(APPEND group_targets ${targets})
            list(APPEND group_tests "${name}")
        endif()
    endforeach()
    if(group_tests)
        add_custom_target(cpp-tests-${group})
        if(group_targets)
            list(REMOVE_DUPLICATES group_targets)
            add_dependencies(cpp-tests-${group} ${group_targets})
        endif()
    endif()
endforeach()
