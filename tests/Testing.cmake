include_guard(GLOBAL)

# The root test module owns registration and execution policy. Tests remain
# next to the production code whose private dependencies they exercise.
# This API does not override CMake's add_test() or affect third-party projects.
function(cloudviewer_add_test)
    cmake_parse_arguments(PARSE_ARGV 0 CVT "COMMAND_EXPAND_LISTS"
        "NAME;WORKING_DIRECTORY" "COMMAND;CONFIGURATIONS;BUILD_TARGETS;LABELS")
    if(NOT CVT_NAME OR NOT CVT_COMMAND OR CVT_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "cloudviewer_add_test requires NAME and COMMAND; unknown arguments: ${CVT_UNPARSED_ARGUMENTS}")
    endif()
    string(SHA256 key "${CVT_NAME}")
    get_property(registered GLOBAL PROPERTY "CV_TEST_${key}_SOURCE")
    if(registered)
        message(FATAL_ERROR "Duplicate test '${CVT_NAME}': ${registered} and ${CMAKE_CURRENT_SOURCE_DIR}")
    endif()
    set(options)
    if(CVT_WORKING_DIRECTORY)
        list(APPEND options WORKING_DIRECTORY "${CVT_WORKING_DIRECTORY}")
    endif()
    if(CVT_CONFIGURATIONS)
        list(APPEND options CONFIGURATIONS ${CVT_CONFIGURATIONS})
    endif()
    if(CVT_COMMAND_EXPAND_LISTS)
        list(APPEND options COMMAND_EXPAND_LISTS)
    endif()
    add_test(NAME "${CVT_NAME}" COMMAND ${CVT_COMMAND} ${options})
    if(CVT_LABELS)
        set_property(TEST "${CVT_NAME}" APPEND PROPERTY LABELS ${CVT_LABELS})
    endif()

    # Commands can be direct executables or wrappers (xvfb, Python, cmake -E
    # env). Capture referenced target identities, not build-tree filenames.
    set(targets ${CVT_BUILD_TARGETS})
    foreach(token IN LISTS CVT_COMMAND)
        if(TARGET "${token}")
            list(APPEND targets "${token}")
        endif()
        string(REGEX MATCHALL "\\$<TARGET_FILE[^:>]*:[^>]+>" references "${token}")
        foreach(reference IN LISTS references)
            string(REGEX REPLACE "^\\$<TARGET_FILE[^:>]*:([^>]+)>$" "\\1" target "${reference}")
            list(APPEND targets "${target}")
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES targets)
    set_property(GLOBAL APPEND PROPERTY CV_TEST_NAMES "${CVT_NAME}")
    set_property(GLOBAL PROPERTY "CV_TEST_${key}_SOURCE" "${CMAKE_CURRENT_SOURCE_DIR}")
    set_property(GLOBAL PROPERTY "CV_TEST_${key}_TARGETS" "${targets}")
    if("cpp" IN_LIST CVT_LABELS)
        set_property(GLOBAL PROPERTY "CV_TEST_${key}_EXTERNAL_NATIVE" TRUE)
    endif()
    set_property(DIRECTORY APPEND PROPERTY CV_LOCAL_TESTS "${CVT_NAME}")
    get_property(scheduled DIRECTORY PROPERTY CV_TEST_FINALIZER_SCHEDULED)
    if(NOT scheduled)
        set_property(DIRECTORY PROPERTY CV_TEST_FINALIZER_SCHEDULED TRUE)
        # Labels and target declarations may follow registration. Read them at
        # the end of the owning directory, using APIs supported by CMake 3.24.
        cmake_language(DEFER CALL cloudviewer_finalize_local_tests)
    endif()
endfunction()

function(cloudviewer_finalize_local_tests)
    get_property(names DIRECTORY PROPERTY CV_LOCAL_TESTS)
    foreach(name IN LISTS names)
        string(SHA256 key "${name}")
        get_property(targets GLOBAL PROPERTY "CV_TEST_${key}_TARGETS")
        get_test_property("${name}" LABELS labels)
        if(NOT labels OR labels MATCHES "NOTFOUND$")
            set(labels)
        endif()
        # Profiles are derived policy, never an escape hatch supplied by owners.
        list(REMOVE_ITEM labels cpp-ci cpp-graphics cpp-model cpp-gpu
            test-ci test-graphics test-model test-gpu cloudviewer-test)
        get_property(native GLOBAL PROPERTY "CV_TEST_${key}_EXTERNAL_NATIVE")
        if("cpp" IN_LIST labels)
            set(native TRUE)
        endif()
        foreach(target IN LISTS targets)
            if(NOT TARGET "${target}")
                # Later sibling directories may create this target (for
                # example plugin replay tests referring to the GUI executable).
                # The root aggregate validates it after all owners are known.
                set(native TRUE)
                continue()
            endif()
            get_target_property(type "${target}" TYPE)
            if(type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY|STATIC_LIBRARY)$")
                set(native TRUE)
            endif()
        endforeach()
        file(RELATIVE_PATH owner "${CMAKE_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}")
        set_property(GLOBAL PROPERTY "CV_TEST_${key}_OWNER" "${owner}")
        set(is_aicore FALSE)
        if(owner MATCHES "^core/AICore" OR "suite-aicore" IN_LIST labels)
            set(is_aicore TRUE)
            list(APPEND labels suite-aicore)
            string(JOIN "|" aicore_model_labels ${AICORE_TIER_MODEL_LABEL})
            string(JOIN "|" aicore_contract_labels ${AICORE_TIER_CONTRACT_LABEL})
            string(JOIN "|" aicore_contract_exclude ${AICORE_TIER_CONTRACT_MODEL_EXCLUDE})
            string(JOIN "|" aicore_fast_exclude ${AICORE_TIER_FAST_EXCLUDE})
            # These are independent selections. A model contract can belong to
            # both model and contract profiles when explicitly enabled.
            if("${labels}" MATCHES "(^|;)(${aicore_model_labels})(;|$)")
                list(APPEND labels aicore-model)
            endif()
            if("${labels}" MATCHES "(^|;)(${aicore_contract_labels})(;|$)")
                if(AICORE_TEST_ENABLE_MODEL_TESTS OR
                   NOT "${labels}" MATCHES "(^|;)(${aicore_contract_exclude})(;|$)")
                    list(APPEND labels aicore-contract)
                endif()
            endif()
            # Fast is an independent selection. Non-excluded capi rows remain
            # eligible, while the cached exclusion list always wins.
            if(NOT "${labels}" MATCHES "(^|;)(${aicore_fast_exclude})(;|$)")
                list(APPEND labels aicore-fast)
            endif()
        endif()
        # Script contracts belong to the same execution policy as native tests.
        # The root infrastructure check is invoked separately by Run.cmake.
        if(NOT "test-system" IN_LIST labels)
            list(APPEND labels cloudviewer-test)
            if(NOT "${labels}" MATCHES "(^|;)(model|gpu|e2e|graphics|network|benchmark|slow)(;|$)")
                list(APPEND labels test-ci)
            endif()
            foreach(capability graphics model gpu)
                if("${capability}" IN_LIST labels)
                    list(APPEND labels "test-${capability}")
                endif()
            endforeach()
        endif()
        if(native)
            list(APPEND labels cpp)
            if(NOT "${labels}" MATCHES "(^|;)(model|gpu|e2e|graphics|network|benchmark|slow)(;|$)")
                list(APPEND labels cpp-ci)
            endif()
            foreach(capability graphics model gpu)
                if("${capability}" IN_LIST labels)
                    list(APPEND labels "cpp-${capability}")
                endif()
            endforeach()
            if(owner MATCHES "^core/AICore")
                list(APPEND labels suite-aicore)
            elseif(owner MATCHES "^libs/Reconstruction")
                list(APPEND labels suite-reconstruction)
            elseif(owner MATCHES "^plugins/")
                list(APPEND labels suite-plugins)
            elseif(owner MATCHES "^libs/CVViewer")
                list(APPEND labels suite-cvviewer)
            elseif(owner MATCHES "^app/")
                list(APPEND labels suite-app)
            else()
                list(APPEND labels suite-foundation)
            endif()
            get_test_property("${name}" TIMEOUT timeout)
            if(NOT timeout OR timeout MATCHES "NOTFOUND$")
                set_tests_properties("${name}" PROPERTIES TIMEOUT 1200)
            endif()
            set_property(GLOBAL APPEND PROPERTY CV_CPP_TEST_NAMES "${name}")
        endif()
        # Native and script-driven model/device processes share the same lock.
        if("gpu" IN_LIST labels OR "model" IN_LIST labels)
            set_property(TEST "${name}" APPEND PROPERTY RESOURCE_LOCK cloudviewer_device)
        endif()
        list(REMOVE_DUPLICATES labels)
        set_tests_properties("${name}" PROPERTIES LABELS "${labels}")
        set_property(GLOBAL PROPERTY "CV_TEST_${key}_LABELS" "${labels}")
    endforeach()
endfunction()
