  "original_tex": "\\documentclass{article}\n\\usepackage{ifthen}\n\\usepackage{epsfig}\n\\usepackage[utf8]{inputenc}\n\\usepackage{newunicodechar}\n  \\newunicodechar{\u207b}{${}^{-}$}% Superscript minus\n  \\newunicodechar{\u00b2}{${}^{2}$}% Superscript two\n  \\newunicodechar{\u00b3}{${}^{3}$}% Superscript three\n\n\\pagestyle{empty}\n\\begin{document}\n$(I_p - I_q)^2 + \\lambda(D_p - (D_q)')^2$\n\\pagebreak\n\n$ I_p $\n\\pagebreak\n\n$ I_q $\n\\pagebreak\n\n$ D_p $\n\\pagebreak\n\n$ D_q $\n\\pagebreak\n\n$mi$\n\\pagebreak\n\n$ma$\n\\pagebreak\n\n$s$\n\\pagebreak\n\n$c$\n\\pagebreak\n\n$mi = c + s (mi - c)$\n\\pagebreak\n\n$ma = c + s (ma - c)$\n\\pagebreak\n\n$image = scale * image + offset$\n\\pagebreak\n\n$I = 0.299 * R + 0.587 * G + 0.114 * B$\n\\pagebreak\n\n$V(r, c+1)-V(r, c)$\n\\pagebreak\n\n$V(r+1, c)-V(r, c)$\n\\pagebreak\n\n\\begin{eqnarray*} \\text{Chamfer Distance: } d_{CD}(X,Y) &=& \\frac{1}{|X|}\\sum_{i \\in X} || x_i - n(x_i, Y) || + \\frac{1}{|Y|}\\sum_{i \\in Y} || y_i - n(y_i, X) || \\\\{} \\text{Hausdorff distance: } d_H(X,Y) &=& \\max \\left\\{ \\max_{i \\in X} || x_i - n(x_i, Y) ||, \\max_{i \\in Y} || y_i - n(y_i, X) || \\right\\} \\\\{} \\text{Precision: } P(X,Y|d) &=& \\frac{100}{|X|} \\sum_{i \\in X} || x_i - n(x_i, Y) || < d \\\\{} \\text{Recall: } R(X,Y|d) &=& \\frac{100}{|Y|} \\sum_{i \\in Y} || y_i - n(y_i, X) || < d \\\\{} \\text{F-Score: } F(X,Y|d) &=& \\frac{2 P(X,Y|d) R(X,Y|d)}{P(X,Y|d) + R(X,Y|d)} \\end{eqnarray*}\n\\pagebreak\n\n$J^T J$\n\\pagebreak\n\n$J^T r$\n\\pagebreak\n\n$[(V_p - V_q)^T N_p]^2$\n\\pagebreak\n\n$ V_p $\n\\pagebreak\n\n$ V_q $\n\\pagebreak\n\n$ N_p $\n\\pagebreak\n\n$(I_p - I_q)^2$\n\\pagebreak\n\n$ |rmse_{i+1} - rmse_i|/rmse_i < relative rmse$\n\\pagebreak\n\n$ |fitness_{i+1} - fitness_i|/fitness_i < relative fitness$\n\\pagebreak\n\n$p$\n\\pagebreak\n\n$s (p - c) + c$\n\\pagebreak\n\n$R$\n\\pagebreak\n\n$R (p - c) + c$\n\\pagebreak\n\n\\end{document}\n"
